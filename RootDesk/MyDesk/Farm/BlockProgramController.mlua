-- ACTIVE CLIENT EDITOR
-- Despite the legacy Farm folder path, this is the live client controller for
-- the mine UI. It assembles the nested D2 `type/body` schema and never executes
-- commands locally; only WorkerController validates and runs the program.
@Logic
script BlockProgramController extends Logic

property integer MaxProgramBlocks = 30
property integer MaxProgramDepth = 3

property ButtonComponent btnMoveE = "a9da4124-530a-4170-b259-5909775f3481"
property ButtonComponent btnMoveW = "6b47f230-0bb2-4528-93f9-0056f7fcf891"
property ButtonComponent btnMoveN = "7d482fdf-29ad-4b9b-b629-9100dabea995"
property ButtonComponent btnMoveS = "bf45e3f6-abf9-4b12-8992-5deb62b22535"
property ButtonComponent btnMine = "d1aedf26-6301-4413-9af8-fdf373c9b93b"
property ButtonComponent btnLoad = "cf049051-293c-4825-bb1a-0d2bab4801e6"
property ButtonComponent btnUnload = "7b720fd0-ddef-4a90-a2f8-95a7e8fc5dcb"
property ButtonComponent btnRepeat = "b18e993e-4ec7-4ef7-8eb4-34bfdd99527d"
property ButtonComponent btnRepeatCount = "792785ab-3d61-4a96-8ba1-ab1892c4785e"
property ButtonComponent btnIfOre = "ecf11b75-f624-4cb2-99db-5e6d5b3cc017"
property ButtonComponent btnCondition = "b8ebfcf3-7135-4eca-9e05-6884c867e13a"
property ButtonComponent btnEnd = "edafbf77-8061-4dcf-a4f2-94d6807482f1"
property ButtonComponent btnRun = "c8de2465-2f5f-42c7-8fe0-e5511682bdec"
property ButtonComponent btnStop = "3dab034e-6ad5-4bf7-a996-48e18ba6dbf6"
property ButtonComponent btnClear = "c93c1752-f4df-4533-a7c4-fd54076c5183"
-- UIBuilder text renderers on the program, feedback, and button entities.
property TextGUIRendererComponent repeatButtonText = "b18e993e-4ec7-4ef7-8eb4-34bfdd99527d"
property TextGUIRendererComponent repeatCountButtonText = "792785ab-3d61-4a96-8ba1-ab1892c4785e"
property TextGUIRendererComponent conditionButtonText = "b8ebfcf3-7135-4eca-9e05-6884c867e13a"
property TextGUIRendererComponent runButtonText = "c8de2465-2f5f-42c7-8fe0-e5511682bdec"
-- T-14 (docs/28): 줄글 표시(ProgramText)와 자연어 입력(ChatInput·변환)은 제거됐다.
-- 프로그램은 ProgramGrid 의 셀 36칸에 "칸 하나 = 블록 하나"로 표시하고,
-- ProgramLabel 이 빈/채움 상태 안내를 겸한다.
property TextGUIRendererComponent programLabelText = "0aa4c8fa-c647-466d-96f2-990c4bc0e2f9"
property Entity programGrid = "af4877f2-c4d8-451a-a15b-5b8cb1670cce"
-- 그리드 셀 수 (ui/BlockProgramUI.ui 의 Cell01..CellNN 과 일치해야 한다).
property integer StripCellCount = 36
-- 방향 블록 공통 아이콘. UIBuilder 로 팔레트·프로그램 셀·드래그 고스트에
-- 같은 리소스를 배치하고, 아래 표시 함수에서 방향별 Z 회전만 바꾼다.
property string DirectionIconRuid = "03af6020eaf541e1937dd23d48476aa5"
-- T-18b (2026-08-26 오너 보고 — "일부 구간에서 안 뜨고 이동도 안 된다"):
-- 드롭 판정을 칸 안쪽으로만 하면 **칸 사이 6px 틈**과 **행 위아래**가 전부
-- 사각지대가 된다(실측: 56px 밴드 밖 y=-152·-92 에서 즉시 판정 0). 정확히
-- 안 들어와도 이 반경 안이면 가장 가까운 칸으로 붙인다. 0 이하면 옛 엄격 판정.
property number DropSnapRadius = 40
property TextGUIRendererComponent feedbackText = "d24cb5fb-6524-4dc9-a58f-2889777374aa"
-- T-17b: 드래그 고스트 — 드래그 확정 중 커서를 따라오는 잔상 셀 (그룹 루트 직속,
-- raycast 없음). 문구·틴트는 원본 토큰을 복제하고, 놓으면 숨긴 뒤 이동을 수행한다.
property Entity dragGhost = "a5edce44-c3ad-45f2-9ffd-b9d86ff16176"
property TextGUIRendererComponent dragGhostText = "a5edce44-c3ad-45f2-9ffd-b9d86ff16176"
property SpriteGUIRendererComponent dragGhostSprite = "a5edce44-c3ad-45f2-9ffd-b9d86ff16176"
-- T-17c: 드롭 위치 안내선 — 커서가 올라간 칸의 왼쪽 경계(= 그 칸 앞 삽입)에
-- 세로로 긴 주황 선을 세운다. 드롭 규칙("대상 칸 앞 삽입")의 시각 표현.
property Entity dropLine = "a798fd1a-e9d5-4caf-97cf-44e8af0d31f2"
property ButtonComponent btnWorker1 = "b82c7a2d-41a0-40ef-93e9-f98b9a13b2cd"
-- 워커 칩 5개는 레거시 TextComponent 를 쓴다. TextGUIRendererComponent 로
-- 선언하면 런타임 nil 이 되어 라벨이 한 번도 갱신되지 않는다 (docs/16 §15 D-12).
property TextComponent worker1ButtonText = "b82c7a2d-41a0-40ef-93e9-f98b9a13b2cd"
property ButtonComponent btnWorker2 = "f08a6c90-b376-411e-b6c9-859d694bb530"
property ButtonComponent btnWorker3 = "a0ca4259-731b-4cc1-bcbd-d23e4e02aff5"
property ButtonComponent btnWorker4 = "d7a3b959-0a71-4742-9b94-fbd4f7135bce"
property ButtonComponent btnWorker5 = "cdf167d4-b5da-48f9-9ac9-fa6a8c144d7f"
property TextComponent worker2ButtonText = "f08a6c90-b376-411e-b6c9-859d694bb530"
property TextComponent worker3ButtonText = "a0ca4259-731b-4cc1-bcbd-d23e4e02aff5"
property TextComponent worker4ButtonText = "d7a3b959-0a71-4742-9b94-fbd4f7135bce"
property TextComponent worker5ButtonText = "cdf167d4-b5da-48f9-9ac9-fa6a8c144d7f"
-- 칩 배경 스프라이트. 라벨과 같은 엔티티라 UUID 도 같지만, 컴포넌트 타입이
-- 다르므로 별도 프로퍼티가 필요하다. 문구를 대체하는 것이 아니라 함께 바뀐다
-- (docs/20 §6 — 아이콘·색 단독 표기 금지).
property SpriteGUIRendererComponent worker1ChipSprite = "b82c7a2d-41a0-40ef-93e9-f98b9a13b2cd"
property SpriteGUIRendererComponent worker2ChipSprite = "f08a6c90-b376-411e-b6c9-859d694bb530"
property SpriteGUIRendererComponent worker3ChipSprite = "a0ca4259-731b-4cc1-bcbd-d23e4e02aff5"
property SpriteGUIRendererComponent worker4ChipSprite = "d7a3b959-0a71-4742-9b94-fbd4f7135bce"
property SpriteGUIRendererComponent worker5ChipSprite = "cdf167d4-b5da-48f9-9ac9-fa6a8c144d7f"
-- docs/26 §5.2 tab-worker-* 의 확정 RUID. 값을 바꿀 일이 생기면 그 문서가
-- 단일 기준이며 여기와 함께 고친다.
property string TabSpriteSelected = "acfb0998854a4fb4b1a9927afd2a9993"
property string TabSpriteNormal = "db0c502147114dbfb47a5e87322937b4"
property string TabSpriteDisabled = "a864624d7b454085bcb76f86a0ed8d07"
property integer SelectedWorkerIndex = 1

-- Panel collapse toggle (C201 / docs/08 §6.3). btnToggle is a sibling of the
-- panel so it stays alive while the panel subtree is disabled.
property ButtonComponent btnToggle = "dc2d9c74-935f-411f-bc00-4337288cc7b1"
property TextGUIRendererComponent toggleButtonText = "dc2d9c74-935f-411f-bc00-4337288cc7b1"
property Entity programPanel = "54c94cbd-758e-4d66-a3fc-2f885989564a"

@ExecSpace("ClientOnly")
method void OnBeginPlay()
    -- Resets the editor and wires every D2 palette, control, and text-input event.
    self:ResetEditor()
    self._T.handlers = {}
    self._T.lastWorkerState = ""
    -- 2026-08-25: 재접속 시 마지막 실행 프로그램을 편집기 버퍼로 복원. 프로필
    -- 로드·복구(0.5s)·자동 실행(1.5s)이 비동기라 3s/8s 두 번 요청한다. 서버가
    -- 조건 미충족(튜토리얼 1회차·기록 없음)이면 응답하지 않는다.
    self._T.editorRestoreDone = false
    self._T.editorRestoreTimers = {
        _TimerService:SetTimerOnce(function() self:RequestEditorRestore() end, 3.0),
        _TimerService:SetTimerOnce(function() self:RequestEditorRestore() end, 8.0),
    }
    self._T.handlers.moveE = self.btnMoveE.Entity:ConnectEvent(ButtonClickEvent, function() self:AddCommand({ type = "move", dir = "E" }, "E") end)
    self._T.handlers.moveW = self.btnMoveW.Entity:ConnectEvent(ButtonClickEvent, function() self:AddCommand({ type = "move", dir = "W" }, "W") end)
    self._T.handlers.moveN = self.btnMoveN.Entity:ConnectEvent(ButtonClickEvent, function() self:AddCommand({ type = "move", dir = "N" }, "N") end)
    self._T.handlers.moveS = self.btnMoveS.Entity:ConnectEvent(ButtonClickEvent, function() self:AddCommand({ type = "move", dir = "S" }, "S") end)
    self._T.handlers.mine = self.btnMine.Entity:ConnectEvent(ButtonClickEvent, function() self:AddCommand({ type = "mine" }, "M") end)
    self._T.handlers.load = self.btnLoad.Entity:ConnectEvent(ButtonClickEvent, function() self:AddCommand({ type = "load" }, "L") end)
    self._T.handlers.unload = self.btnUnload.Entity:ConnectEvent(ButtonClickEvent, function() self:AddCommand({ type = "unload" }, "U") end)
    self._T.handlers.repeatBlock = self.btnRepeat.Entity:ConnectEvent(ButtonClickEvent, self.OnRepeatClicked)
    self._T.handlers.repeatCount = self.btnRepeatCount.Entity:ConnectEvent(ButtonClickEvent, self.OnRepeatCountClicked)
    self._T.handlers.ifOre = self.btnIfOre.Entity:ConnectEvent(ButtonClickEvent, self.OnIfOreClicked)
    self._T.handlers.condition = self.btnCondition.Entity:ConnectEvent(ButtonClickEvent, self.OnConditionClicked)
    self._T.handlers.endBlock = self.btnEnd.Entity:ConnectEvent(ButtonClickEvent, self.OnEndBlockClicked)
    self._T.handlers.run = self.btnRun.Entity:ConnectEvent(ButtonClickEvent, self.OnRunClicked)
    self._T.handlers.stop = self.btnStop.Entity:ConnectEvent(ButtonClickEvent, self.OnStopClicked)
    self._T.handlers.clear = self.btnClear.Entity:ConnectEvent(ButtonClickEvent, self.OnClearClicked)
    self:ConnectStripCells()
    if self.btnWorker1 ~= nil then
        self._T.handlers.worker1 = self.btnWorker1.Entity:ConnectEvent(ButtonClickEvent, self.OnWorker1Clicked)
    end
    if self.btnWorker2 ~= nil then self._T.handlers.worker2 = self.btnWorker2.Entity:ConnectEvent(ButtonClickEvent, self.OnWorker2Clicked) end
    if self.btnWorker3 ~= nil then self._T.handlers.worker3 = self.btnWorker3.Entity:ConnectEvent(ButtonClickEvent, self.OnWorker3Clicked) end
    if self.btnWorker4 ~= nil then self._T.handlers.worker4 = self.btnWorker4.Entity:ConnectEvent(ButtonClickEvent, self.OnWorker4Clicked) end
    if self.btnWorker5 ~= nil then self._T.handlers.worker5 = self.btnWorker5.Entity:ConnectEvent(ButtonClickEvent, self.OnWorker5Clicked) end
    if self.btnToggle ~= nil then
        self._T.handlers.toggle = self.btnToggle.Entity:ConnectEvent(ButtonClickEvent, self.OnToggleClicked)
    end
    self:RefreshToggleLabel()
    self.SelectedWorkerIndex = 1
    self:RefreshWorkerButtons()
    self._T.lastOwnedCount = self:GetOwnedWorkerCount()
    self:RefreshDisplay()
    self:SetFeedback("블록을 눌러 프로그램을 만들어 주세요.")
    log("[BlockProgram] direction icon ready ruid=" .. self.DirectionIconRuid)
    log("[BlockProgram] MVP UI ready - strip cells=" .. tostring(#self._T.cells))
end

@ExecSpace("ClientOnly")
method void AddCommand(table command, string label)
    -- Appends one command to the currently open program body.
    if self:CountBlocks(self._T.program) >= self.MaxProgramBlocks then
        self:SetFeedback("프로그램은 최대 30블록까지 만들 수 있습니다.")
        return
    end
    if (command.type == "repeat" or command.type == "if") and #self._T.openBodies - 1 >= self.MaxProgramDepth then
        self:SetFeedback("제어 블록은 최대 3단계까지 중첩할 수 있습니다.")
        return
    end
    local body = self._T.openBodies[#self._T.openBodies]
    table.insert(body, command)
    self:RefreshDisplay()
    log("[BlockProgram] added block '" .. label .. "' depth=" .. tostring(#self._T.openBodies - 1))
end

@ExecSpace("ClientOnly")
method void ConnectStripCells()
    -- T-14: ProgramGrid 의 Cell01..CellNN 을 이름으로 찾아 클릭 핸들러를 건다.
    -- 셀 36개를 property 로 하나씩 바인딩하는 대신 컨테이너 하나만 바인딩하고
    -- 이름 규칙으로 순회한다 — 이름이 곧 표시 순서다.
    self._T.cells = {}
    self._T.cellHandlers = {}
    self._T.cellNums = {}
    self._T.cellDownHandlers = {}
    self._T.cellDragHandlers = {}
    self._T.cellUpHandlers = {}
    self._T.dragMoved = false
    self._T.dragSrc = nil
    if self.programGrid == nil then return end
    for i = 1, self.StripCellCount do
        local suffix = tostring(i)
        if i < 10 then suffix = "0" .. suffix end
        local cellEntity = self.programGrid:GetChildByName("Cell" .. suffix, false)
        if cellEntity == nil then break end
        self._T.cells[i] = cellEntity
        -- T-16: 셀 좌상단 순번 오버레이 (docs/31 §2.1 — 맵 마커와 같은 번호).
        -- Num 자식이 없는 임포트본에서도 죽지 않게 nil 을 허용한다.
        local numEntity = cellEntity:GetChildByName("Num", false)
        if numEntity ~= nil then
            self._T.cellNums[i] = numEntity.TextGUIRendererComponent
        end
        local cellIndex = i
        self._T.cellHandlers[i] = cellEntity:ConnectEvent(ButtonClickEvent, function() self:OnStripCellClicked(cellIndex) end)
        -- T-17: 셀 드래그 재배치 — 짧게 누르면 삭제(기존), 끌면 이동.
        self._T.cellDownHandlers[i] = cellEntity:ConnectEvent(UITouchDownEvent, function(touchEvent) self:OnCellTouchDown(cellIndex, touchEvent) end)
        self._T.cellDragHandlers[i] = cellEntity:ConnectEvent(UITouchDragEvent, function(touchEvent) self:OnCellTouchDrag(cellIndex, touchEvent) end)
        self._T.cellUpHandlers[i] = cellEntity:ConnectEvent(UITouchUpEvent, function(touchEvent) self:OnCellTouchUp(cellIndex, touchEvent) end)
    end
end

@ExecSpace("ClientOnly")
method void OnCellTouchDown(integer cellIndex, UITouchDownEvent touchEvent)
    -- T-17: 드래그 후보 시작. 실제 이동 여부는 임계 거리(OnCellTouchDrag)가 정한다.
    self._T.dragMoved = false
    self._T.dragSrc = cellIndex
    self._T.dragStart = touchEvent.TouchPoint
end

@ExecSpace("ClientOnly")
method void OnCellTouchDrag(integer cellIndex, UITouchDragEvent touchEvent)
    -- T-17: 임계 거리(화면 12px)를 넘으면 "이동"으로 확정한다. 확정 순간
    -- 이동 가능 여부를 판정해, 제어 칸이면 즉시 취소 안내를 낸다.
    -- 확정 후에는 고스트 셀이 커서를 따라온다 (T-17b — 오너 요청).
    if self._T.dragSrc == nil then return end
    if self._T.dragMoved then
        self:MoveDragGhost(touchEvent.TouchPoint)
        self:UpdateDropLine(touchEvent.TouchPoint)
        return
    end
    local dx = touchEvent.TouchPoint.x - self._T.dragStart.x
    local dy = touchEvent.TouchPoint.y - self._T.dragStart.y
    if dx * dx + dy * dy < 144 then return end
    self._T.dragMoved = true
    local token = self._T.strip[self._T.dragSrc]
    if token == nil or token.kind == "overflow" or token.node == nil then
        -- 접힘(+N) 칸은 단일 블록이 아니라서 끌 수 없다. dragMoved 는 유지해
        -- 뒤따르는 클릭 삭제도 함께 막는다.
        self._T.dragSrc = nil
        self:SetFeedback("접힌 칸은 앞쪽 블록을 지워 펼친 뒤에 옮길 수 있습니다.")
        return
    end
    local nodeType = token.node.type
    local isControl = (nodeType == "repeat" or nodeType == "if")
    if not isControl and nodeType ~= "move" and nodeType ~= "mine"
        and nodeType ~= "load" and nodeType ~= "unload" then
        self._T.dragSrc = nil
        self:SetFeedback("이 칸은 드래그로 옮길 수 없습니다.")
        return
    end
    self:ShowDragGhost(token)
    self:MoveDragGhost(touchEvent.TouchPoint)
    self:UpdateDropLine(touchEvent.TouchPoint)
    if isControl then
        -- T-18 (2026-08-26 오너 결정): 제어 칸은 "이동"이 아니라 **범위 손잡이**다.
        -- 여는 칸을 앞으로 끌면 그 지점부터, ] 을 뒤로 끌면 그 지점까지가 몸통이 된다.
        if token.label == "]" then
            self:SetFeedback("범위의 끝을 정하세요 — 놓는 칸까지가 반복 안에 들어갑니다.")
        else
            self:SetFeedback("범위의 시작을 정하세요 — 놓는 칸부터 반복 안에 들어갑니다.")
        end
    else
        self:SetFeedback("'" .. token.label .. "' 블록을 옮길 칸 위에서 놓으세요.")
    end
end

@ExecSpace("ClientOnly")
method void ShowDragGhost(table token)
    -- T-17b: 고스트를 원본 토큰의 문구·틴트(PaintCell 과 동일 계열)로 켠다.
    -- 원본 칸은 반투명으로 눌러 "여기서 뽑혀 나왔다"를 보인다 — 원복은 드롭 후
    -- RefreshDisplay 의 전체 재도색이 한다.
    if self.dragGhost == nil then return end
    local isMove = token.tint == "move"
    if self.dragGhostText ~= nil then
        -- 이동 블록은 문자(E/W/N/S) 대신 방향 아이콘으로 읽게 한다.
        self.dragGhostText.Text = isMove and "" or token.label
    end
    local ghostIcon = self.dragGhost:GetChildByName("Icon", false)
    if ghostIcon ~= nil then
        ghostIcon.Enable = isMove
        if isMove then self:ApplyDirectionIcon(ghostIcon, token.label, false) end
    end
    if self.dragGhostSprite ~= nil then
        if token.tint == "work" then
            self.dragGhostSprite.Color = Color(0.78, 0.93, 0.78, 0.85)
        elseif token.tint == "ctrl" then
            -- T-18: 제어 칸도 끌 수 있게 되면서 고스트에 계열 틴트가 필요해졌다
            -- (PaintCell 과 같은 값 — 손에 든 것이 무엇인지 색으로 읽힌다).
            self.dragGhostSprite.Color = Color(0.99, 0.86, 0.64, 0.85)
        else
            self.dragGhostSprite.Color = Color(1, 1, 1, 0.85)
        end
    end
    self.dragGhost.Enable = true
    -- 창(UIDraggable)이 잡힐 때마다 SetSiblingIndex(1000000) 으로 맨 앞에 오므로,
    -- 고스트·안내선도 드래그 시작마다 다시 맨 앞으로 올린다 — 안 하면 창을 한 번
    -- 이라도 옮긴 뒤부터 고스트가 창 뒤로 깔린다 (2026-08-26 오너 보고).
    -- 순서: 안내선 → 고스트 (고스트가 최상위).
    if self.dropLine ~= nil and self.dropLine.UITransformComponent ~= nil then
        _UILogic:SetSiblingIndex(self.dropLine.UITransformComponent, 1000000)
    end
    if self.dragGhost.UITransformComponent ~= nil then
        _UILogic:SetSiblingIndex(self.dragGhost.UITransformComponent, 1000000)
    end
    local srcCell = self._T.cells[self._T.dragSrc]
    if srcCell ~= nil and srcCell.SpriteGUIRendererComponent ~= nil then
        local color = srcCell.SpriteGUIRendererComponent.Color
        srcCell.SpriteGUIRendererComponent.Color = Color(color.r, color.g, color.b, 0.35)
    end
end

@ExecSpace("ClientOnly")
method Vector2 WindowToCanvas(Vector2 windowPoint)
    -- **GetWorldCorners 픽셀** → 캔버스 좌표. ⚠ 좌표계 2개 주의(2026-08-25 실측):
    -- 터치 이벤트 TouchPoint 는 ScreenToUIPosition 으로(커서 앵커 줌 §42 가 증명),
    -- GetWorldCorners 는 이 루트 코너 정규화로(안내선 §68 후속2 가 증명) 환산해야
    -- 한다. 둘을 섞어 비교하면 실마우스에서 어긋난다 — 비교는 항상 캔버스에서.
    local root = self.dragGhost.Parent
    if root == nil or root.UITransformComponent == nil then return Vector2(0, 0) end
    local rootTransform = root.UITransformComponent
    local corners = rootTransform:GetWorldCorners()
    if corners == nil or corners[1] == nil or corners[3] == nil then return Vector2(0, 0) end
    local width = corners[3].x - corners[1].x
    local height = corners[2].y - corners[1].y
    if width <= 0 or height <= 0 then return Vector2(0, 0) end
    local size = rootTransform.RectSize
    local nx = (windowPoint.x - corners[1].x) / width
    local ny = (windowPoint.y - corners[1].y) / height
    return Vector2(nx * size.x - size.x / 2, ny * size.y - size.y / 2)
end

@ExecSpace("ClientOnly")
method void MoveDragGhost(Vector2 touchPoint)
    -- 고스트는 전화면 루트 직속 — 터치 좌표는 ScreenToUIPosition 으로 환산해야
    -- 실마우스 커서와 1:1 로 붙는다 (WindowToCanvas 를 쓰면 어긋난다 — 위 주석).
    if self.dragGhost == nil or not self.dragGhost.Enable then return end
    local transform = self.dragGhost.UITransformComponent
    if transform == nil then return end
    transform.anchoredPosition = _UILogic:ScreenToUIPosition(touchPoint)
end

@ExecSpace("ClientOnly")
method boolean IsPointPastCellCenter(integer cellIndex, Vector2 screenPoint)
    -- T-18d: 드롭 경계는 칸의 **앞/뒤 두 자리**다. 커서가 오른쪽 절반이면 뒤에 넣는다.
    -- 항상 "그 칸 앞"으로만 넣으면 ① 자기 바로 뒤 칸에 놓을 때 제자리가 되고
    -- ② **줄 맨 끝 자리에는 아예 놓을 수 없다** (2026-08-26 오너 보고).
    local cell = self._T.cells[cellIndex]
    if cell == nil or cell.UITransformComponent == nil then return false end
    local corners = cell.UITransformComponent:GetWorldCorners()
    if corners == nil or corners[1] == nil or corners[3] == nil then return false end
    local low = self:WindowToCanvas(corners[1])
    local high = self:WindowToCanvas(corners[3])
    local canvasPoint = _UILogic:ScreenToUIPosition(screenPoint)
    return canvasPoint.x > (low.x + high.x) / 2
end

@ExecSpace("ClientOnly")
method boolean IsNoOpBoundary(integer srcIndex, integer dstIndex, boolean insertAfter)
    -- 자기 **바로 앞/뒤** 경계에 놓는 것은 순서가 그대로다. 그런데도 안내선을
    -- 띄우면 "여기로 옮겨진다"고 읽히는데 실제로는 아무 일도 없어 고장으로 보인다
    -- — 오너 보고의 "판정선 위치로 이동하지 않는" 경우가 정확히 이것이다.
    if srcIndex == dstIndex then return true end
    local src = self._T.strip[srcIndex]
    local dst = self._T.strip[dstIndex]
    if src == nil or dst == nil or src.list == nil or src.list ~= dst.list then return false end
    local si = 0
    local di = 0
    for i = 1, #src.list do
        if src.list[i] == src.node then si = i end
        if src.list[i] == dst.node then di = i end
    end
    if si == 0 or di == 0 then return false end
    if not insertAfter and di == si + 1 then return true end
    if insertAfter and di == si - 1 then return true end
    return false
end

@ExecSpace("ClientOnly")
method boolean IsControlDrag()
    -- 제어 손잡이(반복/IF/])는 "경계 칸" 단위라 앞/뒤 절반 구분이 없다.
    local token = self._T.strip[self._T.dragSrc]
    if token == nil or token.node == nil then return false end
    return token.node.type == "repeat" or token.node.type == "if"
end

@ExecSpace("ClientOnly")
method void UpdateDropLine(Vector2 screenPoint)
    -- T-17c: 삽입 안내선. T-18d 개정 — 선을 세우는 자리와 실제 삽입 자리가
    -- 반드시 같아야 한다(앞/뒤 경계 동일 판정 + 제자리 경계는 숨김).
    if self.dropLine == nil then return end
    local target = self:CellIndexAtPoint(screenPoint)
    if target == 0 then
        self.dropLine.Enable = false
        return
    end
    local isControl = self:IsControlDrag()
    local insertAfter = false
    if not isControl then
        insertAfter = self:IsPointPastCellCenter(target, screenPoint)
        if self:IsNoOpBoundary(self._T.dragSrc, target, insertAfter) then
            self.dropLine.Enable = false
            return
        end
    elseif target == self._T.dragSrc then
        self.dropLine.Enable = false
        return
    end
    local cell = self._T.cells[target]
    if cell == nil or cell.UITransformComponent == nil then
        self.dropLine.Enable = false
        return
    end
    local corners = cell.UITransformComponent:GetWorldCorners()
    if corners == nil or corners[1] == nil or corners[2] == nil then
        -- 그냥 return 하면 안내선이 직전 자리에 남아 엉뚱한 곳을 가리킨다.
        self.dropLine.Enable = false
        return
    end
    -- 경계 중앙(실창 픽셀) → 루트 코너 정규화 환산. 칸 간격 6px 의 한가운데.
    -- 뒤에 넣을 때는 **오른쪽** 경계에 세운다 — 안 그러면 선과 결과가 어긋난다.
    local edgeX = corners[1].x
    local gap = -3
    if insertAfter and corners[3] ~= nil then
        edgeX = corners[3].x
        gap = 3
    end
    local edge = self:WindowToCanvas(Vector2(edgeX, (corners[1].y + corners[2].y) / 2))
    local transform = self.dropLine.UITransformComponent
    if transform == nil then return end
    transform.anchoredPosition = Vector2(edge.x + gap, edge.y)
    self.dropLine.Enable = true
end

@ExecSpace("ClientOnly")
method void HideDragGhost()
    -- 드롭·취소 공용 정리 (안내선 포함).
    if self.dragGhost ~= nil then self.dragGhost.Enable = false end
    if self.dropLine ~= nil then self.dropLine.Enable = false end
end

@ExecSpace("ClientOnly")
method void OnCellTouchUp(integer cellIndex, UITouchUpEvent touchEvent)
    -- T-17: 드래그가 확정된 상태로 놓으면 대상 칸을 찾아 이동을 수행한다.
    -- 확정 전(짧은 탭)은 아무것도 하지 않는다 — 기존 클릭 삭제가 처리한다.
    local src = self._T.dragSrc
    self._T.dragSrc = nil
    self:HideDragGhost()
    if src == nil or not self._T.dragMoved then return end
    local dst = self:CellIndexAtPoint(touchEvent.TouchPoint)
    -- T-18d: 안내선과 **같은 함수**로 앞/뒤를 정한다 — 두 곳이 각자 판정하면
    -- 선이 가리킨 자리와 실제 삽입 자리가 갈린다.
    local insertAfter = false
    if dst > 0 and not self:IsControlDrag() then
        insertAfter = self:IsPointPastCellCenter(dst, touchEvent.TouchPoint)
    end
    self:MoveStripToken(src, dst, insertAfter)
end

@ExecSpace("ClientOnly")
method integer CellIndexAtPoint(Vector2 touchPoint)
    -- 터치 좌표가 어느 활성 셀 위인지 판정한다. ⚠ TouchPoint 와 GetWorldCorners
    -- 는 좌표계가 다르므로(§68 후속3) **양쪽 다 캔버스로 환산해** 비교한다 —
    -- 섞어 비교하면 실마우스에서 한 칸씩 어긋난다.
    -- T-18b: 칸 안쪽 정확 판정이 1순위이고, 빗나가면 **가장 가까운 칸에 붙인다**.
    -- 엄격 판정만 두면 칸 사이 6px 틈과 56px 행 밴드 바깥이 통째로 사각지대라,
    -- 커서가 조금만 위아래로 흘러도 안내선이 사라지고 드롭이 취소됐다.
    local canvasPoint = _UILogic:ScreenToUIPosition(touchPoint)
    local bestIndex = 0
    local bestDist = -1
    for i = 1, #self._T.cells do
        local cell = self._T.cells[i]
        if cell ~= nil and cell.Enable then
            local transform = cell.UITransformComponent
            if transform ~= nil then
                local corners = transform:GetWorldCorners()
                if corners ~= nil and corners[1] ~= nil and corners[3] ~= nil then
                    local low = self:WindowToCanvas(corners[1])
                    local high = self:WindowToCanvas(corners[3])
                    -- 점→사각형 거리(안이면 0). 축마다 벗어난 만큼만 센다.
                    local dx = 0
                    if canvasPoint.x < low.x then
                        dx = low.x - canvasPoint.x
                    elseif canvasPoint.x > high.x then
                        dx = canvasPoint.x - high.x
                    end
                    local dy = 0
                    if canvasPoint.y < low.y then
                        dy = low.y - canvasPoint.y
                    elseif canvasPoint.y > high.y then
                        dy = canvasPoint.y - high.y
                    end
                    if dx <= 0 and dy <= 0 then return i end
                    local dist = dx * dx + dy * dy
                    if bestDist < 0 or dist < bestDist then
                        bestDist = dist
                        bestIndex = i
                    end
                end
            end
        end
    end
    -- 반경 밖은 여전히 취소다 — 스트립에서 멀리 떨어뜨려 드롭 취소하는 길을 남긴다.
    if self.DropSnapRadius > 0 and bestIndex > 0
        and bestDist >= 0 and bestDist <= self.DropSnapRadius * self.DropSnapRadius then
        return bestIndex
    end
    return 0
end

@ExecSpace("ClientOnly")
method void MoveStripToken(integer srcIndex, integer dstIndex, boolean insertAfter)
    -- T-17 이동 규칙 (2026-08-25 오너 결정 — 단일 블록만):
    --   대상이 일반 칸 = 그 블록 앞에 삽입 · 제어 시작 칸 = 그 제어 블록 앞 ·
    --   `]` 칸 = 그 제어 블록 몸통의 맨 뒤 · 칸 밖/접힘 칸 = 취소.
    local srcToken = self._T.strip[srcIndex]
    if srcToken == nil or srcToken.node == nil then return end
    if dstIndex == 0 or dstIndex == srcIndex then
        self:SetFeedback("이동을 취소했습니다.")
        self:RefreshDisplay()
        return
    end
    local dstToken = self._T.strip[dstIndex]
    if dstToken == nil or dstToken.kind == "overflow" or dstToken.node == nil then
        self:SetFeedback("이동을 취소했습니다.")
        self:RefreshDisplay()
        return
    end
    -- T-18 (2026-08-26 오너 결정): 제어 칸(반복/IF/])은 **범위 손잡이**다 —
    -- 통째 이동이 아니라 몸통의 시작·끝 경계를 다시 긋는다.
    if srcToken.node.type == "repeat" or srcToken.node.type == "if" then
        self:ResizeControlRange(srcToken, dstToken)
        return
    end
    -- T-18d: 자기 바로 앞/뒤 경계는 순서가 그대로다. 옮겼다고 알리면 거짓말이 된다.
    if self:IsNoOpBoundary(srcIndex, dstIndex, insertAfter) then
        self:SetFeedback("'" .. srcToken.label .. "' 는 이미 그 자리입니다.")
        self:RefreshDisplay()
        return
    end
    -- 원본 노드를 제 리스트에서 뺀다 (토큰이 원본 노드·리스트 참조를 든다 — T-14).
    local removed = false
    for i = 1, #srcToken.list do
        if srcToken.list[i] == srcToken.node then
            table.remove(srcToken.list, i)
            removed = true
            break
        end
    end
    if not removed then
        log("[BlockProgram] drag source missing from tree - repaint")
        self:RefreshDisplay()
        return
    end
    if (dstToken.node.type == "repeat" or dstToken.node.type == "if") and dstToken.label == "]" then
        table.insert(dstToken.node.body, srcToken.node)
    else
        local inserted = false
        for i = 1, #dstToken.list do
            if dstToken.list[i] == dstToken.node then
                -- T-18d: 커서가 칸의 오른쪽 절반이면 **그 칸 뒤**에 넣는다.
                -- 안내선이 오른쪽 경계에 섰을 때와 같은 자리여야 한다.
                local at = i
                if insertAfter then at = i + 1 end
                table.insert(dstToken.list, at, srcToken.node)
                inserted = true
                break
            end
        end
        if not inserted then
            -- 대상이 사라진 극단 케이스 — 프로그램 끝에 붙여 블록 유실을 막는다.
            table.insert(self._T.program, srcToken.node)
        end
    end
    self:RefreshDisplay()
    self:SetFeedback("'" .. srcToken.label .. "' 블록을 옮겼습니다.")
    log("[BlockProgram] strip drag-move '" .. srcToken.label .. "' " .. tostring(srcIndex) .. " -> " .. tostring(dstIndex))
end

@ExecSpace("ClientOnly")
method void ResizeControlRange(table srcToken, table dstToken)
    -- T-18 (2026-08-26 오너 결정 — "블록을 다 만든 뒤에 반복을 씌우고 싶다"):
    -- 제어 블록의 여는 칸과 ] 칸을 각각 **경계 손잡이**로 쓴다.
    --
    -- 방법: 제어 블록을 **한 단계 펼친 한 줄**(앞 형제 + 몸통 + 뒤 형제)로 만든 뒤,
    -- 드롭 지점에서 다시 자른다. 여는 칸을 끌면 시작 경계가, ] 을 끌면 끝 경계가
    -- 그 자리로 온다. 경계 밖으로 밀려난 블록은 **형제로 제자리에 남는다**(오너
    -- 결정 — 칸 클릭 삭제의 "껍데기만·몸통 보존"과 같은 원칙. 조작 한 번에
    -- 블록이 증발하지 않게 한다).
    local ctrl = srcToken.node
    local list = srcToken.list
    local body = ctrl.body
    if type(body) ~= "table" or type(list) ~= "table" then
        self:RefreshDisplay()
        return
    end
    local ctrlIndex = 0
    for i = 1, #list do
        if list[i] == ctrl then
            ctrlIndex = i
            break
        end
    end
    if ctrlIndex == 0 then
        log("[BlockProgram] control missing from tree - repaint")
        self:RefreshDisplay()
        return
    end
    -- 펼친 한 줄: [앞 형제…][몸통…][뒤 형제…]. 제어 자신은 빠진다.
    local combined = {}
    for i = 1, ctrlIndex - 1 do table.insert(combined, list[i]) end
    for i = 1, #body do table.insert(combined, body[i]) end
    for i = ctrlIndex + 1, #list do table.insert(combined, list[i]) end
    local bodyStart = ctrlIndex
    local bodyEnd = ctrlIndex + #body - 1
    -- 드롭 대상이 이 한 줄의 몇 번째인가. 같은 형제 리스트나 이 제어의 몸통이
    -- 아니면 취소한다 — 다른 제어 안쪽으로 경계를 밀어 넣는 것은 괄호 짝이
    -- 엇갈리므로 허용하지 않는다.
    local target = 0
    if dstToken.list == list then
        for i = 1, #list do
            if list[i] == dstToken.node then
                if i < ctrlIndex then target = i else target = i - 1 + #body end
                break
            end
        end
    elseif dstToken.list == body then
        for i = 1, #body do
            if body[i] == dstToken.node then
                target = ctrlIndex - 1 + i
                break
            end
        end
    end
    if target == 0 or dstToken.node == ctrl then
        self:SetFeedback("이 칸으로는 반복 범위를 옮길 수 없습니다. 같은 줄의 블록 위에 놓아 주세요.")
        self:RefreshDisplay()
        return
    end
    -- T-18c (2026-08-26 오너 보고 — "] 는 옮겨지지가 않아"): 두 손잡이를 **대칭**으로
    -- 만든다. 잡은 경계를 반대쪽 경계 너머로 끌면 예전에는 빈 범위로 접혀
    -- "아무 일도 안 일어난 것"처럼 보였다 — 제어가 줄 맨 끝에 빈 몸통으로 있으면
    -- ] 뒤에 블록이 없어 **항상** 그 경우였다. 이제는 반대쪽 경계가 따라와서
    -- "그 방향으로 쓸어 담기"가 된다.
    local isClosing = (srcToken.label == "]")
    local newStart = bodyStart
    local newEnd = bodyEnd
    if isClosing then
        if target >= bodyStart then
            newEnd = target
        else
            -- ] 을 시작 경계보다 앞으로 → 앞쪽으로 쓸어 담는다.
            newStart = target
            newEnd = bodyStart - 1
        end
    else
        if target <= bodyEnd then
            newStart = target
        else
            -- 여는 칸을 끝 경계보다 뒤로 → 뒤쪽으로 쓸어 담는다 (위의 거울).
            newStart = bodyEnd + 1
            newEnd = target
        end
    end
    if newStart == bodyStart and newEnd == bodyEnd then
        self:SetFeedback("범위가 그대로입니다.")
        self:RefreshDisplay()
        return
    end
    -- **제자리 수술**: body·list 를 새 테이블로 갈아 끼우면 열림 스택
    -- (openControls[k].body == openBodies[k+1])의 참조가 끊어져, 아직 닫지 않은
    -- 제어 블록이 조용히 고아가 된다. 반드시 같은 테이블을 비우고 다시 채운다.
    for i = #body, 1, -1 do table.remove(body, i) end
    for i = newStart, newEnd do table.insert(body, combined[i]) end
    for i = #list, 1, -1 do table.remove(list, i) end
    for i = 1, newStart - 1 do table.insert(list, combined[i]) end
    table.insert(list, ctrl)
    for i = newEnd + 1, #combined do table.insert(list, combined[i]) end
    self:RefreshDisplay()
    local countLabel = "반복"
    if ctrl.type == "if" then countLabel = "IF" end
    if #body == 0 then
        self:SetFeedback(countLabel .. " 범위를 비웠습니다. 경계 칸을 감쌀 블록 위로 끌면 다시 채워집니다.")
    else
        self:SetFeedback(countLabel .. " 범위를 바꿨습니다 — 안에 든 블록 " .. tostring(#body) .. "개.")
    end
    log("[BlockProgram] control range resized type=" .. tostring(ctrl.type)
        .. " handle=" .. tostring(srcToken.label) .. " body=" .. tostring(#body)
        .. " start=" .. tostring(newStart) .. " end=" .. tostring(newEnd))
end

@ExecSpace("ClientOnly")
method void RefreshDisplay()
    -- T-14 (docs/28 §2): 프로그램을 평탄 토큰 스트립으로 펴서 "칸 하나 = 블록
    -- 하나"로 그린다. 중첩은 괄호 칸(반복/IF ~ ])이 말하고 들여쓰기는 없다.
    self._T.strip = {}
    self:FlattenList(self._T.program)
    local total = #self._T.strip
    if self.programLabelText ~= nil then
        if total == 0 then
            self.programLabelText.Text = "공용 프로그램 (비어 있음 - 블록을 눌러 추가)"
        else
            -- ⚠ 한 줄을 넘기면 2줄로 흘러 셀 첫 행을 덮는다 (2026-08-26 실측 회귀).
            -- 문구를 늘릴 때는 Play 로 줄바꿈부터 확인할 것.
            self.programLabelText.Text = "공용 프로그램 (클릭=삭제 · 끌기=이동/범위)"
        end
    end
    local cellCount = #self._T.cells
    for i = 1, cellCount do
        local cell = self._T.cells[i]
        if i > total then
            cell.Enable = false
            self:SetCellNumber(i, "")
        elseif i == cellCount and total > cellCount then
            -- 초과 접기: 마지막 칸을 +N 으로 표시. 접힌 블록은 클릭 삭제 불가 —
            -- 앞쪽을 지워 펼친 뒤 지운다.
            self._T.strip[i] = { kind = "overflow" }
            self:PaintCell(cell, "+" .. tostring(total - cellCount + 1), "overflow")
            -- 접힘 칸은 단일 블록이 아니라서 순번을 갖지 않는다 (docs/31 §3-5).
            self:SetCellNumber(i, "")
        else
            local token = self._T.strip[i]
            self:PaintCell(cell, token.label, token.tint)
            -- T-16: 순번 = 스트립 인덱스. 맵 마커와 같은 번호를 공유한다 (docs/31 §2.1).
            self:SetCellNumber(i, tostring(i))
        end
    end
    -- T-16 (docs/31 §2.4): 모든 편집 경로가 이 함수로 수렴하므로, 여기 한 줄이
    -- 곧 "편집 즉시 미리보기 재계산" 계약이다.
    _PathPreviewController:RefreshPreview()
end

@ExecSpace("ClientOnly")
method void SetCellNumber(integer cellIndex, string label)
    -- T-16: 셀 순번 오버레이 갱신. Num 자식이 없는 셀은 조용히 건너뛴다.
    local numText = self._T.cellNums[cellIndex]
    if numText ~= nil then numText.Text = label end
end

@ExecSpace("ClientOnly")
method void PaintCell(any cell, string label, string tint)
    -- 셀 하나의 문구·틴트를 칠한다. 문자 + 계열 틴트 병행 (docs/20 §6 —
    -- 색 단독 표기 금지). 배경 파츠는 command-tile-slate-blank 이고 틴트만 바꾼다.
    cell.Enable = true
    local isMove = tint == "move" and (label == "E" or label == "W" or label == "N" or label == "S")
    local text = cell.TextGUIRendererComponent
    if text ~= nil then text.Text = isMove and "" or label end
    local icon = cell:GetChildByName("Icon", false)
    if icon ~= nil then
        icon.Enable = isMove
        if isMove then self:ApplyDirectionIcon(icon, label, true) end
    end
    local sprite = cell.SpriteGUIRendererComponent
    if sprite == nil then return end
    if tint == "work" then
        sprite.Color = Color(0.78, 0.93, 0.78, 1)      -- 채굴·적재·하역 = 녹색 계열
    elseif tint == "ctrl" then
        sprite.Color = Color(0.99, 0.86, 0.64, 1)      -- 반복·IF·끝 = 주황 계열
    elseif tint == "overflow" then
        sprite.Color = Color(0.82, 0.82, 0.82, 1)
    else
        sprite.Color = Color(1, 1, 1, 1)               -- 이동 = 슬레이트 원색
    end
end

@ExecSpace("ClientOnly")
method Entity DirectionIconSource(string direction)
    -- 팔레트 버튼의 Icon 자식이 방향별 단일 기준이다. Maker에서 조정한
    -- RUID/PosX·PosY/LocalPosition/Flip 값을 그대로 프로그램 셀에 복제한다.
    local button = nil
    if direction == "E" then
        button = self.btnMoveE
    elseif direction == "W" then
        button = self.btnMoveW
    elseif direction == "N" then
        button = self.btnMoveN
    elseif direction == "S" then
        button = self.btnMoveS
    end
    if button == nil or button.Entity == nil then return nil end
    return button.Entity:GetChildByName("Icon", false)
end

@ExecSpace("ClientOnly")
method void ApplyDirectionIcon(Entity targetIcon, string direction, boolean alignCell)
    if targetIcon == nil then return end
    local targetTransform = targetIcon.UITransformComponent
    local targetSprite = targetIcon.SpriteGUIRendererComponent
    if targetTransform == nil or targetSprite == nil then return end

    local sourceIcon = self:DirectionIconSource(direction)
    if sourceIcon ~= nil then
        local sourceTransform = sourceIcon.UITransformComponent
        local sourceSprite = sourceIcon.SpriteGUIRendererComponent
        if sourceTransform ~= nil then
            -- 버튼 아이콘과 같은 좌측 기준을 재현한다. anchoredPosition만
            -- 복사하면 셀 Icon의 middle-center anchor가 남아 위치가 어긋나므로,
            -- anchor/Pivot/RectSize까지 함께 복제한다.
            targetTransform.AlignmentOption = sourceTransform.AlignmentOption
            targetTransform.AnchorsMin = sourceTransform.AnchorsMin
            targetTransform.AnchorsMax = sourceTransform.AnchorsMax
            targetTransform.Pivot = sourceTransform.Pivot
            targetTransform.RectSize = sourceTransform.RectSize
            targetTransform.anchoredPosition = sourceTransform.anchoredPosition
            if alignCell and targetIcon.Parent ~= nil and targetIcon.Parent.UITransformComponent ~= nil then
                -- 버튼의 x=21/22는 136px 팔레트 버튼 기준이다. 56px 셀에서는
                -- 아이콘(34px)을 셀 중앙에 놓을 수 있도록 x=11로 환산한다.
                local cellWidth = targetIcon.Parent.UITransformComponent.RectSize.x
                local iconWidth = targetTransform.RectSize.x
                targetTransform.anchoredPosition = Vector2((cellWidth - iconWidth) / 2, targetTransform.anchoredPosition.y)
            end
            targetTransform.ZRotation = sourceTransform.ZRotation
        end
        if sourceSprite ~= nil then
            targetSprite.ImageRUID = sourceSprite.ImageRUID
            targetSprite.LocalPosition = sourceSprite.LocalPosition
            targetSprite.LocalScale = sourceSprite.LocalScale
            targetSprite.PreserveSprite = sourceSprite.PreserveSprite
            targetSprite.FlipX = sourceSprite.FlipX
            targetSprite.FlipY = sourceSprite.FlipY
        end
        return
    end

    -- 예외적으로 팔레트 아이콘을 찾지 못한 경우에만 기존 공통 아이콘을
    -- 안전한 기본값으로 사용한다. 정상 경로에서는 위의 복제 분기가 실행된다.
    targetTransform.anchoredPosition = Vector2(0, 0)
    targetTransform.ZRotation = 0
    targetSprite.ImageRUID = DataRef(self.DirectionIconRuid)
    targetSprite.LocalPosition = Vector2(0, 0)
    targetSprite.LocalScale = Vector2(1, 1)
    targetSprite.FlipX = false
    targetSprite.FlipY = false
end

@ExecSpace("ClientOnly")
method void FlattenList(table list)
    -- 트리를 표시 순서의 토큰으로 편다. 각 토큰은 원본 노드 참조를 들고 있어
    -- 클릭 삭제가 트리를 직접 수술할 수 있다. 아직 닫히지 않은(열림 스택의)
    -- 제어 블록은 ] 토큰을 내지 않는다 — 열려 있음이 화면에서도 보인다.
    for i = 1, #list do
        local command = list[i]
        if command.type == "move" then
            table.insert(self._T.strip, { label = command.dir, tint = "move", node = command, list = list })
        elseif command.type == "mine" then
            table.insert(self._T.strip, { label = "M", tint = "work", node = command, list = list })
        elseif command.type == "load" then
            table.insert(self._T.strip, { label = "L", tint = "work", node = command, list = list })
        elseif command.type == "unload" then
            table.insert(self._T.strip, { label = "U", tint = "work", node = command, list = list })
        elseif command.type == "repeat" then
            local countLabel = tostring(command.count)
            if command.count == "inf" then countLabel = "∞" end
            table.insert(self._T.strip, { label = "×" .. countLabel, tint = "ctrl", node = command, list = list })
            self:FlattenList(command.body)
            if not self:IsOpenControl(command) then
                table.insert(self._T.strip, { label = "]", tint = "ctrl", node = command, list = list })
            end
        elseif command.type == "if" then
            table.insert(self._T.strip, { label = "IF", tint = "ctrl", node = command, list = list })
            self:FlattenList(command.body)
            if not self:IsOpenControl(command) then
                table.insert(self._T.strip, { label = "]", tint = "ctrl", node = command, list = list })
            end
        end
    end
end

@ExecSpace("ClientOnly")
method boolean IsOpenControl(table command)
    -- 열림 스택에 아직 남아 있는(= 끝]을 안 누른) 제어 블록인지.
    for i = 1, #self._T.openControls do
        if self._T.openControls[i] == command then return true end
    end
    return false
end

@ExecSpace("ClientOnly")
method void OnStripCellClicked(integer cellIndex)
    -- T-14 (docs/28 §2.3, 2026-08-21 개정): 칸 클릭 = 그 블록 삭제. 제어 블록은
    -- 시작 칸이든 ] 칸이든 **껍데기만** 지우고 몸통은 제자리에 펼쳐 보존한다 —
    -- 괄호 짝도 안 깨지고, 클릭 한 번에 프로그램 전체가 증발하지 않는다.
    -- T-17: 방금 드래그 이동(또는 이동 시도)이 끝났으면 이 클릭은 삭제가 아니다 —
    -- 버튼 클릭이 드래그 릴리스에 딸려 오는 것을 삼킨다.
    if self._T.dragMoved then
        self._T.dragMoved = false
        return
    end
    local token = self._T.strip[cellIndex]
    if token == nil then return end
    if token.kind == "overflow" then
        self:SetFeedback("접힌 블록은 앞쪽 블록을 지워 펼친 뒤 삭제할 수 있습니다.")
        return
    end
    local removedLabel = token.label
    local removedIndex = 0
    for i = 1, #token.list do
        if token.list[i] == token.node then
            table.remove(token.list, i)
            removedIndex = i
            break
        end
    end
    if removedIndex == 0 then
        -- 스트립과 트리가 어긋났다 — 다시 그리는 것으로 복구한다 (무증상 방지 로그).
        log("[BlockProgram] strip token missing from tree - repaint")
        self:RefreshDisplay()
        return
    end
    if token.node.type == "repeat" or token.node.type == "if" then
        local preserved = 0
        if type(token.node.body) == "table" then
            for b = 1, #token.node.body do
                table.insert(token.list, removedIndex + b - 1, token.node.body[b])
                preserved = preserved + 1
            end
        end
        self:RemoveNodeFromOpenStacks(token.node)
        self:RefreshDisplay()
        if preserved > 0 then
            self:SetFeedback("'" .. removedLabel .. "' 제어 블록만 삭제했습니다. 안의 블록 " .. tostring(preserved) .. "개는 남아 있습니다.")
        else
            self:SetFeedback("'" .. removedLabel .. "' 블록을 삭제했습니다.")
        end
        log("[BlockProgram] strip shell-delete '" .. removedLabel .. "' preserved=" .. tostring(preserved) .. " at cell " .. tostring(cellIndex))
        return
    end
    self:RefreshDisplay()
    self:SetFeedback("'" .. removedLabel .. "' 블록을 삭제했습니다.")
    log("[BlockProgram] strip delete '" .. removedLabel .. "' at cell " .. tostring(cellIndex))
end

@ExecSpace("ClientOnly")
method void RemoveNodeFromOpenStacks(table node)
    -- 삭제한 제어 블록이 열림 스택에 남지 않게 한다. 2026-08-21 개정: 껍데기만
    -- 삭제(몸통 보존)로 바뀌어 **그 노드 하나만** 스택에서 뺀다 — 몸통 안의
    -- 제어 블록들은 트리에 살아 있으므로 열림 상태도 그대로 유지해야 한다.
    -- openControls[k].body == openBodies[k+1] 쌍을 유지하며 함께 제거한다.
    for i = #self._T.openControls, 1, -1 do
        if self._T.openControls[i] == node then
            table.remove(self._T.openControls, i)
            table.remove(self._T.openBodies, i + 1)
            break
        end
    end
    self:RefreshRepeatControlFromOpenStack()
end

@ExecSpace("ClientOnly")
method string RenderList(table list, integer depth)
    -- ⚠️ 편집기 표시는 T-14 로 스트립 그리드가 대체했지만, **라이브러리 상세
    -- 미리보기(ProgramLibraryController.RefreshDetail)가 이 텍스트 렌더를 쓴다.**
    -- 지우면 라이브러리 상세가 nil 호출로 죽는다 — T-14 첫 빌드 로그가 실제로
    -- 잡았던 결함이다. 편집기 쪽에서는 더 이상 부르지 않는다.
    local rendered = ""
    local indent = string.rep("  ", depth)
    for i = 1, #list do
        local command = list[i]
        if command.type == "move" then
            rendered = rendered .. indent .. command.dir .. "\n"
        elseif command.type == "mine" then
            rendered = rendered .. indent .. "M\n"
        elseif command.type == "load" then
            rendered = rendered .. indent .. "L\n"
        elseif command.type == "unload" then
            rendered = rendered .. indent .. "U\n"
        elseif command.type == "repeat" then
            local countLabel = tostring(command.count)
            if command.count == "inf" then countLabel = "∞" end
            rendered = rendered .. indent .. "R×" .. countLabel .. " [\n"
            rendered = rendered .. self:RenderList(command.body, depth + 1)
            rendered = rendered .. indent .. "]\n"
        elseif command.type == "if" then
            local conditionLabel = self:ConditionLabel(command.cond)
            rendered = rendered .. indent .. "IF " .. conditionLabel .. " [\n"
            rendered = rendered .. self:RenderList(command.body, depth + 1)
            rendered = rendered .. indent .. "]\n"
        end
    end
    return rendered
end

@ExecSpace("ClientOnly")
method void OnRunClicked()
    -- Closes open blocks and sends the reviewed program to the server worker.
    if #self._T.program == 0 then
        log("[BlockProgram] Run pressed but program is empty - ignored")
        self:SetFeedback("실행할 블록이 없습니다.")
        return
    end

    if #self._T.openBodies > 1 then
        self:CloseAllOpenBlocks()
        self:SetFeedback("열린 제어 블록을 모두 닫고 실행했습니다.")
    else
        self:SetFeedback("프로그램을 일꾼에게 전송했습니다.")
    end
    -- T-07 (F7-E §3 보강): 튜토리얼 5·6단계는 제어 블록에 body 가 있는지 Run 직전
    -- 선검증한다. 비활성 상태면 빈 문자열을 돌려 아무 영향이 없다.
    local tutorialVeto = _TutorialController:PreRunCheck(self._T.program)
    if tutorialVeto ~= "" then
        self:SetFeedback(tutorialVeto)
        log("[BlockProgram] tutorial pre-run veto: " .. tutorialVeto)
        return
    end
    if not self:ValidateClientProgram(self._T.program) then
        self:SetFeedback("실행할 수 없는 프로그램입니다: " .. tostring(self._T.clientValidationError))
        log("[BlockProgram] client validation rejected: " .. tostring(self._T.clientValidationError))
        return
    end
    local worker = self:GetSelectedWorker()
    if worker == nil then
        self:SetFeedback("선택한 일꾼을 찾을 수 없습니다.")
        return
    end
    log("[BlockProgram] Run pressed - sending nested program to worker " .. tostring(self.SelectedWorkerIndex))
    worker:RunProgram(self._T.program)
end

@ExecSpace("ClientOnly")
method void OnStopClicked()
    -- Requests an immediate server-side interpreter stop.
    local worker = self:GetSelectedWorker()
    if worker == nil then
        self:SetFeedback("선택한 일꾼을 찾을 수 없습니다.")
        return
    end
    worker:StopProgram()
    self:SetFeedback("일꾼 " .. tostring(self.SelectedWorkerIndex) .. "에게 정지 요청을 보냈습니다.")
end

@ExecSpace("ClientOnly")
method void OnToggleClicked()
    -- Collapses / expands the editor panel so the world is not permanently
    -- covered (C201). Enable is the standard show/hide flag; the running
    -- program is server-side and unaffected by this client-side toggle.
    if self.programPanel == nil then return end
    self.programPanel.Enable = not self.programPanel.Enable
    self:RefreshToggleLabel()
    log("[BlockProgram] panel collapsed=" .. tostring(not self.programPanel.Enable))
end

@ExecSpace("ClientOnly")
method void RefreshToggleLabel()
    -- Keeps the toggle caption in sync with the panel's current state.
    if self.toggleButtonText == nil then return end
    local expanded = true
    if self.programPanel ~= nil then expanded = self.programPanel.Enable end
    if expanded then self.toggleButtonText.Text = "패널 접기"
    else self.toggleButtonText.Text = "패널 펼치기" end
end

@ExecSpace("ClientOnly")
method WorkerController GetSelectedWorker()
    -- Resolves the active mine worker after each map transition instead of
    -- retaining a farm01 UUID that becomes invalid on another mine map.
    local player = _UserService.LocalPlayer
    if player == nil or player.CurrentMap == nil then return nil end
    local suffix = tostring(self.SelectedWorkerIndex)
    if self.SelectedWorkerIndex < 10 then suffix = "0" .. suffix end
    local workerEntity = player.CurrentMap:GetChildByName("Worker" .. suffix, false)
    if workerEntity == nil then return nil end
    ---@type WorkerController
    local worker = workerEntity:GetComponent("script.WorkerController")
    return worker
end

@ExecSpace("ClientOnly")
method integer GetSelectedWorkerIndex()
    -- Returns the editor's selected worker slot for HUD synchronization.
    return self.SelectedWorkerIndex
end

@ExecSpace("ClientOnly")
method table GetProgram()
    -- T-05: 라이브러리 저장이 읽는 현재 편집기 프로그램 (F7-C §1).
    return self._T.program
end

@ExecSpace("ClientOnly")
method table GetStrip()
    -- T-16 2차: 미리보기 순번 부여용 평탄 토큰 (FlattenList 산출물 그대로).
    -- 토큰이 원본 노드 참조를 들고 있어 시뮬레이터가 노드→칸 번호 역인덱스를 만든다.
    if self._T.strip == nil then return {} end
    return self._T.strip
end

@ExecSpace("ClientOnly")
method table GetSanitizedProgram()
    -- 직렬화용 사본 — 빈 body 제어 블록을 걷어낸다. MSW `JSONEncode` 는 빈
    -- Lua 테이블을 `LEA-3001 UnknownType` 으로 거부하므로 (2026-08-18 실측),
    -- 라이브러리 저장 등 JSON 으로 나가는 경로는 이 사본을 쓴다.
    return self:SanitizeListForJson(self._T.program)
end

@ExecSpace("ClientOnly")
method table SanitizeListForJson(table list)
    -- GetSanitizedProgram 의 재귀 본체. 빈 반복/IF 는 실행 의미가 없어 제거해도
    -- 동작이 같다 (서버 WorkerController.SanitizeProgramForJson 과 같은 규칙).
    local sanitized = {}
    for i = 1, #list do
        local command = list[i]
        if type(command) == "table" then
            if command.type == "repeat" or command.type == "if" then
                local body = {}
                if type(command.body) == "table" then body = self:SanitizeListForJson(command.body) end
                if #body > 0 then
                    local copy = { type = command.type, body = body }
                    if command.type == "repeat" then copy.count = command.count
                    else copy.cond = command.cond end
                    table.insert(sanitized, copy)
                end
            else
                table.insert(sanitized, command)
            end
        end
    end
    return sanitized
end

@ExecSpace("ClientOnly")
method void LoadProgramFromLibrary(table program)
    -- T-05: 라이브러리 → 편집기. 호출자가 사본을 넘긴다 (원본 공유 금지, F7-C §4).
    if type(program) ~= "table" then return end
    self._T.program = program
    self._T.openBodies = { self._T.program }
    self._T.openControls = {}
    self._T.repeatPreset = 2
    self:RefreshRepeatButton(2)
    self:RefreshDisplay()
    self:SetFeedback("라이브러리에서 프로그램을 불러왔습니다. 실행 전 내용을 확인하세요.")
    log("[BlockProgram] program loaded from library blocks=" .. tostring(self:CountBlocks(self._T.program)))
end

@ExecSpace("ClientOnly")
method void RequestEditorRestore()
    -- 2026-08-25: 재접속 편집기 복원 요청. 이미 복원했거나 사용자가 편집을
    -- 시작했으면 건너뛴다 — 버퍼를 덮지 않는다.
    if self._T.editorRestoreDone then return end
    if self:CountBlocks(self._T.program) > 0 then return end
    local player = _UserService.LocalPlayer
    if player == nil then return end
    ---@type AccountProfileService
    local profile = player:GetComponent("script.AccountProfileService")
    if profile == nil then return end
    profile:RequestSavedProgram(self:GetSelectedWorkerIndex())
end

@ExecSpace("Client")
method void DeliverSavedProgram(integer workerIndex, string programJson)
    -- AccountProfileService.RequestSavedProgram 의 응답. 빈 버퍼일 때만 싣는다.
    if self._T.editorRestoreDone then return end
    if self:CountBlocks(self._T.program) > 0 then return end
    local ok, parsed = pcall(function() return _HttpService:JSONDecode(programJson) end)
    if not ok or type(parsed) ~= "table" or #parsed == 0 then return end
    self:LoadProgramFromLibrary(parsed)
    self:SetFeedback("마지막 실행 프로그램을 불러왔습니다. [실행]으로 이어서 시작하세요.")
    self._T.editorRestoreDone = true
    log("[BlockProgram] editor restored from last valid program worker=" .. tostring(workerIndex))
end

@ExecSpace("ClientOnly")
method void OnWorker1Clicked()
    -- Selects the first worker as the Run and Stop target.
    self:SelectWorker(1)
end

@ExecSpace("ClientOnly")
method void OnWorker2Clicked()
    self:SelectWorker(2)
end

@ExecSpace("ClientOnly")
method void OnWorker3Clicked()
    self:SelectWorker(3)
end

@ExecSpace("ClientOnly")
method void OnWorker4Clicked()
    self:SelectWorker(4)
end

@ExecSpace("ClientOnly")
method void OnWorker5Clicked()
    self:SelectWorker(5)
end

@ExecSpace("ClientOnly")
method void SelectWorker(integer workerIndex)
    if workerIndex < 1 or workerIndex > 5 then return end
    local player = _UserService.LocalPlayer
    if player == nil then return end
    local profile = player:GetComponent("script.AccountProfileService")
    if profile == nil or workerIndex > profile.OwnedWorkerCount then
        self:SetFeedback("아직 고용하지 않은 일꾼입니다.")
        return
    end
    self.SelectedWorkerIndex = workerIndex
    self._T.lastWorkerState = ""
    self:RefreshWorkerButtons()
    self:SetFeedback("일꾼 " .. tostring(workerIndex) .. "을(를) 선택했습니다.")
    log("[BlockProgram] selected worker=" .. tostring(workerIndex))
end

@ExecSpace("ClientOnly")
method integer GetOwnedWorkerCount()
    -- 보유 일꾼 수의 단일 조회 지점. 칩 갱신과 변화 감지가 같은 값을 본다.
    local player = _UserService.LocalPlayer
    if player == nil then return 1 end
    local profile = player:GetComponent("script.AccountProfileService")
    if profile == nil then return 1 end
    return profile.OwnedWorkerCount
end

@ExecSpace("ClientOnly")
method string GetWorkerChipState(integer workerIndex, integer owned)
    -- 칩 상태 결정의 단일 기준. 라벨·스프라이트·로그가 모두 이 값을 쓴다.
    -- 셋이 각자 판단하면 문구와 그림이 어긋나는 것을 아무도 못 잡는다.
    if workerIndex > owned then return "disabled" end
    if self.SelectedWorkerIndex == workerIndex then return "selected" end
    return "normal"
end

@ExecSpace("ClientOnly")
method void RefreshWorkerButtons()
    -- 워커 칩 5개의 라벨과 배경 스프라이트를 현재 보유 수·선택 인덱스에 맞춘다.
    local owned = self:GetOwnedWorkerCount()
    self:SetWorkerButtonState(self.worker1ButtonText, self.worker1ChipSprite, 1, owned)
    self:SetWorkerButtonState(self.worker2ButtonText, self.worker2ChipSprite, 2, owned)
    self:SetWorkerButtonState(self.worker3ButtonText, self.worker3ChipSprite, 3, owned)
    self:SetWorkerButtonState(self.worker4ButtonText, self.worker4ChipSprite, 4, owned)
    self:SetWorkerButtonState(self.worker5ButtonText, self.worker5ChipSprite, 5, owned)
    log("[BlockProgram] chips owned=" .. tostring(owned)
        .. " 1=" .. self:GetWorkerChipState(1, owned)
        .. " 2=" .. self:GetWorkerChipState(2, owned)
        .. " 3=" .. self:GetWorkerChipState(3, owned)
        .. " 4=" .. self:GetWorkerChipState(4, owned)
        .. " 5=" .. self:GetWorkerChipState(5, owned))
end

@ExecSpace("ClientOnly")
method void SetWorkerButtonState(TextComponent label, SpriteGUIRendererComponent chip, integer workerIndex, integer owned)
    -- 칩은 64x52 뿐이라 "일꾼 N (미보유)" 는 들어가지 않는다. 번호 + 짧은 표식만
    -- 쓰고, 선택 결과는 피드백 줄이 문장으로 알려 준다. 배경 스프라이트는 그
    -- 문구를 대체하지 않고 함께 바뀐다 (docs/20 §6).
    local state = self:GetWorkerChipState(workerIndex, owned)
    if label ~= nil then
        -- 상태 구분은 배경 스프라이트(선택/일반/회색)가 전담한다 — "[N]"·"N X"
        -- 텍스트 표식은 중복이라 제거했다 (2026-08-20 오너 결정).
        label.Text = tostring(workerIndex)
    end
    if chip == nil then return end
    if state == "disabled" then
        chip.ImageRUID = DataRef(self.TabSpriteDisabled)
    elseif state == "selected" then
        chip.ImageRUID = DataRef(self.TabSpriteSelected)
    else
        chip.ImageRUID = DataRef(self.TabSpriteNormal)
    end
end

@ExecSpace("ClientOnly")
method table GetTutorialButtons()
    -- T-07 (F7-E §5.1): 튜토리얼 잠금 대상 — 이 컨트롤러가 소유한 버튼 전부를
    -- 키로 돌려준다. 잠금·dim 은 TutorialController 가 수행한다.
    return {
        moveE = self.btnMoveE,
        moveW = self.btnMoveW,
        moveN = self.btnMoveN,
        moveS = self.btnMoveS,
        mine = self.btnMine,
        load = self.btnLoad,
        unload = self.btnUnload,
        repeatAdd = self.btnRepeat,
        repeatCount = self.btnRepeatCount,
        ifAdd = self.btnIfOre,
        condition = self.btnCondition,
        endBlock = self.btnEnd,
        run = self.btnRun,
        stop = self.btnStop,
        clear = self.btnClear,
        worker1 = self.btnWorker1,
        worker2 = self.btnWorker2,
        worker3 = self.btnWorker3,
        worker4 = self.btnWorker4,
        worker5 = self.btnWorker5,
        toggle = self.btnToggle,
    }
end

@ExecSpace("ClientOnly")
method void ClearProgramForTutorial()
    -- T-07 (F7-E §4): 단계 진입 시 편집기 프로그램을 비운다 (OnClearClicked 상당,
    -- 피드백 문구는 튜토리얼 안내가 대신하므로 내지 않는다).
    self:ResetEditor()
    self:RefreshDisplay()
end

@ExecSpace("ClientOnly")
method void CollapsePanelForTutorial()
    -- T-15b: 판매·고용 단계(7·8)는 편집기가 필요 없다 — 접어서 넓어진 판매·선택
    -- 패널과의 겹침을 없앤다. 펼침 원복은 편집기 단계 재진입·튜토리얼 종료가 한다.
    if self.programPanel == nil then return end
    if self.programPanel.Enable then
        self.programPanel.Enable = false
        self:RefreshToggleLabel()
    end
end

@ExecSpace("ClientOnly")
method void ForceExpandPanelForTutorial()
    -- T-07 (F7-E §5.1): 튜토리얼 중 패널을 펼친 상태로 고정한다. 접힌 상태에서
    -- 안내만 남으면 진행이 불가능하다.
    if self.programPanel == nil then return end
    if not self.programPanel.Enable then
        self.programPanel.Enable = true
        self:RefreshToggleLabel()
    end
end

@ExecSpace("ClientOnly")
method void OnClearClicked()
    -- Clears every assembled block and resets nested editor state.
    self:ResetEditor()
    self:RefreshDisplay()
    self:SetFeedback("프로그램을 초기화했습니다.")
    log("[BlockProgram] program cleared")
end

@ExecSpace("ClientOnly")
method void OnRepeatClicked()
    -- Always opens a new repeat so repeat-in-repeat remains authorable.
    local count = self._T.repeatPreset
    if #self._T.openBodies > 1 and count == "inf" then count = 2 end
    local command = { type = "repeat", count = count, body = {} }
    local beforeCount = self:CountBlocks(self._T.program)
    self:AddCommand(command, "R×" .. tostring(count))
    if self:CountBlocks(self._T.program) == beforeCount then return end
    table.insert(self._T.openControls, command)
    table.insert(self._T.openBodies, command.body)
    self:RefreshDisplay()
    self:SetFeedback("반복 블록을 열었습니다. 횟수 버튼으로 값을 바꿀 수 있습니다.")
end

@ExecSpace("ClientOnly")
method void OnRepeatCountClicked()
    -- Cycles the nearest open repeat without consuming the repeat-add action.
    local topControl = self._T.openControls[#self._T.openControls]
    local current = self._T.repeatPreset
    if topControl ~= nil and topControl.type == "repeat" then current = topControl.count end
    local nextCount = self:NextRepeatCount(current)
    if topControl ~= nil and topControl.type == "repeat" and #self._T.openBodies > 2 and nextCount == "inf" then
        nextCount = 2
    end
    self._T.repeatPreset = nextCount
    if topControl ~= nil and topControl.type == "repeat" then
        topControl.count = nextCount
        self:RefreshDisplay()
    end
    self:RefreshRepeatButton(nextCount)
    self:SetFeedback("반복 횟수를 변경했습니다.")
    log("[BlockProgram] repeat count=" .. tostring(nextCount))
end

@ExecSpace("ClientOnly")
method void OnIfOreClicked()
    -- Opens an IF body using the currently selected D3 condition.
    local command = { type = "if", cond = self._T.conditionPreset, body = {} }
    local beforeCount = self:CountBlocks(self._T.program)
    self:AddCommand(command, "IF " .. self:ConditionLabel(command.cond))
    if self:CountBlocks(self._T.program) == beforeCount then return end
    table.insert(self._T.openControls, command)
    table.insert(self._T.openBodies, command.body)
    self:RefreshDisplay()
    self:SetFeedback("IF " .. self:ConditionLabel(command.cond) .. " 블록을 열었습니다.")
end

@ExecSpace("ClientOnly")
method void OnConditionClicked()
    -- Cycles the condition used by the next IF block.
    local current = self._T.conditionPreset
    if current == "ore_present" then current = "ore_absent"
    elseif current == "ore_absent" then current = "cart_full"
    elseif current == "cart_full" then current = "cart_empty"
    else current = "ore_present" end
    self._T.conditionPreset = current
    self:RefreshConditionButton()
    self:SetFeedback("IF 조건을 " .. self:ConditionLabel(current) .. "으로 변경했습니다.")
end

@ExecSpace("ClientOnly")
method void OnEndBlockClicked()
    -- Closes the most recently opened repeat or IF block.
    if #self._T.openBodies <= 1 then
        self:SetFeedback("닫을 제어 블록이 없습니다.")
        return
    end
    table.remove(self._T.openBodies)
    table.remove(self._T.openControls)
    self:RefreshRepeatControlFromOpenStack()
    self:RefreshDisplay()
    self:SetFeedback("가장 최근 제어 블록을 닫았습니다.")
end

@ExecSpace("ClientOnly")
method void CloseAllOpenBlocks()
    -- Closes all unfinished control blocks before execution.
    while #self._T.openBodies > 1 do
        table.remove(self._T.openBodies)
        table.remove(self._T.openControls)
    end
    self._T.repeatPreset = 2
    self:RefreshRepeatButton(2)
    self:RefreshDisplay()
end

@ExecSpace("ClientOnly")
method void ResetEditor()
    -- Reinitializes the root program and editor stacks.
    self._T.program = {}
    self._T.openBodies = { self._T.program }
    self._T.openControls = {}
    self._T.repeatPreset = 2
    self._T.conditionPreset = "ore_present"
    self:RefreshRepeatButton(2)
    self:RefreshConditionButton()
end

@ExecSpace("ClientOnly")
method any NextRepeatCount(any current)
    -- Returns the next repeat preset in the 2, 3, 5, 10, infinity cycle.
    if current == 2 then return 3 end
    if current == 3 then return 5 end
    if current == 5 then return 10 end
    if current == 10 then return "inf" end
    return 2
end

@ExecSpace("ClientOnly")
method void RefreshRepeatButton(any count)
    -- Updates the repeat palette label to show the active preset.
    if self.repeatCountButtonText == nil then return end
    local label = tostring(count)
    if count == "inf" then label = "∞" end
    self.repeatCountButtonText.Text = "횟수 ×" .. label
end

@ExecSpace("ClientOnly")
method void RefreshRepeatControlFromOpenStack()
    -- Restores the repeat label from the nearest open repeat block.
    local topControl = self._T.openControls[#self._T.openControls]
    if topControl ~= nil and topControl.type == "repeat" then
        self._T.repeatPreset = topControl.count
        self:RefreshRepeatButton(topControl.count)
    else
        self._T.repeatPreset = 2
        self:RefreshRepeatButton(2)
    end
end

@ExecSpace("ClientOnly")
method string ConditionLabel(string condition)
    -- Converts a serialized condition key into its Korean UI label.
    if condition == "ore_absent" then return "광물 없음" end
    if condition == "cart_full" then return "수레 가득" end
    if condition == "cart_empty" then return "수레 비어 있음" end
    return "광물 있음"
end

@ExecSpace("ClientOnly")
method void RefreshConditionButton()
    -- Mirrors the active condition preset into the condition button label.
    if self.conditionButtonText == nil then return end
    self.conditionButtonText.Text = "조건: " .. self:ConditionLabel(self._T.conditionPreset)
end

@ExecSpace("ClientOnly")
method boolean ValidateClientProgram(table program)
    -- Mirrors the server limits so invalid programs fail before an RPC.
    self._T.clientValidationError = ""
    self._T.clientValidationBlockCount = 0
    self._T.clientValidationInfiniteCount = 0
    return self:ValidateClientList(program, 0)
end

@ExecSpace("ClientOnly")
method boolean ValidateClientList(table list, integer depth)
    -- Recursively mirrors the authoritative server program validation rules.
    if type(list) ~= "table" then
        self._T.clientValidationError = "body must be a table"
        return false
    end
    if depth > self.MaxProgramDepth then
        self._T.clientValidationError = "depth limit exceeded"
        return false
    end
    for i = 1, #list do
        local command = list[i]
        if type(command) ~= "table" then
            self._T.clientValidationError = "invalid block"
            return false
        end
        self._T.clientValidationBlockCount = self._T.clientValidationBlockCount + 1
        if self._T.clientValidationBlockCount > self.MaxProgramBlocks then
            self._T.clientValidationError = "block limit exceeded"
            return false
        end
        if command.type == "move" then
            if command.dir ~= "E" and command.dir ~= "W" and command.dir ~= "N" and command.dir ~= "S" then
                self._T.clientValidationError = "invalid direction"
                return false
            end
        elseif command.type == "mine" or command.type == "load" or command.type == "unload" then
        elseif command.type == "repeat" then
            if command.count == "inf" then
                if depth ~= 0 then
                    self._T.clientValidationError = "infinite repeat must be top-level"
                    return false
                end
                self._T.clientValidationInfiniteCount = self._T.clientValidationInfiniteCount + 1
                if self._T.clientValidationInfiniteCount > 1 then
                    self._T.clientValidationError = "only one infinite repeat is allowed"
                    return false
                end
            elseif type(command.count) ~= "number" or command.count < 2 or command.count > 99 or math.floor(command.count) ~= command.count then
                self._T.clientValidationError = "invalid repeat count"
                return false
            end
            if not self:ValidateClientList(command.body, depth + 1) then return false end
        elseif command.type == "if" then
            if command.cond ~= "ore_present" and command.cond ~= "ore_absent" and command.cond ~= "cart_full" and command.cond ~= "cart_empty" then
                self._T.clientValidationError = "invalid condition"
                return false
            end
            if not self:ValidateClientList(command.body, depth + 1) then return false end
        else
            self._T.clientValidationError = "unknown block type"
            return false
        end
    end
    return true
end

@ExecSpace("ClientOnly")
method void SetFeedback(string message)
    -- Displays parser or editor feedback without starting execution.
    self.feedbackText.Text = message
end

@ExecSpace("ClientOnly")
method integer CountBlocks(table list)
    -- Counts action and control blocks recursively for parser feedback.
    local count = 0
    for i = 1, #list do
        local command = list[i]
        count = count + 1
        if command.type == "repeat" or command.type == "if" then
            count = count + self:CountBlocks(command.body)
        end
    end
    return count
end

@ExecSpace("ClientOnly")
method void OnUpdate(number delta)
    -- Mirrors the synchronized worker run state into the Run button label.
    -- 보유 일꾼 수 변화를 먼저 본다. 구매 경로(MineSelectController)는 편집기를
    -- 직접 부르지 않으므로, 이 감지가 없으면 방금 산 일꾼의 칩이 잠금 스프라이트로
    -- 남는다. 아래 state 조기 return 보다 앞에 있어야 한다.
    local ownedNow = self:GetOwnedWorkerCount()
    if ownedNow ~= self._T.lastOwnedCount then
        self._T.lastOwnedCount = ownedNow
        self:RefreshWorkerButtons()
    end
    local worker = self:GetSelectedWorker()
    if worker == nil then return end
    local state = worker.ProgramState
    if state == self._T.lastWorkerState then return end
    self._T.lastWorkerState = state
    if self.runButtonText ~= nil then
        if state == "Running" then
            self.runButtonText.Text = "재실행"
        else
            self.runButtonText.Text = "실행"
        end
    end
    log("[BlockProgram] worker=" .. tostring(self.SelectedWorkerIndex) .. " state=" .. tostring(state))
end

@ExecSpace("ClientOnly")
method void OnEndPlay()
    -- Disconnects every UI event handler registered during begin play.
    if self._T.editorRestoreTimers ~= nil then
        for _, timerId in ipairs(self._T.editorRestoreTimers) do
            if timerId ~= nil and timerId ~= 0 then _TimerService:ClearTimer(timerId) end
        end
        self._T.editorRestoreTimers = nil
    end
    if self._T.cells ~= nil and self._T.cellHandlers ~= nil then
        for i = 1, #self._T.cells do
            if self._T.cellHandlers[i] ~= nil then
                self._T.cells[i]:DisconnectEvent(ButtonClickEvent, self._T.cellHandlers[i])
            end
            -- T-17 드래그 핸들러 3종 해제.
            if self._T.cellDownHandlers ~= nil and self._T.cellDownHandlers[i] ~= nil then
                self._T.cells[i]:DisconnectEvent(UITouchDownEvent, self._T.cellDownHandlers[i])
            end
            if self._T.cellDragHandlers ~= nil and self._T.cellDragHandlers[i] ~= nil then
                self._T.cells[i]:DisconnectEvent(UITouchDragEvent, self._T.cellDragHandlers[i])
            end
            if self._T.cellUpHandlers ~= nil and self._T.cellUpHandlers[i] ~= nil then
                self._T.cells[i]:DisconnectEvent(UITouchUpEvent, self._T.cellUpHandlers[i])
            end
        end
    end
    self.btnMoveE.Entity:DisconnectEvent(ButtonClickEvent, self._T.handlers.moveE)
    self.btnMoveW.Entity:DisconnectEvent(ButtonClickEvent, self._T.handlers.moveW)
    self.btnMoveN.Entity:DisconnectEvent(ButtonClickEvent, self._T.handlers.moveN)
    self.btnMoveS.Entity:DisconnectEvent(ButtonClickEvent, self._T.handlers.moveS)
    self.btnMine.Entity:DisconnectEvent(ButtonClickEvent, self._T.handlers.mine)
    self.btnLoad.Entity:DisconnectEvent(ButtonClickEvent, self._T.handlers.load)
    self.btnUnload.Entity:DisconnectEvent(ButtonClickEvent, self._T.handlers.unload)
    self.btnRepeat.Entity:DisconnectEvent(ButtonClickEvent, self._T.handlers.repeatBlock)
    self.btnRepeatCount.Entity:DisconnectEvent(ButtonClickEvent, self._T.handlers.repeatCount)
    self.btnIfOre.Entity:DisconnectEvent(ButtonClickEvent, self._T.handlers.ifOre)
    self.btnCondition.Entity:DisconnectEvent(ButtonClickEvent, self._T.handlers.condition)
    self.btnEnd.Entity:DisconnectEvent(ButtonClickEvent, self._T.handlers.endBlock)
    self.btnRun.Entity:DisconnectEvent(ButtonClickEvent, self._T.handlers.run)
    self.btnStop.Entity:DisconnectEvent(ButtonClickEvent, self._T.handlers.stop)
    self.btnClear.Entity:DisconnectEvent(ButtonClickEvent, self._T.handlers.clear)
    if self.btnWorker1 ~= nil and self._T.handlers.worker1 ~= nil then
        self.btnWorker1.Entity:DisconnectEvent(ButtonClickEvent, self._T.handlers.worker1)
    end
    if self.btnWorker2 ~= nil and self._T.handlers.worker2 ~= nil then self.btnWorker2.Entity:DisconnectEvent(ButtonClickEvent, self._T.handlers.worker2) end
    if self.btnWorker3 ~= nil and self._T.handlers.worker3 ~= nil then self.btnWorker3.Entity:DisconnectEvent(ButtonClickEvent, self._T.handlers.worker3) end
    if self.btnWorker4 ~= nil and self._T.handlers.worker4 ~= nil then self.btnWorker4.Entity:DisconnectEvent(ButtonClickEvent, self._T.handlers.worker4) end
    if self.btnWorker5 ~= nil and self._T.handlers.worker5 ~= nil then self.btnWorker5.Entity:DisconnectEvent(ButtonClickEvent, self._T.handlers.worker5) end
    if self.btnToggle ~= nil and self._T.handlers.toggle ~= nil then self.btnToggle.Entity:DisconnectEvent(ButtonClickEvent, self._T.handlers.toggle) end
end

end
