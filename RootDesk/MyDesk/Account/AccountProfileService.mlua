@ExecSpace("Server")
method void RequestTutorialWorkersResume()
    -- 2026-08-26 (오너 보고): 튜토리얼이 **어떤 경로로 끝나든** 디스폰해 둔 일꾼
    -- 2~5를 되살린다. 클라이언트의 Deactivate 한 곳에서만 부른다 — 종료 경로가
    -- 완주·스킵·다시 보기 닫기·비정상(step=0) 넷인데 그중 서버까지 오는 것은
    -- 완주와 (1회차) 스킵뿐이라, 다시 보기를 닫으면 일꾼이 영영 사라져 있었다.
    -- 멱등이라 완주 경로에서 이미 복귀한 뒤 다시 불려도 안전하다.
    if senderUserId ~= self.Entity.PlayerComponent.UserId then return end
    if not self.IsLoaded or self._T.profile == nil then return end
    self:ResumeExtraWorkersAfterTutorial()
end

@ExecSpace("Server")
method boolean RequestTutorialFundsCheck()
    -- T-07: 8단계 골드 보정 (2026-08-18 오너 결정). 클라이언트가 8단계 진입 시
    -- 부른다 — 판정·지급은 전부 서버(TutorialService) 몫이다.
    return _TutorialService:EnsureWorkerPurchaseFunds(self.Entity)
end

@ExecSpace("Server")
method boolean RequestTutorialWorkerReset(integer cellX, integer cellY, string hand, integer handCount, integer cartStone)
    -- T-07: 실패 되돌리기 — 일꾼 1을 단계 시작 상태로 (F7-E §5.2).
    return _TutorialService:RequestWorkerReset(self.Entity, cellX, cellY, hand, handCount, cartStone)
end

@ExecSpace("Server")
method boolean RequestMineUpgrade()
    -- Routes the local player's mine-upgrade request to the progression authority.
    return _ProgressionService:RequestMineUpgrade(self.Entity)
end

@ExecSpace("Server")
method boolean RequestFieldUpgrade()
    -- D10 §6.1: 필드 확장(1~5) 요청을 진행 권한(ProgressionService)으로 라우팅한다.
    -- 맵 강화(RequestMineUpgrade)와 나란한, 별도 시스템의 진입점이다.
    return _ProgressionService:RequestFieldUpgrade(self.Entity)
end

