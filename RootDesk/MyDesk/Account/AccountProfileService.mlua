end

@ExecSpace("Server")
method boolean RequestRareSaleSetting(string oreType, boolean autoSell)
    local updated = self:UpdateRareAutoSell(oreType, autoSell)
    if updated and autoSell then _EconomyService:TryAutomaticRareSale(self, oreType) end
    return updated
end

