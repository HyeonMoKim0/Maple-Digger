@Component
script AccountProfileService extends Component

property string StorageKey = "maple-digger.account.v1"
property string BackupStorageKey = "maple-digger.account.backup.v1"
property string RecoveryArchiveStorageKey = "maple-digger.account.recovery-archive.v1"
property string SessionLockStorageKey = "maple-digger.account.session-lock.v1"
property integer SchemaVersion = 8
property integer AutoSaveSeconds = 300
property integer SessionLockLeaseSeconds = 90
property integer SessionLockRefreshSeconds = 30
property boolean IsLoaded = false
property boolean IsDirty = false
property integer SaveGeneration = 0

@Sync
property integer Gold = 0

@Sync
property integer Crystal = 0

-- F7-B §5.6.5: 광산 선택 화면의 `Lv.n / 10` 표시용 맵별 현재 레벨.
@Sync
property integer MineLevelBeginner = 0

@Sync
property integer MineLevelDeep = 0

@Sync
property integer MineLevelGem = 0

-- F7-B §5.6.5: 현재 입장 광산의 강화 표기 계약 전체(현재/다음 보너스·절대값·비용).
-- 클라이언트는 재계산하지 않고 이 서버 계산 결과를 그대로 그린다 (§5.6.3).
@Sync
property string MineUpgradeInfoJson = ""

-- T-05 (F7-C): 프로그램 라이브러리 전체를 표시용으로 하향. 클라이언트는 읽기 전용.
@Sync
property string ProgramLibraryJson = ""

-- T-05: 슬롯 구매 기본 비용 (4번째 슬롯). 이후 직전 비용의 1.2배 (C174).
-- ⚠ 기본값 50골드는 첫 Play 테스트 제안값이다 — 오너 확정 대상.
property integer LibrarySlotBaseCost = 50

-- T-07 (F7-E): 튜토리얼 진행 표시용 미러. 판정·보상·저장은 TutorialService 가
-- 소유하며, 클라이언트(TutorialController)는 이 세 값만 읽는다.
@Sync
property integer TutorialStep = 0

@Sync
property boolean TutorialCompleted = false

@Sync
property boolean TutorialSkipped = false

@Sync
property integer MineTokens = 0

@Sync
property integer Stone = 0

@Sync
property integer Iron = 0

@Sync
property integer GoldOre = 0

@Sync
property integer RareStoneCollectionLevel = 0

@Sync
property integer RareIronCollectionLevel = 0

@Sync
property integer RareGoldCollectionLevel = 0

@Sync
property integer RareStoneStored = 0

@Sync
property integer RareIronStored = 0

@Sync
property integer RareGoldStored = 0

@Sync
property boolean RareStoneAutoSell = false

@Sync
property boolean RareIronAutoSell = false

@Sync
property boolean RareGoldAutoSell = false

@Sync
property boolean StoneAutoSell = false

@Sync
property boolean IronAutoSell = false

@Sync
property boolean GoldOreAutoSell = false

@Sync
property integer StoneProtectedAmount = 0

@Sync
property integer IronProtectedAmount = 0

@Sync
property integer GoldOreProtectedAmount = 0

-- Read-only mirrors of max(설정 보호, 해금 필요 보호). Runtime-only; not persisted.
@Sync
property integer StoneEffectiveProtection = 0

@Sync
property integer IronEffectiveProtection = 0

@Sync
property integer GoldOreEffectiveProtection = 0

@Sync
property boolean DeepMineUnlocked = false

@Sync
property boolean GemMineUnlocked = false

@Sync
property string LastTransactionMessage = ""

@Sync
property string LastMineId = "farm01"

@Sync
property integer OwnedWorkerCount = 1

@Sync
property integer Worker1CartCapacity = 20

@Sync
property integer Worker2CartCapacity = 20

@Sync
property integer Worker3CartCapacity = 20

@Sync
property integer Worker4CartCapacity = 20

@Sync
property integer Worker5CartCapacity = 20

@Sync
property string RecoveryStatus = ""

@Sync
property boolean RecoveryPending = false

@Sync
property boolean RecoveryCanRestore = false

@Sync
property boolean SessionAccessDenied = false

@Sync
property string SessionMessage = ""

@ExecSpace("ServerOnly")
method void OnBeginPlay()
    self._T.profile = self:CreateDefaultProfile()
    self._T.autoSaveTimer = 0
    self._T.restoreTimer = 0
    self._T.restoredMapName = ""
    self._T.lockRefreshTimer = 0
    self._T.lockHeld = false
    self._T.lockToken = ""
    self._T.lockRaw = ""
    -- Player-scoped DataStorage becomes available just after entity begin-play.
    self._T.initializeTimer = _TimerService:SetTimerOnce(function()
        self:InitializeProfileStorage()
    end, 1.0)
end

@ExecSpace("ServerOnly")
method void InitializeProfileStorage()
    if self.Entity.PlayerComponent == nil then
        log_error("[AccountProfile] missing PlayerComponent")
        return
    end

    -- UserDataStorage is keyed by the account UserId; ProfileCode is only a player-profile label.
    local userId = self.Entity.PlayerComponent.UserId
    if userId == nil or userId == "" then
        log_error("[AccountProfile] missing PlayerComponent.UserId")
        return
    end

    self._T.storage = _DataStorageService:GetUserDataStorage(userId)
    log("[AccountProfile] storage ready user=" .. tostring(userId))
    if not self:AcquireSessionLock() then return end
    self:LoadProfile()
    self:StartSessionTimers()
end

@ExecSpace("ServerOnly")
method void OnEndPlay()
    if self._T.initializeTimer ~= nil and self._T.initializeTimer ~= 0 then
        _TimerService:ClearTimer(self._T.initializeTimer)
        self._T.initializeTimer = 0
    end
    if self._T.autoSaveTimer ~= nil and self._T.autoSaveTimer ~= 0 then
        _TimerService:ClearTimer(self._T.autoSaveTimer)
        self._T.autoSaveTimer = 0
    end
    if self._T.restoreTimer ~= nil and self._T.restoreTimer ~= 0 then
        _TimerService:ClearTimer(self._T.restoreTimer)
        self._T.restoreTimer = 0
    end
    if self._T.autoRunTimer ~= nil and self._T.autoRunTimer ~= 0 then
        _TimerService:ClearTimer(self._T.autoRunTimer)
        self._T.autoRunTimer = 0
    end
    if self._T.lockRefreshTimer ~= nil and self._T.lockRefreshTimer ~= 0 then
        _TimerService:ClearTimer(self._T.lockRefreshTimer)
        self._T.lockRefreshTimer = 0
    end
    if self:CanWriteProfile() then
        self:CaptureCurrentWorkerState()
        self:SaveProfileAndWait()
    end
    self:ReleaseSessionLock()
end

@ExecSpace("ServerOnly")
method table CreateDefaultProfile()
    return {
        schemaVersion = self.SchemaVersion,
        gold = 0,
        crystal = 0,
        mineTokens = 0,
        stone = 0,
        iron = 0,
        goldOre = 0,
        -- v8 (F7-B §5.1): 맵별 영구 강화 레벨 0~10. 미해금 맵도 0으로 기록한다.
        mineLevels = { beginner_mine = 0, deep_mine = 0, gem_mine = 0 },
        -- v8 (F7-E §10.2): 튜토리얼 진행 상태. step 0 = 미시작, 9 = 완료.
        tutorial = {
            step = 0,
            completed = false,
            skipped = false,
            rewardsClaimed = false,
            midRewards = { s4 = false, s6 = false },
        },
        -- v8 (F10 §4.2 · C214): 표현 설정 그룹. 원장이 아니므로 별도 최상위 그룹.
        settings = { bgmVolume = 0.5, sfxVolume = 1.0 },
        deepMineUnlocked = false,
        gemMineUnlocked = false,
        stoneTokenProgress = 0,
        ironTokenProgress = 0,
        rareCollection = { rare_stone = 0, rare_iron = 0, rare_gold = 0 },
        rareStorage = { rare_stone = 0, rare_iron = 0, rare_gold = 0 },
        rareSaleSettings = {
            rare_stone = { autoSell = false },
            rare_iron = { autoSell = false },
            rare_gold = { autoSell = false },
        },
        saleSettings = {
            stone = { autoSell = false, protectedAmount = 0 },
            iron = { autoSell = false, protectedAmount = 0 },
            gold = { autoSell = false, protectedAmount = 0 },
        },
        lastMineId = "farm01",
        workers = { self:CreateWorkerRecord(1) },
        unlocksJson = "{}",
        programLibraryJson = "{}",
        workerAppearanceJson = "{}",
        statsJson = "{}",
    }
end

@ExecSpace("ServerOnly")
method void LoadProfile()
    local errorCode, raw = self._T.storage:GetAndWait(self.StorageKey)
    if errorCode == 1000002 or raw == nil or raw == "" then
        self.IsLoaded = true
        self:SyncRuntimeState()
        self:MarkProfileDirty()
        self:SaveProfileAndWait()
        log("[AccountProfile] new profile ready")
        return
    end
    if errorCode ~= 0 then
        log_error("[AccountProfile] load failed error=" .. tostring(errorCode))
        self:BeginRecovery("계정 데이터를 읽지 못했습니다.", "")
        return
    end

    local decoded = self:DecodeJsonSafely(raw)
    if type(decoded) ~= "table" then
        log_error("[AccountProfile] invalid saved JSON; waiting for recovery choice")
        self:BeginRecovery("현재 계정 데이터를 읽을 수 없습니다.", raw)
        return
    end

    local loadedSchemaVersion = decoded.schemaVersion or 1
    self._T.profile = self:NormalizeProfile(decoded)
    self.IsLoaded = true
    self:SyncRuntimeState()
    if loadedSchemaVersion ~= self.SchemaVersion then
        self:MarkProfileDirty()
        self:SaveProfileAndWait()
        log("[AccountProfile] profile migrated from schema=" .. tostring(loadedSchemaVersion) .. " to=" .. tostring(self.SchemaVersion))
    end
    self:EnsureBackupFromRaw(raw)
    log("[AccountProfile] profile loaded schema=" .. tostring(self._T.profile.schemaVersion) .. " gold=" .. tostring(self._T.profile.gold))
end

@ExecSpace("ServerOnly")
method table CreateWorkerRecord(integer workerIndex)
    local suffix = tostring(workerIndex)
    if workerIndex < 10 then suffix = "0" .. suffix end
    return {
        id = "worker-" .. suffix,
        owned = true,
        cartUpgradeLevel = 0,
        cartCapacity = 20,
        cart = { stone = 0, iron = 0, gold = 0, rare_stone = 0, rare_iron = 0, rare_gold = 0 },
        cartCount = 0,
        pendingOre = "",
        -- v8 (F7-B §5.3): yield 추가 지급이 발동하면 손에 같은 광물 최대 2개.
        pendingOreCount = 0,
        lastValidProgramId = "default-worker-" .. suffix,
        -- T-05 (F7-C): 서버 검증을 통과한 마지막 프로그램 내용. 재접속 자동 실행의
        -- 원본이다. 실행 중 frame/인덱스는 저장하지 않는다 (§2).
        lastValidProgramJson = "",
    }
end

@ExecSpace("ServerOnly")
method void StartSessionTimers()
    -- Timers start only after a profile is usable and this session owns its lease.
    if not self:CanWriteProfile() then return end
    self._T.autoSaveTimer = _TimerService:SetTimerRepeat(function()
        self:SaveProfileAsync()
    end, self.AutoSaveSeconds, self.AutoSaveSeconds)
    self._T.lockRefreshTimer = _TimerService:SetTimerRepeat(function()
        self:RefreshSessionLock()
    end, self.SessionLockRefreshSeconds, self.SessionLockRefreshSeconds)
    self._T.restoreTimer = _TimerService:SetTimerOnce(function()
        self:RestoreLastMineAndWorker()
    end, 0.5)
end

@ExecSpace("ServerOnly")
method boolean CanWriteProfile()
    return self.IsLoaded and self._T.lockHeld and not self.RecoveryPending and not self.SessionAccessDenied
end

@ExecSpace("ServerOnly")
method integer CurrentLockClock()
    -- DateTime elapsed is server UTC based, so lease comparisons do not trust client time.
    return DateTime.UtcNow.Elapsed
end

@ExecSpace("ServerOnly")
method string BuildLockValue(string token)
    return _HttpService:JSONEncode({
        token = token,
        expiresAt = self:CurrentLockClock() + self.SessionLockLeaseSeconds * 1000,
    })
end

@ExecSpace("ServerOnly")
method boolean IsActiveLock(string raw)
    if raw == nil or raw == "" then return false end
    local decoded = self:DecodeJsonSafely(raw)
    return type(decoded) == "table" and type(decoded.token) == "string" and decoded.token ~= "" and type(decoded.expiresAt) == "number" and decoded.expiresAt > self:CurrentLockClock()
end

@ExecSpace("ServerOnly")
method any DecodeJsonSafely(string raw)
    local ok, decoded = pcall(function()
        return _HttpService:JSONDecode(raw)
    end)
    if not ok then return nil end
    return decoded
end

@ExecSpace("ServerOnly")
method boolean AcquireSessionLock()
    local errorCode, current = self._T.storage:GetAndWait(self.SessionLockStorageKey)
    local lockMissing = errorCode == 1000002 or current == nil
    if lockMissing then current = "" end
    if errorCode ~= 0 and errorCode ~= 1000002 then
        self.SessionAccessDenied = true
        self.SessionMessage = "계정 잠금을 확인하지 못했습니다. 잠시 후 다시 시도해 주세요."
        self:SetRecoveryStatus(self.SessionMessage)
        log_error("[AccountProfile] lock read failed error=" .. tostring(errorCode))
        return false
    end
    if self:IsActiveLock(current) then
        self.SessionAccessDenied = true
        self.SessionMessage = "다른 기기에서 플레이 중입니다. 잠시 후 다시 시도해 주세요."
        self:SetRecoveryStatus(self.SessionMessage)
        log_warning("[AccountProfile] session denied reason=active-lock")
        return false
    end
    self._T.lockToken = _UtilLogic:NewGuid()
    local nextRaw = self:BuildLockValue(self._T.lockToken)
    local updateError = 0
    if lockMissing then
        -- UpdateAndWait cannot create a missing key, so bootstrap the first lease.
        -- Later acquisition/refresh/release operations use compare-and-set.
        updateError = self._T.storage:SetAndWait(self.SessionLockStorageKey, nextRaw)
    else
        updateError = self._T.storage:UpdateAndWait(self.SessionLockStorageKey, current, nextRaw)
    end
    if updateError ~= 0 then
        self.SessionAccessDenied = true
        self.SessionMessage = "다른 접속이 먼저 계정을 열었습니다. 다시 시도해 주세요."
        self:SetRecoveryStatus(self.SessionMessage)
        log_warning("[AccountProfile] session denied reason=lock-race error=" .. tostring(updateError))
        return false
    end
    self._T.lockHeld = true
    self._T.lockRaw = nextRaw
    self.SessionAccessDenied = false
    self.SessionMessage = ""
    log("[AccountProfile] session lock acquired")
    return true
end

@ExecSpace("ServerOnly")
method void RefreshSessionLock()
    if not self._T.lockHeld then return end
    local nextRaw = self:BuildLockValue(self._T.lockToken)
    local errorCode = self._T.storage:UpdateAndWait(self.SessionLockStorageKey, self._T.lockRaw, nextRaw)
    if errorCode ~= 0 then
        self._T.lockHeld = false
        self.SessionAccessDenied = true
        self.SessionMessage = "계정 세션 잠금을 유지하지 못했습니다. 다시 접속해 주세요."
        self:SetRecoveryStatus(self.SessionMessage)
        log_error("[AccountProfile] session lock refresh failed error=" .. tostring(errorCode))
        return
    end
    self._T.lockRaw = nextRaw
end

@ExecSpace("ServerOnly")
method void ReleaseSessionLock()
    if not self._T.lockHeld then return end
    local errorCode = self._T.storage:UpdateAndWait(self.SessionLockStorageKey, self._T.lockRaw, "")
    if errorCode ~= 0 then
        log_warning("[AccountProfile] session lock release failed error=" .. tostring(errorCode))
    else
        log("[AccountProfile] session lock released")
    end
    self._T.lockHeld = false
    self._T.lockRaw = ""
end

@ExecSpace("ServerOnly")
method void EnsureBackupFromRaw(string raw)
    -- Existing v3 users may predate the backup key; seed it once without extra writes later.
    local errorCode, backupRaw = self._T.storage:GetAndWait(self.BackupStorageKey)
    if errorCode == 1000002 or backupRaw == nil or backupRaw == "" then
        local backupError = self._T.storage:SetAndWait(self.BackupStorageKey, raw)
        if backupError ~= 0 then log_warning("[AccountProfile] backup seed failed error=" .. tostring(backupError)) end
    elseif errorCode ~= 0 then
        log_warning("[AccountProfile] backup read failed error=" .. tostring(errorCode))
    end
end

@ExecSpace("ServerOnly")
method void BeginRecovery(string reason, string corruptRaw)
    self.IsLoaded = false
    self.RecoveryPending = true
    self.RecoveryCanRestore = false
    self.SessionAccessDenied = false
    self.SessionMessage = ""
    self._T.corruptRaw = corruptRaw
    self._T.recoveryBackupRaw = ""
    local errorCode, backupRaw = self._T.storage:GetAndWait(self.BackupStorageKey)
    if errorCode == 0 and backupRaw ~= nil and type(self:DecodeJsonSafely(backupRaw)) == "table" then
        self._T.recoveryBackupRaw = backupRaw
        self.RecoveryCanRestore = true
        self:SetRecoveryStatus(reason .. " 마지막 정상 저장본을 복구할 수 있습니다.")
    else
        self:SetRecoveryStatus(reason .. " 복구 가능한 저장본이 없습니다.")
    end
    log_warning("[AccountProfile] recovery pending canRestore=" .. tostring(self.RecoveryCanRestore))
end

@ExecSpace("ServerOnly")
method boolean RestoreFromBackup()
    if not self.RecoveryPending or not self.RecoveryCanRestore then return false end
    local decoded = self:DecodeJsonSafely(self._T.recoveryBackupRaw)
    if type(decoded) ~= "table" then return false end
    self._T.profile = self:NormalizeProfile(decoded)
    self.IsLoaded = true
    self.RecoveryPending = false
    self.RecoveryCanRestore = false
    self:SetRecoveryStatus("마지막 정상 저장본을 복구했습니다.")
    self:SyncRuntimeState()
    self:MarkProfileDirty()
    if not self:SaveProfileAndWait() then
        self.IsLoaded = false
        self.RecoveryPending = true
        self.RecoveryCanRestore = true
        self:SetRecoveryStatus("복구본 저장에 실패했습니다. 다시 시도해 주세요.")
        return false
    end
    self:StartSessionTimers()
    log("[AccountProfile] recovery restored")
    return true
end

@ExecSpace("ServerOnly")
method boolean AbandonCorruptProfile()
    if not self.RecoveryPending then return false end
    local profile = self:CreateDefaultProfile()
    local encoded = _HttpService:JSONEncode(profile)
    local values = { [self.StorageKey] = encoded }
    if self._T.recoveryBackupRaw ~= nil and self._T.recoveryBackupRaw ~= "" then
        values[self.RecoveryArchiveStorageKey] = self._T.recoveryBackupRaw
    end
    local errorCode = self._T.storage:TransactSetAndWait(values)
    if errorCode ~= 0 then
        self:SetRecoveryStatus("새 계정을 저장하지 못했습니다. 다시 시도해 주세요.")
        return false
    end
    self._T.profile = profile
    self.IsLoaded = true
    self.RecoveryPending = false
    self.RecoveryCanRestore = false
    self:SetRecoveryStatus("손상된 저장 후보를 포기하고 새 계정을 시작합니다.")
    self:SyncRuntimeState()
    self:StartSessionTimers()
    log("[AccountProfile] corrupt candidate abandoned")
    return true
end

@ExecSpace("Server")
method boolean RequestRecoveryRestore()
    return self:RestoreFromBackup()
end

@ExecSpace("Server")
method boolean RequestRecoveryAbandon()
    return self:AbandonCorruptProfile()
end

@ExecSpace("ServerOnly")
method table NormalizeProfile(table profile)
    local normalized = self:CreateDefaultProfile()
    normalized.schemaVersion = self.SchemaVersion
    normalized.gold = profile.gold or profile.credits or normalized.gold
    -- v7 → v8: 필드가 없으면 변환 실패가 아니라 기본값이다 (F7-A §2.1).
    if type(profile.crystal) == "number" then normalized.crystal = math.max(0, math.floor(profile.crystal)) end
    normalized.mineLevels = self:NormalizeMineLevels(profile.mineLevels)
    normalized.tutorial = self:NormalizeTutorial(profile.tutorial)
    normalized.settings = self:NormalizeSettings(profile.settings)
    normalized.mineTokens = profile.mineTokens or normalized.mineTokens
    normalized.stone = profile.stone or normalized.stone
    normalized.iron = profile.iron or normalized.iron
    normalized.goldOre = profile.goldOre or normalized.goldOre
    normalized.deepMineUnlocked = profile.deepMineUnlocked or normalized.deepMineUnlocked
    normalized.gemMineUnlocked = profile.gemMineUnlocked or normalized.gemMineUnlocked
    normalized.stoneTokenProgress = profile.stoneTokenProgress or normalized.stoneTokenProgress
    normalized.ironTokenProgress = profile.ironTokenProgress or normalized.ironTokenProgress
    normalized.saleSettings = self:NormalizeSaleSettings(profile.saleSettings)
    normalized.rareCollection = self:NormalizeRareCounts(profile.rareCollection)
    normalized.rareStorage = self:NormalizeRareStorage(profile.rareStorage)
    normalized.rareSaleSettings = self:NormalizeRareSaleSettings(profile.rareSaleSettings)
    if self:IsKnownMineMap(profile.lastMineId) then normalized.lastMineId = profile.lastMineId end
    normalized.workers = self:NormalizeWorkers(profile.workers, normalized.rareCollection.rare_stone)
    normalized.unlocksJson = profile.unlocksJson or normalized.unlocksJson
    normalized.programLibraryJson = profile.programLibraryJson or normalized.programLibraryJson
    normalized.workerAppearanceJson = profile.workerAppearanceJson or normalized.workerAppearanceJson
    normalized.statsJson = profile.statsJson or normalized.statsJson
    return normalized
end

@ExecSpace("ServerOnly")
method table NormalizeMineLevels(any source)
    -- 맵별 강화 레벨 0~10 정수. v7 프로필(필드 없음)은 세 맵 모두 0으로 변환한다.
    local levels = { beginner_mine = 0, deep_mine = 0, gem_mine = 0 }
    if type(source) ~= "table" then return levels end
    for mineId, level in pairs(source) do
        if levels[mineId] ~= nil and type(level) == "number" then
            levels[mineId] = math.max(0, math.min(10, math.floor(level)))
        end
    end
    return levels
end

@ExecSpace("ServerOnly")
method table NormalizeTutorial(any source)
    -- F7-E §10.2: v7 프로필은 step 0 + 모든 플래그 false 로 변환한다.
    local tutorial = {
        step = 0,
        completed = false,
        skipped = false,
        rewardsClaimed = false,
        midRewards = { s4 = false, s6 = false },
    }
    if type(source) ~= "table" then return tutorial end
    if type(source.step) == "number" then tutorial.step = math.max(0, math.min(9, math.floor(source.step))) end
    tutorial.completed = source.completed == true
    tutorial.skipped = source.skipped == true
    tutorial.rewardsClaimed = source.rewardsClaimed == true
    if type(source.midRewards) == "table" then
        tutorial.midRewards.s4 = source.midRewards.s4 == true
        tutorial.midRewards.s6 = source.midRewards.s6 == true
    end
    return tutorial
end

@ExecSpace("ServerOnly")
method table NormalizeSettings(any source)
    -- F10 §4.2 (C214): 서버는 0.0~1.0 클램프만 하고 거절하지 않는다.
    local settings = { bgmVolume = 0.5, sfxVolume = 1.0 }
    if type(source) ~= "table" then return settings end
    if type(source.bgmVolume) == "number" then settings.bgmVolume = math.max(0.0, math.min(1.0, source.bgmVolume)) end
    if type(source.sfxVolume) == "number" then settings.sfxVolume = math.max(0.0, math.min(1.0, source.sfxVolume)) end
    return settings
end

@ExecSpace("ServerOnly")
method table NormalizeSaleSettings(any source)
    local settings = self:CreateDefaultProfile().saleSettings
    if type(source) ~= "table" then return settings end
    for oreType, record in pairs(source) do
        if self:IsRegularOre(oreType) and type(record) == "table" then
            settings[oreType].autoSell = record.autoSell == true
            if type(record.protectedAmount) == "number" then
                settings[oreType].protectedAmount = math.max(0, math.floor(record.protectedAmount))
            end
        end
    end
    return settings
end

@ExecSpace("ServerOnly")
method table NormalizeRareCounts(any source)
    local counts = { rare_stone = 0, rare_iron = 0, rare_gold = 0 }
    if type(source) ~= "table" then return counts end
    for oreType, count in pairs(source) do
        if self:IsRareOre(oreType) and type(count) == "number" then
            counts[oreType] = math.max(0, math.min(10, math.floor(count)))
        end
    end
    return counts
end

@ExecSpace("ServerOnly")
method table NormalizeRareStorage(any source)
    local counts = { rare_stone = 0, rare_iron = 0, rare_gold = 0 }
    if type(source) ~= "table" then return counts end
    for oreType, count in pairs(source) do
        if self:IsRareOre(oreType) and type(count) == "number" then
            counts[oreType] = math.max(0, math.floor(count))
        end
    end
    return counts
end

@ExecSpace("ServerOnly")
method table NormalizeRareSaleSettings(any source)
    local settings = self:CreateDefaultProfile().rareSaleSettings
    if type(source) ~= "table" then return settings end
    for oreType, record in pairs(source) do
        if self:IsRareOre(oreType) and type(record) == "table" then
            settings[oreType].autoSell = record.autoSell == true
        end
    end
    return settings
end

@ExecSpace("ServerOnly")
method table NormalizeWorkers(any workers, integer rareStoneLevel)
    -- Owned workers are contiguous 1..5. Runtime entities and interpreter frames
    -- remain session-only, but each worker's cart and selected program reference persist.
    if type(workers) ~= "table" or type(workers[1]) ~= "table" then
        return { self:CreateWorkerRecord(1) }
    end
    local normalized = {}
    for workerIndex = 1, 5 do
        local source = workers[workerIndex]
        if type(source) ~= "table" or source.owned == false then break end
        local record = self:CreateWorkerRecord(workerIndex)
        if type(source.cartUpgradeLevel) == "number" then
            record.cartUpgradeLevel = math.max(0, math.min(15, math.floor(source.cartUpgradeLevel)))
        elseif type(source.cartCapacity) == "number" then
            record.cartUpgradeLevel = math.max(0, math.min(15, math.floor((source.cartCapacity - 20) / 2)))
        end
        record.cartCapacity = 20 + record.cartUpgradeLevel * 2
        if type(source.cartCapacity) == "number" then
            local savedCapacity = math.max(20, math.min(50, math.floor(source.cartCapacity)))
            if savedCapacity > record.cartCapacity then
                record.cartUpgradeLevel = math.max(0, math.min(15, math.floor((savedCapacity - 20) / 2)))
                record.cartCapacity = 20 + record.cartUpgradeLevel * 2
            end
        end
        if type(source.pendingOre) == "string" and self:IsKnownOre(source.pendingOre) then
            record.pendingOre = source.pendingOre
        end
        -- v7 기록은 개수 필드가 없다: 손에 광물이 있으면 1, 없으면 0 (F7-A §2.1 ②).
        if record.pendingOre == "" then
            record.pendingOreCount = 0
        elseif type(source.pendingOreCount) == "number" then
            record.pendingOreCount = math.max(1, math.min(2, math.floor(source.pendingOreCount)))
        else
            record.pendingOreCount = 1
        end
        if type(source.lastValidProgramId) == "string" and source.lastValidProgramId ~= "" then
            record.lastValidProgramId = source.lastValidProgramId
        end
        -- T-05: 내용이 유효한 JSON 이 아니면 버리지 않고 그대로 보존한다 — 자동
        -- 실행 쪽이 검증 실패로 Idle 처리한다 (F7-C §4: 원본 자동 수정 금지).
        if type(source.lastValidProgramJson) == "string" then
            record.lastValidProgramJson = source.lastValidProgramJson
        end
        if type(source.cart) == "table" then
            for oreType, count in pairs(source.cart) do
                if self:IsKnownOre(oreType) and type(count) == "number" and count > 0 then
                    record.cart[oreType] = math.floor(count)
                end
            end
        end
        record.cartCount = self:CountCart(record.cart)
        local effectiveCapacity = record.cartCapacity + math.floor(record.cartCapacity * rareStoneLevel * 3 / 100)
        if record.cartCount > effectiveCapacity then
            record.cart = { stone = 0, iron = 0, gold = 0, rare_stone = 0, rare_iron = 0, rare_gold = 0 }
            record.cartCount = 0
            record.pendingOre = ""
            log_warning("[AccountProfile] invalid saved worker cart cleared index=" .. tostring(workerIndex))
        end
        table.insert(normalized, record)
    end
    if #normalized == 0 then table.insert(normalized, self:CreateWorkerRecord(1)) end
    return normalized
end

@ExecSpace("ServerOnly")
method boolean IsRegularOre(string oreType)
    return oreType == "stone" or oreType == "iron" or oreType == "gold"
end

@ExecSpace("ServerOnly")
method boolean IsRareOre(string oreType)
    return oreType == "rare_stone" or oreType == "rare_iron" or oreType == "rare_gold"
end

@ExecSpace("ServerOnly")
method boolean IsKnownOre(string oreType)
    return self:IsRegularOre(oreType) or self:IsRareOre(oreType)
end

@ExecSpace("ServerOnly")
method integer CountCart(table cart)
    local total = 0
    for oreType, count in pairs(cart) do
        if self:IsKnownOre(oreType) and type(count) == "number" and count > 0 then
            total = total + math.floor(count)
        end
    end
    return total
end

@ExecSpace("ServerOnly")
method boolean IsKnownMineMap(any mapName)
    return mapName == "farm01" or mapName == "deep_mine" or mapName == "gem_mine"
end

@ExecSpace("ServerOnly")
method table GetProfile()
    return self._T.profile
end

@ExecSpace("ServerOnly")
method void SyncRuntimeState()
    -- Mirrors only player-visible progression data; authoritative values stay in the profile.
    self.Gold = self._T.profile.gold
    self.Crystal = self._T.profile.crystal or 0
    self.MineLevelBeginner = self._T.profile.mineLevels.beginner_mine
    self.MineLevelDeep = self._T.profile.mineLevels.deep_mine
    self.MineLevelGem = self._T.profile.mineLevels.gem_mine
    self.MineUpgradeInfoJson = self:BuildMineUpgradeInfoJson()
    self.ProgramLibraryJson = self._T.profile.programLibraryJson or "{}"
    self.TutorialStep = self._T.profile.tutorial.step or 0
    self.TutorialCompleted = self._T.profile.tutorial.completed == true
    self.TutorialSkipped = self._T.profile.tutorial.skipped == true
    self.MineTokens = self._T.profile.mineTokens
    self.Stone = self._T.profile.stone
    self.Iron = self._T.profile.iron
    self.GoldOre = self._T.profile.goldOre
    self.RareStoneCollectionLevel = self._T.profile.rareCollection.rare_stone
    self.RareIronCollectionLevel = self._T.profile.rareCollection.rare_iron
    self.RareGoldCollectionLevel = self._T.profile.rareCollection.rare_gold
    self.RareStoneStored = self._T.profile.rareStorage.rare_stone
    self.RareIronStored = self._T.profile.rareStorage.rare_iron
    self.RareGoldStored = self._T.profile.rareStorage.rare_gold
    self.RareStoneAutoSell = self._T.profile.rareSaleSettings.rare_stone.autoSell
    self.RareIronAutoSell = self._T.profile.rareSaleSettings.rare_iron.autoSell
    self.RareGoldAutoSell = self._T.profile.rareSaleSettings.rare_gold.autoSell
    self.StoneAutoSell = self._T.profile.saleSettings.stone.autoSell
    self.IronAutoSell = self._T.profile.saleSettings.iron.autoSell
    self.GoldOreAutoSell = self._T.profile.saleSettings.gold.autoSell
    self.StoneProtectedAmount = self._T.profile.saleSettings.stone.protectedAmount
    self.IronProtectedAmount = self._T.profile.saleSettings.iron.protectedAmount
    self.GoldOreProtectedAmount = self._T.profile.saleSettings.gold.protectedAmount
    -- Effective protection = max(설정값, 다음 광산 해금 필요량). The sale screen must
    -- show this, not the configured value alone: with 0 configured and 120 mandatory
    -- the player saw "보호 0" and could not tell why the sale was refused
    -- (docs/16 §14 D-10).
    self.StoneEffectiveProtection = _EconomyService:GetEffectiveProtection(self._T.profile, "stone")
    self.IronEffectiveProtection = _EconomyService:GetEffectiveProtection(self._T.profile, "iron")
    self.GoldOreEffectiveProtection = _EconomyService:GetEffectiveProtection(self._T.profile, "gold")
    self.DeepMineUnlocked = self._T.profile.deepMineUnlocked
    self.GemMineUnlocked = self._T.profile.gemMineUnlocked
    self.LastMineId = self._T.profile.lastMineId
    self.OwnedWorkerCount = #self._T.profile.workers
    self.Worker1CartCapacity = self:GetWorkerCartCapacity(1)
    self.Worker2CartCapacity = self:GetWorkerCartCapacity(2)
    self.Worker3CartCapacity = self:GetWorkerCartCapacity(3)
    self.Worker4CartCapacity = self:GetWorkerCartCapacity(4)
    self.Worker5CartCapacity = self:GetWorkerCartCapacity(5)
end

@ExecSpace("ServerOnly")
method integer GetWorkerCartCapacity(integer workerIndex)
    local record = self._T.profile.workers[workerIndex]
    if record == nil then return 20 end
    local baseCapacity = math.max(20, math.min(50, math.floor(record.cartCapacity or 20)))
    local bonus = math.floor(baseCapacity * self._T.profile.rareCollection.rare_stone * 3 / 100)
    return baseCapacity + bonus
end

@ExecSpace("ServerOnly")
method boolean UpdateSaleSetting(string oreType, boolean autoSell, integer protectedAmount)
    if not self:CanWriteProfile() or not self:IsKnownOre(oreType) then return false end
    if protectedAmount < 0 then return false end
    local snapshot = _HttpService:JSONEncode(self._T.profile)
    local record = self._T.profile.saleSettings[oreType]
    record.autoSell = autoSell
    record.protectedAmount = math.floor(protectedAmount)
    self:SyncRuntimeState()
    self:MarkProfileDirty()
    if self:SaveProfileAndWait() then
        self:SetTransactionMessage("판매 설정 저장: " .. oreType .. " 보호 " .. tostring(record.protectedAmount) .. ", 자동 " .. tostring(record.autoSell))
        return true
    end
    self._T.profile = self:NormalizeProfile(self:DecodeJsonSafely(snapshot))
    self:SyncRuntimeState()
    self:SetTransactionMessage("판매 설정 저장에 실패해 이전 설정으로 되돌렸습니다. 다시 시도해 주세요.")
    return false
end

@ExecSpace("ServerOnly")
method void SetRecoveryStatus(string status)
    self.RecoveryStatus = status
end

@ExecSpace("ServerOnly")
method any GetCurrentWorker()
    return self:GetWorkerByIndex(1)
end

@ExecSpace("ServerOnly")
method string WorkerEntityName(integer workerIndex)
    local suffix = tostring(workerIndex)
    if workerIndex < 10 then suffix = "0" .. suffix end
    return "Worker" .. suffix
end

@ExecSpace("ServerOnly")
method any GetWorkerByIndex(integer workerIndex)
    local map = self.Entity.CurrentMap
    if map == nil then return nil end
    local workerEntity = map:GetChildByName(self:WorkerEntityName(workerIndex), false)
    if workerEntity == nil then return nil end
    ---@type WorkerController
    return workerEntity:GetComponent("script.WorkerController")
end

@ExecSpace("ServerOnly")
method void CaptureCurrentWorkerState()
    -- Persists each owned worker's hand/cart; position and interpreter frames remain session-only.
    if not self:CanWriteProfile() then return end
    for workerIndex = 1, #self._T.profile.workers do
        local worker = self:GetWorkerByIndex(workerIndex)
        local record = self._T.profile.workers[workerIndex]
        if worker ~= nil and record ~= nil then
            -- Runtime capacity includes the rare-stone collection bonus.  Only the
            -- base upgrade capacity belongs in persistent worker progression.
            record.cartCapacity = math.max(20, math.min(50, math.floor(record.cartCapacity or 20)))
            record.cartUpgradeLevel = math.max(0, math.min(15, math.floor((record.cartCapacity - 20) / 2)))
            record.cart = { stone = 0, iron = 0, gold = 0, rare_stone = 0, rare_iron = 0, rare_gold = 0 }
            for oreType, count in pairs(worker.Cart) do
                if self:IsKnownOre(oreType) and type(count) == "number" and count > 0 then
                    record.cart[oreType] = math.floor(count)
                end
            end
            record.cartCount = self:CountCart(record.cart)
            record.pendingOre = ""
            record.pendingOreCount = 0
            if self:IsKnownOre(worker.PendingOre) then
                record.pendingOre = worker.PendingOre
                record.pendingOreCount = math.max(1, math.min(2, math.floor(worker.PendingOreCount or 1)))
            end
        end
    end
    self:MarkProfileDirty()
end

@ExecSpace("ServerOnly")
method boolean RestoreCurrentWorkerState()
    if not self:CanWriteProfile() then return false end
    -- 맵 진입 시점의 보너스 캐시 갱신 (F7-B §5.5). 로그인·광산 전환 모두 이 경로를 지난다.
    self:PushMineBonusesToSimulator()
    local restoredCount = 0
    for workerIndex = 1, #self._T.profile.workers do
        if self:RestoreOwnedWorker(workerIndex) then restoredCount = restoredCount + 1 end
    end
    if restoredCount <= 0 then return false end
    self:SetRecoveryStatus("저장된 일꾼 " .. tostring(restoredCount) .. "명의 수레 상태를 복구했습니다.")
    log("[AccountProfile] owned workers restored count=" .. tostring(restoredCount))
    return true
end

@ExecSpace("ServerOnly")
method boolean RestoreOwnedWorker(integer workerIndex)
    local record = self._T.profile.workers[workerIndex]
    if record == nil then return false end
    local worker = self:GetWorkerByIndex(workerIndex)
    if worker == nil and workerIndex > 1 then
        local map = self.Entity.CurrentMap
        if map == nil then return false end
        local spawned = _SpawnService:SpawnByModelId("worker", self:WorkerEntityName(workerIndex), Vector3(0, 0, 0), map)
        if spawned == nil then
            log_error("[AccountProfile] worker spawn failed index=" .. tostring(workerIndex))
            return false
        end
        worker = spawned:GetComponent("script.WorkerController")
    end
    if worker == nil then return false end
    worker:ConfigureFromProfile(workerIndex, self:GetWorkerCartCapacity(workerIndex), record.cart, record.pendingOre, record.pendingOreCount or 0)
    return true
end

@ExecSpace("ServerOnly")
method boolean PurchaseNextWorker(integer goldCost, integer stoneCost, integer ironCost, integer goldOreCost)
    if not self:CanWriteProfile() then return false end
    local profile = self._T.profile
    local workerIndex = #profile.workers + 1
    if workerIndex > 5 then
        self:SetRejectWorkerMax()
        return false
    end
    if profile.gold < goldCost or profile.stone < stoneCost or profile.iron < ironCost or profile.goldOre < goldOreCost then
        self:SetTransactionMessage("일꾼 구매 재화가 부족합니다. " .. self:DescribeShortfall(goldCost, 0, stoneCost, ironCost, goldOreCost))
        return false
    end
    local snapshot = _HttpService:JSONEncode(profile)
    profile.gold = profile.gold - goldCost
    profile.stone = profile.stone - stoneCost
    profile.iron = profile.iron - ironCost
    profile.goldOre = profile.goldOre - goldOreCost
    table.insert(profile.workers, self:CreateWorkerRecord(workerIndex))
    self:SyncRuntimeState()
    self:MarkProfileDirty()
    if not self:SaveProfileAndWait() then
        self._T.profile = self:NormalizeProfile(self:DecodeJsonSafely(snapshot))
        self:SyncRuntimeState()
        self:SetTransactionMessage("일꾼 구매 저장에 실패해 비용을 되돌렸습니다. 다시 시도해 주세요.")
        return false
    end
    local spawned = self:RestoreOwnedWorker(workerIndex)
    if spawned then
        self:SetTransactionMessage("일꾼 " .. tostring(workerIndex) .. " 고용 완료")
    else
        self:SetTransactionMessage("일꾼 " .. tostring(workerIndex) .. " 고용 완료: 다음 광산 진입 시 배치됩니다.")
    end
    log("[AccountProfile] worker purchased index=" .. tostring(workerIndex) .. " spawned=" .. tostring(spawned))
    return true
end

@ExecSpace("ServerOnly")
method boolean PurchaseCartUpgrade(integer workerIndex, integer goldCost, string oreType, integer oreCost)
    if not self:CanWriteProfile() or workerIndex < 1 or oreCost < 0 or goldCost < 0 then return false end
    local profile = self._T.profile
    local record = profile.workers[workerIndex]
    if record == nil then
        self:SetRejectCartNotOwned()
        return false
    end
    if record.cartUpgradeLevel >= 15 or record.cartCapacity >= 50 then
        self:SetRejectCartMax(workerIndex)
        return false
    end
    local oreBalance = 0
    if oreType == "stone" then oreBalance = profile.stone
    elseif oreType == "iron" then oreBalance = profile.iron
    elseif oreType == "gold" then oreBalance = profile.goldOre
    else return false end
    if profile.gold < goldCost or oreBalance < oreCost then
        local stoneCost = 0
        local ironCost = 0
        local goldOreCost = 0
        if oreType == "stone" then stoneCost = oreCost
        elseif oreType == "iron" then ironCost = oreCost
        else goldOreCost = oreCost end
        self:SetTransactionMessage("수레 강화 재화가 부족합니다. " .. self:DescribeShortfall(goldCost, 0, stoneCost, ironCost, goldOreCost))
        return false
    end
    local snapshot = _HttpService:JSONEncode(profile)
    profile.gold = profile.gold - goldCost
    if oreType == "stone" then profile.stone = profile.stone - oreCost
    elseif oreType == "iron" then profile.iron = profile.iron - oreCost
    else profile.goldOre = profile.goldOre - oreCost end
    record.cartUpgradeLevel = record.cartUpgradeLevel + 1
    record.cartCapacity = 20 + record.cartUpgradeLevel * 2
    self:SyncRuntimeState()
    self:MarkProfileDirty()
    if not self:SaveProfileAndWait() then
        self._T.profile = self:NormalizeProfile(self:DecodeJsonSafely(snapshot))
        self:SyncRuntimeState()
        self:SetTransactionMessage("수레 강화 저장에 실패해 비용을 되돌렸습니다. 다시 시도해 주세요.")
        return false
    end
    local worker = self:GetWorkerByIndex(workerIndex)
    local effectiveCapacity = self:GetWorkerCartCapacity(workerIndex)
    if worker ~= nil then worker:ApplyCartCapacity(effectiveCapacity) end
    self:SetTransactionMessage("일꾼 " .. tostring(workerIndex) .. " 수레 강화: 기본 " .. tostring(record.cartCapacity) .. "칸 / 적용 " .. tostring(effectiveCapacity) .. "칸")
    log("[AccountProfile] cart upgraded worker=" .. tostring(workerIndex) .. " level=" .. tostring(record.cartUpgradeLevel) .. " baseCapacity=" .. tostring(record.cartCapacity) .. " effectiveCapacity=" .. tostring(effectiveCapacity))
    return true
end

@ExecSpace("ServerOnly")
method void RestoreLastMineAndWorker()
    -- Startup recovery moves only to a known authored mine, then applies the saved Worker01 state.
    if not self:CanWriteProfile() then return end
    local currentMap = self.Entity.CurrentMap
    if currentMap == nil then return end
    local targetMine = self._T.profile.lastMineId
    if self:IsKnownMineMap(targetMine) and currentMap.Name ~= targetMine and self.Entity.PlayerComponent ~= nil then
        self.Entity.PlayerComponent:MoveToMapPosition(targetMine, Vector2(0, 0))
        self._T.restoreTimer = _TimerService:SetTimerOnce(function()
            self:RestoreCurrentWorkerState()
            self:ScheduleAutoRun()
        end, 0.5)
        return
    end
    self:RestoreCurrentWorkerState()
    self:ScheduleAutoRun()
end

@ExecSpace("ServerOnly")
method void ScheduleAutoRun()
    -- 재접속 자동 실행은 F7-A 복구·F6 초기화가 끝난 뒤에만 (F7-C §3). 이 메서드는
    -- 로그인 경로(RestoreLastMineAndWorker)에서만 불린다 — 맵 전환은 수동 대기가
    -- 우선이므로 MineTransitionService 경로에서는 부르지 않는다.
    self._T.autoRunTimer = _TimerService:SetTimerOnce(function()
        self:AutoRunSavedPrograms()
    end, 1.0)
end

@ExecSpace("ServerOnly")
method boolean PrepareMineTransition(string targetMapName)
    -- Commits hand/cart and next map before movement. A failed save blocks the transition.
    if not self:CanWriteProfile() or not self:IsKnownMineMap(targetMapName) then return false end
    local snapshot = _HttpService:JSONEncode(self._T.profile)
    self:CaptureCurrentWorkerState()
    self._T.profile.lastMineId = targetMapName
    self:SyncRuntimeState()
    if self:SaveProfileAndWait() then
        self:SetRecoveryStatus("광산 이동 상태를 저장했습니다.")
        return true
    end
    self._T.profile = self:NormalizeProfile(_HttpService:JSONDecode(snapshot))
    self:SyncRuntimeState()
    self:SetRecoveryStatus("광산 이동 저장에 실패했습니다.")
    return false
end

@ExecSpace("ServerOnly")
method void SetTransactionMessage(string message)
    -- Provides one synchronized result line for the client progression panel.
    self.LastTransactionMessage = message
end

@ExecSpace("ServerOnly")
method string ShortfallPart(string label, integer cost, integer balance)
    -- docs/23 §4.1: 부족 거절은 "무엇이 얼마나" 부족한지 숫자로 말한다.
    if cost <= 0 or balance >= cost then return "" end
    return label .. " " .. tostring(cost - balance) .. " 부족 (필요 " .. tostring(cost) .. " / 보유 " .. tostring(balance) .. ")"
end

@ExecSpace("ServerOnly")
method string DescribeShortfall(integer goldCost, integer tokenCost, integer stoneCost, integer ironCost, integer goldOreCost)
    -- Joins every insufficient resource into one " · "-separated detail string.
    local profile = self._T.profile
    local parts = {}
    local candidates = {
        self:ShortfallPart("골드", goldCost, profile.gold),
        self:ShortfallPart("토큰", tokenCost, profile.mineTokens),
        self:ShortfallPart("돌", stoneCost, profile.stone),
        self:ShortfallPart("철", ironCost, profile.iron),
        self:ShortfallPart("금 광석", goldOreCost, profile.goldOre),
    }
    for i = 1, #candidates do
        if candidates[i] ~= "" then table.insert(parts, candidates[i]) end
    end
    return table.concat(parts, " · ")
end

@ExecSpace("ServerOnly")
method void SetRejectWorkerMax()
    -- docs/23 §2.1: 같은 조건의 문구는 이 메서드 하나만 소유한다 (WORKER_MAX_REACHED).
    self:SetTransactionMessage("이미 최대 5명의 일꾼을 보유하고 있습니다.")
end

@ExecSpace("ServerOnly")
method void SetRejectCartNotOwned()
    -- docs/23 §2.1 불일치 해소 (CART_NOT_OWNED). 선검증·최종검증이 같은 문장을 쓴다.
    self:SetTransactionMessage("보유한 일꾼만 수레를 강화할 수 있습니다.")
end

@ExecSpace("ServerOnly")
method void SetRejectCartMax(integer workerIndex)
    -- docs/23 §2.1 불일치 해소 (CART_MAX_CAPACITY).
    self:SetTransactionMessage("일꾼 " .. tostring(workerIndex) .. "의 수레는 최대 용량입니다. (50칸)")
end

@ExecSpace("ServerOnly")
method void CreditOre(string oreType, integer count)
    -- Adds delivered ore to the account ledger and defers persistence to the autosave batch.
    if count <= 0 or not self:CanWriteProfile() then return end
    if oreType == "stone" then self._T.profile.stone = self._T.profile.stone + count
    elseif oreType == "iron" then self._T.profile.iron = self._T.profile.iron + count
    elseif oreType == "gold" then self._T.profile.goldOre = self._T.profile.goldOre + count
    else
        log_error("[AccountProfile] credit rejected ore=" .. tostring(oreType))
        return
    end
    self:SyncRuntimeState()
    self:MarkProfileDirty()
    log("[AccountProfile] credited ore=" .. oreType .. " count=" .. tostring(count))
end

@ExecSpace("ServerOnly")
method boolean RegisterRareOre(string oreType, integer count)
    -- A rare stack is registered only when it reaches the account warehouse.
    -- The first ten registrations advance the permanent collection; later
    -- stacks remain sellable inventory and never grant an extra passive.
    if count <= 0 or not self:IsRareOre(oreType) or not self:CanWriteProfile() then return false end
    local profile = self._T.profile
    local snapshot = _HttpService:JSONEncode(profile)
    local level = profile.rareCollection[oreType] or 0
    local collectionGain = math.min(count, math.max(0, 10 - level))
    local storedGain = count - collectionGain
    profile.rareCollection[oreType] = level + collectionGain
    if storedGain > 0 then
        profile.rareStorage[oreType] = (profile.rareStorage[oreType] or 0) + storedGain
    end
    self:SyncRuntimeState()
    self:MarkProfileDirty()
    if not self:SaveProfileAndWait() then
        self._T.profile = self:NormalizeProfile(_HttpService:JSONDecode(snapshot))
        self:SyncRuntimeState()
        self:SetTransactionMessage("희귀 광물 등록 저장에 실패해 되돌렸습니다. 다시 시도해 주세요.")
        return false
    end
    if oreType == "rare_stone" and collectionGain > 0 then
        self:ApplyRareStoneCartBonus()
    end
    self:SetTransactionMessage("희귀 광물 등록: " .. oreType .. " 컬렉션 +" .. tostring(collectionGain) .. ", 보관 +" .. tostring(storedGain))
    log("[AccountProfile] rare registered ore=" .. oreType .. " collectionGain=" .. tostring(collectionGain) .. " storedGain=" .. tostring(storedGain))
    return true
end

@ExecSpace("ServerOnly")
method void ApplyRareStoneCartBonus()
    -- Reapply derived runtime capacity after a collection level changes or rolls back.
    for workerIndex = 1, #self._T.profile.workers do
        local worker = self:GetWorkerByIndex(workerIndex)
        if worker ~= nil then
            worker:ApplyCartCapacity(self:GetWorkerCartCapacity(workerIndex))
        end
    end
end

@ExecSpace("ServerOnly")
method boolean UpdateRareAutoSell(string oreType, boolean autoSell)
    if not self:IsRareOre(oreType) or not self:CanWriteProfile() then return false end
    if (self._T.profile.rareCollection[oreType] or 0) < 10 then
        self:SetTransactionMessage("희귀 컬렉션 10단계를 달성한 뒤 자동 판매를 설정할 수 있습니다.")
        return false
    end
    local snapshot = _HttpService:JSONEncode(self._T.profile)
    self._T.profile.rareSaleSettings[oreType].autoSell = autoSell
    self:SyncRuntimeState()
    self:MarkProfileDirty()
    if self:SaveProfileAndWait() then
        self:SetTransactionMessage("희귀 광물 자동 판매 설정: " .. oreType .. " = " .. tostring(autoSell))
        return true
    end
    self._T.profile = self:NormalizeProfile(_HttpService:JSONDecode(snapshot))
    self:SyncRuntimeState()
    self:SetTransactionMessage("희귀 광물 판매 설정 저장에 실패해 이전 설정으로 되돌렸습니다. 다시 시도해 주세요.")
    return false
end

@ExecSpace("ServerOnly")
method boolean ApplyRareSale(string oreType, integer amount, integer goldGain)
    if not self:IsRareOre(oreType) or amount <= 0 or goldGain <= 0 or not self:CanWriteProfile() then return false end
    local profile = self._T.profile
    if (profile.rareCollection[oreType] or 0) < 10 then return false end
    if (profile.rareStorage[oreType] or 0) < amount then return false end
    local snapshot = _HttpService:JSONEncode(profile)
    profile.rareStorage[oreType] = profile.rareStorage[oreType] - amount
    profile.gold = profile.gold + goldGain
    self:SyncRuntimeState()
    self:MarkProfileDirty()
    if self:SaveProfileAndWait() then
        self:SetTransactionMessage("희귀 광물 판매 완료: 골드 +" .. tostring(goldGain))
        log("[AccountProfile] rare sale ore=" .. oreType .. " amount=" .. tostring(amount) .. " gold=" .. tostring(goldGain))
        return true
    end
    self._T.profile = self:NormalizeProfile(_HttpService:JSONDecode(snapshot))
    self:SyncRuntimeState()
    self:SetTransactionMessage("희귀 광물 판매 저장에 실패해 되돌렸습니다. 다시 시도해 주세요.")
    return false
end

@ExecSpace("ServerOnly")
method boolean ApplySale(integer stoneSold, integer ironSold, integer goldOreSold, integer goldGain, integer tokenGain, integer stoneTokenProgress, integer ironTokenProgress)
    -- Commits a validated sale atomically, restoring in-memory values if saving fails.
    if not self:CanWriteProfile() then return false end
    local profile = self._T.profile
    if stoneSold < 0 or ironSold < 0 or goldOreSold < 0 or goldGain < 0 or tokenGain < 0 then return false end
    if profile.stone < stoneSold or profile.iron < ironSold or profile.goldOre < goldOreSold then return false end
    local snapshot = _HttpService:JSONEncode(profile)
    profile.stone = profile.stone - stoneSold
    profile.iron = profile.iron - ironSold
    profile.goldOre = profile.goldOre - goldOreSold
    profile.gold = profile.gold + goldGain
    profile.mineTokens = profile.mineTokens + tokenGain
    profile.stoneTokenProgress = stoneTokenProgress
    profile.ironTokenProgress = ironTokenProgress
    self:SyncRuntimeState()
    self:MarkProfileDirty()
    if self:SaveProfileAndWait() then
        self:SetTransactionMessage("판매 완료: 골드 +" .. tostring(goldGain) .. ", 토큰 +" .. tostring(tokenGain))
        return true
    end
    self._T.profile = self:NormalizeProfile(_HttpService:JSONDecode(snapshot))
    self:SyncRuntimeState()
    self:SetTransactionMessage("판매 저장에 실패해 되돌렸습니다. 다시 시도해 주세요.")
    return false
end

@ExecSpace("ServerOnly")
method boolean SpendAndUnlock(string mineId, integer goldCost, integer tokenCost, integer stoneCost, integer ironCost)
    -- Deducts one configured mine-unlock cost and persists the resulting flag as one transaction.
    -- 부족 거절 문구는 여기(최종 검증)가 소유한다 — 선검증(ProgressionService)은 문구를 만들지 않는다 (docs/23 §7-1).
    if not self:CanWriteProfile() then return false end
    if mineId ~= "deep_mine" and mineId ~= "gem_mine" then return false end
    local profile = self._T.profile
    if profile.gold < goldCost or profile.mineTokens < tokenCost or profile.stone < stoneCost or profile.iron < ironCost then
        local mineName = "깊은 광산"
        if mineId == "gem_mine" then mineName = "보석 광산" end
        self:SetTransactionMessage(mineName .. " 해금 조건이 부족합니다. " .. self:DescribeShortfall(goldCost, tokenCost, stoneCost, ironCost, 0))
        return false
    end
    local snapshot = _HttpService:JSONEncode(profile)
    profile.gold = profile.gold - goldCost
    profile.mineTokens = profile.mineTokens - tokenCost
    profile.stone = profile.stone - stoneCost
    profile.iron = profile.iron - ironCost
    if mineId == "deep_mine" then profile.deepMineUnlocked = true end
    if mineId == "gem_mine" then profile.gemMineUnlocked = true end
    self:SyncRuntimeState()
    self:MarkProfileDirty()
    if self:SaveProfileAndWait() then
        self:SetTransactionMessage("광산 해금 완료: " .. mineId)
        return true
    end
    self._T.profile = self:NormalizeProfile(_HttpService:JSONDecode(snapshot))
    self:SyncRuntimeState()
    self:SetTransactionMessage("해금 저장에 실패해 비용을 되돌렸습니다. 다시 시도해 주세요.")
    return false
end

@ExecSpace("ServerOnly")
method string MineIdForMapName(string mapName)
    -- 맵 파일명 ↔ 강화 원장 키. 초보 광산만 파일명(farm01)과 mineId 가 다르다.
    if mapName == "farm01" then return "beginner_mine" end
    if mapName == "deep_mine" or mapName == "gem_mine" then return mapName end
    return ""
end

@ExecSpace("ServerOnly")
method string GetMinePrimaryEffect(string mineId)
    -- F7-B §5.2: 광산마다 주 효과만 다르다.
    if mineId == "beginner_mine" then return "yield" end
    if mineId == "deep_mine" then return "recovery" end
    if mineId == "gem_mine" then return "rareChance" end
    return ""
end

@ExecSpace("ServerOnly")
method string GetMineRepresentativeOre(string mineId)
    -- F7-B §3: 대표 광물 정의를 수레 강화·맵 강화·토큰 환산이 공유한다.
    if mineId == "beginner_mine" then return "stone" end
    if mineId == "deep_mine" then return "iron" end
    if mineId == "gem_mine" then return "gold" end
    return ""
end

@ExecSpace("ServerOnly")
method number GetMineBonus(string mineId, string effectKey)
    -- F7-B §5.5: 해당 맵·효과의 누적 보너스 비율 (주 효과 0.00~0.30, 부 효과 0.00~0.10).
    local levels = self._T.profile.mineLevels
    if levels == nil or levels[mineId] == nil then return 0.0 end
    local level = levels[mineId]
    if self:GetMinePrimaryEffect(mineId) == effectKey then
        return level * 0.03
    end
    return level * 0.01
end

@ExecSpace("ServerOnly")
method integer GetMineUpgradeGoldCost(integer currentLevel)
    -- F7-B §5.4: n = L+1, 골드 round(30 × 1.35^(n-1)).
    local n = currentLevel + 1
    return math.floor(30 * (1.35 ^ (n - 1)) + 0.5)
end

@ExecSpace("ServerOnly")
method integer GetMineUpgradeOreCost(integer currentLevel)
    -- F7-B §5.4: 대표 광물 20 × n.
    return 20 * (currentLevel + 1)
end

@ExecSpace("ServerOnly")
method void PushMineBonusesToSimulator()
    -- F7-B §5.5: 시뮬레이터는 매 틱 프로필을 조회하지 않는다. 맵 진입 시와
    -- 강화 성공 시에만 이 메서드가 네 보너스를 캐시로 밀어 넣는다.
    local map = self.Entity.CurrentMap
    if map == nil then return end
    ---@type VeinTickSimulator
    local sim = map:GetComponent("script.VeinTickSimulator")
    if sim == nil then return end
    local mineId = sim.MineId
    sim:ApplyMineBonuses(
        self:GetMineBonus(mineId, "yield"),
        self:GetMineBonus(mineId, "recovery"),
        self:GetMineBonus(mineId, "rareChance"),
        self:GetMineBonus(mineId, "specialSpawn"))
    -- T-07 완화 C3 (F7-E §8): 튜토리얼 1회차 동안 희귀 드롭·특별 광맥 스폰 억제.
    -- 맵 진입·강화 성공·튜토리얼 상태 전환이 전부 이 경로를 지나므로 캐시가
    -- 최신으로 유지된다 (매 틱 프로필 조회 금지 원칙과 같은 구조).
    sim:SetTutorialSuppression(_TutorialService:IsRelaxationActive(self._T.profile))
end

@ExecSpace("ServerOnly")
method void RestoreProfileSnapshot(string snapshot)
    -- T-07: 외부 서비스(TutorialService)의 저장 실패 롤백 창구. 내부 롤백과 같은
    -- NormalizeProfile 경로를 지난다.
    self._T.profile = self:NormalizeProfile(self:DecodeJsonSafely(snapshot))
    self:SyncRuntimeState()
end

@ExecSpace("ServerOnly")
method boolean GrantTutorialDefaultProgram()
    -- F7-E §7: 완료 일괄 보상의 "기본 프로그램 1개" — 4단계에서 배운 왕복 루프를
    -- 무한 반복으로 감싼 ProgramRecord 를 라이브러리에 넣는다. 저장은 호출자
    -- (TutorialService)가 튜토리얼 상태와 함께 원자적으로 수행한다.
    local library = self:GetLibrary()
    if #library.programs >= library.slots then
        log_warning("[AccountProfile] tutorial default program skipped reason=slots-full")
        return false
    end
    local record = {
        programId = "prog-" .. tostring(library.seq),
        name = "기본왕복",
        blockTree = {
            {
                type = "repeat",
                count = "inf",
                body = {
                    { type = "move", dir = "E" },
                    { type = "mine" },
                    { type = "load" },
                    { type = "move", dir = "W" },
                    { type = "unload" },
                },
            },
        },
        dataVersion = 1,
        updatedAt = self:NowStamp(),
        lastValidation = "valid",
    }
    library.seq = library.seq + 1
    table.insert(library.programs, record)
    self:SetLibrary(library)
    log("[AccountProfile] tutorial default program granted id=" .. record.programId)
    return true
end

@ExecSpace("ServerOnly")
method boolean PurchaseMineUpgrade(string mineId, integer goldCost, string oreType, integer oreCost)
    -- F7-B §5.5: 저장 성공 뒤에만 비용 차감과 레벨 증가를 확정한다. 실패 시 롤백.
    if not self:CanWriteProfile() or goldCost < 0 or oreCost < 0 then return false end
    local profile = self._T.profile
    if profile.mineLevels == nil or profile.mineLevels[mineId] == nil then return false end
    local currentLevel = profile.mineLevels[mineId]
    if currentLevel >= 10 then
        -- UPGRADE_MAX_LEVEL (docs/23 §6.1): 차감이 없었음을 명시한다 (B10).
        self:SetTransactionMessage("이미 최대 레벨입니다. 비용은 차감되지 않았습니다.")
        return false
    end
    local oreBalance = 0
    local stoneCost = 0
    local ironCost = 0
    local goldOreCost = 0
    if oreType == "stone" then oreBalance = profile.stone stoneCost = oreCost
    elseif oreType == "iron" then oreBalance = profile.iron ironCost = oreCost
    elseif oreType == "gold" then oreBalance = profile.goldOre goldOreCost = oreCost
    else return false end
    if profile.gold < goldCost or oreBalance < oreCost then
        -- UPGRADE_INSUFFICIENT_FUNDS (docs/23 §6.1): 부족분을 숫자로 (§4.1).
        self:SetTransactionMessage("맵 강화 재화가 부족합니다. " .. self:DescribeShortfall(goldCost, 0, stoneCost, ironCost, goldOreCost))
        return false
    end
    local snapshot = _HttpService:JSONEncode(profile)
    profile.gold = profile.gold - goldCost
    if oreType == "stone" then profile.stone = profile.stone - oreCost
    elseif oreType == "iron" then profile.iron = profile.iron - oreCost
    else profile.goldOre = profile.goldOre - oreCost end
    profile.mineLevels[mineId] = currentLevel + 1
    self:SyncRuntimeState()
    self:MarkProfileDirty()
    if not self:SaveProfileAndWait() then
        self._T.profile = self:NormalizeProfile(self:DecodeJsonSafely(snapshot))
        self:SyncRuntimeState()
        -- UPGRADE_SAVE_FAILED (docs/23 §6.1): 레벨과 비용 모두 롤백했음을 명시.
        self:SetTransactionMessage("맵 강화 저장에 실패해 레벨과 비용을 되돌렸습니다. 다시 시도해 주세요.")
        return false
    end
    -- 강화 성공 시 현재 맵 시뮬레이터에 갱신을 통지한다 (F7-B §5.5).
    self:PushMineBonusesToSimulator()
    self:SetTransactionMessage("맵 강화 완료: Lv." .. tostring(profile.mineLevels[mineId]) .. " / 10")
    log("[AccountProfile] mine upgraded mineId=" .. mineId .. " level=" .. tostring(profile.mineLevels[mineId]) .. " gold=-" .. tostring(goldCost) .. " ore=" .. oreType .. "-" .. tostring(oreCost))
    return true
end

@ExecSpace("ServerOnly")
method string BuildMineUpgradeInfoJson()
    -- F7-B §5.6.5: 현재 입장 광산의 표기 계약. 전부 서버 계산값이며 클라이언트는
    -- 재계산하지 않는다 (버림·만분율·하한 때문 — §5.6.3).
    local mineId = self:MineIdForMapName(self._T.profile.lastMineId)
    if mineId == "" then return "" end
    local level = self._T.profile.mineLevels[mineId]
    local nextLevel = math.min(10, level + 1)
    local isMax = level >= 10
    local rareIronPct = self._T.profile.rareCollection.rare_iron * 3
    local primary = self:GetMinePrimaryEffect(mineId)

    local info = { mineId = mineId, level = level, maxLevel = isMax, primaryEffect = primary }
    local effectKeys = { "yield", "recovery", "rareChance", "specialSpawn" }
    for i = 1, #effectKeys do
        local key = effectKeys[i]
        local perLevel = 1
        if primary == key then perLevel = 3 end
        info[key .. "NowPct"] = perLevel * level
        info[key .. "NextPct"] = perLevel * nextLevel
    end
    -- recovery: 희귀 철 패시브와 가산 합성한 최종 배율 (C198, §5.6.4).
    info.recoveryMultiplierNow = 1.0 + (rareIronPct + info.recoveryNowPct) / 100
    info.recoveryMultiplierNext = 1.0 + (rareIronPct + info.recoveryNextPct) / 100
    -- rareChance: 적용 후 만분율 (§5.3). 기본 일반 100bp / 특별 500bp.
    info.rareBpNow = math.floor(100 * (1 + info.rareChanceNowPct / 100))
    info.rareBpNext = math.floor(100 * (1 + info.rareChanceNextPct / 100))
    info.rareSpecialBpNow = math.floor(500 * (1 + info.rareChanceNowPct / 100))
    info.rareSpecialBpNext = math.floor(500 * (1 + info.rareChanceNextPct / 100))
    -- specialSpawn: effectiveSpawnTicks = max(60, floor(750 / (1 + 보너스))) (§5.3 · C200).
    info.specialTicksNow = math.max(60, math.floor(750 / (1 + info.specialSpawnNowPct / 100)))
    info.specialTicksNext = math.max(60, math.floor(750 / (1 + info.specialSpawnNextPct / 100)))
    if isMax then
        info.nextCostGold = 0
        info.nextCostOreType = ""
        info.nextCostOre = 0
    else
        info.nextCostGold = self:GetMineUpgradeGoldCost(level)
        info.nextCostOreType = self:GetMineRepresentativeOre(mineId)
        info.nextCostOre = self:GetMineUpgradeOreCost(level)
    end
    return _HttpService:JSONEncode(info)
end

@ExecSpace("ServerOnly")
method table GetLibrary()
    -- F7-C §1: 계정 공용 라이브러리. profile.programLibraryJson(문자열) 을 정규화해
    -- 돌려준다 — 초기 3슬롯 / 최대 20, ProgramRecord 배열.
    local decoded = self:DecodeJsonSafely(self._T.profile.programLibraryJson or "")
    local library = { slots = 3, seq = 1, programs = {} }
    if type(decoded) ~= "table" then return library end
    if type(decoded.slots) == "number" then library.slots = math.max(3, math.min(20, math.floor(decoded.slots))) end
    if type(decoded.seq) == "number" then library.seq = math.max(1, math.floor(decoded.seq)) end
    if type(decoded.programs) == "table" then
        for i = 1, #decoded.programs do
            local record = decoded.programs[i]
            if type(record) == "table" and type(record.programId) == "string" and record.programId ~= "" and type(record.name) == "string" then
                table.insert(library.programs, {
                    programId = record.programId,
                    name = record.name,
                    blockTree = record.blockTree,
                    dataVersion = record.dataVersion or 1,
                    updatedAt = record.updatedAt or "",
                    lastValidation = record.lastValidation or "unknown",
                })
            end
        end
    end
    return library
end

@ExecSpace("ServerOnly")
method void SetLibrary(table library)
    self._T.profile.programLibraryJson = _HttpService:JSONEncode(library)
end

@ExecSpace("ServerOnly")
method string NowStamp()
    -- 수정일 표시용 "YYYY-MM-DD HH:MM". 서버 UTC 기준.
    local now = DateTime.UtcNow
    return string.format("%04d-%02d-%02d %02d:%02d", now.Year, now.Month, now.Day, now.Hour, now.Minute)
end

@ExecSpace("ServerOnly")
method integer GetProgramNameLength(string name)
    -- UTF-8 문자 수. 한글 1글자 = 1로 센다.
    local count = 0
    for _ in string.gmatch(name, "[%z\1-\127\194-\244][\128-\191]*") do count = count + 1 end
    return count
end

@ExecSpace("ServerOnly")
method string ValidateProgramName(string name)
    -- F7-C §1: 한글/영문/숫자 최대 12자. 위반 사유를 구체적으로 돌려준다 (docs/23 §6.2).
    if name == nil or name == "" then return "이름을 입력해 주세요." end
    local length = self:GetProgramNameLength(name)
    if length > 12 then return "이름은 최대 12자입니다. (현재 " .. tostring(length) .. "자)" end
    for ch in string.gmatch(name, "[%z\1-\127\194-\244][\128-\191]*") do
        if #ch == 1 then
            if not string.match(ch, "[%w]") then
                return "이름에는 한글·영문·숫자만 쓸 수 있습니다. ('" .. ch .. "' 제외)"
            end
        end
    end
    return ""
end

@ExecSpace("ServerOnly")
method integer GetNextSlotCost(integer currentSlots)
    -- 4번째 슬롯부터 구매. 비용은 직전 비용의 1.2배 (C174). 기본 50골드는 제안값.
    local cost = self.LibrarySlotBaseCost
    for i = 4, currentSlots do cost = math.floor(cost * 1.2 + 0.5) end
    return cost
end

@ExecSpace("ServerOnly")
method any FindProgram(table library, string programId)
    for i = 1, #library.programs do
        if library.programs[i].programId == programId then return library.programs[i] end
    end
    return nil
end

@ExecSpace("ServerOnly")
method string SuggestProgramFix(string validationError)
    -- LIB_PROGRAM_INVALID (docs/23 §6.2): 자동 수정하지 않고 문제와 수정안을 제시한다.
    if string.find(validationError, "block limit", 1, true) then return "블록 수가 30개를 넘습니다. 블록을 줄여 주세요." end
    if string.find(validationError, "depth limit", 1, true) then return "제어 블록 중첩이 3단계를 넘습니다. 중첩을 줄여 주세요." end
    if string.find(validationError, "infinite repeat", 1, true) then return "무한 반복은 최상위에 1개만 둘 수 있습니다." end
    if string.find(validationError, "invalid repeat", 1, true) then return "반복 횟수는 2~99 사이 정수여야 합니다." end
    return "블록 구성을 확인해 주세요. (" .. tostring(validationError) .. ")"
end

@ExecSpace("ServerOnly")
method any GetProgramValidator()
    -- 서버 최종 검증은 WorkerController 가 소유한다 (F7-C §1). 맵의 일꾼 1을 쓴다.
    return self:GetWorkerByIndex(1)
end

@ExecSpace("ServerOnly")
method boolean SaveProgramToLibrary(string name, string programJson)
    if not self:CanWriteProfile() then return false end
    local nameError = self:ValidateProgramName(name)
    if nameError ~= "" then
        self:SetTransactionMessage("저장할 수 없습니다: " .. nameError)
        return false
    end
    local library = self:GetLibrary()
    if #library.programs >= library.slots then
        -- LIB_SLOT_FULL: 확장 비용을 함께 안내 (docs/23 §6.2).
        if library.slots >= 20 then
            self:SetTransactionMessage("슬롯이 가득 찼습니다. (최대 20개)")
        else
            self:SetTransactionMessage("슬롯이 가득 찼습니다. (" .. tostring(library.slots) .. "개) 다음 슬롯 비용: 골드 " .. tostring(self:GetNextSlotCost(library.slots)))
        end
        return false
    end
    local program = self:DecodeJsonSafely(programJson)
    if type(program) ~= "table" or #program == 0 then
        self:SetTransactionMessage("저장할 블록이 없습니다.")
        return false
    end
    ---@type WorkerController
    local validator = self:GetProgramValidator()
    if validator == nil then
        log_error("[AccountProfile] program validator missing (Worker01 not found)")
        self:SetTransactionMessage("요청을 처리하지 못했습니다.")
        return false
    end
    if not validator:ValidateProgram(program) then
        self:SetTransactionMessage("저장할 수 없습니다: " .. self:SuggestProgramFix(validator:GetLastValidationError()))
        return false
    end
    local snapshot = _HttpService:JSONEncode(self._T.profile)
    local record = {
        programId = "prog-" .. tostring(library.seq),
        name = name,
        blockTree = program,
        dataVersion = 1,
        updatedAt = self:NowStamp(),
        lastValidation = "valid",
    }
    library.seq = library.seq + 1
    table.insert(library.programs, record)
    self:SetLibrary(library)
    self:SyncRuntimeState()
    self:MarkProfileDirty()
    if not self:SaveProfileAndWait() then
        self._T.profile = self:NormalizeProfile(self:DecodeJsonSafely(snapshot))
        self:SyncRuntimeState()
        self:SetTransactionMessage("프로그램 저장에 실패해 되돌렸습니다. 다시 시도해 주세요.")
        return false
    end
    self:SetTransactionMessage("프로그램 '" .. name .. "' 저장 완료 (" .. tostring(#library.programs) .. "/" .. tostring(library.slots) .. " 슬롯)")
    log("[AccountProfile] program saved id=" .. record.programId .. " name=" .. name)
    return true
end

@ExecSpace("ServerOnly")
method boolean RenameProgram(string programId, string newName)
    if not self:CanWriteProfile() then return false end
    local nameError = self:ValidateProgramName(newName)
    if nameError ~= "" then
        self:SetTransactionMessage("이름을 바꿀 수 없습니다: " .. nameError)
        return false
    end
    local library = self:GetLibrary()
    local record = self:FindProgram(library, programId)
    if record == nil then
        self:SetTransactionMessage("요청을 처리하지 못했습니다.")
        log_error("[AccountProfile] rename target missing id=" .. tostring(programId))
        return false
    end
    local snapshot = _HttpService:JSONEncode(self._T.profile)
    record.name = newName
    record.updatedAt = self:NowStamp()
    self:SetLibrary(library)
    self:SyncRuntimeState()
    self:MarkProfileDirty()
    if not self:SaveProfileAndWait() then
        self._T.profile = self:NormalizeProfile(self:DecodeJsonSafely(snapshot))
        self:SyncRuntimeState()
        self:SetTransactionMessage("이름 변경 저장에 실패해 되돌렸습니다. 다시 시도해 주세요.")
        return false
    end
    self:SetTransactionMessage("이름을 '" .. newName .. "'(으)로 바꿨습니다.")
    return true
end

@ExecSpace("ServerOnly")
method boolean DuplicateProgram(string programId)
    if not self:CanWriteProfile() then return false end
    local library = self:GetLibrary()
    if #library.programs >= library.slots then
        if library.slots >= 20 then
            self:SetTransactionMessage("슬롯이 가득 찼습니다. (최대 20개)")
        else
            self:SetTransactionMessage("슬롯이 가득 찼습니다. (" .. tostring(library.slots) .. "개) 다음 슬롯 비용: 골드 " .. tostring(self:GetNextSlotCost(library.slots)))
        end
        return false
    end
    local record = self:FindProgram(library, programId)
    if record == nil then
        self:SetTransactionMessage("요청을 처리하지 못했습니다.")
        log_error("[AccountProfile] duplicate target missing id=" .. tostring(programId))
        return false
    end
    local snapshot = _HttpService:JSONEncode(self._T.profile)
    -- 이름 12자 제한 안에서 복제 표식을 붙인다.
    local copyName = record.name
    if self:GetProgramNameLength(copyName) > 10 then
        local trimmed = ""
        local count = 0
        for ch in string.gmatch(copyName, "[%z\1-\127\194-\244][\128-\191]*") do
            count = count + 1
            if count > 10 then break end
            trimmed = trimmed .. ch
        end
        copyName = trimmed
    end
    copyName = copyName .. "사본"
    local copy = {
        programId = "prog-" .. tostring(library.seq),
        name = copyName,
        blockTree = self:DecodeJsonSafely(_HttpService:JSONEncode(record.blockTree)),
        dataVersion = record.dataVersion,
        updatedAt = self:NowStamp(),
        lastValidation = record.lastValidation,
    }
    library.seq = library.seq + 1
    table.insert(library.programs, copy)
    self:SetLibrary(library)
    self:SyncRuntimeState()
    self:MarkProfileDirty()
    if not self:SaveProfileAndWait() then
        self._T.profile = self:NormalizeProfile(self:DecodeJsonSafely(snapshot))
        self:SyncRuntimeState()
        self:SetTransactionMessage("복제 저장에 실패해 되돌렸습니다. 다시 시도해 주세요.")
        return false
    end
    self:SetTransactionMessage("'" .. record.name .. "'을(를) 복제했습니다.")
    return true
end

@ExecSpace("ServerOnly")
method boolean DeleteProgram(string programId)
    if not self:CanWriteProfile() then return false end
    local library = self:GetLibrary()
    local removed = false
    for i = #library.programs, 1, -1 do
        if library.programs[i].programId == programId then
            table.remove(library.programs, i)
            removed = true
        end
    end
    if not removed then
        self:SetTransactionMessage("요청을 처리하지 못했습니다.")
        log_error("[AccountProfile] delete target missing id=" .. tostring(programId))
        return false
    end
    local snapshot = _HttpService:JSONEncode(self._T.profile)
    self:SetLibrary(library)
    self:SyncRuntimeState()
    self:MarkProfileDirty()
    if not self:SaveProfileAndWait() then
        self._T.profile = self:NormalizeProfile(self:DecodeJsonSafely(snapshot))
        self:SyncRuntimeState()
        self:SetTransactionMessage("삭제 저장에 실패해 되돌렸습니다. 다시 시도해 주세요.")
        return false
    end
    self:SetTransactionMessage("프로그램을 삭제했습니다. (" .. tostring(#library.programs) .. "/" .. tostring(library.slots) .. " 슬롯)")
    return true
end

@ExecSpace("ServerOnly")
method boolean PurchaseLibrarySlot()
    if not self:CanWriteProfile() then return false end
    local library = self:GetLibrary()
    if library.slots >= 20 then
        self:SetTransactionMessage("슬롯은 최대 20개입니다. 비용은 차감되지 않았습니다.")
        return false
    end
    local cost = self:GetNextSlotCost(library.slots)
    local profile = self._T.profile
    if profile.gold < cost then
        -- LIB_SLOT_PURCHASE_FUNDS: 부족분을 숫자로 (docs/23 §4.1).
        self:SetTransactionMessage("슬롯 구매 골드가 부족합니다. " .. self:DescribeShortfall(cost, 0, 0, 0, 0))
        return false
    end
    local snapshot = _HttpService:JSONEncode(profile)
    profile.gold = profile.gold - cost
    library.slots = library.slots + 1
    self:SetLibrary(library)
    self:SyncRuntimeState()
    self:MarkProfileDirty()
    if not self:SaveProfileAndWait() then
        self._T.profile = self:NormalizeProfile(self:DecodeJsonSafely(snapshot))
        self:SyncRuntimeState()
        self:SetTransactionMessage("슬롯 구매 저장에 실패해 비용을 되돌렸습니다. 다시 시도해 주세요.")
        return false
    end
    self:SetTransactionMessage("슬롯을 " .. tostring(library.slots) .. "개로 늘렸습니다. (골드 -" .. tostring(cost) .. ")")
    log("[AccountProfile] library slot purchased slots=" .. tostring(library.slots) .. " cost=" .. tostring(cost))
    return true
end

@ExecSpace("ServerOnly")
method void RecordWorkerProgram(integer workerIndex, string programJson)
    -- F7-C §1: 서버 최종 검증을 통과한 프로그램만 이 경로로 들어온다.
    -- 즉시 저장하지 않고 자동 저장 배치에 맡긴다 (§3 "참조만 계정에 저장").
    if not self:CanWriteProfile() then return end
    local record = self._T.profile.workers[workerIndex]
    if record == nil then return end
    record.lastValidProgramJson = programJson
    self:MarkProfileDirty()
end

@ExecSpace("ServerOnly")
method void AutoRunSavedPrograms()
    -- F7-C §3 재접속: 각 보유 일꾼의 마지막 유효 프로그램을 처음부터 자동 실행.
    -- 무효/손상 프로그램은 실행하지 않고 Idle 유지 + 안내 (§4: 자동 수정 금지).
    if not self:CanWriteProfile() then return end
    -- T-07: 튜토리얼 1회차 진행 중에는 자동 실행하지 않는다. 자동 실행이 일꾼을
    -- 움직여 단계 판정 신호를 오염시킨다 (검증 중 실제로 1단계가 저절로 통과됐다).
    if _TutorialService:IsRelaxationActive(self._T.profile) then
        log("[AccountProfile] auto-run skipped reason=tutorial-active step=" .. tostring(self._T.profile.tutorial.step))
        return
    end
    local ranCount = 0
    local invalidCount = 0
    for workerIndex = 1, #self._T.profile.workers do
        local record = self._T.profile.workers[workerIndex]
        if record ~= nil and type(record.lastValidProgramJson) == "string" and record.lastValidProgramJson ~= "" then
            ---@type WorkerController
            local worker = self:GetWorkerByIndex(workerIndex)
            if worker ~= nil then
                local program = self:DecodeJsonSafely(record.lastValidProgramJson)
                if type(program) == "table" and #program > 0 and worker:ValidateProgram(program) then
                    worker:RunProgram(program)
                    ranCount = ranCount + 1
                else
                    invalidCount = invalidCount + 1
                    log_warning("[AccountProfile] saved program invalid worker=" .. tostring(workerIndex) .. " - staying Idle")
                end
            end
        end
    end
    if invalidCount > 0 then
        self:SetTransactionMessage("저장된 프로그램 " .. tostring(invalidCount) .. "개가 유효하지 않아 자동 실행하지 않았습니다. 편집기에서 내용을 확인해 주세요.")
    end
    log("[AccountProfile] auto-run complete ran=" .. tostring(ranCount) .. " invalid=" .. tostring(invalidCount))
end

