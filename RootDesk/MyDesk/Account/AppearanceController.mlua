@ExecSpace("ClientOnly")
method void OnBeginPlay()
    self._T.handlers = {}
    self._T.handlerButtons = {}
    self._T.selectedWorker = 1
    self._T.selectedPart = "hair"
    self._T.selectedPieceId = ""
    self._T.visiblePieces = {}
    self._T.lastState = ""
    self._T.lastResultSequence = 0
    self._T.messageAtOpen = ""
    if self.appearancePanel ~= nil then self.appearancePanel.Enable = false end
    if self.pityPanel ~= nil then self.pityPanel.Enable = false end
    if self.resultPanel ~= nil then self.resultPanel.Enable = false end

    self:Connect("open", self.btnOpen, self.OnOpenClicked)
    self:Connect("close", self.btnClose, self.OnCloseClicked)
    self:Connect("equip", self.btnEquip, self.OnEquipClicked)
    self:Connect("default", self.btnDefault, self.OnDefaultClicked)
    self:Connect("gacha", self.btnGacha, self.OnGachaClicked)
    self:Connect("craft", self.btnCraft, self.OnCraftClicked)
    self:Connect("exchange1", self.btnExchange1, self.OnExchange1Clicked)
    self:Connect("exchange10", self.btnExchange10, self.OnExchange10Clicked)
    self:Connect("resultClose", self.btnResultClose, self.OnResultCloseClicked)
    self:Connect("worker1", self.worker1, function() self:SelectWorker(1) end)
    self:Connect("worker2", self.worker2, function() self:SelectWorker(2) end)
    self:Connect("worker3", self.worker3, function() self:SelectWorker(3) end)
    self:Connect("worker4", self.worker4, function() self:SelectWorker(4) end)
    self:Connect("worker5", self.worker5, function() self:SelectWorker(5) end)
    self:Connect("partHair", self.partHair, function() self:SelectPart("hair") end)
    self:Connect("partFace", self.partFace, function() self:SelectPart("face") end)
    self:Connect("partOutfit", self.partOutfit, function() self:SelectPart("outfit") end)
    self:Connect("pityHair", self.pityHair, function() self:ClaimPity("hair") end)
    self:Connect("pityFace", self.pityFace, function() self:ClaimPity("face") end)
    self:Connect("pityOutfit", self.pityOutfit, function() self:ClaimPity("outfit") end)
    for index = 1, 10 do
        local capturedIndex = index
        local slot = self:GetSlotButton(index)
        self:Connect("slot" .. tostring(index), slot, function() self:SelectSlot(capturedIndex) end)
    end
    log("[AppearanceUI] ready")
end

@ExecSpace("ClientOnly")
method void Connect(string key, ButtonComponent button, any callback)
    if button == nil then return end
    self._T.handlers[key] = button.Entity:ConnectEvent(ButtonClickEvent, callback)
    self._T.handlerButtons[key] = button
end

@ExecSpace("ClientOnly")
method any GetProfile()
    -- Returns the local player's profile component without an unsupported concrete return cast.
    local player = _UserService.LocalPlayer
    if player == nil then return nil end
    ---@type AccountProfileService
    return player:GetComponent("script.AccountProfileService")
end

@ExecSpace("ClientOnly")
method table GetInfo(AccountProfileService profile)
    if profile == nil or profile.AppearanceInfoJson == "" then return {} end
    local ok, data = pcall(function() return _HttpService:JSONDecode(profile.AppearanceInfoJson) end)
    if not ok or type(data) ~= "table" then return {} end
    return data
end

@ExecSpace("ClientOnly")
method void OnUpdate(number delta)
    if self.appearancePanel == nil or not self.appearancePanel.Enable then return end
    local profile = self:GetProfile()
    if profile == nil then return end
    local state = profile.AppearanceInfoJson .. ":" .. profile.LastTransactionMessage .. ":" .. tostring(self._T.selectedWorker) .. ":" .. self._T.selectedPart .. ":" .. self._T.selectedPieceId
    if state == self._T.lastState then return end
    self._T.lastState = state
    self:Refresh(profile)
end

@ExecSpace("ClientOnly")
method void OnOpenClicked()
    if self.appearancePanel == nil then return end
    if self.appearancePanel.Enable then self:ClosePanel() return end
    if _MineSelectController ~= nil then _MineSelectController:CloseAllPanelsForTutorial() end
    if _MineInventoryController ~= nil then _MineInventoryController:OnCloseClicked() end
    if _SettingsPanelController ~= nil then _SettingsPanelController:ClosePanel() end
    if _ProgramLibraryController ~= nil then _ProgramLibraryController:OnCloseClicked() end
    local profile = self:GetProfile()
    self._T.messageAtOpen = profile ~= nil and profile.LastTransactionMessage or ""
    self._T.lastState = ""
    self.appearancePanel.Enable = true
    if profile ~= nil then self:Refresh(profile) end
    log("[AppearanceUI] opened")
end

@ExecSpace("ClientOnly")
method void OnCloseClicked()
    self:ClosePanel()
end

@ExecSpace("ClientOnly")
method void ClosePanel()
    if self.appearancePanel ~= nil then self.appearancePanel.Enable = false end
    if self.pityPanel ~= nil then self.pityPanel.Enable = false end
    if self.resultPanel ~= nil then self.resultPanel.Enable = false end
end

@ExecSpace("ClientOnly")
method void SelectWorker(integer workerIndex)
    local profile = self:GetProfile()
    local info = self:GetInfo(profile)
    if workerIndex < 1 or workerIndex > (info.ownedWorkerCount or 0) then return end
    self._T.selectedWorker = workerIndex
    self._T.selectedPieceId = ""
    self._T.lastState = ""
end

@ExecSpace("ClientOnly")
method void SelectPart(string part)
    self._T.selectedPart = part
    self._T.selectedPieceId = ""
    self._T.lastState = ""
end

@ExecSpace("ClientOnly")
method void SelectSlot(integer index)
    local piece = self._T.visiblePieces[index]
    if piece == nil then return end
    self._T.selectedPieceId = piece.id
    self._T.lastState = ""
end

@ExecSpace("ClientOnly")
method void OnEquipClicked()
    local profile = self:GetProfile()
    if profile == nil or self._T.selectedPieceId == "" then return end
    profile:RequestEquipPiece(self._T.selectedWorker, self._T.selectedPart, self._T.selectedPieceId)
end

@ExecSpace("ClientOnly")
method void OnDefaultClicked()
    local profile = self:GetProfile()
    if profile ~= nil then profile:RequestEquipPiece(self._T.selectedWorker, self._T.selectedPart, "") end
end

@ExecSpace("ClientOnly")
method void OnGachaClicked()
    local profile = self:GetProfile()
    if profile ~= nil then profile:RequestGachaPull(self._T.selectedPart) end
end

@ExecSpace("ClientOnly")
method void OnCraftClicked()
    local profile = self:GetProfile()
    if profile ~= nil then profile:RequestCraft(self._T.selectedPart) end
end

@ExecSpace("ClientOnly")
method void OnExchange1Clicked()
    local profile = self:GetProfile()
    if profile ~= nil then profile:RequestCrystalExchange(1) end
end

@ExecSpace("ClientOnly")
method void OnExchange10Clicked()
    local profile = self:GetProfile()
    if profile ~= nil then profile:RequestCrystalExchange(10) end
end

@ExecSpace("ClientOnly")
method void ClaimPity(string part)
    local profile = self:GetProfile()
    if profile ~= nil then profile:RequestPityClaim(part) end
end

@ExecSpace("ClientOnly")
method void OnResultCloseClicked()
    if self.resultPanel ~= nil then self.resultPanel.Enable = false end
end

@ExecSpace("ClientOnly")
method void Refresh(AccountProfileService profile)
    local info = self:GetInfo(profile)
    if type(info.pieces) ~= "table" then return end
    if self._T.selectedWorker > (info.ownedWorkerCount or 1) then self._T.selectedWorker = 1 end
    self:RefreshWorkerTabs(info.ownedWorkerCount or 1)
    self:RefreshSlots(info)
    self:RefreshSummary(info, profile)
    if self.pityPanel ~= nil then self.pityPanel.Enable = info.pity ~= nil and info.pity.pending == true end
    self:RefreshResult(info)
end

@ExecSpace("ClientOnly")
method void RefreshWorkerTabs(integer ownedCount)
    for index = 1, 5 do
        local button = self:GetWorkerButton(index)
        if button ~= nil then button.Enable = index <= ownedCount end
    end
end

@ExecSpace("ClientOnly")
method void RefreshSlots(table info)
    self._T.visiblePieces = {}
    for _, piece in ipairs(info.pieces) do
        if piece.part == self._T.selectedPart then table.insert(self._T.visiblePieces, piece) end
    end
    local equippedId = ""
    local workerRecord = info.equipped ~= nil and info.equipped[tostring(self._T.selectedWorker)] or nil
    if workerRecord ~= nil then equippedId = workerRecord[self._T.selectedPart] or "" end
    for index = 1, 10 do
        local piece = self._T.visiblePieces[index]
        local button = self:GetSlotButton(index)
        local image = self:GetSlotImage(index)
        local rarity = self:GetRarityImage(index)
        local rarityText = self:GetRarityText(index)
        local equipped = self:GetEquipped(index)
        if button ~= nil then button.Enable = piece ~= nil end
        if image ~= nil then image.ImageRUID = piece ~= nil and piece.thumbnailRuid ~= "" and ("thumbnail://" .. piece.thumbnailRuid) or "" end
        if rarity ~= nil then rarity.ImageRUID = piece ~= nil and self:RarityBadge(piece.rarity) or "" end
        if rarityText ~= nil then rarityText.Text = piece ~= nil and piece.rarityLabel or "" end
        if equipped ~= nil then equipped.Enable = piece ~= nil and piece.id == equippedId end
    end
end

@ExecSpace("ClientOnly")
method void RefreshSummary(table info, AccountProfileService profile)
    local collection = info.collection or {}
    local pity = info.pity or {}
    local costs = info.costs or {}
    local probabilities = info.probabilities or {}
    if self.collectionText ~= nil then
        self.collectionText.Text = "도감 " .. tostring(collection.score or 0) .. "/" .. tostring(collection.maxScore or 72)
            .. "  다음 " .. tostring(collection.nextThreshold or 72) .. "  수레 +" .. tostring(collection.cartBonus or 0)
    end
    if self.pityText ~= nil then self.pityText.Text = "천장 " .. tostring(pity.counter or 0) .. "/" .. tostring(pity.max or 50) end
    if self.costText ~= nil then
        self.costText.Text = "뽑기 크리스탈 " .. tostring(costs.gachaCrystal or 0)
            .. "  | 제작 돌 " .. tostring(costs.craftStone or 0) .. " / 철 " .. tostring(costs.craftIron or 0) .. " / 금 " .. tostring(costs.craftGoldOre or 0)
            .. "  | 교환 1개=" .. tostring(costs.exchangeGoldPerCrystal or 0) .. "골드"
    end
    if self.probabilityText ~= nil then
        self.probabilityText.Text = "일반 " .. tostring(probabilities.commonLabel or "") .. " · 고급 " .. tostring(probabilities.uncommonLabel or "")
            .. " · 희귀 " .. tostring(probabilities.rareLabel or "") .. " · 영웅 " .. tostring(probabilities.epicLabel or "") .. " · 전설 " .. tostring(probabilities.legendaryLabel or "")
    end
    local selected = self:FindPiece(info, self._T.selectedPieceId)
    if self.selectedText ~= nil then
        local line = "피스를 선택하세요. 슬롯 선택만으로는 저장되지 않습니다."
        if selected ~= nil then line = selected.name .. "  [" .. selected.rarityLabel .. "]  " .. (selected.owned and "보유" or "미보유") .. "  도감 +" .. tostring(selected.score) end
        if profile.LastTransactionMessage ~= self._T.messageAtOpen and profile.LastTransactionMessage ~= "" then
            line = line .. "  |  " .. profile.LastTransactionMessage
        end
        self.selectedText.Text = line
    end
    if self.btnEquip ~= nil then self.btnEquip.Enable = selected ~= nil and selected.owned == true end
end

@ExecSpace("ClientOnly")
method void RefreshResult(table info)
    local result = info.lastResult
    if type(result) ~= "table" or (result.sequence or 0) <= self._T.lastResultSequence then return end
    self._T.lastResultSequence = result.sequence
    if result.pieceId == "" then return end
    local piece = self:FindPiece(info, result.pieceId)
    if piece == nil then return end
    if self.resultText ~= nil then
        local tail = result.isNew and "새 외형 획득!" or ("중복 전환 골드 +" .. tostring(result.duplicateGold or 0))
        self.resultText.Text = piece.name .. "\n" .. piece.rarityLabel .. " · " .. tail
    end
    if self.resultPanel ~= nil then self.resultPanel.Enable = true end
end

@ExecSpace("ClientOnly")
method any FindPiece(table info, string pieceId)
    if pieceId == "" then return nil end
    for _, piece in ipairs(info.pieces) do if piece.id == pieceId then return piece end end
    return nil
end

@ExecSpace("ClientOnly")
method string RarityBadge(string rarity)
    if rarity == "common" then return "08ebbf2be1de4081972380e119c9d3af" end
    if rarity == "uncommon" then return "af19b1b6961a424bbf0187d304553441" end
    if rarity == "rare" then return "3c34787ff2e44d7e99036d07ebcaaba8" end
    if rarity == "epic" then return "7745e36e8a9a47b08bffc194f071b91b" end
    if rarity == "legendary" then return "0cb30501bd6b4d24b4f54c5d6245c48e" end
    return ""
end

@ExecSpace("ClientOnly")
method ButtonComponent GetWorkerButton(integer index)
    if index == 1 then return self.worker1 elseif index == 2 then return self.worker2 elseif index == 3 then return self.worker3 elseif index == 4 then return self.worker4 else return self.worker5 end
end

@ExecSpace("ClientOnly")
method ButtonComponent GetSlotButton(integer index)
    if index == 1 then return self.slot1 elseif index == 2 then return self.slot2 elseif index == 3 then return self.slot3 elseif index == 4 then return self.slot4 elseif index == 5 then return self.slot5 elseif index == 6 then return self.slot6 elseif index == 7 then return self.slot7 elseif index == 8 then return self.slot8 elseif index == 9 then return self.slot9 else return self.slot10 end
end

@ExecSpace("ClientOnly")
method SpriteGUIRendererComponent GetSlotImage(integer index)
    if index == 1 then return self.slotImage1 elseif index == 2 then return self.slotImage2 elseif index == 3 then return self.slotImage3 elseif index == 4 then return self.slotImage4 elseif index == 5 then return self.slotImage5 elseif index == 6 then return self.slotImage6 elseif index == 7 then return self.slotImage7 elseif index == 8 then return self.slotImage8 elseif index == 9 then return self.slotImage9 else return self.slotImage10 end
end

@ExecSpace("ClientOnly")
method SpriteGUIRendererComponent GetRarityImage(integer index)
    if index == 1 then return self.rarity1 elseif index == 2 then return self.rarity2 elseif index == 3 then return self.rarity3 elseif index == 4 then return self.rarity4 elseif index == 5 then return self.rarity5 elseif index == 6 then return self.rarity6 elseif index == 7 then return self.rarity7 elseif index == 8 then return self.rarity8 elseif index == 9 then return self.rarity9 else return self.rarity10 end
end

@ExecSpace("ClientOnly")
method TextGUIRendererComponent GetRarityText(integer index)
    if index == 1 then return self.rarityText1 elseif index == 2 then return self.rarityText2 elseif index == 3 then return self.rarityText3 elseif index == 4 then return self.rarityText4 elseif index == 5 then return self.rarityText5 elseif index == 6 then return self.rarityText6 elseif index == 7 then return self.rarityText7 elseif index == 8 then return self.rarityText8 elseif index == 9 then return self.rarityText9 else return self.rarityText10 end
end

@ExecSpace("ClientOnly")
method Entity GetEquipped(integer index)
    if index == 1 then return self.equipped1 elseif index == 2 then return self.equipped2 elseif index == 3 then return self.equipped3 elseif index == 4 then return self.equipped4 elseif index == 5 then return self.equipped5 elseif index == 6 then return self.equipped6 elseif index == 7 then return self.equipped7 elseif index == 8 then return self.equipped8 elseif index == 9 then return self.equipped9 else return self.equipped10 end
end

@ExecSpace("ClientOnly")
method void OnEndPlay()
    -- Disconnects every UI button handler registered during begin-play.
    if self._T.handlers == nil then return end
    for key, eventHandler in pairs(self._T.handlers) do
        local button = self._T.handlerButtons[key]
        if button ~= nil and eventHandler ~= nil then button.Entity:DisconnectEvent(ButtonClickEvent, eventHandler) end
    end
end

end
