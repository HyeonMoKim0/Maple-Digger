-- F7-B CLIENT MINE SELECTOR
-- This UI only renders synchronized account state and sends requests through
-- AccountProfileService. Costs, sales, unlocks, and movement stay server-owned.
@Logic
script MineSelectController extends Logic

property Entity selectPanel = "20cb4dbc-1e9a-42f4-a237-549a3a3edf41"
property ButtonComponent btnOpen = "94c58c02-b4ac-4901-b9b7-0f02e69568c9"
