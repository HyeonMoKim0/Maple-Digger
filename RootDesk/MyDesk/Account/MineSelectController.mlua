@ExecSpace("ClientOnly")
method string GetRareSummary(AccountProfileService profile)
    local stoneStatus = "잠금"
    local ironStatus = "잠금"
    local goldStatus = "잠금"
    if profile.RareStoneCollectionLevel >= 10 then stoneStatus = "판매 가능" end
    if profile.RareIronCollectionLevel >= 10 then ironStatus = "판매 가능" end
    if profile.RareGoldCollectionLevel >= 10 then goldStatus = "판매 가능" end

    local stoneAuto = "꺼짐"
    local ironAuto = "꺼짐"
    local goldAuto = "꺼짐"
    if profile.RareStoneAutoSell then stoneAuto = "켜짐" end
    if profile.RareIronAutoSell then ironAuto = "켜짐" end
    if profile.RareGoldAutoSell then goldAuto = "켜짐" end

    return "희귀 컬렉션: 돌 " .. tostring(profile.RareStoneCollectionLevel) .. "/10 (보관 " .. tostring(profile.RareStoneStored) .. ") · 철 " .. tostring(profile.RareIronCollectionLevel) .. "/10 (보관 " .. tostring(profile.RareIronStored) .. ") · 금 " .. tostring(profile.RareGoldCollectionLevel) .. "/10 (보관 " .. tostring(profile.RareGoldStored) .. ")\n10단계 전 판매·자동 판매 잠금 | 돌 " .. stoneStatus .. "/" .. stoneAuto .. " · 철 " .. ironStatus .. "/" .. ironAuto .. " · 금 " .. goldStatus .. "/" .. goldAuto
end

@ExecSpace("ClientOnly")
method void OnCartOpenClicked()
    -- One centre modal at a time (docs/08 §6.1, docs/16 §13 D-8).
    if self.selectPanel ~= nil then self.selectPanel.Enable = false end
    if self.salePanel ~= nil then self.salePanel.Enable = false end
    if self.rarePanel ~= nil then self.rarePanel.Enable = false end
    if self.upgradePanel ~= nil then self.upgradePanel.Enable = false end
    if self.cartPanel ~= nil then self.cartPanel.Enable = true end
    self._T.cartWorkerIndex = 1
    self:RefreshUI(true)
end

@ExecSpace("ClientOnly")
method void OnUpgradeOpenClicked()
    -- ⚠ T-15 개정 후 UI 진입점이 없다 — [광산 강화]는 TryOpenUpgrade 의 확인
    -- 팝업으로 직행한다. UpgradePanel 모달(레벨·4효과 상세)을 되살리려면 이
    -- 메서드를 다시 배선하면 된다.
    -- One centre modal at a time (docs/08 §6.1, docs/16 §13 D-8).
    if self.selectPanel ~= nil then self.selectPanel.Enable = false end
    if self.salePanel ~= nil then self.salePanel.Enable = false end
    if self.rarePanel ~= nil then self.rarePanel.Enable = false end
    if self.cartPanel ~= nil then self.cartPanel.Enable = false end
    if self.upgradePanel ~= nil then self.upgradePanel.Enable = true end
    -- 모달을 열 때 이전 화면의 메시지를 지운다 (docs/23 §5-2). LastTransactionMessage
    -- 는 서버 소유 전역 슬롯이라 지울 수 없으므로, 연 시점의 값을 기억해 두고
    -- 그 이후에 바뀐 것만 이 패널의 결과로 그린다.
    local profile = self:GetProfile()
    if profile ~= nil then self._T.upgradeMsgAtOpen = profile.LastTransactionMessage end
    log("[MineSelectUI] upgrade panel opened")
    self:RefreshUI(true)
end

@ExecSpace("ClientOnly")
method void OnUpgradeCloseClicked()
