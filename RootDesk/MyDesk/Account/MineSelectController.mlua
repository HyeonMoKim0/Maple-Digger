@ExecSpace("ClientOnly")
method table GetTutorialButtons()
    -- T-07 (F7-E §5.1): 이 컨트롤러 소유 버튼의 튜토리얼 잠금 대상 목록.
    return {
        selectOpen = self.btnOpen,
        selectClose = self.btnClose,
        sellOpen = self.btnSell,
        mineBeginner = self.btnBeginner,
        mineDeep = self.btnDeep,
        mineGem = self.btnGem,
        buyWorker = self.btnBuyWorker,
        cartOpen = self.btnCartOpen,
        upgradeBeginner = self.btnUpgradeBeginner,
        upgradeDeep = self.btnUpgradeDeep,
        upgradeGem = self.btnUpgradeGem,
        tabMines = self.btnTabMines,
        tabUpgrade = self.btnTabUpgrade,
        rareOpen = self.btnRareOpen,
        saleClose = self.btnSaleClose,
        oreStone = self.btnOreStone,
        oreIron = self.btnOreIron,
        oreGold = self.btnOreGold,
        saleMinus = self.btnSaleMinus,
        salePlus = self.btnSalePlus,
        quickAll = self.btnQuickAll,
        sellSelected = self.btnSellSelected,
        toggleProtected = self.btnToggleProtected,
        saveProtection = self.btnSaveProtection,
        toggleAutoSell = self.btnToggleAutoSell,
        tutorialReplay = self.btnTutorialReplay,
    }
end

@ExecSpace("ClientOnly")
method void CloseAllPanelsForTutorial()
    -- T-07: 편집기 단계(1~6) 진입 시 광산 선택 계열 패널을 전부 닫는다. "다시
    -- 보기"가 SelectPanel 에서 진입하므로, 닫지 않으면 열린 패널이 편집기와
    -- 안내를 덮는다 (검증 스크린샷에서 실측).
    if self.selectPanel ~= nil then self.selectPanel.Enable = false end
    if self.salePanel ~= nil then self.salePanel.Enable = false end
    if self.rarePanel ~= nil then self.rarePanel.Enable = false end
    if self.cartPanel ~= nil then self.cartPanel.Enable = false end
    if self.upgradePanel ~= nil then self.upgradePanel.Enable = false end
end

@ExecSpace("ClientOnly")
method void OpenSelectPanelForTutorial()
    -- T-07: 7·8단계 안내가 광산 선택 화면을 열어야 할 때 쓴다 (클릭 대체 아님 —
    -- 실제 열기는 플레이어의 버튼 클릭이 하고, 이것은 실패 복귀용이다).
    if self.selectPanel ~= nil then self.selectPanel.Enable = true end
end

@ExecSpace("ClientOnly")
method void RequestEntry(string targetMapName)
    local profile = self:GetProfile()
    if profile == nil then return end
    profile:RequestMineEntry(targetMapName)
end

@ExecSpace("ClientOnly")
method void OnEndPlay()
    self:DisconnectButton("upgradeBeginner", self.btnUpgradeBeginner)
    self:DisconnectButton("upgradeDeep", self.btnUpgradeDeep)
    self:DisconnectButton("upgradeGem", self.btnUpgradeGem)
    self:DisconnectButton("tabMines", self.btnTabMines)
    self:DisconnectButton("tabUpgrade", self.btnTabUpgrade)
    self:DisconnectButton("upgradeConfirm", self.btnUpgradeConfirm)
    self:DisconnectButton("upgradeClose", self.btnUpgradeClose)
    self:DisconnectButton("open", self.btnOpen)
    self:DisconnectButton("close", self.btnClose)
    self:DisconnectButton("sell", self.btnSell)
    self:DisconnectButton("beginner", self.btnBeginner)
    self:DisconnectButton("deep", self.btnDeep)
    self:DisconnectButton("gem", self.btnGem)
    self:DisconnectButton("saleClose", self.btnSaleClose)
    self:DisconnectButton("oreStone", self.btnOreStone)
    self:DisconnectButton("oreIron", self.btnOreIron)
    self:DisconnectButton("oreGold", self.btnOreGold)
    self:DisconnectButton("saleMinus", self.btnSaleMinus)
    self:DisconnectButton("salePlus", self.btnSalePlus)
    self:DisconnectButton("quickAll", self.btnQuickAll)
    if self._T.saleSliderHandler ~= nil and self.saleSlider ~= nil then
        self.saleSlider.Entity:DisconnectEvent(SliderValueChangedEvent, self._T.saleSliderHandler)
        self._T.saleSliderHandler = nil
    end
    if self._T.protSliderHandler ~= nil and self.protSlider ~= nil then
        self.protSlider.Entity:DisconnectEvent(SliderValueChangedEvent, self._T.protSliderHandler)
        self._T.protSliderHandler = nil
    end
    self:DisconnectButton("sellSelected", self.btnSellSelected)
    self:DisconnectButton("toggleProtected", self.btnToggleProtected)
    self:DisconnectButton("saveProtection", self.btnSaveProtection)
    self:DisconnectButton("protectedMinus", self.btnProtectedMinus)
    self:DisconnectButton("protectedPlus", self.btnProtectedPlus)
    self:DisconnectButton("toggleAutoSell", self.btnToggleAutoSell)
    self:DisconnectButton("rareOpen", self.btnRareOpen)
    self:DisconnectButton("rareClose", self.btnRareClose)
    self:DisconnectButton("buyWorker", self.btnBuyWorker)
    self:DisconnectButton("rareStone", self.btnRareStone)
    self:DisconnectButton("rareIron", self.btnRareIron)
    self:DisconnectButton("rareGold", self.btnRareGold)
    self:DisconnectButton("rareStoneAuto", self.btnRareStoneAuto)
    self:DisconnectButton("rareIronAuto", self.btnRareIronAuto)
    self:DisconnectButton("rareGoldAuto", self.btnRareGoldAuto)
    self:DisconnectButton("tutorialReplay", self.btnTutorialReplay)
end

@ExecSpace("ClientOnly")
method void DisconnectButton(string key, ButtonComponent button)
    if button == nil or self._T.handlers[key] == nil then return end
    button.Entity:DisconnectEvent(ButtonClickEvent, self._T.handlers[key])
end

end
