-- 두 입력창의 실제 컴포넌트는 TextGUIRendererInputComponent 다. 레거시
-- TextInputComponent 로 선언하면 GetComponent 가 nil 을 돌려주고, 수량이 절대
-- 입력되지 않아 판매가 항상 "수량은 1 이상" 으로 실패했다 (docs/16 §14 D-11).
property TextGUIRendererInputComponent saleAmountInput = "35a53a3e-b413-4f1c-acab-6f67795f97a1"
property TextGUIRendererInputComponent protectedAmountInput = "11ee646a-5d19-469f-949b-65106eebe749"
property ButtonComponent btnQuickOne = "17fb7222-327e-45c9-8f31-e3592659a17a"
property ButtonComponent btnQuickTen = "f179fa04-2b7b-4493-811c-8df7f4fb77b3"
property ButtonComponent btnQuickHundred = "4cb338a6-780e-4a9f-99da-8d62d96b6a3a"
property ButtonComponent btnQuickAll = "6c8f9913-59c7-4613-8ec8-399c092b8c53"
