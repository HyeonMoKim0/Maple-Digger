-- F7-B CLIENT MINE SELECTOR
-- This UI only renders synchronized account state and sends requests through
-- AccountProfileService. Costs, sales, unlocks, and movement stay server-owned.
@Logic
script MineSelectController extends Logic

property Entity selectPanel = "20cb4dbc-1e9a-42f4-a237-549a3a3edf41"
property ButtonComponent btnOpen = "94c58c02-b4ac-4901-b9b7-0f02e69568c9"
property ButtonComponent btnClose = "825b75ee-fb22-4fad-8408-1de384b07a4c"
property ButtonComponent btnSell = "21647cc6-ca6e-460f-aa6f-0ffcbf9bb385"
property ButtonComponent btnBeginner = "54711815-5537-4bd1-8264-33fc12fdbec8"
property ButtonComponent btnDeep = "ca11aa60-d838-48f3-bb72-215d57ce08a1"
property ButtonComponent btnGem = "a8f1b7c8-d870-4044-bfe9-766610322ba8"
