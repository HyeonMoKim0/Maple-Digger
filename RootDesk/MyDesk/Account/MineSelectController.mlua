    if profile == nil then return end
    profile:RequestCartUpgrade(self._T.cartWorkerIndex)
end

@ExecSpace("ClientOnly")
method void RequestEntry(string targetMapName)
    local profile = self:GetProfile()
    if profile == nil then return end
    profile:RequestMineEntry(targetMapName)
end

@ExecSpace("ClientOnly")
method void OnEndPlay()
    self:DisconnectButton("open", self.btnOpen)
    self:DisconnectButton("close", self.btnClose)
    self:DisconnectButton("sell", self.btnSell)
    self:DisconnectButton("beginner", self.btnBeginner)
    self:DisconnectButton("deep", self.btnDeep)
    self:DisconnectButton("gem", self.btnGem)
    self:DisconnectButton("saleClose", self.btnSaleClose)
    self:DisconnectButton("oreStone", self.btnOreStone)
    self:DisconnectButton("oreIron", self.btnOreIron)
    self:DisconnectButton("oreGold", self.btnOreGold)
    self:DisconnectButton("quickOne", self.btnQuickOne)
    self:DisconnectButton("quickTen", self.btnQuickTen)
    self:DisconnectButton("quickHundred", self.btnQuickHundred)
    self:DisconnectButton("quickAll", self.btnQuickAll)
    self:DisconnectButton("sellSelected", self.btnSellSelected)
    self:DisconnectButton("toggleProtected", self.btnToggleProtected)
    self:DisconnectButton("saveProtection", self.btnSaveProtection)
    self:DisconnectButton("toggleAutoSell", self.btnToggleAutoSell)
    self:DisconnectButton("rareOpen", self.btnRareOpen)
    self:DisconnectButton("rareClose", self.btnRareClose)
    self:DisconnectButton("buyWorker", self.btnBuyWorker)
    self:DisconnectButton("rareStone", self.btnRareStone)
    self:DisconnectButton("rareIron", self.btnRareIron)
    self:DisconnectButton("rareGold", self.btnRareGold)
    self:DisconnectButton("rareStoneAuto", self.btnRareStoneAuto)
    self:DisconnectButton("rareIronAuto", self.btnRareIronAuto)
    self:DisconnectButton("rareGoldAuto", self.btnRareGoldAuto)
end

@ExecSpace("ClientOnly")
method void DisconnectButton(string key, ButtonComponent button)
    if button == nil or self._T.handlers[key] == nil then return end
    button.Entity:DisconnectEvent(ButtonClickEvent, self._T.handlers[key])
end

end
