property ButtonComponent btnCartOpen = "467843b6-73f5-425b-9b94-2f0cd0f0a89d"
property Entity cartPanel = "2ddf0bf0-6b16-4e5a-8422-56f1685cbf55"
property ButtonComponent btnCartClose = "fad448d9-9044-4c6c-925f-353d66eaea43"
property ButtonComponent btnCartWorker1 = "c9d87a4e-ad97-46d6-b5be-5dd7e4f98ea6"
property ButtonComponent btnCartWorker2 = "e7b052b6-fa61-457b-8c89-e6cbb2db27b4"
property ButtonComponent btnCartWorker3 = "26e77396-6738-45ea-b225-72cd37602140"
property ButtonComponent btnCartWorker4 = "68b01220-83bb-47a6-8b64-524aec3e2323"
property ButtonComponent btnCartWorker5 = "22a4e518-aaa1-4b95-8938-98a34550a4ba"
property ButtonComponent btnCartUpgrade = "dff1aaae-2536-4fc1-b8eb-6734a9403f85"
property TextComponent cartSummaryText = "6845ae6a-932f-4bac-8509-fb3a6b323fcb"

@ExecSpace("ClientOnly")
method void OnBeginPlay()
    self._T.handlers = {}
    self._T.lastState = ""
    self._T.selectedOre = "stone"
    self._T.includeProtected = false
    self._T.localSaleHint = ""
    self._T.cartWorkerIndex = 1
    if self.selectPanel ~= nil then self.selectPanel.Enable = false end
    if self.salePanel ~= nil then self.salePanel.Enable = false end
    if self.rarePanel ~= nil then self.rarePanel.Enable = false end
    if self.cartPanel ~= nil then self.cartPanel.Enable = false end
    self:ConnectButton("open", self.btnOpen, self.OnOpenClicked)
    self:ConnectButton("close", self.btnClose, self.OnCloseClicked)
    self:ConnectButton("sell", self.btnSell, self.OnSellClicked)
    self:ConnectButton("beginner", self.btnBeginner, self.OnBeginnerClicked)
    self:ConnectButton("deep", self.btnDeep, self.OnDeepClicked)
    self:ConnectButton("gem", self.btnGem, self.OnGemClicked)
    self:ConnectButton("saleClose", self.btnSaleClose, self.OnSaleCloseClicked)
    self:ConnectButton("oreStone", self.btnOreStone, self.OnOreStoneClicked)
    self:ConnectButton("oreIron", self.btnOreIron, self.OnOreIronClicked)
    self:ConnectButton("oreGold", self.btnOreGold, self.OnOreGoldClicked)
    self:ConnectButton("quickOne", self.btnQuickOne, self.OnQuickOneClicked)
    self:ConnectButton("quickTen", self.btnQuickTen, self.OnQuickTenClicked)
    self:ConnectButton("quickHundred", self.btnQuickHundred, self.OnQuickHundredClicked)
    self:ConnectButton("quickAll", self.btnQuickAll, self.OnQuickAllClicked)
    self:ConnectButton("sellSelected", self.btnSellSelected, self.OnSellSelectedClicked)
    self:ConnectButton("toggleProtected", self.btnToggleProtected, self.OnToggleProtectedClicked)
    self:ConnectButton("saveProtection", self.btnSaveProtection, self.OnSaveProtectionClicked)
    self:ConnectButton("toggleAutoSell", self.btnToggleAutoSell, self.OnToggleAutoSellClicked)
    self:ConnectButton("rareOpen", self.btnRareOpen, self.OnRareOpenClicked)
    self:ConnectButton("rareClose", self.btnRareClose, self.OnRareCloseClicked)
    self:ConnectButton("buyWorker", self.btnBuyWorker, self.OnBuyWorkerClicked)
    self:ConnectButton("rareStone", self.btnRareStone, self.OnRareStoneClicked)
    self:ConnectButton("rareIron", self.btnRareIron, self.OnRareIronClicked)
    self:ConnectButton("rareGold", self.btnRareGold, self.OnRareGoldClicked)
    self:ConnectButton("rareStoneAuto", self.btnRareStoneAuto, self.OnRareStoneAutoClicked)
    self:ConnectButton("rareIronAuto", self.btnRareIronAuto, self.OnRareIronAutoClicked)
    self:ConnectButton("rareGoldAuto", self.btnRareGoldAuto, self.OnRareGoldAutoClicked)
    self:ConnectButton("cartOpen", self.btnCartOpen, self.OnCartOpenClicked)
    self:ConnectButton("cartClose", self.btnCartClose, self.OnCartCloseClicked)
    self:ConnectButton("cartWorker1", self.btnCartWorker1, self.OnCartWorker1Clicked)
    self:ConnectButton("cartWorker2", self.btnCartWorker2, self.OnCartWorker2Clicked)
    self:ConnectButton("cartWorker3", self.btnCartWorker3, self.OnCartWorker3Clicked)
    self:ConnectButton("cartWorker4", self.btnCartWorker4, self.OnCartWorker4Clicked)
    self:ConnectButton("cartWorker5", self.btnCartWorker5, self.OnCartWorker5Clicked)
    self:ConnectButton("cartUpgrade", self.btnCartUpgrade, self.OnCartUpgradeClicked)
    self:RefreshUI(true)
    log("[MineSelectUI] F7-B selector ready")
end

@ExecSpace("ClientOnly")
method void OnUpdate(number delta)
    self:RefreshUI(false)
end

@ExecSpace("ClientOnly")
method void ConnectButton(string key, ButtonComponent button, any callback)
    if button == nil then return end
    self._T.handlers[key] = button.Entity:ConnectEvent(ButtonClickEvent, callback)
end

@ExecSpace("ClientOnly")
method AccountProfileService GetProfile()
    local player = _UserService.LocalPlayer
    if player == nil then return nil end
    ---@type AccountProfileService
    local profile = player:GetComponent("script.AccountProfileService")
    return profile
end

@ExecSpace("ClientOnly")
method void RefreshUI(boolean force)
    local profile = self:GetProfile()
    if profile == nil then return end
    local state = tostring(profile.Gold) .. ":" .. tostring(profile.MineTokens) .. ":" .. tostring(profile.Stone) .. ":" .. tostring(profile.Iron) .. ":" .. tostring(profile.GoldOre) .. ":" .. tostring(profile.RareStoneCollectionLevel) .. ":" .. tostring(profile.RareIronCollectionLevel) .. ":" .. tostring(profile.RareGoldCollectionLevel) .. ":" .. tostring(profile.RareStoneStored) .. ":" .. tostring(profile.RareIronStored) .. ":" .. tostring(profile.RareGoldStored) .. ":" .. tostring(profile.OwnedWorkerCount) .. ":" .. tostring(profile.Worker1CartCapacity) .. ":" .. tostring(profile.Worker2CartCapacity) .. ":" .. tostring(profile.Worker3CartCapacity) .. ":" .. tostring(profile.Worker4CartCapacity) .. ":" .. tostring(profile.Worker5CartCapacity) .. ":" .. tostring(profile.StoneAutoSell) .. ":" .. tostring(profile.IronAutoSell) .. ":" .. tostring(profile.GoldOreAutoSell) .. ":" .. tostring(profile.StoneProtectedAmount) .. ":" .. tostring(profile.IronProtectedAmount) .. ":" .. tostring(profile.GoldOreProtectedAmount) .. ":" .. tostring(profile.DeepMineUnlocked) .. ":" .. tostring(profile.GemMineUnlocked) .. ":" .. profile.LastTransactionMessage .. ":" .. profile.RecoveryStatus
    state = state .. ":" .. tostring(profile.RareStoneAutoSell) .. ":" .. tostring(profile.RareIronAutoSell) .. ":" .. tostring(profile.RareGoldAutoSell)
    state = state .. ":" .. tostring(profile.StoneEffectiveProtection) .. ":" .. tostring(profile.IronEffectiveProtection) .. ":" .. tostring(profile.GoldOreEffectiveProtection)
    if not force and state == self._T.lastState then return end
    self._T.lastState = state

    if self.resourceText ~= nil then
        self.resourceText.Text = "골드 " .. tostring(profile.Gold) .. "  |  토큰 " .. tostring(profile.MineTokens) .. "\n돌 " .. tostring(profile.Stone) .. "  철 " .. tostring(profile.Iron) .. "  금광석 " .. tostring(profile.GoldOre)
    end
    if self.deepText ~= nil then
        if profile.DeepMineUnlocked then self.deepText.Text = "깊은 광산  ·  해금됨"
        else self.deepText.Text = "깊은 광산  ·  180 골드 / 토큰 6 / 돌 120" end
    end
    if self.gemText ~= nil then
        if profile.GemMineUnlocked then self.gemText.Text = "보석 광산  ·  해금됨"
        else self.gemText.Text = "보석 광산  ·  700 골드 / 토큰 10 / 돌 200 / 철 60" end
    end
    if self.feedbackText ~= nil then
        if profile.LastTransactionMessage ~= "" then self.feedbackText.Text = profile.LastTransactionMessage
        elseif profile.RecoveryStatus ~= "" then self.feedbackText.Text = profile.RecoveryStatus
        else self.feedbackText.Text = "광물은 다음 광산 해금에 필요한 수량만 자동 보호됩니다."
        end
    end
    if self.workerStatusText ~= nil then self.workerStatusText.Text = self:GetWorkerPurchaseStatus(profile) end
    if self.rareSummaryText ~= nil then self.rareSummaryText.Text = "희귀 컬렉션  돌 " .. tostring(profile.RareStoneCollectionLevel) .. "/10 (보관 " .. tostring(profile.RareStoneStored) .. ") · 철 " .. tostring(profile.RareIronCollectionLevel) .. "/10 (보관 " .. tostring(profile.RareIronStored) .. ") · 금 " .. tostring(profile.RareGoldCollectionLevel) .. "/10 (보관 " .. tostring(profile.RareGoldStored) .. ")" end
    if self.cartSummaryText ~= nil then self.cartSummaryText.Text = self:GetCartSummary(profile) end
    if self.rareSummaryText ~= nil then self.rareSummaryText.Text = self:GetRareSummary(profile) end
    self:RefreshSaleSummary(profile)
end

@ExecSpace("ClientOnly")
method integer GetCartCapacity(AccountProfileService profile, integer workerIndex)
    if workerIndex == 1 then return profile.Worker1CartCapacity end
    if workerIndex == 2 then return profile.Worker2CartCapacity end
    if workerIndex == 3 then return profile.Worker3CartCapacity end
    if workerIndex == 4 then return profile.Worker4CartCapacity end
    return profile.Worker5CartCapacity
end

@ExecSpace("ClientOnly")
method string GetCartOreLabel()
    local player = _UserService.LocalPlayer
    if player == nil or player.CurrentMap == nil then return "광물" end
    if player.CurrentMap.Name == "farm01" then return "돌" end
    if player.CurrentMap.Name == "deep_mine" then return "철" end
    if player.CurrentMap.Name == "gem_mine" then return "금광석" end
    return "광물"
end

@ExecSpace("ClientOnly")
method string GetCartSummary(AccountProfileService profile)
    local workerIndex = self._T.cartWorkerIndex
    local capacity = self:GetCartCapacity(profile, workerIndex)
    local level = math.max(0, math.floor((capacity - 20) / 2))
    if workerIndex > profile.OwnedWorkerCount then
        return "일꾼 " .. tostring(workerIndex) .. "은 아직 고용되지 않았습니다.\n현재 적재량: " .. tostring(capacity) .. "칸"
    end
    if level >= 15 then
        return "일꾼 " .. tostring(workerIndex) .. "  ·  적재량 " .. tostring(capacity) .. " / 50칸\n최대 강화 완료"
    end
    local nextLevel = level + 1
    local rawGoldCost = 20
    for index = 2, nextLevel do rawGoldCost = rawGoldCost * 1.25 end
    local goldCost = math.floor(rawGoldCost + 0.5)
    return "일꾼 " .. tostring(workerIndex) .. "  ·  적재량 " .. tostring(capacity) .. " / 50칸\n다음 강화: 골드 " .. tostring(goldCost) .. " / " .. self:GetCartOreLabel() .. " " .. tostring(5 * nextLevel) .. "  (+2칸)"
end

@ExecSpace("ClientOnly")
method string GetWorkerPurchaseStatus(AccountProfileService profile)
    local owned = profile.OwnedWorkerCount
    if owned >= 5 then return "일꾼 " .. tostring(owned) .. " / 5  ·  모두 고용함" end
    if owned == 1 then return "일꾼 1 / 5  ·  다음: 60 골드" end
    if owned == 2 then return "일꾼 2 / 5  ·  다음: 깊은 광산 + 200 골드 / 돌 80" end
    if owned == 3 then return "일꾼 3 / 5  ·  다음: 보석 광산 + 650 골드 / 돌 160 / 철 50" end
    return "일꾼 4 / 5  ·  다음: 1,600 골드 / 돌 300 / 철 120 / 금광석 30"
end

@ExecSpace("ClientOnly")
method integer GetSelectedBalance(AccountProfileService profile)
    if self._T.selectedOre == "stone" then return profile.Stone end
    if self._T.selectedOre == "iron" then return profile.Iron end
    return profile.GoldOre
end

@ExecSpace("ClientOnly")
method integer GetSelectedProtection(AccountProfileService profile)
    if self._T.selectedOre == "stone" then return profile.StoneProtectedAmount end
    if self._T.selectedOre == "iron" then return profile.IronProtectedAmount end
    return profile.GoldOreProtectedAmount
end

@ExecSpace("ClientOnly")
method boolean GetSelectedAutoSell(AccountProfileService profile)
    if self._T.selectedOre == "stone" then return profile.StoneAutoSell end
    if self._T.selectedOre == "iron" then return profile.IronAutoSell end
    return profile.GoldOreAutoSell
end

@ExecSpace("ClientOnly")
method integer GetSelectedEffectiveProtection(AccountProfileService profile)
    -- max(설정 보호, 다음 광산 해금 필요량). 서버가 판매를 판정할 때 쓰는 값이다.
    if self._T.selectedOre == "stone" then return profile.StoneEffectiveProtection end
    if self._T.selectedOre == "iron" then return profile.IronEffectiveProtection end
    return profile.GoldOreEffectiveProtection
end

@ExecSpace("ClientOnly")
method string OreLabel(string oreType)
    -- 요약에 코드값(stone)이 아니라 한글 라벨을 보여 준다.
    if oreType == "stone" then return "돌" end
    if oreType == "iron" then return "철" end
    if oreType == "gold" then return "금광석" end
    return oreType
end

@ExecSpace("ClientOnly")
method void RefreshSaleSummary(AccountProfileService profile)
    if self.saleSummaryText ~= nil then
        local autoLabel = "끔"
        if self:GetSelectedAutoSell(profile) then autoLabel = "켬" end
        local protectionLabel = "해제"
        if self._T.includeProtected then protectionLabel = "포함" end
        local balance = self:GetSelectedBalance(profile)
        local effective = self:GetSelectedEffectiveProtection(profile)
        local sellable = balance - effective
        if sellable < 0 then sellable = 0 end
        self.saleSummaryText.Text = "선택: " .. self:OreLabel(self._T.selectedOre) .. "  |  보유 " .. tostring(balance) .. "  |  보호 " .. tostring(effective) .. " (설정 " .. tostring(self:GetSelectedProtection(profile)) .. ")\n지금 팔 수 있는 수량 " .. tostring(sellable) .. "  |  자동판매 " .. autoLabel .. "  |  보호분 판매 " .. protectionLabel
    end
    self:RefreshSaleFeedback(profile)
end

@ExecSpace("ClientOnly")
method void RefreshSaleFeedback(AccountProfileService profile)
    -- 판매 패널 전용 피드백. LastTransactionMessage 는 SelectPanel 의 FeedbackText 에만
    -- 있었고, 판매 패널을 열면 SelectPanel 이 꺼지므로 거부 사유가 화면에서 사라졌다
    -- (docs/16 §14 D-10).
    if self.saleFeedbackText == nil then return end
    if self._T.localSaleHint ~= nil and self._T.localSaleHint ~= "" then
        self.saleFeedbackText.Text = self._T.localSaleHint
        return
    end
    if profile.LastTransactionMessage ~= "" then
        self.saleFeedbackText.Text = profile.LastTransactionMessage
        return
    end
    local balance = self:GetSelectedBalance(profile)
    local effective = self:GetSelectedEffectiveProtection(profile)
    if balance <= effective and not self._T.includeProtected then
        self.saleFeedbackText.Text = "보유 " .. tostring(balance) .. "개가 모두 보호 수량(" .. tostring(effective) .. ")입니다. 팔려면 `보호분 포함 전환`을 먼저 누르세요."
        return
    end
    self.saleFeedbackText.Text = "광물과 수량을 고른 뒤 `선택 수량 판매`를 누르세요."
end

@ExecSpace("ClientOnly")
method integer ReadNonNegative(TextGUIRendererInputComponent input, integer fallback)
    if input == nil then return fallback end
    local parsed = tonumber(input.Text)
    if parsed == nil then return fallback end
    return math.max(0, math.floor(parsed))
end

@ExecSpace("ClientOnly")
method void SelectOre(string oreType)
    self._T.selectedOre = oreType
    self._T.includeProtected = false
    -- 이전 요청의 힌트를 지운다. 지우지 않으면 한 번 뜬 "수량은 1 이상" 문구가
    -- 계속 남아 이후의 서버 거부 사유를 덮는다.
    self._T.localSaleHint = ""
    local profile = self:GetProfile()
    if profile ~= nil and self.protectedAmountInput ~= nil then
        self.protectedAmountInput.Text = tostring(self:GetSelectedProtection(profile))
    end
    self:RefreshUI(true)
end

@ExecSpace("ClientOnly")
method void OnOpenClicked()
    if self.selectPanel ~= nil then self.selectPanel.Enable = true end
    if self.salePanel ~= nil then self.salePanel.Enable = false end
    if self.rarePanel ~= nil then self.rarePanel.Enable = false end
    self:RefreshUI(true)
end

@ExecSpace("ClientOnly")
method void OnCloseClicked()
    if self.selectPanel ~= nil then self.selectPanel.Enable = false end
    if self.salePanel ~= nil then self.salePanel.Enable = false end
    if self.rarePanel ~= nil then self.rarePanel.Enable = false end
end

@ExecSpace("ClientOnly")
method void OnSellClicked()
    -- One centre modal at a time (docs/08 §6.1). Leaving selectPanel enabled
    -- stacked two same-sized panels and made both unreadable (docs/16 §13 D-8).
    if self.selectPanel ~= nil then self.selectPanel.Enable = false end
    if self.salePanel ~= nil then self.salePanel.Enable = true end
    if self.cartPanel ~= nil then self.cartPanel.Enable = false end
    if self.rarePanel ~= nil then self.rarePanel.Enable = false end
    self:SelectOre(self._T.selectedOre)
    if self.saleAmountInput ~= nil then self.saleAmountInput.Text = "1" end
end

@ExecSpace("ClientOnly")
method void OnSaleCloseClicked()
    -- Closing a sub-panel returns to the mine-select menu it was opened from.
    if self.salePanel ~= nil then self.salePanel.Enable = false end
    if self.selectPanel ~= nil then self.selectPanel.Enable = true end
    self:RefreshUI(true)
end

@ExecSpace("ClientOnly")
method void OnRareOpenClicked()
    if self.selectPanel ~= nil then self.selectPanel.Enable = false end
    if self.salePanel ~= nil then self.salePanel.Enable = false end
    if self.cartPanel ~= nil then self.cartPanel.Enable = false end
    if self.rarePanel ~= nil then self.rarePanel.Enable = true end
    self:RefreshUI(true)
end

@ExecSpace("ClientOnly")
method void OnRareCloseClicked()
    -- The rare popup is opened from the sale panel, so it returns there.
    if self.rarePanel ~= nil then self.rarePanel.Enable = false end
    if self.salePanel ~= nil then self.salePanel.Enable = true end
    self:RefreshUI(true)
end

@ExecSpace("ClientOnly")
method void OnOreStoneClicked()
    self:SelectOre("stone")
end

@ExecSpace("ClientOnly")
method void OnOreIronClicked()
    self:SelectOre("iron")
end

@ExecSpace("ClientOnly")
method void OnOreGoldClicked()
    self:SelectOre("gold")
end

@ExecSpace("ClientOnly")
method void SetSaleAmount(integer amount)
    if self.saleAmountInput ~= nil then self.saleAmountInput.Text = tostring(math.max(0, amount)) end
    self._T.localSaleHint = ""
    self:RefreshUI(true)
end

@ExecSpace("ClientOnly")
method void OnQuickOneClicked()
    self:SetSaleAmount(1)
end

@ExecSpace("ClientOnly")
method void OnQuickTenClicked()
    self:SetSaleAmount(10)
end

@ExecSpace("ClientOnly")
method void OnQuickHundredClicked()
    self:SetSaleAmount(100)
end

@ExecSpace("ClientOnly")
method void OnQuickAllClicked()
    local profile = self:GetProfile()
    if profile == nil then return end
    self:SetSaleAmount(self:GetSelectedBalance(profile))
end

@ExecSpace("ClientOnly")
method void OnToggleProtectedClicked()
    self._T.includeProtected = not self._T.includeProtected
    self._T.localSaleHint = ""
    self:RefreshUI(true)
end

@ExecSpace("ClientOnly")
method void OnSellSelectedClicked()
    local profile = self:GetProfile()
    if profile == nil then return end
    self._T.localSaleHint = ""
    local amount = self:ReadNonNegative(self.saleAmountInput, 0)
    if amount <= 0 then
        self._T.localSaleHint = "판매 수량은 1 이상이어야 합니다."
        self:RefreshUI(true)
        return
    end
    log("[MineSelectUI] sell request ore=" .. self._T.selectedOre .. " amount=" .. tostring(amount) .. " includeProtected=" .. tostring(self._T.includeProtected))
    profile:RequestSellOre(self._T.selectedOre, amount, self._T.includeProtected)
end

@ExecSpace("ClientOnly")
method void OnSaveProtectionClicked()
    local profile = self:GetProfile()
    if profile == nil then return end
    local protectedAmount = self:ReadNonNegative(self.protectedAmountInput, self:GetSelectedProtection(profile))
    profile:RequestSaleSetting(self._T.selectedOre, self:GetSelectedAutoSell(profile), protectedAmount)
end

@ExecSpace("ClientOnly")
method void OnToggleAutoSellClicked()
    local profile = self:GetProfile()
    if profile == nil then return end
    local protectedAmount = self:ReadNonNegative(self.protectedAmountInput, self:GetSelectedProtection(profile))
    profile:RequestSaleSetting(self._T.selectedOre, not self:GetSelectedAutoSell(profile), protectedAmount)
end

