@ExecSpace("ClientOnly")
method void SetSaleAmount(integer amount)
    -- 판매 수량 갱신 단일 경로 (슬라이더·±버튼·전량·패널 열기 공용).
    -- 슬라이더 Value 대입이 SliderValueChangedEvent 를 재발화하지만, 핸들러는
    -- 같은 값을 입력창에 다시 쓸 뿐이라 루프가 생기지 않는다 (§52-13 계열).
    local clamped = math.max(0, amount)
    if self.saleAmountInput ~= nil then self.saleAmountInput.Text = tostring(clamped) end
    if self.saleSlider ~= nil then
        local profile = self:GetProfile()
        if profile ~= nil then self.saleSlider.MaxValue = math.max(1, self:GetSelectedBalance(profile)) end
        self.saleSlider.Value = clamped
    end
    self._T.localSaleHint = ""
    self:RefreshUI(true)
end

@ExecSpace("ClientOnly")
method void OnSaleSliderChanged(SliderValueChangedEvent event)
    -- 슬라이더 → 입력창 단방향 동기화. 판매 시점 값은 입력창에서 읽는다
    -- (OnSellSelectedClicked 의 ReadNonNegative — 직접 입력도 같은 경로).
    if self.saleSlider == nil or self.saleAmountInput == nil then return end
    self.saleAmountInput.Text = tostring(math.floor(self.saleSlider.Value))
end

@ExecSpace("ClientOnly")
method void NudgeSaleAmount(integer delta)
    -- ± 미세 조정: 직접 입력 중이던 값을 기준으로 1단위 가감, 0~보유량 클램프.
    local profile = self:GetProfile()
    if profile == nil then return end
    local amount = self:ReadNonNegative(self.saleAmountInput, 0) + delta
    local balance = self:GetSelectedBalance(profile)
    if amount > balance then amount = balance end
    self:SetSaleAmount(math.max(0, amount))
end

@ExecSpace("ClientOnly")
method void OnSaleMinusClicked()
    self:NudgeSaleAmount(-1)
end

@ExecSpace("ClientOnly")
method void OnSalePlusClicked()
    self:NudgeSaleAmount(1)
end

@ExecSpace("ClientOnly")
method void OnQuickAllClicked()
    local profile = self:GetProfile()
    if profile == nil then return end
    self:SetSaleAmount(self:GetSelectedBalance(profile))
end

@ExecSpace("ClientOnly")
method void OnToggleProtectedClicked()
    self._T.includeProtected = not self._T.includeProtected
    self._T.localSaleHint = ""
    self:RefreshUI(true)
end

@ExecSpace("ClientOnly")
method void OnSellSelectedClicked()
    local profile = self:GetProfile()
    if profile == nil then return end
    self._T.localSaleHint = ""
    local amount = self:ReadNonNegative(self.saleAmountInput, 0)
    if amount <= 0 then
        self._T.localSaleHint = "판매 수량은 1 이상이어야 합니다."
        self:RefreshUI(true)
        return
    end
    log("[MineSelectUI] sell request ore=" .. self._T.selectedOre .. " amount=" .. tostring(amount) .. " includeProtected=" .. tostring(self._T.includeProtected))
    profile:RequestSellOre(self._T.selectedOre, amount, self._T.includeProtected)
end

@ExecSpace("ClientOnly")
method void OnSaveProtectionClicked()
    local profile = self:GetProfile()
    if profile == nil then return end
    -- 직접 입력창에 타이핑만 하고 저장을 누른 경우까지 잡는다 — 입력값 우선.
    local protectedAmount = self:ReadNonNegative(self.protAmountInput, math.max(0, self._T.protectedAmountDraft or self:GetSelectedProtection(profile)))
    self._T.protectedAmountDraft = protectedAmount
    self:SyncProtSlider()
    profile:RequestSaleSetting(self._T.selectedOre, self:GetSelectedAutoSell(profile), protectedAmount)
end

@ExecSpace("ClientOnly")
method void OnToggleAutoSellClicked()
    local profile = self:GetProfile()
    if profile == nil then return end
    local protectedAmount = self:ReadNonNegative(self.protAmountInput, math.max(0, self._T.protectedAmountDraft or self:GetSelectedProtection(profile)))
    self._T.protectedAmountDraft = protectedAmount
    profile:RequestSaleSetting(self._T.selectedOre, not self:GetSelectedAutoSell(profile), protectedAmount)
end

@ExecSpace("ClientOnly")
method void SetProtectedDraft(integer amount)
    -- 보호 수량 초안 갱신 단일 경로 (슬라이더·±버튼·직접 입력 공용).
    self._T.protectedAmountDraft = math.max(0, amount)
    if self.protAmountInput ~= nil then self.protAmountInput.Text = tostring(self._T.protectedAmountDraft) end
    self._T.localSaleHint = "보호 수량 " .. tostring(self._T.protectedAmountDraft) .. " — 저장을 누르면 적용됩니다."
    self:RefreshUI(true)
end

@ExecSpace("ClientOnly")
method void SyncProtSlider()
    -- Value 대입의 이벤트 재발화는 같은 값을 다시 쓰는 것으로 끝난다 (루프 없음).
    if self.protSlider ~= nil then self.protSlider.Value = self._T.protectedAmountDraft or 0 end
end

@ExecSpace("ClientOnly")
method void OnProtSliderChanged(SliderValueChangedEvent event)
    if self.protSlider == nil then return end
    self:SetProtectedDraft(math.floor(self.protSlider.Value))
end

@ExecSpace("ClientOnly")
method void AdjustProtectedAmount(integer delta)
    local profile = self:GetProfile()
    if profile == nil then return end
    local base = self._T.protectedAmountDraft
    if base == nil then base = self:GetSelectedProtection(profile) end
    -- 직접 입력 중이던 값을 우선한다 (± 는 입력값 기준 미세 조정).
    base = self:ReadNonNegative(self.protAmountInput, base)
    self:SetProtectedDraft(base + delta)
    self:SyncProtSlider()
end

@ExecSpace("ClientOnly")
method void OnProtectedMinusClicked()
    self:AdjustProtectedAmount(-1)
end

@ExecSpace("ClientOnly")
method void OnProtectedPlusClicked()
    self:AdjustProtectedAmount(1)
end

