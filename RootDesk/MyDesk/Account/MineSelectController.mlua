-- T-07 (F7-E §9.2 결정 9): 광산 선택 화면의 "튜토리얼 다시 보기" 진입점.
property ButtonComponent btnTutorialReplay = "a32d8d87-4584-4d14-88c2-bd69b18231d9"

@ExecSpace("ClientOnly")
method void OnBeginPlay()
    self._T.handlers = {}
    self._T.lastState = ""
    self._T.selectedOre = "stone"
    self._T.includeProtected = false
    self._T.protectedAmountDraft = nil
    self._T.localSaleHint = ""
    self._T.cartWorkerIndex = 1
    self._T.upgradeMsgAtOpen = ""
    if self.selectPanel ~= nil then self.selectPanel.Enable = false end
    if self.salePanel ~= nil then self.salePanel.Enable = false end
    if self.rarePanel ~= nil then self.rarePanel.Enable = false end
    if self.cartPanel ~= nil then self.cartPanel.Enable = false end
    if self.upgradePanel ~= nil then self.upgradePanel.Enable = false end
    self:ConnectButton("upgradeBeginner", self.btnUpgradeBeginner, self.OnUpgradeBeginnerClicked)
    self:ConnectButton("upgradeDeep", self.btnUpgradeDeep, self.OnUpgradeDeepClicked)
    self:ConnectButton("upgradeGem", self.btnUpgradeGem, self.OnUpgradeGemClicked)
    self:ConnectButton("tabMines", self.btnTabMines, self.OnTabMinesClicked)
    self:ConnectButton("tabUpgrade", self.btnTabUpgrade, self.OnTabUpgradeClicked)
    self:ConnectButton("upgradeConfirm", self.btnUpgradeConfirm, self.OnUpgradeConfirmClicked)
    self:ConnectButton("upgradeClose", self.btnUpgradeClose, self.OnUpgradeCloseClicked)
    self:ConnectButton("open", self.btnOpen, self.OnOpenClicked)
    self:ConnectButton("close", self.btnClose, self.OnCloseClicked)
    self:ConnectButton("sell", self.btnSell, self.OnSellClicked)
    self:ConnectButton("beginner", self.btnBeginner, self.OnBeginnerClicked)
    self:ConnectButton("deep", self.btnDeep, self.OnDeepClicked)
    self:ConnectButton("gem", self.btnGem, self.OnGemClicked)
    self:ConnectButton("saleClose", self.btnSaleClose, self.OnSaleCloseClicked)
    self:ConnectButton("oreStone", self.btnOreStone, self.OnOreStoneClicked)
    self:ConnectButton("oreIron", self.btnOreIron, self.OnOreIronClicked)
    self:ConnectButton("oreGold", self.btnOreGold, self.OnOreGoldClicked)
    self:ConnectButton("saleMinus", self.btnSaleMinus, self.OnSaleMinusClicked)
    self:ConnectButton("salePlus", self.btnSalePlus, self.OnSalePlusClicked)
    self:ConnectButton("quickAll", self.btnQuickAll, self.OnQuickAllClicked)
    if self.saleSlider ~= nil then
        self._T.saleSliderHandler = self.saleSlider.Entity:ConnectEvent(SliderValueChangedEvent, self.OnSaleSliderChanged)
    end
    if self.protSlider ~= nil then
        self._T.protSliderHandler = self.protSlider.Entity:ConnectEvent(SliderValueChangedEvent, self.OnProtSliderChanged)
    end
    self:ConnectButton("sellSelected", self.btnSellSelected, self.OnSellSelectedClicked)
    self:ConnectButton("toggleProtected", self.btnToggleProtected, self.OnToggleProtectedClicked)
    self:ConnectButton("saveProtection", self.btnSaveProtection, self.OnSaveProtectionClicked)
    self:ConnectButton("protectedMinus", self.btnProtectedMinus, self.OnProtectedMinusClicked)
    self:ConnectButton("protectedPlus", self.btnProtectedPlus, self.OnProtectedPlusClicked)
    self:ConnectButton("toggleAutoSell", self.btnToggleAutoSell, self.OnToggleAutoSellClicked)
    self:ConnectButton("rareOpen", self.btnRareOpen, self.OnRareOpenClicked)
    self:ConnectButton("rareClose", self.btnRareClose, self.OnRareCloseClicked)
    self:ConnectButton("buyWorker", self.btnBuyWorker, self.OnBuyWorkerClicked)
    self:ConnectButton("rareStone", self.btnRareStone, self.OnRareStoneClicked)
    self:ConnectButton("rareIron", self.btnRareIron, self.OnRareIronClicked)
    self:ConnectButton("rareGold", self.btnRareGold, self.OnRareGoldClicked)
    self:ConnectButton("rareStoneAuto", self.btnRareStoneAuto, self.OnRareStoneAutoClicked)
    self:ConnectButton("rareIronAuto", self.btnRareIronAuto, self.OnRareIronAutoClicked)
    self:ConnectButton("rareGoldAuto", self.btnRareGoldAuto, self.OnRareGoldAutoClicked)
    self:ConnectButton("cartOpen", self.btnCartOpen, self.OnCartOpenClicked)
    self:ConnectButton("cartClose", self.btnCartClose, self.OnCartCloseClicked)
    self:ConnectButton("cartWorker1", self.btnCartWorker1, self.OnCartWorker1Clicked)
    self:ConnectButton("cartWorker2", self.btnCartWorker2, self.OnCartWorker2Clicked)
    self:ConnectButton("cartWorker3", self.btnCartWorker3, self.OnCartWorker3Clicked)
    self:ConnectButton("cartWorker4", self.btnCartWorker4, self.OnCartWorker4Clicked)
    self:ConnectButton("cartWorker5", self.btnCartWorker5, self.OnCartWorker5Clicked)
    self:ConnectButton("cartUpgrade", self.btnCartUpgrade, self.OnCartUpgradeClicked)
    self:ConnectButton("tutorialReplay", self.btnTutorialReplay, self.OnTutorialReplayClicked)
    self:RefreshUI(true)
    log("[MineSelectUI] F7-B selector ready")
end

@ExecSpace("ClientOnly")
method void OnUpdate(number delta)
    self:RefreshUI(false)
end

@ExecSpace("ClientOnly")
method void ConnectButton(string key, ButtonComponent button, any callback)
    if button == nil then return end
    self._T.handlers[key] = button.Entity:ConnectEvent(ButtonClickEvent, callback)
end

@ExecSpace("ClientOnly")
method AccountProfileService GetProfile()
    local player = _UserService.LocalPlayer
    if player == nil then return nil end
    ---@type AccountProfileService
    local profile = player:GetComponent("script.AccountProfileService")
    return profile
end

@ExecSpace("ClientOnly")
method void RefreshUI(boolean force)
    local profile = self:GetProfile()
    if profile == nil then return end
    local state = tostring(profile.Gold) .. ":" .. tostring(profile.MineTokens) .. ":" .. tostring(profile.Stone) .. ":" .. tostring(profile.Iron) .. ":" .. tostring(profile.GoldOre) .. ":" .. tostring(profile.RareStoneCollectionLevel) .. ":" .. tostring(profile.RareIronCollectionLevel) .. ":" .. tostring(profile.RareGoldCollectionLevel) .. ":" .. tostring(profile.RareStoneStored) .. ":" .. tostring(profile.RareIronStored) .. ":" .. tostring(profile.RareGoldStored) .. ":" .. tostring(profile.OwnedWorkerCount) .. ":" .. tostring(profile.Worker1CartCapacity) .. ":" .. tostring(profile.Worker2CartCapacity) .. ":" .. tostring(profile.Worker3CartCapacity) .. ":" .. tostring(profile.Worker4CartCapacity) .. ":" .. tostring(profile.Worker5CartCapacity) .. ":" .. tostring(profile.StoneAutoSell) .. ":" .. tostring(profile.IronAutoSell) .. ":" .. tostring(profile.GoldOreAutoSell) .. ":" .. tostring(profile.StoneProtectedAmount) .. ":" .. tostring(profile.IronProtectedAmount) .. ":" .. tostring(profile.GoldOreProtectedAmount) .. ":" .. tostring(profile.DeepMineUnlocked) .. ":" .. tostring(profile.GemMineUnlocked) .. ":" .. profile.LastTransactionMessage .. ":" .. profile.RecoveryStatus
    state = state .. ":" .. tostring(profile.RareStoneAutoSell) .. ":" .. tostring(profile.RareIronAutoSell) .. ":" .. tostring(profile.RareGoldAutoSell)
    state = state .. ":" .. tostring(profile.StoneEffectiveProtection) .. ":" .. tostring(profile.IronEffectiveProtection) .. ":" .. tostring(profile.GoldOreEffectiveProtection)
    -- 입장 중인 광산. 노드 뱃지가 이 값으로 갈리므로 감지 키에 반드시 있어야
    -- 한다 — 빠지면 광산을 옮겨도 뱃지가 안 바뀐다 (D-11/D-12 계열 무증상 실패).
    state = state .. ":" .. tostring(profile.LastMineId)
    -- T-03 맵 강화 표기 계약. 키에서 빠지면 강화해도 패널·레벨 표시가 갱신되지
    -- 않는다 (docs/23 §5-3 무증상 실패).
    state = state .. ":" .. profile.MineUpgradeInfoJson .. ":" .. tostring(profile.MineLevelBeginner) .. ":" .. tostring(profile.MineLevelDeep) .. ":" .. tostring(profile.MineLevelGem)
    -- T-15: 같은 문구가 재전송돼도(시퀀스만 증가) 피드백 줄이 다시 그려지게 한다
    -- (팝업 억제 목록 반영이 한 프레임 안에 화면에 닿아야 한다).
    state = state .. ":" .. tostring(profile.LastTransactionSeq)
    if not force and state == self._T.lastState then return end
    self._T.lastState = state

    -- 헤더 재화는 아이콘+숫자 쌍 5개로 그린다 (2026-08-25 오너 요청 —
    -- resourceText 문자열 표기는 폐지, 엔티티는 Enable=false 로 잔존).
    if self.goldText ~= nil then self.goldText.Text = tostring(profile.Gold) end
    if self.tokenText ~= nil then self.tokenText.Text = tostring(profile.MineTokens) end
    if self.stoneText ~= nil then self.stoneText.Text = tostring(profile.Stone) end
    if self.ironText ~= nil then self.ironText.Text = tostring(profile.Iron) end
    if self.goldOreText ~= nil then self.goldOreText.Text = tostring(profile.GoldOre) end
    -- T-15 개정 (2026-08-22 오너): 카드에는 광산 이름만, 일러스트 위에 표시한다.
    -- 해금·강화 비용은 카드에 상시 표기하지 않는다 — 강화 비용은 [광산 강화]
    -- 확인 팝업이, 해금 부족분은 서버 거절 문구(DescribeShortfall)가 알려 준다.
    if self.beginnerText ~= nil then self.beginnerText.Text = "초급 광산" end
    if self.deepText ~= nil then self.deepText.Text = "깊은 광산" end
    if self.gemText ~= nil then self.gemText.Text = "보석 광산" end
    self:RefreshMineNodes(profile)
    if self.feedbackText ~= nil then
        -- 실패·거절류는 전역 TransactionNoticeLogic 이 팝업으로 안내한다 —
        -- 같은 문구를 헤더에 중복 표기하지 않는다.
        if profile.LastTransactionMessage ~= "" and not _TransactionNoticeLogic:IsSuppressed(profile.LastTransactionMessage) then
            self.feedbackText.Text = profile.LastTransactionMessage
        elseif profile.RecoveryStatus ~= "" then self.feedbackText.Text = profile.RecoveryStatus
        else self.feedbackText.Text = "광물은 다음 광산 해금에 필요한 수량만 자동 보호됩니다."
        end
    end
    if self.workerStatusText ~= nil then self.workerStatusText.Text = self:GetWorkerPurchaseStatus(profile) end
    if self.rareSummaryText ~= nil then self.rareSummaryText.Text = "희귀 컬렉션  돌 " .. tostring(profile.RareStoneCollectionLevel) .. "/10 (보관 " .. tostring(profile.RareStoneStored) .. ") · 철 " .. tostring(profile.RareIronCollectionLevel) .. "/10 (보관 " .. tostring(profile.RareIronStored) .. ") · 금 " .. tostring(profile.RareGoldCollectionLevel) .. "/10 (보관 " .. tostring(profile.RareGoldStored) .. ")" end
    if self.cartSummaryText ~= nil then self.cartSummaryText.Text = self:GetCartSummary(profile) end
    if self.cartNextUpgradeText ~= nil then self.cartNextUpgradeText.Text = self:GetCartUpgradeLine(profile) end
    if self.rareSummaryText ~= nil then self.rareSummaryText.Text = self:GetRareSummary(profile) end
    self:RefreshSaleSummary(profile)
    self:RefreshUpgradePanel(profile)
end

@ExecSpace("ClientOnly")
method string FormatTicksAsTime(number ticks)
    -- 0.4초 틱을 "m분 s초"로 환산해 병기한다 (F7-B §5.6.2).
    local totalSeconds = math.floor(ticks * 0.4 + 0.5)
    local minutes = math.floor(totalSeconds / 60)
    local seconds = totalSeconds - minutes * 60
    return tostring(minutes) .. "분 " .. tostring(seconds) .. "초"
end

@ExecSpace("ClientOnly")
method string FormatMultiplier(number value)
    -- 1.13 → "1.13배". 소수 둘째 자리까지.
    return string.format("%.2f배", value)
end

@ExecSpace("ClientOnly")
method string BuildEffectLine(string label, boolean isPrimary, number nowPct, number nextPct, string extra, boolean isMax)
    -- §5.6.1: 4효과를 항상 4줄, 주 효과에만 (주), 누적값 + 강화 후 값을 → 병기.
    local line = label
    if isPrimary then line = line .. " (주)" end
    line = line .. "   +" .. tostring(math.floor(nowPct)) .. "%"
    if not isMax then line = line .. "  →  +" .. tostring(math.floor(nextPct)) .. "%" end
    if extra ~= "" then line = line .. "   (" .. extra .. ")" end
    return line
end

@ExecSpace("ClientOnly")
method void RefreshUpgradePanel(AccountProfileService profile)
    -- 서버가 내려보낸 MineUpgradeInfoJson 을 그대로 그린다. 재계산 금지 (§5.6.3).
    if self.upgradeLevelText == nil then return end
    local raw = profile.MineUpgradeInfoJson
    if raw == nil or raw == "" then return end
    local info = _HttpService:JSONDecode(raw)
    if info == nil then return end

    local mineName = "초보 광산"
    if info.mineId == "deep_mine" then mineName = "깊은 광산"
    elseif info.mineId == "gem_mine" then mineName = "보석 광산" end
    self.upgradeLevelText.Text = mineName .. "   Lv." .. tostring(math.floor(info.level)) .. " / 10"

    local isMax = info.maxLevel == true
    -- §5.6.2 절대값 병기 · §5.6.4 recovery 는 희귀 철 합산 결과를 병기.
    local recoveryExtra = "합산 " .. self:FormatMultiplier(info.recoveryMultiplierNow)
    if not isMax then recoveryExtra = recoveryExtra .. " → " .. self:FormatMultiplier(info.recoveryMultiplierNext) end
    local rareExtra = tostring(math.floor(info.rareBpNow)) .. "bp"
    if not isMax then rareExtra = rareExtra .. " → " .. tostring(math.floor(info.rareBpNext)) .. "bp" end
    local specialExtra = self:FormatTicksAsTime(info.specialTicksNow)
    if not isMax then specialExtra = specialExtra .. " → " .. self:FormatTicksAsTime(info.specialTicksNext) end
    local primary = tostring(info.primaryEffect)
    self.upgradeEffectsText.Text =
        self:BuildEffectLine("획득량", primary == "yield", info.yieldNowPct, info.yieldNextPct, "", isMax) .. "\n"
        .. self:BuildEffectLine("회복 속도", primary == "recovery", info.recoveryNowPct, info.recoveryNextPct, recoveryExtra, isMax) .. "\n"
        .. self:BuildEffectLine("희귀 확률", primary == "rareChance", info.rareChanceNowPct, info.rareChanceNextPct, rareExtra, isMax) .. "\n"
        .. self:BuildEffectLine("특별 광맥", primary == "specialSpawn", info.specialSpawnNowPct, info.specialSpawnNextPct, specialExtra, isMax)

    if self.upgradeCostText ~= nil then
        if isMax then
            self.upgradeCostText.Text = "최대 레벨"
        else
            self.upgradeCostText.Text = "다음 강화: 골드 " .. tostring(math.floor(info.nextCostGold)) .. " · " .. self:OreLabel(tostring(info.nextCostOreType)) .. " " .. tostring(math.floor(info.nextCostOre))
        end
    end
    if self.btnUpgradeConfirm ~= nil then self.btnUpgradeConfirm.Enable = not isMax end

    if self.upgradeFeedbackText ~= nil then
        -- 모달을 연 시점 이후의 결과만 그린다 — 이전 화면의 메시지가 남지 않는다
        -- (docs/23 §5-2·R5). 성공·실패 모두 같은 자리, 색이 아니라 문구로 구분.
        if profile.LastTransactionMessage ~= "" and profile.LastTransactionMessage ~= self._T.upgradeMsgAtOpen then
            self.upgradeFeedbackText.Text = profile.LastTransactionMessage
        elseif isMax then
            self.upgradeFeedbackText.Text = "이 광산은 최대 레벨입니다."
        else
            self.upgradeFeedbackText.Text = "강화 비용은 입장 중인 광산의 대표 광물로 지불합니다."
        end
    end
end

@ExecSpace("ClientOnly")
method string GetMineNodeState(string mineId, string currentMineId, boolean unlocked)
    -- 노드 상태 결정의 단일 기준. 뱃지와 로그가 같은 값을 본다.
    -- `beginner_mine` 도 받는 것은 레이아웃 mineId 와 맵 이름이 다르기 때문이며,
    -- MineInventoryController 의 표시명 처리와 같은 이유다.
    if mineId == currentMineId then return "current" end
    if mineId == "farm01" and currentMineId == "beginner_mine" then return "current" end
    if unlocked then return "next" end
    return "locked"
end

@ExecSpace("ClientOnly")
method void ApplyMineNode(SpriteGUIRendererComponent node, string state)
    -- 상태 문자열 하나를 RUID 로 옮긴다. 판정은 GetMineNodeState 가 이미 끝냈다.
    if node == nil then return end
    if state == "current" then
        node.ImageRUID = DataRef(self.MineNodeCurrent)
    elseif state == "next" then
        node.ImageRUID = DataRef(self.MineNodeNext)
    else
        node.ImageRUID = DataRef(self.MineNodeLocked)
    end
end

@ExecSpace("ClientOnly")
method void RefreshMineNodes(AccountProfileService profile)
    -- 세 광산 뱃지를 입장 중 / 해금 / 잠금으로 칠한다. 초보 광산은 항상 해금이다.
    local current = profile.LastMineId
    local beginner = self:GetMineNodeState("farm01", current, true)
    local deep = self:GetMineNodeState("deep_mine", current, profile.DeepMineUnlocked)
    local gem = self:GetMineNodeState("gem_mine", current, profile.GemMineUnlocked)
    self:ApplyMineNode(self.beginnerNode, beginner)
    self:ApplyMineNode(self.deepNode, deep)
    self:ApplyMineNode(self.gemNode, gem)
    self:ApplyUpgradeButton(self.btnUpgradeBeginner, beginner)
    self:ApplyUpgradeButton(self.btnUpgradeDeep, deep)
    self:ApplyUpgradeButton(self.btnUpgradeGem, gem)
    log("[MineSelect] nodes current=" .. tostring(current)
        .. " beginner=" .. beginner .. " deep=" .. deep .. " gem=" .. gem)
end

@ExecSpace("ClientOnly")
method void ApplyUpgradeButton(ButtonComponent button, string state)
    -- T-15: 광산별 강화 버튼. 서버 RequestMineUpgrade 가 입장 중인 광산만
    -- 강화하므로 current 만 활성이다. 튜토리얼 잠금 중에는 Enable 을 건드리지
    -- 않는다 — ApplyStepLocks 의 잠금을 되살리면 안 된다.
    if button == nil then return end
    local label = button.Entity.TextGUIRendererComponent
    if state == "current" then
        if label ~= nil then label.Text = "광산 강화" end
        if _TutorialController == nil or not _TutorialController:IsUiDragLocked() then
            button.Enable = true
        end
    else
        if label ~= nil then label.Text = "입장 후 강화" end
        button.Enable = false
    end
end

@ExecSpace("ClientOnly")
method void ShowTab(boolean mines)
    -- T-15: 탭 전환 = 컨테이너 Enable 토글 + 탭 버튼 파츠 스왑 (selected/normal).
    if self.minesTab ~= nil then self.minesTab.Enable = mines end
    if self.upgradeTab ~= nil then self.upgradeTab.Enable = not mines end
    self:ApplyTabSkin(self.btnTabMines, mines)
    self:ApplyTabSkin(self.btnTabUpgrade, not mines)
end

@ExecSpace("ClientOnly")
method void ApplyTabSkin(ButtonComponent tabButton, boolean selected)
    -- 활성 탭 = tab-worker-selected, 비활성 = tab-worker-normal (docs/26 §5).
    if tabButton == nil then return end
    local sprite = tabButton.Entity.SpriteGUIRendererComponent
    if sprite == nil then return end
    if selected then
        sprite.ImageRUID = DataRef(self.TabSelectedRUID)
    else
        sprite.ImageRUID = DataRef(self.TabNormalRUID)
    end
end

@ExecSpace("ClientOnly")
method void OnTabMinesClicked()
    self:ShowTab(true)
end

@ExecSpace("ClientOnly")
method void OnTabUpgradeClicked()
    self:ShowTab(false)
end

@ExecSpace("ClientOnly")
method void TryOpenUpgrade(string mineId, boolean unlocked)
    -- T-15 개정 (2026-08-22 오너): [광산 강화]는 큰 모달 대신 "강화하시겠습니까?"
    -- 확인 팝업으로 직행한다 — 팝업 본문 아래 줄이 다음 강화 비용이다.
    -- 입장 중인 광산만 열 수 있다 (서버 RequestMineUpgrade 계약).
    local profile = self:GetProfile()
    if profile == nil then return end
    if self:GetMineNodeState(mineId, profile.LastMineId, unlocked) ~= "current" then
        if self.feedbackText ~= nil then
            self.feedbackText.Text = "광산 강화는 그 광산에 입장한 뒤 할 수 있습니다."
        end
        return
    end
    -- 비용은 서버가 내려보낸 MineUpgradeInfoJson 그대로 — 재계산 금지 (F7-B §5.6.3).
    local raw = profile.MineUpgradeInfoJson
    if raw == nil or raw == "" then return end
    local info = _HttpService:JSONDecode(raw)
    if info == nil then return end
    if info.maxLevel == true then
        if self.feedbackText ~= nil then self.feedbackText.Text = "이 광산은 최대 레벨입니다." end
        return
    end
    local costLine = "다음 강화 비용: 골드 " .. tostring(math.floor(info.nextCostGold))
        .. " · " .. self:OreLabel(tostring(info.nextCostOreType)) .. " " .. tostring(math.floor(info.nextCostOre))
    local message = "광산을 강화하시겠습니까?\nLv." .. tostring(math.floor(info.level)) .. " → Lv." .. tostring(math.floor(info.level) + 1) .. "\n" .. costLine
    log("[MineSelectUI] upgrade confirm popup mine=" .. mineId .. " " .. costLine)
    _UIPopup:Open(message, function()
        local requestProfile = self:GetProfile()
        if requestProfile ~= nil then
            log("[MineSelectUI] upgrade request sent (popup confirm)")
            -- 결과(성공/부족/실패) 안내는 전역 TransactionNoticeLogic 이 팝업으로 띄운다.
            requestProfile:RequestMineUpgrade()
        end
    end, nil)
end

@ExecSpace("ClientOnly")
method void OnUpgradeBeginnerClicked()
    self:TryOpenUpgrade("farm01", true)
end

@ExecSpace("ClientOnly")
method void OnUpgradeDeepClicked()
    local profile = self:GetProfile()
    self:TryOpenUpgrade("deep_mine", profile ~= nil and profile.DeepMineUnlocked)
end

@ExecSpace("ClientOnly")
method void OnUpgradeGemClicked()
    local profile = self:GetProfile()
    self:TryOpenUpgrade("gem_mine", profile ~= nil and profile.GemMineUnlocked)
end

@ExecSpace("ClientOnly")
method integer GetCartCapacity(AccountProfileService profile, integer workerIndex)
    if workerIndex == 1 then return profile.Worker1CartCapacity end
    if workerIndex == 2 then return profile.Worker2CartCapacity end
    if workerIndex == 3 then return profile.Worker3CartCapacity end
    if workerIndex == 4 then return profile.Worker4CartCapacity end
    return profile.Worker5CartCapacity
end

@ExecSpace("ClientOnly")
method string GetCartOreLabel()
    local player = _UserService.LocalPlayer
    if player == nil or player.CurrentMap == nil then return "광물" end
    if player.CurrentMap.Name == "farm01" then return "돌" end
    if player.CurrentMap.Name == "deep_mine" then return "철" end
    if player.CurrentMap.Name == "gem_mine" then return "금광석" end
    return "광물"
end

@ExecSpace("ClientOnly")
method string GetCartSummary(AccountProfileService profile)
    -- Header line only (worker + capacity); the next-upgrade line moved to GetCartUpgradeLine (2026-08-21 오너 요청).
    local workerIndex = self._T.cartWorkerIndex
    local capacity = self:GetCartCapacity(profile, workerIndex)
    if workerIndex > profile.OwnedWorkerCount then
        return "일꾼 " .. tostring(workerIndex) .. "  ·  아직 고용되지 않았습니다"
    end
    return "일꾼 " .. tostring(workerIndex) .. "  ·  적재량 " .. tostring(capacity) .. " / 50칸"
end

@ExecSpace("ClientOnly")
method string GetCartUpgradeLine(AccountProfileService profile)
    -- Next-upgrade cost line shown right above the upgrade button.
    local workerIndex = self._T.cartWorkerIndex
    local capacity = self:GetCartCapacity(profile, workerIndex)
    local level = math.max(0, math.floor((capacity - 20) / 2))
    if workerIndex > profile.OwnedWorkerCount then
        return "현재 적재량: " .. tostring(capacity) .. "칸"
    end
    if level >= 15 then
        return "최대 강화 완료"
    end
    local nextLevel = level + 1
    local rawGoldCost = 20
    for index = 2, nextLevel do rawGoldCost = rawGoldCost * 1.25 end
    local goldCost = math.floor(rawGoldCost + 0.5)
    return "다음 강화: 골드 " .. tostring(goldCost) .. " / " .. self:GetCartOreLabel() .. " " .. tostring(5 * nextLevel) .. "  (+2칸)"
end

@ExecSpace("ClientOnly")
method string GetWorkerPurchaseStatus(AccountProfileService profile)
    local owned = profile.OwnedWorkerCount
    if owned >= 5 then return "일꾼 " .. tostring(owned) .. " / 5  ·  모두 고용함" end
    if owned == 1 then return "일꾼 1 / 5  ·  다음: 60 골드" end
    if owned == 2 then return "일꾼 2 / 5  ·  다음: 깊은 광산 + 200 골드 / 돌 80" end
    if owned == 3 then return "일꾼 3 / 5  ·  다음: 보석 광산 + 650 골드 / 돌 160 / 철 50" end
    return "일꾼 4 / 5  ·  다음: 1,600 골드 / 돌 300 / 철 120 / 금광석 30"
end

@ExecSpace("ClientOnly")
method integer GetSelectedBalance(AccountProfileService profile)
    if self._T.selectedOre == "stone" then return profile.Stone end
    if self._T.selectedOre == "iron" then return profile.Iron end
    return profile.GoldOre
end

@ExecSpace("ClientOnly")
method integer GetSelectedProtection(AccountProfileService profile)
    if self._T.selectedOre == "stone" then return profile.StoneProtectedAmount end
    if self._T.selectedOre == "iron" then return profile.IronProtectedAmount end
    return profile.GoldOreProtectedAmount
end

@ExecSpace("ClientOnly")
method boolean GetSelectedAutoSell(AccountProfileService profile)
    if self._T.selectedOre == "stone" then return profile.StoneAutoSell end
    if self._T.selectedOre == "iron" then return profile.IronAutoSell end
    return profile.GoldOreAutoSell
end

@ExecSpace("ClientOnly")
method boolean IsSalePanelOpen()
    -- 판매 패널이 실제로 화면에 떠 있는가. 튜토리얼 화살표가 이 패널 **안의**
    -- 버튼(보호분 판매 토글)을 가리키기 전에 확인한다 — 닫힌 패널의 버튼은
    -- `GetWorldCorners()` 가 화면 밖/낡은 좌표를 주어 화살표가 허공에 뜬다
    -- (2026-08-21 오너 스크린샷, docs/16 §49).
    return self.salePanel ~= nil and isvalid(self.salePanel) and self.salePanel.Enable
end

method boolean IsSaleBlockedByProtection(AccountProfileService profile)
    -- 지금 [선택 수량 판매]를 누르면 반드시 거절되는 상태인가 —
    -- 보호분 판매가 꺼져 있고 보유량이 전부 보호 수량에 걸린 경우.
    -- 판정값은 서버가 판매를 거절할 때 쓰는 EffectiveProtection 과 같다.
    -- 소유자(여기)가 답한다 — 다른 스크립트가 `_T.includeProtected` 를 직접
    -- 들여다보지 않게 하기 위한 공개 창구다 (TutorialController 7단계 화살표).
    if profile == nil then return false end
    if self._T.includeProtected == true then return false end
    return self:GetSelectedBalance(profile) <= self:GetSelectedEffectiveProtection(profile)
end

method integer GetSelectedEffectiveProtection(AccountProfileService profile)
    -- max(설정 보호, 다음 광산 해금 필요량). 서버가 판매를 판정할 때 쓰는 값이다.
    if self._T.selectedOre == "stone" then return profile.StoneEffectiveProtection end
    if self._T.selectedOre == "iron" then return profile.IronEffectiveProtection end
    return profile.GoldOreEffectiveProtection
end

@ExecSpace("ClientOnly")
method void ApplyOreButtonSkins()
    -- 선택된 광물 버튼을 어둡게 표시 — "선택: X" 텍스트를 대체한다
    -- (2026-08-25 오너 요청, §52-11 워커 탭과 같은 규칙).
    local selected = Color(0.55, 0.55, 0.55, 1)
    local normal = Color(1, 1, 1, 1)
    if self.oreStoneSprite ~= nil then
        if self._T.selectedOre == "stone" then self.oreStoneSprite.Color = selected
        else self.oreStoneSprite.Color = normal end
    end
    if self.oreIronSprite ~= nil then
        if self._T.selectedOre == "iron" then self.oreIronSprite.Color = selected
        else self.oreIronSprite.Color = normal end
    end
    if self.oreGoldSprite ~= nil then
        if self._T.selectedOre == "gold" then self.oreGoldSprite.Color = selected
        else self.oreGoldSprite.Color = normal end
    end
end

@ExecSpace("ClientOnly")
method string OreLabel(string oreType)
    -- 요약에 코드값(stone)이 아니라 한글 라벨을 보여 준다.
    if oreType == "stone" then return "돌" end
    if oreType == "iron" then return "철" end
    if oreType == "gold" then return "금광석" end
    return oreType
end

@ExecSpace("ClientOnly")
method void RefreshSaleSummary(AccountProfileService profile)
    if self.saleSummaryText ~= nil then
        local autoLabel = "끔"
        if self:GetSelectedAutoSell(profile) then autoLabel = "켬" end
        local balance = self:GetSelectedBalance(profile)
        local effective = self:GetSelectedEffectiveProtection(profile)
        local sellable = balance - effective
        if sellable < 0 then sellable = 0 end
        -- 2026-08-25 개정: "선택: X" 는 광물 버튼 어둡게로, "보호분 판매 Y" 는
        -- 아래 토글이 이미 보여 주므로 요약에서 뺀다 (오너 요청).
        self.saleSummaryText.Text = "보유 " .. tostring(balance) .. "  |  보호 " .. tostring(effective) .. " (설정 " .. tostring(self:GetSelectedProtection(profile)) .. ")\n지금 팔 수 있는 수량 " .. tostring(sellable) .. "  |  자동판매 " .. autoLabel
    end
    if self._T.protectedAmountDraft == nil then
        self._T.protectedAmountDraft = self:GetSelectedProtection(profile)
        if self.protAmountInput ~= nil then self.protAmountInput.Text = tostring(self._T.protectedAmountDraft) end
        self:SyncProtSlider()
    end
    if self.saleSlider ~= nil then
        self.saleSlider.MaxValue = math.max(1, self:GetSelectedBalance(profile))
    end
    if self.protSlider ~= nil then
        self.protSlider.MaxValue = 999
    end
    self:ApplyOreButtonSkins()
    if self.protectedToggleSprite ~= nil then
        if self._T.includeProtected then self.protectedToggleSprite.ImageRUID = DataRef(self.ToggleOnRUID)
        else self.protectedToggleSprite.ImageRUID = DataRef(self.ToggleOffRUID) end
    end
    if self.btnToggleProtected ~= nil and self.btnToggleProtected.Entity.TextGUIRendererComponent ~= nil then
        if self._T.includeProtected then self.btnToggleProtected.Entity.TextGUIRendererComponent.Text = "보호분 판매 ON"
        else self.btnToggleProtected.Entity.TextGUIRendererComponent.Text = "보호분 판매 OFF" end
    end
    if self.autoSellToggleSprite ~= nil then
        if self:GetSelectedAutoSell(profile) then self.autoSellToggleSprite.ImageRUID = DataRef(self.ToggleOnRUID)
        else self.autoSellToggleSprite.ImageRUID = DataRef(self.ToggleOffRUID) end
    end
    if self.btnToggleAutoSell ~= nil and self.btnToggleAutoSell.Entity.TextGUIRendererComponent ~= nil then
        if self:GetSelectedAutoSell(profile) then self.btnToggleAutoSell.Entity.TextGUIRendererComponent.Text = "자동 판매 ON"
        else self.btnToggleAutoSell.Entity.TextGUIRendererComponent.Text = "자동 판매 OFF" end
    end
    if self.protectedWarningIcon ~= nil then
        self.protectedWarningIcon.Enable = self:GetSelectedBalance(profile) <= self:GetSelectedEffectiveProtection(profile) and not self._T.includeProtected
    end
    self:RefreshSaleFeedback(profile)
end

@ExecSpace("ClientOnly")
method void RefreshSaleFeedback(AccountProfileService profile)
    -- 판매 패널 전용 피드백. LastTransactionMessage 는 SelectPanel 의 FeedbackText 에만
    -- 있었고, 판매 패널을 열면 SelectPanel 이 꺼지므로 거부 사유가 화면에서 사라졌다
    -- (docs/16 §14 D-10).
    if self.saleFeedbackText == nil then return end
    if self._T.localSaleHint ~= nil and self._T.localSaleHint ~= "" then
        self.saleFeedbackText.Text = self._T.localSaleHint
        return
    end
    if profile.LastTransactionMessage ~= "" and not _TransactionNoticeLogic:IsSuppressed(profile.LastTransactionMessage) then
        self.saleFeedbackText.Text = profile.LastTransactionMessage
        return
    end
    local balance = self:GetSelectedBalance(profile)
    local effective = self:GetSelectedEffectiveProtection(profile)
    if balance <= effective and not self._T.includeProtected then
        -- 버튼 실제 라벨은 `보호분 판매 OFF/ON` 이다 — 문구가 없는 이름을 가리키면
        -- 사용자가 무엇을 눌러야 할지 못 찾는다 (2026-08-21 오너 보고, docs/16 §47).
        self.saleFeedbackText.Text = "보유 " .. tostring(balance) .. "개가 모두 보호 수량(" .. tostring(effective) .. ")입니다. 팔려면 [보호분 판매 OFF]를 눌러 ON 으로 바꾸세요."
        return
    end
    self.saleFeedbackText.Text = "광물과 수량을 고른 뒤 `선택 수량 판매`를 누르세요."
end

@ExecSpace("ClientOnly")
method integer ReadNonNegative(TextGUIRendererInputComponent input, integer fallback)
    if input == nil then return fallback end
    local parsed = tonumber(input.Text)
    if parsed == nil then return fallback end
    return math.max(0, math.floor(parsed))
end

@ExecSpace("ClientOnly")
method void SelectOre(string oreType)
    self._T.selectedOre = oreType
    self._T.includeProtected = false
    -- 이전 요청의 힌트를 지운다. 지우지 않으면 한 번 뜬 "수량은 1 이상" 문구가
    -- 계속 남아 이후의 서버 거부 사유를 덮는다.
    self._T.localSaleHint = ""
    local profile = self:GetProfile()
    if profile ~= nil then
        self._T.protectedAmountDraft = self:GetSelectedProtection(profile)
        if self.protAmountInput ~= nil then self.protAmountInput.Text = tostring(self._T.protectedAmountDraft) end
        self:SyncProtSlider()
    end
    self:RefreshUI(true)
end

@ExecSpace("ClientOnly")
method void OnOpenClicked()
    -- 토글: 광산 선택 계열 패널이 하나라도 열려 있으면 전부 닫는다 (2026-08-20
    -- 오너 요청 — 라이브러리와 동일한 열기 버튼 재클릭 닫기).
    local anyOpen = (self.selectPanel ~= nil and self.selectPanel.Enable)
        or (self.salePanel ~= nil and self.salePanel.Enable)
        or (self.rarePanel ~= nil and self.rarePanel.Enable)
        or (self.cartPanel ~= nil and self.cartPanel.Enable)
        or (self.upgradePanel ~= nil and self.upgradePanel.Enable)
    if anyOpen then
        self:CloseAllPanelsForTutorial()
        log("[MineSelect] closed by toggle")
        return
    end
    -- T-12-B: 중앙 모달은 한 번에 하나 — 설정 모달이 열려 있으면 닫는다 (F5 §6.1).
    if _SettingsPanelController ~= nil then _SettingsPanelController:ClosePanel() end
    if _AppearanceController ~= nil then _AppearanceController:ClosePanel() end
    if self.selectPanel ~= nil then self.selectPanel.Enable = true end
    if self.salePanel ~= nil then self.salePanel.Enable = false end
    if self.rarePanel ~= nil then self.rarePanel.Enable = false end
    if self.upgradePanel ~= nil then self.upgradePanel.Enable = false end
    -- T-15: 열 때는 항상 [광산] 탭부터 보인다.
    self:ShowTab(true)
    self:RefreshUI(true)
end

@ExecSpace("ClientOnly")
method void OnCloseClicked()
    if self.selectPanel ~= nil then self.selectPanel.Enable = false end
    if self.salePanel ~= nil then self.salePanel.Enable = false end
    if self.rarePanel ~= nil then self.rarePanel.Enable = false end
    if self.upgradePanel ~= nil then self.upgradePanel.Enable = false end
end

@ExecSpace("ClientOnly")
method void OnSellClicked()
    -- 2026-08-25 (docs/16 §63): [판매] 는 토글 — 판매 계열(판매·희귀)이 열려
    -- 있으면 닫는다 ([광산 선택]·[인벤토리] 와 같은 재클릭 닫기). 튜토리얼
    -- 7단계는 EnterStep 이 패널을 닫고 시작하므로 첫 클릭은 항상 '열기'다.
    if (self.salePanel ~= nil and self.salePanel.Enable) or (self.rarePanel ~= nil and self.rarePanel.Enable) then
        if self.salePanel ~= nil then self.salePanel.Enable = false end
        if self.rarePanel ~= nil then self.rarePanel.Enable = false end
        self:RefreshUI(true)
        return
    end
    -- One centre modal at a time (docs/08 §6.1). Leaving selectPanel enabled
    -- stacked two same-sized panels and made both unreadable (docs/16 §13 D-8).
    if self.selectPanel ~= nil then self.selectPanel.Enable = false end
    if self.salePanel ~= nil then self.salePanel.Enable = true end
    if self.cartPanel ~= nil then self.cartPanel.Enable = false end
    if self.rarePanel ~= nil then self.rarePanel.Enable = false end
    if self.upgradePanel ~= nil then self.upgradePanel.Enable = false end
    self:SelectOre(self._T.selectedOre)
    self:SetSaleAmount(1)
end

@ExecSpace("ClientOnly")
method void OnSaleCloseClicked()
    -- 2026-08-25: T-15 개편 후 판매는 HUD [판매] 직행이라 닫기는 그냥 닫는다.
    -- (예전엔 광산 선택에서 열려 닫기가 선택 화면으로 복귀했다 — 그 잔재가
    -- "판매 닫기를 눌렀는데 광산 선택 UI가 뜬다"로 보였다. 오너 보고.)
    if self.salePanel ~= nil then self.salePanel.Enable = false end
    self:RefreshUI(true)
end

@ExecSpace("ClientOnly")
method void OnRareOpenClicked()
    if self.selectPanel ~= nil then self.selectPanel.Enable = false end
    if self.salePanel ~= nil then self.salePanel.Enable = false end
    if self.cartPanel ~= nil then self.cartPanel.Enable = false end
    if self.upgradePanel ~= nil then self.upgradePanel.Enable = false end
    if self.rarePanel ~= nil then self.rarePanel.Enable = true end
    self:RefreshUI(true)
end

