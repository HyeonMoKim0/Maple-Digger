property ButtonComponent btnRareOpen = "3ab7dc8e-ddfc-43ce-a503-c174cc6fb8c4"
property Entity rarePanel = "1e5dbbfb-0671-4eb3-84c5-d39b45ad9ecd"
property ButtonComponent btnRareClose = "f64125f4-938c-4639-8684-d5d5190311c2"
property ButtonComponent btnBuyWorker = "3595093e-2707-4992-8d2c-43b2f5a64c6a"
-- SelectPanel/WorkerStatus 는 레거시 TextComponent 를 쓴다 (docs/16 §14 D-11).
property TextComponent workerStatusText = "8d793449-ab64-4ccf-b43c-76e1f9b73324"
property ButtonComponent btnRareStone = "49556e19-68aa-4d27-bed5-a716026ab9ac"
