-- TUTORIAL CLIENT CONTROLLER (T-07 / F7-E)
-- 단계 안내·툴팁 배치·버튼 잠금/dim·판정 신호 감시·통과 요청만 담당한다.
-- 원장 변경·진행도 확정·보상은 전부 서버(TutorialService) 몫이다 (F7-E §10.1).
-- 판정 신호는 기존 @Sync 값의 변화다 (F7-E §3 — VisualEvent* 채널을 쓰지 않는다).
@Logic
script TutorialController extends Logic

-- ui/TutorialUI.ui 바인딩 (UUID 는 UIBuilder injectBindings 가 주입한다).
property Entity tutorialRoot = "2cad9ae1-57fb-44d4-95b1-4f76de3675b4"
property Entity dimmer = "ff1ec330-2963-4e4a-83ae-1ccde331debe"
property Entity tooltip = "e8afc725-2b46-4045-b8ba-b50440342198"
property TextGUIRendererComponent guideText = "514225e8-de47-4262-96e3-99dafc33028a"
property TextGUIRendererComponent progressText = "c4c129f3-991a-4d59-abbf-25a3993add3d"
property Entity arrow = "2483e6d5-7360-466b-b060-59acd95d9f44"
property ButtonComponent btnSkip = "47bafc69-2e67-422f-86c8-e5e8a584e0e9"
property any skipHandler = nil
-- 단계 진입 직후 신호 평가를 미루는 정착 시간. 일꾼 리셋 RPC 왕복 전의 낡은
-- @Sync 값을 스냅숏하는 것을 막는다.
property number SettleSeconds = 0.6
-- 접속 직후 활성화 유예. 로그인 복구(RestoreLastMineAndWorker, 0.5초)와 자동
-- 실행 판단(1.5초)이 끝난 뒤에 튜토리얼을 켜야 복구가 단계 시작 상태를 덮지
-- 않는다 (검증 중 실제 경합 관측).
property number WarmupSeconds = 3.0

-- 8단계 목표 일꾼 수. **`TutorialService.VerifyStep(8)` 의 `#workers >= 2` 와
-- 반드시 같은 값이어야 한다** — 클라 신호와 서버 재검증의 축이 어긋나면 그 틈이
-- 그대로 진행 불능이 된다 (docs/16 §48).
property integer TutorialWorkerGoal = 2

-- #4 진단 스위치 (2026-08-27 오너 보고 — "창 크기를 바꾸면 화살표가 어긋난다").
-- ⚠️ **원인 특정용으로 임시로 켜 두었다. 원인을 잡으면 반드시 false 로 되돌린다**
-- — 릴리스는 조용해야 한다(`MineLogPolicy`·`PerfProbeLogic` 과 같은 원칙).
-- 켜져 있으면 `UpdateArrowTarget` 의 환산 입출력과 조기 return 사유가 Maker
-- Console 에 `[TutorialArrow]` 로 찍힌다. `LogArrow` 가 직전과 같은 줄을
-- 걸러 내므로, 값이 바뀌는 순간에만 새 줄이 남는다.
property boolean DebugArrow = true

@ExecSpace("ClientOnly")
method void OnBeginPlay()
    -- 초기 상태: 비활성. 활성화는 OnUpdate 의 @Sync 감시가 결정한다.
    self._T.active = false
    self._T.replayActive = false
    self._T.replayRequested = false
    self._T.stepShown = 0
    self._T.settle = 0
    self._T.warmup = 0
    self._T.advanceCooldown = 0
    self._T.startCooldown = 0
    self._T.runSeen = false
    self._T.lastProgramState = ""
    self._T.lastRunHadRepeat = false
    self._T.lastRunHadIf = false
    self._T.snapshot = nil
    self._T.buttons = nil
    self._T.dimCache = {}
    self._T.completionToastShown = false
    self._T.seq = nil
    self._T.seqIndex = 0
    self._T.seqHandlers = {}
    self._T.uiGroupRef = nil
    if self.tutorialRoot ~= nil then self.tutorialRoot.Enable = false end
    -- 전화면 Dimmer 는 docs/19 §6.1 개정(2026-08-21)으로 비활성이다. Maker 재저장이
    -- 파일 초기값을 true 로 되살릴 수 있어 런타임에서도 강제로 끈다.
    if self.dimmer ~= nil then self.dimmer.Enable = false end
    if self.btnSkip ~= nil then
        self.skipHandler = self.btnSkip.Entity:ConnectEvent(ButtonClickEvent, self.OnSkipClicked)
    end
    log("[Tutorial] controller ready")
end

@ExecSpace("ClientOnly")
method void OnEndPlay()
    -- 이벤트 해제와 잠금 원복. Play 종료 시 dim 이 남지 않게 한다.
    if self.btnSkip ~= nil and self.skipHandler ~= nil then
        self.btnSkip.Entity:DisconnectEvent(ButtonClickEvent, self.skipHandler)
    end
    self:ClearSeqHandlers()
    if self._T.active then self:ReleaseAllLocks() end
end

@ExecSpace("ClientOnly")
method AccountProfileService GetProfile()
    -- 로컬 플레이어의 프로필 @Sync 미러.
    local player = _UserService.LocalPlayer
    if player == nil then return nil end
    ---@type AccountProfileService
    local profile = player:GetComponent("script.AccountProfileService")
    return profile
end

@ExecSpace("ClientOnly")
method WorkerController GetWorker()
    -- 튜토리얼 대상은 항상 일꾼 1이다 (워커 탭이 잠겨 있어 바뀌지 않는다).
    local player = _UserService.LocalPlayer
    if player == nil or player.CurrentMap == nil then return nil end
    local workerEntity = player.CurrentMap:GetChildByName("Worker01", false)
    if workerEntity == nil then return nil end
    ---@type WorkerController
    local worker = workerEntity:GetComponent("script.WorkerController")
    return worker
end

@ExecSpace("ClientOnly")
method boolean IsOnBeginnerMine()
    -- 기준 맵은 초보 광산(farm01) 하나다 (F7-E §4).
    local player = _UserService.LocalPlayer
    return player ~= nil and player.CurrentMap ~= nil and player.CurrentMap.Name == "farm01"
end

@ExecSpace("ClientOnly")
method table GetStepConfig(integer step)
    -- 단계별 안내·활성 버튼·시작 상태·툴팁/화살표 배치의 단일 정의.
    -- 5·6단계 팔레트에 이미 배운 행동 블록(L/W/U)을 포함한다 — U3(C213)의
    -- "R×5 로 돌 5개"는 왕복 1회당 돌 1개 적립을 전제하기 때문이다 (docs/16 기록).
    --
    -- 툴팁 배치 (2026-08-21 오너 보고 — 캐릭터가 안 보인다, docs/16 §50):
    -- 1~6단계는 `(240, -400)` = 화면 하단 빈 띠. 예전 `(350, -150)` 은 편집기(x -680..-40)와
    -- 광산 현황(x 480..940) 사이의 **캐릭터가 다니는 빈 띠 한복판**(x 70..630, y -265..-35)을
    -- 덮고 있었다. 새 위치는 x -40..520 / y -515..-285 로, 광산 현황과 세로가 겹치지 않고
    -- (HUD 하단 -160) 편집기 오른쪽 끝(-40)에 닿기만 한다.
    -- 7·8단계는 `(-660, 208)` 유지 — 그때는 중앙 판매/선택 모달이 주인공이라 왼쪽으로 비켜야 한다.
    if step == 1 then
        return {
            guide = "일꾼을 오른쪽으로 한 칸 보내 봐요.\n[동]를 누르고 [실행]을 누르세요.",
            fail = "일꾼이 움직이지 못했어요. [동] 하나만 넣고 다시 실행해 보세요.",
            allowed = { moveE = true, run = true, clear = true },
            reset = { cellX = 0, cellY = 0, hand = "", handCount = 0, cart = 0 },
            clearProgram = true,
            tooltipX = 240, tooltipY = -400, arrowX = -15, arrowY = 314, arrowDir = "left",
            seq = { "moveE", "run" },
        }
    elseif step == 2 then
        return {
            guide = "일꾼 발밑에 돌 광맥이 있어요.\n[채굴]을 넣고 [실행]으로 캐 봅시다.",
            fail = "여기엔 캘 광물이 없어요. 잠시 기다렸다가 다시 [채굴]을 실행해 보세요.",
            allowed = { mine = true, run = true, clear = true },
            reset = { cellX = 1, cellY = 0, hand = "", handCount = 0, cart = 0 },
            clearProgram = true,
            tooltipX = 240, tooltipY = -400, arrowX = -15, arrowY = 210, arrowDir = "left",
            seq = { "mine", "run" },
        }
    elseif step == 3 then
        return {
            guide = "손에 든 돌을 수레에 실어요.\n[적재]을 넣고 [실행]을 누르세요.",
            fail = "수레에 싣지 못했어요. [적재]을 넣고 다시 실행해 보세요.",
            allowed = { load = true, run = true, clear = true },
            reset = { cellX = 1, cellY = 0, hand = "stone", handCount = 1, cart = 0 },
            clearProgram = true,
            tooltipX = 240, tooltipY = -400, arrowX = -15, arrowY = 210, arrowDir = "left",
            seq = { "load", "run" },
        }
    elseif step == 4 then
        -- §4 예외: 4단계는 진입 시 시작 셀 복귀를 하지 않는다 (1~3단계의 결과
        -- 상태 — (1,0)·수레 돌 1 — 를 유지). 실패 복귀만 그 상태로 되돌린다.
        return {
            guide = "창고는 시작 자리예요.\n[서]로 돌아가 [하역]로 내리면 창고에 쌓입니다.",
            fail = "창고에 내리지 못했어요. [서]로 창고(시작 칸)에 돌아간 뒤 [하역]를 실행하세요.",
            allowed = { moveW = true, unload = true, run = true, clear = true },
            reset = nil,
            failReset = { cellX = 1, cellY = 0, hand = "", handCount = 0, cart = 1 },
            clearProgram = true,
            tooltipX = 240, tooltipY = -400, arrowX = -15, arrowY = 210, arrowDir = "left",
            seq = { "moveW", "unload", "run" },
        }
    elseif step == 5 then
        return {
            -- T-15b: 순서 강제 잠금으로 [횟수] 버튼을 누를 수 없게 됐다 — 기본값
            -- ×2 를 그대로 쓰도록 안내한다 (VerifyStep(5)는 반복 존재만 본다).
            guide = "같은 일을 여러 번 시키려면 [반복 추가]로 묶어요.\n횟수는 ×2 그대로 두고 안에 [동]·[채굴]·[적재]·[서]·[하역]을 넣고 [끝 ]]으로 닫은 뒤 실행하세요.",
            fail = "반복이 끝났지만 목표를 채우지 못했어요. 안내대로 반복 안에 블록을 넣고 다시 실행해 보세요.",
            allowed = { repeatAdd = true, repeatCount = true, endBlock = true, moveE = true, mine = true, load = true, moveW = true, unload = true, run = true, clear = true },
            reset = { cellX = 0, cellY = 0, hand = "", handCount = 0, cart = 0 },
            clearProgram = true,
            tooltipX = 240, tooltipY = -400, arrowX = -15, arrowY = 106, arrowDir = "left",
            seq = { "repeatAdd", "moveE", "mine", "load", "moveW", "unload", "endBlock", "run" },
        }
    elseif step == 6 then
        return {
            guide = "광물이 있을 때만 캐게 하려면 [IF 추가]를 써요.\n반복 안에 IF(광물 있음)[채굴·적재]를 넣어 실행해 보세요.",
            fail = "조건 블록이 비어 있거나 실행이 끝나지 않았어요. IF 안에 블록을 넣고 다시 실행해 보세요.",
            allowed = { ifAdd = true, condition = true, repeatAdd = true, repeatCount = true, endBlock = true, moveE = true, mine = true, load = true, moveW = true, unload = true, run = true, clear = true },
            reset = { cellX = 0, cellY = 0, hand = "", handCount = 0, cart = 0 },
            clearProgram = true,
            tooltipX = 240, tooltipY = -400, arrowX = -15, arrowY = 106, arrowDir = "left",
            -- endBlock 은 1회만 안내한다 (2026-08-21 오너 보고): IF 를 닫는 1번이면
            -- 충분하고 남은 반복은 [실행]의 CloseAllOpenBlocks 가 자동으로 닫는다.
            -- 2회 연속으로 두면 같은 버튼을 가리킨 채 "화살표가 안 움직이는" 것처럼 보인다.
            seq = { "repeatAdd", "ifAdd", "mine", "load", "endBlock", "run" },
        }
    elseif step == 7 then
        return {
            guide = "창고의 돌을 팔아 골드를 벌어요.\n오른쪽 광산 현황의 [판매]에서 돌을 파세요. 팔 수 있는 수량이 0이면 [보호분 판매]를 먼저 켜세요.",
            fail = "",
            -- toggleProtected 는 2026-08-21 버그 수정으로 허용 — 보유량이 보호 수량
            -- 이하면(다시 보기·후반 계정에서 흔함) 판매 가능 수량이 0이라 토글 없이는
            -- 7단계 완료가 불가능했다 (docs/16 §41.7).
            -- T-15: [판매]가 광산 현황(HUD) 하단으로 옮겨져 [광산 선택]을 거치지 않는다.
            allowed = { sellOpen = true, saleClose = true, oreStone = true, quickOne = true, quickTen = true, quickAll = true, sellSelected = true, toggleProtected = true },
            reset = nil,
            clearProgram = true,
            -- 7단계: 판매 모달(폭 760, X -380~380)을 가리지 않도록 왼쪽 바깥에
            -- 배치하고 화살표는 대상 버튼을 매 프레임 추적한다 (2026-08-20 오너 결정).
            tooltipX = -660, tooltipY = 208, arrowX = -400, arrowY = 208, arrowDir = "right",
            seq = { "sellOpen", "quickAll", "sellSelected" },
        }
    end
    return {
        guide = "골드로 두 번째 일꾼을 고용해요.\n[광산 선택] → [강화·고용] 탭에서 [일꾼 고용]을 누르세요.",
        fail = "",
        -- T-15: 일꾼 고용이 [강화·고용] 탭 안으로 들어갔다 — 탭 버튼을 시퀀스에 넣는다.
        allowed = { selectOpen = true, selectClose = true, tabMines = true, tabUpgrade = true, buyWorker = true },
        reset = nil,
        clearProgram = false,
        -- 8단계: 개편 후 선택 패널이 넓어져(1140) 왼쪽 바깥 자리가 없다 — 하단
        -- 빈 띠(1~6단계와 같은 자리)로 내린다. 패널 하단(-280)과 겹치지 않는다.
        tooltipX = 240, tooltipY = -400, arrowX = -400, arrowY = 208, arrowDir = "right",
        seq = { "selectOpen", "tabUpgrade", "buyWorker" },
    }
end

@ExecSpace("ClientOnly")
method table GetButtonRegistry()
    -- 잠금 대상 버튼 전체 { key → ButtonComponent }. 각 소유 컨트롤러가 자기
    -- 버튼을 내놓는다 — UUID 를 여기 중복 선언하지 않는다.
    if self._T.buttons ~= nil then return self._T.buttons end
    local registry = {}
    for key, button in pairs(_BlockProgramController:GetTutorialButtons()) do registry[key] = button end
    for key, button in pairs(_MineSelectController:GetTutorialButtons()) do registry[key] = button end
    for key, button in pairs(_MineInventoryController:GetTutorialButtons()) do registry[key] = button end
    self._T.buttons = registry
    return registry
end

@ExecSpace("ClientOnly")
method void ApplyStepLocks(table allowed)
    -- 결정 2·5: 활성 버튼 외 전부 잠금(Enable=false) + dim. 알파는 명세 초안
    -- 0.35 에서 0.25 로 낮췄다 — 오너 실플레이에서 잠긴 버튼과 활성 버튼의
    -- 구분이 약해 잘못 누르려는 시도가 나왔다 (2026-08-18 피드백).
    -- 원래 색은 최초 1회 캐시하고 해제 시 캐시값으로 원복한다 (F7-E §5.1).
    for key, button in pairs(self:GetButtonRegistry()) do
        if button ~= nil and isvalid(button) then
            local sprite = button.Entity.SpriteGUIRendererComponent
            if allowed[key] == true then
                button.Enable = true
                self:RestoreButtonColor(key, sprite)
            else
                button.Enable = false
                if sprite ~= nil then
                    if self._T.dimCache[key] == nil then
                        self._T.dimCache[key] = sprite.Color
                    end
                    local original = self._T.dimCache[key]
                    sprite.Color = Color(original.r, original.g, original.b, 0.25)
                end
            end
        end
    end
    -- 패널 접기 토글은 잠근다. 편집기 단계(1~6)는 패널을 펼친 상태로 고정하고
    -- (§5.1), 판매·고용 단계(7·8)는 접는다 — 편집기가 필요 없는 단계인데 T-15
    -- 개편으로 넓어진 판매·선택 패널과 겹쳐 화면을 어지럽힌다 (2026-08-23 오너
    -- 다시 보기 보고: "블록 UI 창이 안 닫혀 있다").
    if (self._T.stepShown or 0) >= 7 then
        _BlockProgramController:CollapsePanelForTutorial()
    else
        _BlockProgramController:ForceExpandPanelForTutorial()
    end
end

@ExecSpace("ClientOnly")
method void RestoreButtonColor(string key, SpriteGUIRendererComponent sprite)
    -- dim 캐시가 있으면 원래 색으로 되돌린다.
    if sprite ~= nil and self._T.dimCache[key] ~= nil then
        sprite.Color = self._T.dimCache[key]
        self._T.dimCache[key] = nil
    end
end

@ExecSpace("ClientOnly")
method void ReleaseAllLocks()
    -- 종료·스킵·완료 시 전 버튼 잠금과 dim 을 원복한다.
    for key, button in pairs(self:GetButtonRegistry()) do
        if button ~= nil and isvalid(button) then
            button.Enable = true
            self:RestoreButtonColor(key, button.Entity.SpriteGUIRendererComponent)
        end
    end
    -- ⚠️ dim 캐시(색)와 Enable 은 이 컨트롤러가 **잠시 빌려 쓴** 값이다. 캐시는
    -- 잠금이 걸린 순간의 스냅숏이라, 튜토리얼 도중 상태가 바뀌면 원복이 그
    -- 과거 값을 되살린다. 그래서 원복 뒤에는 반드시 상태의 **단일 소유자**에게
    -- 다시 파생시킨다.
    --   · 일꾼 칩: 8단계가 곧 [일꾼 고용]이라 캐시는 항상 "사기 전(회색)" 이다.
    --     이걸 안 되돌리면 방금 산 일꾼 2 칩이 회색으로 굳는다(2026-08-27 오너 보고).
    --   · 광산 강화 버튼: 미입장 광산은 Enable=false 가 정상인데 위 루프가 전부
    --     true 로 열어 둔다. RefreshUI 는 state 해시가 같으면 조기 return 하므로
    --     force 로 강제 재도출해야 한다.
    if _BlockProgramController ~= nil then _BlockProgramController:RefreshWorkerButtons() end
    if _MineSelectController ~= nil then _MineSelectController:ForceRefresh() end
end

@ExecSpace("ClientOnly")
method void ClearSeqHandlers()
    -- 순차 안내용 클릭 감시를 전부 해제한다 (단계 전환·비활성 공통).
    if self._T.seqHandlers ~= nil then
        for i = 1, #self._T.seqHandlers do
            local rec = self._T.seqHandlers[i]
            if rec.entity ~= nil and isvalid(rec.entity) and rec.h ~= nil then
                rec.entity:DisconnectEvent(ButtonClickEvent, rec.h)
            end
        end
    end
    self._T.seqHandlers = {}
    self._T.seq = nil
    self._T.seqIndex = 0
end

@ExecSpace("ClientOnly")
method void StartArrowSequence(table config)
    -- 단계 내 화살표 순차 안내 (2026-08-21 오너 요청): seq 의 버튼을 순서대로
    -- 가리키고, 그 버튼이 눌리면 다음 버튼으로 화살표를 옮긴다. 위치는 매 프레임
    -- UpdateArrowTarget 이 실제 버튼 위치에서 계산한다 (창 드래그 추적).
    self:ClearSeqHandlers()
    if type(config.seq) ~= "table" or #config.seq == 0 then return end
    self._T.seq = config.seq
    self._T.seqIndex = 1
    -- seq 대상 + 되돌림 트리거(초기화·패널 닫기)에 클릭 감시를 건다. 중복 키는 1회만.
    local watch = {}
    for i = 1, #config.seq do watch[config.seq[i]] = true end
    watch["clear"] = true
    watch["selectClose"] = true
    watch["saleClose"] = true
    -- seq 에는 없지만 감시는 해야 하는 버튼: 7단계의 막힘 해제 토글 (되감기용).
    watch["toggleProtected"] = true
    local registry = self:GetButtonRegistry()
    for key, _ in pairs(watch) do
        local button = registry[key]
        if button ~= nil and isvalid(button) then
            local capturedKey = key
            local h = button.Entity:ConnectEvent(ButtonClickEvent, function() self:OnSeqButtonClicked(capturedKey) end)
            table.insert(self._T.seqHandlers, { entity = button.Entity, h = h })
        end
    end
end

@ExecSpace("ClientOnly")
method void OnSeqButtonClicked(string key)
    -- 현재 가리키는 버튼이 눌리면 다음으로. 초기화·패널 닫기는 처음으로 되돌린다.
    if not self._T.active or self._T.seq == nil then return end
    if key == "clear" or key == "selectClose" or key == "saleClose" then
        self._T.seqIndex = 1
        return
    end
    if key == "toggleProtected" and self._T.stepShown == 7 then
        -- 막힘을 푸는 버튼이다 (seq 밖 — ResolveArrowKey 참고). 이걸 켠 뒤에는
        -- [선택 수량 판매]를 다시 눌러야 하므로 소진된 seq 를 그 자리로 되감는다.
        -- 되감지 않으면 토글을 켠 순간 화살표가 다시 사라진다.
        self._T.seqIndex = #self._T.seq
        return
    end
    local current = self._T.seq[self._T.seqIndex]
    if current ~= nil and key == current then
        self._T.seqIndex = self._T.seqIndex + 1
    end
end

@ExecSpace("ClientOnly")
method string ResolveArrowKey(table seq)
    -- 화살표가 가리킬 버튼 키 (없으면 ""). 보통은 seq 의 현재 항목이지만,
    -- **"지금 누르면 반드시 실패하는" 상태**에서는 그 막힘을 푸는 버튼을 먼저 가리킨다.
    --
    -- 7단계(판매)가 그 경우다. 보유량 ≤ 보호 수량이면 판매 가능 수량이 0이라
    -- [선택 수량 판매]는 무조건 거절된다. [보호분 판매]를 켜야 풀리는데, 이 토글은
    -- **계정마다 필요 여부가 갈려 seq 에 넣을 수 없다** — 보호 수량이 없는 계정에는
    -- 잘못된 안내가 되기 때문이다. 그래서 조건이 성립할 때만 조건부로 가리킨다.
    --
    -- 이게 없으면: [선택 수량 판매]가 seq 의 마지막이라 누르는 순간 seqIndex 가
    -- 소진돼 화살표가 사라지는데, 판매는 거절돼 단계도 안 넘어간다 → 열린 판매창
    -- 앞에서 안내가 통째로 끊긴다 (2026-08-21 오너 다시 보기 실플레이, docs/16 §47).
    if self:IsSaleBlockedByProtection() then return "toggleProtected" end
    if self._T.seqIndex > #seq then return "" end
    return seq[self._T.seqIndex]
end

@ExecSpace("ClientOnly")
method boolean IsSaleBlockedByProtection()
    -- 7단계에서 [보호분 판매]가 꺼진 채 판매 가능 수량이 0인가.
    -- 판정값은 서버가 판매를 거절할 때 쓰는 것과 같은 EffectiveProtection 이다
    -- (max(설정 보호, 다음 해금 필요량)) — 클라가 따로 계산하지 않는다.
    if self._T.stepShown ~= 7 then return false end
    -- **판매 패널이 열려 있을 때만** 참이다. 토글은 그 패널 안에 있으므로,
    -- 닫힌 상태에서 화살표를 그쪽으로 돌리면 좌표가 허공에 뜬다 (docs/16 §49).
    -- 패널이 닫혀 있으면 seq(`selectOpen → sellOpen → …`)가 거기까지 데려간다 —
    -- 재조준은 "도착한 뒤 막혔을 때"만 개입하는 것이 맞다.
    if not _MineSelectController:IsSalePanelOpen() then return false end
    local profile = self:GetProfile()
    if profile == nil then return false end
    -- 판정은 판매 화면의 소유자에게 묻는다 — 여기서 보호/보유를 다시 계산하면
    -- 서버 거절 규칙과 갈라진다 (D-11 계열).
    return _MineSelectController:IsSaleBlockedByProtection(profile)
end

@ExecSpace("ClientOnly")
method void LogArrow(string body)
    -- #4 진단 전용 로거. `UpdateArrowTarget` 은 매 프레임 도므로 그대로 찍으면
    -- 초당 60줄이 쌓여 콘솔에서 읽을 수 없다 — **직전과 내용이 같으면 건너뛴다.**
    -- 좌표를 정수로 반올림해 넘기므로, 값이 안 흔들리는 동안에는 한 줄만 남고
    -- 창 크기·대상이 바뀌는 순간에만 새 줄이 찍힌다. (docs/24 §5 로그량 원칙)
    if not self.DebugArrow then return end
    if self._T.arrowDbgLast == body then return end
    self._T.arrowDbgLast = body
    log("[TutorialArrow] " .. body)
end

@ExecSpace("ClientOnly")
method Vector2 CanvasCenterOf(Entity target)
    -- UI 계층을 루트까지 걸어 올라가 캔버스(1920×1080, 중앙 원점) 중심 좌표를 낸다.
    --
    -- ⚠️ **`GetWorldCorners()` 를 쓰지 않는 것이 이 함수의 존재 이유다.** 그 API 는
    -- 엔티티마다 갱신 시점이 달라 같은 프레임에 형제끼리도 배율이 어긋난다
    -- (2026-08-27 실측 — docs/16 §80.3). 여기서 쓰는 값(AnchorsMin/Max, Pivot,
    -- anchoredPosition, RectSize)은 전부 **캔버스 기준 저작값**이라 캐시도
    -- 해상도도 타지 않는다.
    --
    -- 한 단계 공식 — 자식 중심의, 부모 중심 기준 오프셋:
    --   (앵커중심 − 0.5) × 부모크기  +  anchoredPosition  +  (0.5 − pivot) × 자기크기
    -- 이를 루트(부모에 UITransform 이 없는 지점 = 전화면 그룹, 중심이 원점)까지 누적한다.
    -- stretch 앵커(AnchorsMin ≠ Max)는 앵커 중점으로 근사한다 — 잠금 대상 버튼은
    -- 전부 점 앵커라 실사용 경로에서는 정확하다.
    local cx = 0.0
    local cy = 0.0
    local cur = target
    local guard = 0
    while cur ~= nil and guard < 16 do
        guard = guard + 1
        local t = cur.UITransformComponent
        if t == nil then break end
        local parent = cur.Parent
        if parent == nil then break end
        local pt = parent.UITransformComponent
        if pt == nil then break end
        local ax = (t.AnchorsMin.x + t.AnchorsMax.x) * 0.5
        local ay = (t.AnchorsMin.y + t.AnchorsMax.y) * 0.5
        cx = cx + (ax - 0.5) * pt.RectSize.x + t.anchoredPosition.x + (0.5 - t.Pivot.x) * t.RectSize.x
        cy = cy + (ay - 0.5) * pt.RectSize.y + t.anchoredPosition.y + (0.5 - t.Pivot.y) * t.RectSize.y
        cur = parent
    end
    return Vector2(cx, cy)
end

@ExecSpace("ClientOnly")
method void UpdateArrowTarget()
    -- 화살표를 현재 seq 대상 버튼 옆에 붙인다. GetWorldCorners 는 실창 픽셀을
    -- 돌려주므로 전화면 UI 그룹(/ui/TutorialUI)의 코너로 자기보정해 1920×1080
    -- 캔버스 좌표로 환산한다 (2026-08-21 Play 실측 — btnRun 폭 186.0 정확 일치).
    if self.arrow == nil or not self._T.active then return end
    local seq = self._T.seq
    if seq == nil or #seq == 0 then return end
    local key = self:ResolveArrowKey(seq)
    -- T-15b: seq 가 진행되거나 재조준이 일어나면 잠금도 그 대상만 열리게 갱신한다.
    if key ~= self._T.lockedKey then
        local config = self:GetStepConfig(self._T.stepShown)
        self:ApplySeqLock(key, config)
    end
    if key == "" then
        -- 마지막 대상까지 눌렀다 — 판정 대기 동안 화살표를 감춘다.
        if self.arrow.Enable then self.arrow.Enable = false end
        return
    end
    local button = self:GetButtonRegistry()[key]
    if button == nil or not isvalid(button) then
        -- ⚠️ 아래 조기 return 들은 전부 "화살표를 그 자리에 그대로 둔다" — 즉
        -- config 폴백 자리(arrowX/arrowY)에 멈춘 채 엉뚱한 버튼을 가리키는
        -- 것처럼 보인다 (2026-08-27 오너 보고 #4). 그래서 사유마다 로그를 뗀다.
        self:LogArrow("bail=button-missing key=" .. tostring(key))
        return
    end
    if not self.arrow.Enable then self.arrow.Enable = true end
    local arrowTransform = self.arrow.UITransformComponent
    -- ⚠️⚠️ **`GetWorldCorners()` 를 쓰지 않는다** (2026-08-27 실측으로 완전 폐기).
    -- 이 API 는 **엔티티마다 다른 시점의 캐시**를 돌려준다 — 같은 프레임·같은
    -- 부모의 형제인데도 배율이 갈렸다: Arrow 0.6146 vs Tooltip 0.7646,
    -- TutRoot 0.7646 vs BPRoot 0.6146 (`[SPACE]` 실측). 정적 레이아웃에서
    -- 일어날 수 없는 값이므로, 이 API 로는 어떤 자도 만들 수 없다.
    --   · 옛 구현(그룹 rect 정규화)이 창 크기에 따라 어긋난 이유가 이것이고,
    --   · 그 대안으로 넣었던 "화살표 자기보정"은 **낡은 코너에 매 프레임 델타를
    --     더해 양의 되먹임으로 발산**했다(실측 `anchored.x = -37,276,772`).
    --     §76 카메라의 "1프레임 지연값을 매 프레임 유도하면 발산한다" 와 같은 함정.
    --
    -- 대신 **저작값만으로 계층을 걸어 올라간다**(`CanvasCenterOf`). 앵커·피벗·
    -- anchoredPosition·RectSize 는 전부 캔버스(1920×1080) 기준 저작값이라
    -- 캐시도 해상도도 타지 않는다. 검증: Tooltip → canvas(240.0,-400.0) 로
    -- 실제 anchoredPosition 과 정확히 일치.
    local btnTransform = button.Entity.UITransformComponent
    if btnTransform == nil then
        self:LogArrow("bail=button-transform-missing key=" .. tostring(key))
        return
    end
    local center = self:CanvasCenterOf(button.Entity)
    local cx = center.x
    local cy = center.y
    local half = btnTransform.RectSize.y * 0.5
    local bottom = cy - half
    local top = cy + half
    -- 화살표 자산(ba442ba7…)은 위쪽을 가리키는 스프라이트다. 기본은 버튼 아래에서
    -- 위를 가리키고, 버튼이 화면 하단이라 자리가 없으면 위에서 세로 반전(↓)한다.
    local x = cx
    local y = bottom - 50
    local flipY = 1
    if y - 35 < -530 then
        y = top + 50
        flipY = -1
    end
    arrowTransform.anchoredPosition = Vector2(x, y)
    arrowTransform.UIScale = Vector3(1, flipY, 1)
    -- #4 진단: 창 크기를 바꾼 상태에서 이 줄의 canvas 값이 버튼의 설계 좌표와
    -- 어긋나면 환산이 깨진 것이고, 값이 맞는데 화면이 틀리면 화살표 앵커·부모
    -- 쪽 문제다. 둘을 가르는 것이 이 로그의 목적이다.
    self:LogArrow("key=" .. tostring(key)
        .. " btnCanvas=(" .. string.format("%.0f,%.0f", cx, cy) .. ")"
        .. " -> arrow(" .. string.format("%.0f,%.0f", x, y) .. ") flipY=" .. tostring(flipY))
end

@ExecSpace("ClientOnly")
method void TakeSnapshot()
    -- 판정 신호 비교 기준. 정착 시간(SettleSeconds) 뒤에 찍는다.
    local profile = self:GetProfile()
    local worker = self:GetWorker()
    local snapshot = { stone = 0, gold = 0, owned = 1, cellX = 0, cellY = 0, cartCount = 0, unloadCount = 0 }
    if profile ~= nil then
        snapshot.stone = profile.Stone
        snapshot.gold = profile.Gold
        snapshot.owned = profile.OwnedWorkerCount
    end
    if worker ~= nil then
        snapshot.cellX = worker.CellX
        snapshot.cellY = worker.CellY
        snapshot.cartCount = worker.CartCount
        snapshot.unloadCount = worker.UnloadCount
    end
    self._T.snapshot = snapshot
end

@ExecSpace("ClientOnly")
method void EnterStep(integer step)
    -- 단계 진입: 상태 정리(§4) → 잠금 → 안내 → 정착 후 스냅숏.
    local config = self:GetStepConfig(step)
    self._T.stepShown = step
    self._T.runSeen = false
    self._T.lastProgramState = ""
    self._T.lastRunHadRepeat = false
    self._T.lastRunHadIf = false
    self._T.snapshot = nil
    self._T.settle = self.SettleSeconds
    self._T.advanceCooldown = 0
    if config.clearProgram then _BlockProgramController:ClearProgramForTutorial() end
    -- 광산 선택 계열 패널은 **모든 단계** 진입 시 닫는다. 1~6단계는 편집기·안내를
    -- 덮지 않기 위해서고, 7·8단계는 seq 의 첫 버튼(sellOpen/selectOpen)이 "닫힌
    -- 상태에서 연다"를 전제하기 때문이다. 특히 8단계: 7단계가 판매 패널을 연 채
    -- 끝나는데 [광산 선택]은 토글이라(열린 패널이 있으면 전부 닫기 — 2026-08-20)
    -- 첫 클릭이 '닫기'로 소모되고 seq 는 이미 진행돼 닫힌 패널 속 [강화·고용]에
    -- 잠금·화살표가 걸려 진행 불능이 됐다 (2026-08-23 오너 다시 보기 실플레이).
    _MineSelectController:CloseAllPanelsForTutorial()
    if config.reset ~= nil then
        local profile = self:GetProfile()
        if profile ~= nil then
            profile:RequestTutorialWorkerReset(config.reset.cellX, config.reset.cellY, config.reset.hand, config.reset.handCount, config.reset.cart)
        end
    end
    if step == 8 then
        -- 8단계 골드 보정 (2026-08-18 오너 결정): 판매 결과가 갈려 골드가 10
        -- 미만이면 구매가 막힌다 — 서버가 인하가까지 채운다 (재개 경로 포함).
        local fundsProfile = self:GetProfile()
        if fundsProfile ~= nil then fundsProfile:RequestTutorialFundsCheck() end
    end
    self:StartArrowSequence(config)
    -- T-15b (2026-08-22 오너): 화살표가 가리키는 버튼만 눌리게 순서를 강제한다.
    -- 이후 seq 진행에 따른 재잠금은 UpdateArrowTarget 이 키 변화를 보고 한다.
    self._T.lockedKey = nil
    self:ApplySeqLock(self:ResolveArrowKey(config.seq or {}), config)
    self:ShowTooltip(step, "")
    log("[Tutorial] step enter step=" .. tostring(step) .. " replay=" .. tostring(self._T.replayActive))
end

@ExecSpace("ClientOnly")
method void ApplySeqLock(string key, table config)
    -- T-15b: 활성 버튼 = 화살표 대상 1개 + [초기화](실수 복구, §46 허용).
    -- seq 가 없는 특수 상황에서만 config.allowed 로 되돌아간다.
    if config.seq == nil or #config.seq == 0 then
        self:ApplyStepLocks(config.allowed)
        return
    end
    local allowed = { clear = true }
    if key ~= nil and key ~= "" then allowed[key] = true end
    self._T.lockedKey = key
    self:ApplyStepLocks(allowed)
end

@ExecSpace("ClientOnly")
method void ShowTooltip(integer step, string reason)
    -- 결정 4·6: 안내 문구 + 진행도 n / 8. 실패 사유가 있으면 덧붙인다 (§5.2-4).
    local config = self:GetStepConfig(step)
    if self.tutorialRoot ~= nil then self.tutorialRoot.Enable = true end
    if self.guideText ~= nil then
        local text = config.guide
        if reason ~= "" then text = reason .. "\n" .. config.guide end
        self.guideText.Text = text
    end
    if self.progressText ~= nil then self.progressText.Text = tostring(step) .. " / 8" end
    if self.tooltip ~= nil then
        self.tooltip.UITransformComponent.anchoredPosition = Vector2(config.tooltipX, config.tooltipY)
    end
    if self.arrow ~= nil then
        -- 초기 위치는 config 폴백. 실제 위치·방향은 UpdateArrowTarget 이 매 프레임
        -- 대상 버튼 기준으로 덮어쓴다 (위쪽 화살표 자산 — 세로 반전만 쓴다).
        self.arrow.Enable = true
        self.arrow.UITransformComponent.anchoredPosition = Vector2(config.arrowX, config.arrowY)
        self.arrow.UITransformComponent.UIScale = Vector3(1, 1, 1)
    end
end

@ExecSpace("ClientOnly")
method string PreRunCheck(table program)
    -- 5·6단계 Run 직전 선검증 (F7-E §3 보강·E5). 비활성이면 빈 문자열.
    if not self._T.active then return "" end
    local step = self._T.stepShown
    if step == 5 then
        if not self:HasControlWithBody(program, "repeat") then
            return "반복 블록 안에 실행할 블록을 넣고 [끝 ]]으로 닫아 주세요."
        end
    elseif step == 6 then
        if not self:HasControlWithBody(program, "if") then
            return "IF 블록 안에 실행할 블록을 넣고 [끝 ]]으로 닫아 주세요."
        end
    end
    if step == 5 then self._T.lastRunHadRepeat = true end
    if step == 6 then self._T.lastRunHadIf = true end
    return ""
end

@ExecSpace("ClientOnly")
method boolean HasControlWithBody(table list, string controlType)
    -- 재귀: 해당 제어 블록이 존재하고 body 가 비어 있지 않은지 확인한다.
    if type(list) ~= "table" then return false end
    for i = 1, #list do
        local command = list[i]
        if type(command) == "table" then
            if command.type == controlType and type(command.body) == "table" and #command.body > 0 then
                return true
            end
            if (command.type == "repeat" or command.type == "if") and self:HasControlWithBody(command.body, controlType) then
                return true
            end
        end
    end
    return false
end

@ExecSpace("ClientOnly")
method boolean IsStepSignalMet(integer step)
    -- F7-E §3 판정표. 스냅숏 대비 @Sync 변화를 본다.
    local snapshot = self._T.snapshot
    if snapshot == nil then return false end
    local profile = self:GetProfile()
    local worker = self:GetWorker()
    if step <= 6 and worker == nil then return false end
    if step == 1 then
        return worker.CellX ~= snapshot.cellX or worker.CellY ~= snapshot.cellY
    elseif step == 2 then
        return worker.PendingOre ~= "" or worker.CartCount > snapshot.cartCount
    elseif step == 3 then
        return worker.CartCount > snapshot.cartCount
    elseif step == 4 then
        -- 2026-08-25 (docs/16 §59): 계정 돌 증가(profile.Stone > snapshot.stone)로
        -- 판정하면 자동판매가 보호 수량 위를 즉시 팔아 수치가 안 늘 때 하역해도
        -- 영구 실패한다 — 경제와 무관한 하역 횟수 카운터로 판정한다.
        return worker.UnloadCount > (snapshot.unloadCount or 0)
    elseif step == 5 then
        return self._T.lastRunHadRepeat and self._T.runSeen and worker.ProgramState == "Idle"
    elseif step == 6 then
        return self._T.lastRunHadIf and self._T.runSeen and worker.ProgramState == "Idle"
    elseif step == 7 then
        -- 판매는 반복 가능한 행동이라 "증가분"으로 둔다 — 다시 보기에서도 실제로
        -- 한 번 팔아 보게 하는 것이 맞다.
        return profile ~= nil and profile.Gold > snapshot.gold
    end
    -- 8단계(일꾼 고용)는 **절대값**으로 판정한다 — 서버 `VerifyStep(8)` 의
    -- `#workers >= 2` 와 같은 축이다.
    --
    -- 예전의 "스냅숏 대비 증가"는 1회차(1→2)에서만 우연히 맞았다. 다시 보기에서는
    -- 진입 시점 스냅숏이 이미 2라 3명째를 요구하는데, **일꾼 3은 깊은 광산 해금이
    -- 선행**이라 잠긴 계정에서는 어떤 조작으로도 증가시킬 수 없다 → 서버는 이미
    -- 통과인데 클라가 영영 요청하지 않아 8단계가 영구 정지했다
    -- (2026-08-21 오너 다시 보기 실플레이, docs/16 §48).
    --
    -- 교훈: 클라 신호와 서버 재검증은 **같은 축**이어야 한다. 한쪽이 증가분,
    -- 다른 쪽이 절대값이면 그 틈이 곧 진행 불능이다.
    return profile ~= nil and profile.OwnedWorkerCount >= self.TutorialWorkerGoal
end

@ExecSpace("ClientOnly")
method void HandleStepFailure(integer step)
    -- 결정 3: 자동 되돌리기 + 사유를 덧붙인 재안내. 진행도는 줄지 않는다 (§5.2).
    local config = self:GetStepConfig(step)
    local reset = config.failReset
    if reset == nil then reset = config.reset end
    local profile = self:GetProfile()
    if reset ~= nil and profile ~= nil then
        profile:RequestTutorialWorkerReset(reset.cellX, reset.cellY, reset.hand, reset.handCount, reset.cart)
    end
    if config.clearProgram then _BlockProgramController:ClearProgramForTutorial() end
    self._T.runSeen = false
    self._T.settle = self.SettleSeconds
    self._T.snapshot = nil
    -- T-15b: 순서 강제 잠금에서는 실패 시 seq 를 처음으로 되감아야 한다 —
    -- 소진된 seq 를 두면 화살표도 잠금도 열리지 않아 재시도가 불가능해진다.
    self._T.seqIndex = 1
    self:ApplySeqLock(self:ResolveArrowKey(config.seq or {}), config)
    self:ShowTooltip(step, config.fail)
    log("[Tutorial] step failed step=" .. tostring(step) .. " - reset and re-guide")
end

@ExecSpace("ClientOnly")
method void Activate(integer step, boolean replay)
    -- 튜토리얼 UI·잠금 가동.
    self._T.active = true
    self._T.replayActive = replay
    -- 2026-08-21 오너 요청: 튜토리얼 중에는 창 위치가 설계 기본값이어야 화살표
    -- 좌표 안내가 어긋나지 않는다 — 드래그된 창을 원위치로 보정한다. 활성 중
    -- 드래그 자체는 IsUiDragLocked 가 UIDraggable 에서 차단한다.
    self:ResetDraggablePanels()
    -- 2026-08-25 (docs/16 §58): 튜토리얼은 일꾼 1 전용 — 편집기 [실행] 대상을
    -- 일꾼 1로 강제한다 (일꾼 2 선택 상태로 진입하면 1단계 판정이 영영 안 된다).
    if _BlockProgramController ~= nil then _BlockProgramController:SelectWorker(1) end
    self:EnterStep(step)
    log("[Tutorial] activated step=" .. tostring(step) .. " replay=" .. tostring(replay))
end

@ExecSpace("ClientOnly")
method void RegisterDraggable(any draggable)
    -- UIDraggable 이 스스로 등록한다 (창 목록을 여기 중복 선언하지 않는다 —
    -- GetButtonRegistry 와 같은 원칙). OnBeginPlay 순서와 무관하게 lazy-init.
    if self._T.draggables == nil then self._T.draggables = {} end
    table.insert(self._T.draggables, draggable)
end

@ExecSpace("ClientOnly")
method boolean IsUiDragLocked()
    -- 튜토리얼 활성 중에는 창 드래그를 막는다 (다시 보기 포함 — 화살표 안내 보호).
    return self._T.active == true
end

@ExecSpace("ClientOnly")
method void ResetDraggablePanels()
    -- 등록된 모든 드래그 창을 설계 기본 위치로 되돌린다.
    if self._T.draggables == nil then return end
    local resetCount = 0
    for i = 1, #self._T.draggables do
        local draggable = self._T.draggables[i]
        if draggable ~= nil and isvalid(draggable) then
            draggable:ResetToHome()
            resetCount = resetCount + 1
        end
    end
    log("[Tutorial] draggable panels reset count=" .. tostring(resetCount))
end

@ExecSpace("ClientOnly")
method void Deactivate(boolean showCompletionHint)
    -- 잠금·dim 원복 + UI 숨김 (§9.1 스킵·§7 완료 공통).
    self._T.active = false
    self._T.replayActive = false
    self._T.replayRequested = false
    self._T.stepShown = 0
    self:ClearSeqHandlers()
    self:ReleaseAllLocks()
    -- 7·8단계가 접어 둔 편집기 패널을 기본 상태(펼침)로 되돌린다.
    _BlockProgramController:ForceExpandPanelForTutorial()
    if self.tutorialRoot ~= nil then self.tutorialRoot.Enable = false end
    -- 2026-08-26 (오너 보고 — 다시 보기 후 일꾼이 안 돌아옴): 튜토리얼이 켜지면
    -- 서버가 일꾼 2~5를 디스폰한다(§58). 그 복귀를 완주·스킵 경로에만 달아 뒀더니
    -- **다시 보기를 닫는 경로에는 서버 호출이 아예 없어** 일꾼이 재접속 전까지
    -- 사라진 채였다. 종료는 전부 이 메서드를 지나므로 여기서 한 번 요청한다 —
    -- 서버 쪽이 멱등이라 이미 복귀한 뒤 다시 불려도 안전하다.
    local profile = self:GetProfile()
    if profile ~= nil then profile:RequestTutorialWorkersResume() end
    -- T-14 (docs/28): §9.3 완료 후 자연어 힌트는 자연어 입력 제거와 함께 폐지됐다.
    -- showCompletionHint 인자는 호출부 호환을 위해 남기되 아무것도 하지 않는다.
    log("[Tutorial] deactivated hint=" .. tostring(showCompletionHint))
end

@ExecSpace("ClientOnly")
method void OnSkipClicked()
    -- 결정: 스킵은 확인 팝업을 거친다 (§9.1).
    if self._T.replayActive then
        -- 다시 보기는 이미 완료·스킵된 원장을 바꾸지 않는다 — 화면만 닫는다.
        _UIPopup:Open("튜토리얼 다시 보기를 끝낼까요?", function()
            self:Deactivate(false)
        end, nil)
        return
    end
    _UIPopup:Open("튜토리얼을 건너뛸까요?\n지금까지 받은 보상은 유지되고, 완료 보상은 지급되지 않습니다.", function()
        local profile = self:GetProfile()
        if profile ~= nil then profile:RequestTutorialSkip() end
    end, nil)
end

@ExecSpace("ClientOnly")
method void OnReplayEntry()
    -- 광산 선택 화면의 "튜토리얼 다시 보기" (결정 8·9, §9.2).
    local profile = self:GetProfile()
    if profile == nil or self._T.active then return end
    local step = profile.TutorialStep
    if profile.TutorialCompleted or step <= 1 or step > 8 then
        self._T.replayRequested = true
        profile:RequestTutorialReplay(true)
        return
    end
    _UIPopup:Open("튜토리얼을 처음부터 볼까요?\n확인 = 처음부터 · 취소 = 이어서 (" .. tostring(step) .. "단계부터)", function()
        self._T.replayRequested = true
        local requestProfile = self:GetProfile()
        if requestProfile ~= nil then requestProfile:RequestTutorialReplay(true) end
    end, function()
        self._T.replayRequested = true
        local requestProfile = self:GetProfile()
        if requestProfile ~= nil then requestProfile:RequestTutorialReplay(false) end
    end)
end

@ExecSpace("ClientOnly")
method void OnUpdate(number delta)
    -- 활성/비활성 전환과 단계 신호 감시를 한 곳에서 돈다.
    local profile = self:GetProfile()
    if profile == nil then return end
    local step = profile.TutorialStep

    if not self._T.active then
        if not self:IsOnBeginnerMine() then return end
        -- 접속 직후 유예: 복구·자동 실행 판단이 끝난 뒤에만 켠다.
        if (self._T.warmup or 0) < self.WarmupSeconds then
            self._T.warmup = (self._T.warmup or 0) + delta
            return
        end
        local pristine = not profile.TutorialCompleted and not profile.TutorialSkipped
        if self._T.replayRequested and step >= 1 and step <= 8 then
            self:Activate(step, true)
        elseif pristine and step >= 1 and step <= 8 then
            -- E12: 첫 1회차 진행 중 재접속 — 저장된 단계부터 이어 간다.
            self:Activate(step, false)
        elseif pristine and step == 0 then
            -- E1·E14: 초보 광산 첫 진입 자동 시작 (재시도 쿨다운 3초).
            self._T.startCooldown = (self._T.startCooldown or 0) - delta
            if self._T.startCooldown <= 0 then
                self._T.startCooldown = 3.0
                profile:RequestTutorialStart()
            end
        end
        return
    end

    -- 활성 중 서버 상태 전환 감시.
    if step == 0 then
        -- 방어선: 서버 원장이 초기화된 비정상 경로 — 잠금을 남기지 않는다.
        self:Deactivate(false)
        return
    end
    if profile.TutorialSkipped and not self._T.replayActive then
        self:Deactivate(false)
        return
    end
    if step == 9 or (profile.TutorialCompleted and step > 8) then
        -- T-15b (2026-08-22 오너): 8단계는 일꾼이 이미 2명이면 신호가 즉시 충족돼
        -- 진입하자마자 통과된다(§48 설계 — 고용은 해금 상한 때문에 반복 불가).
        -- 안내 없이 닫히면 버그로 보이므로, 끝났음을 팝업으로 알린다.
        local autoPassed = self._T.stepShown == 8 and (self._T.seqIndex or 0) <= 1
        local closingReplay = self._T.replayActive
        self:Deactivate(true)
        if closingReplay or autoPassed then
            local message = "튜토리얼을 마쳤습니다."
            if closingReplay then message = "튜토리얼 다시 보기를 마쳤습니다." end
            if autoPassed then
                message = message .. "\n\n(일꾼이 이미 " .. tostring(self.TutorialWorkerGoal) .. "명이라 8단계 고용은 자동으로 통과됐어요)"
            end
            _UIPopup:OpenNotice(message, nil)
            log("[Tutorial] completion notice replay=" .. tostring(closingReplay) .. " autoPassed=" .. tostring(autoPassed))
        end
        return
    end
    if step >= 1 and step <= 8 and step ~= self._T.stepShown then
        self:EnterStep(step)
        return
    end

    -- 화살표 순차 안내: 현재 대상 버튼 위치를 매 프레임 추적한다 (창 드래그 대응).
    self:UpdateArrowTarget()

    -- 정착 시간: 리셋 RPC 왕복 전의 낡은 값을 스냅숏하지 않는다.
    if self._T.settle > 0 then
        self._T.settle = self._T.settle - delta
        if self._T.settle <= 0 then self:TakeSnapshot() end
        return
    end
    if self._T.snapshot == nil then self:TakeSnapshot() end

    -- 실행 상태 추적 (실패 판정용 — 결정 3).
    local worker = self:GetWorker()
    if worker ~= nil then
        local state = worker.ProgramState
        if state ~= self._T.lastProgramState then
            local previous = self._T.lastProgramState
            self._T.lastProgramState = state
            if state == "Running" then
                self._T.runSeen = true
            elseif state == "Stopped" and previous ~= "" then
                -- 서버 거부·정지 계열 (§5.2 실패 조건).
                self:HandleStepFailure(self._T.stepShown)
                return
            elseif state == "Idle" and self._T.runSeen then
                -- 완주 후 신호 미충족이면 실패 (E4). 신호 충족이면 아래에서 통과.
                if not self:IsStepSignalMet(self._T.stepShown) then
                    self:HandleStepFailure(self._T.stepShown)
                    return
                end
            end
        end
    end

    -- 통과 요청 (쿨다운 2초 — 서버 재검증 거부 시 재시도 여지).
    self._T.advanceCooldown = math.max(0, (self._T.advanceCooldown or 0) - delta)
    if self._T.advanceCooldown <= 0 and self:IsStepSignalMet(self._T.stepShown) then
        self._T.advanceCooldown = 2.0
        profile:RequestTutorialAdvance(self._T.stepShown)
        log("[Tutorial] advance requested step=" .. tostring(self._T.stepShown))
    end
end

end
