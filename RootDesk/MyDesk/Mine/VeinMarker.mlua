@Component
script VeinMarker extends Component

	property string MarkerId = ""

	property string MarkerKind = "normal"

	@Sync
	property integer CellX = 0

	@Sync
	property integer CellY = 0

	@Sync
	property integer ReserveStage = 0

	@Sync
	property string OreType = ""

	@Sync
	property boolean IsActive = false

	@Sync
	property integer VisualRevision = 0

	-- 부유석(일반 광맥) 스프라이트의 pivot 결함 보정. 그림의 시각 중심이 캔버스
	-- pivot보다 왼쪽·위에 있어 셀 중심에 놓으면 좌상단으로 치우쳐 보인다
	-- (2026-08-27 오너 관측). 연출 의도 오프셋이 아니라 자산 결함 보정이므로
	-- MarkerKind == "normal" 에만 적용한다 — 특별 광맥(신비한 광석)·Depot(광차)은
	-- 자산이 달라 pivot도 다르다. 값은 VeinScale 0.7 기준 실측치라 스케일이나
	-- 자산을 바꾸면 다시 재야 한다 (msw-asset-verify "pivot 보정" 절).
	property number VeinPivotOffsetX = 0.02

	property number VeinPivotOffsetY = -0.55

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		    -- Derives this marker's cell from its authored position and registers itself
		    -- with the current mine's server simulator.
		    local mine = self.Entity.CurrentMap.VeinTickSimulator
		    if mine == nil then
		        log_error("[VeinMarker] simulator missing id=" .. self.MarkerId)
		        return
		    end
		
		    -- RectTile 에서 1 셀 = 1 world unit 이고, 맵에 저작된 marker 위치가 곧 셀
		    -- 좌표다. 별도 좌표 property 를 두면 맵과 이중 관리가 되므로 위치에서 얻는다.
		    -- 셀 c 는 world [c, c+1) 을 차지한다 (ToWorldPosition(c) = c+0.5 실측).
		    -- floor(pos)는 저작 좌표(정수 모서리)와 아래에서 옮긴 중심 좌표(c+0.5)
		    -- 어느 쪽에서 다시 계산해도 같은 셀이 나온다. floor(pos+1)은 정수 저작
		    -- 좌표를 한 칸 우상단 셀로 밀어 광맥 전체가 고갈 표시되는 회귀였다.
		    local pos = self.Entity.TransformComponent.Position
		    self.CellX = math.floor(pos.x)
		    self.CellY = math.floor(pos.y)
		
		    -- 맵에 저작된 마커는 정수 좌표(셀의 좌하단)를 사용하지만,
		    -- RectTileMap:ToWorldPosition 은 셀 중심 좌표를 반환한다.
		    -- 논리 셀 좌표는 위에서 확정한 뒤, 표시/상호작용 기준점만 타일 중심으로
		    -- 옮겨서 격자 오버레이와 광석 스프라이트가 같은 중심을 공유하게 한다.
		    local tilemap = self.Entity.CurrentMap:GetFirstChildComponentByTypeName("RectTileMapComponent")
		    if tilemap ~= nil then
		        local center = tilemap:ToWorldPosition(Vector2Int(self.CellX, self.CellY))
		        -- pivot 보정은 일반 광맥(부유석)에만 더한다 (property 주석 참조).
		        local offsetX = 0.0
		        local offsetY = 0.0
		        if self.MarkerKind == "normal" then
		            offsetX = self.VeinPivotOffsetX
		            offsetY = self.VeinPivotOffsetY
		        end
		        self.Entity.TransformComponent.Position = Vector3(center.x + offsetX, center.y + offsetY, pos.z)
		        log("[VeinMarker] centered id=" .. self.MarkerId
		            .. " cell=(" .. self.CellX .. "," .. self.CellY .. ")"
		            .. " world=(" .. center.x .. "," .. center.y .. ")")
		    else
		        log_warning("[VeinMarker] tilemap missing while centering id=" .. self.MarkerId)
		    end
		
		    -- 3번째 인자로 자기 자신을 넘겨야 시뮬레이터가 매 틱 stage 를 밀어 넣을 수 있다.
		    mine:RegisterMarker(self.MarkerId, self.MarkerKind, self)
	end

	@ExecSpace("ServerOnly")
	method void ApplyVeinState(string oreType, integer stage, boolean isActive)
		    -- Writes one visual snapshot, bumping VisualRevision only on a real change.
		    -- Called every tick by the simulator, so the no-change path must stay cheap
		    -- and must not touch @Sync properties (each write costs a sync message).
		    if self.OreType == oreType and self.ReserveStage == stage and self.IsActive == isActive then
		        return
		    end
		    self.OreType = oreType
		    self.ReserveStage = stage
		    self.IsActive = isActive
		    self.VisualRevision = self.VisualRevision + 1
	end

end