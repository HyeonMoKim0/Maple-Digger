@Logic
script PerfProbeLogic extends Logic

-- F9 성능·부하 측정 프로브 (docs/24). 기본 비활성 — Active 가 false 면
-- OnUpdate 는 조기 return 한 줄만 실행한다. 측정 세션에서만
-- maker_execute_script 로 side 별로 켠다: _PerfProbeLogic.Active = true
property boolean Active = false

-- 집계 창 길이(초). 창이 차면 요약 1줄을 로그로 내고 리셋한다.
property number WindowSeconds = 10.0

property integer frames = 0
property number sumDelta = 0.0
property number maxDelta = 0.0
property integer over33 = 0
property integer over100 = 0
property number windowElapsed = 0.0

method void OnUpdate(number delta)
    -- 프레임 delta 를 창 단위로 집계한다. 서버/클라 각자 자기 쪽 값을 집계한다.
    if not self.Active then return end
    self.frames = self.frames + 1
    self.sumDelta = self.sumDelta + delta
    if delta > self.maxDelta then self.maxDelta = delta end
    if delta > 0.0334 then self.over33 = self.over33 + 1 end
    if delta > 0.1 then self.over100 = self.over100 + 1 end
    self.windowElapsed = self.windowElapsed + delta
    if self.windowElapsed >= self.WindowSeconds then
        local side = "client"
        if self:IsServer() then side = "server" end
        local avgMs = 0.0
        if self.frames > 0 then avgMs = self.sumDelta / self.frames * 1000.0 end
        log(string.format("[Perf] side=%s window=%.1fs frames=%d avgMs=%.2f fps=%.1f maxMs=%.1f over33=%d over100=%d",
            side, self.windowElapsed, self.frames, avgMs, self.frames / self.windowElapsed, self.maxDelta * 1000.0, self.over33, self.over100))
        self:ResetWindow()
    end
end

method void ResetWindow()
    -- 집계 창을 비운다. Active 를 켠 직후에도 호출해 이전 잔량을 버린다.
    self.frames = 0
    self.sumDelta = 0.0
    self.maxDelta = 0.0
    self.over33 = 0
    self.over100 = 0
    self.windowElapsed = 0.0
end

end
