-- ACTIVE MINE RUNTIME CONTRACT
-- This component owns one worker's validated D2 stack interpreter and cell
-- state, but it does not own a timer. VeinTickSimulator calls
-- AdvanceSimulationTick exactly once per server simulation tick. D3 may fill
-- the load/unload and cart-condition stubs; it must preserve this tick contract.
@Component
script WorkerController extends Component

property table CommandQueue = {}
property integer MaxProgramBlocks = 30
property integer MaxProgramDepth = 3
property integer MaxEvaluationsPerTick = 20
property table Cart = {}
property integer StartCellX = 0
property integer StartCellY = 0

@Sync
property integer WorkerIndex = 1

@Sync
property integer CellX = 0

@Sync
property integer CellY = 0

@Sync
property string ProgramState = "Idle"

@Sync
property string PendingOre = ""

-- F7-B §5.3: 손 기본 1칸. `yield` 추가 지급이 발동한 경우에 한해 같은 광물 최대 2개.
@Sync
property integer PendingOreCount = 0

@Sync
property integer CartCount = 0

@Sync
property integer CartCapacity = 20

-- F5 §2.2 행동 이벤트 채널. 서버가 액션을 확정할 때마다 Sequence 를 올리고,
-- 클라이언트는 아직 처리하지 않은 Sequence 만 한 번 처리한다. 같은 kind 가
-- 연속으로 나와도 Sequence 가 다르므로 구분된다.
@Sync
property integer VisualEventSequence = 0

-- move / mine_success / mine_fail / load_success / unload_success
@Sync
property string VisualEventKind = ""

@Sync
property integer VisualEventCellX = 0

@Sync
property integer VisualEventCellY = 0

@ExecSpace("ServerOnly")
method void OnBeginPlay()
    -- Initializes the worker cell, interpreter state, and mine simulation registration.
    -- D4 instance boundary: every worker owns its starting/current cell.
    -- Map model overrides set these values; overlap is intentionally allowed.
    self._T.cellX = self.StartCellX
    self._T.cellY = self.StartCellY
    self.CellX = self._T.cellX
    self.CellY = self._T.cellY
    self._T.running = false
    self._T.frames = {}
    self._T.actionStep = 0
    self._T.lastSimulationTick = 0
    self._T.tilemap = self.Entity.CurrentMap:GetFirstChildComponentByTypeName("RectTileMapComponent")
    self._T.mineState = self.Entity.CurrentMap.VeinTickSimulator
    self.CommandQueue = {}
    self.ProgramState = "Idle"
    self.PendingOre = ""
    self.PendingOreCount = 0
    self.CartCount = 0
    self.Cart = { stone = 0 }

    if self._T.tilemap == nil then
        log_error(self:WorkerTag() .. " RectTileMapComponent not found")
        return
    end
    if self._T.mineState == nil then
        log_error(self:WorkerTag() .. " VeinTickSimulator not found on current map")
        return
    end

    local configuredStart = self._T.mineState:GetWorkerStart(self.WorkerIndex)
    if configuredStart ~= nil then
        self._T.cellX = configuredStart.cellX
        self._T.cellY = configuredStart.cellY
        self.CellX = self._T.cellX
        self.CellY = self._T.cellY
    end

    self.CartCapacity = self._T.mineState.CartCapacity

    self.Entity.KinematicbodyComponent:SetWorldPosition(self:CellToWorld(self._T.cellX, self._T.cellY))
    self._T.mineState:RegisterWorker(self)
    log(self:WorkerTag() .. " spawned at cell (" .. self._T.cellX .. "," .. self._T.cellY .. ") state=Idle")
end

@ExecSpace("ServerOnly")
method void OnEndPlay()
    -- Unregisters the worker from the map-scoped simulation.
    if self._T.mineState ~= nil then
        self._T.mineState:UnregisterWorker(self)
    end
end

@ExecSpace("Server")
method void RunProgram(table commands)
    -- Replaces the current run only with a server-validated D2 program.
    -- A new request always replaces the old run. Invalid input clears execution
    -- so an untrusted client cannot preserve hidden execution.
    -- `Stopped` 는 **조기 return 두 곳에만** 쓴다 (C217). ResetExecution 은 성공
    -- 경로에서도 먼저 도므로, 거기에 Stopped 를 넣으면 Stopped→Running 깜빡임이
    -- 생겨 램프가 매 실행마다 빨갛게 튄다.
    self:ResetExecution()
    if commands == nil or type(commands) ~= "table" or #commands == 0 then
        self.ProgramState = "Stopped"
        log(self:WorkerTag() .. " empty program received - state=Stopped")
        return
    end

    if not self:ValidateProgram(commands) then
        self.ProgramState = "Stopped"
        log(self:WorkerTag() .. " program rejected: " .. tostring(self._T.validationError) .. " - state=Stopped")
        return
    end

    self.CommandQueue = commands
    self._T.frames = {
        { list = commands, index = 1, remaining = 1, kind = "root" }
    }
    self._T.actionStep = 0
    self._T.running = true
    self.ProgramState = "Running"
    -- T-05 (F7-C §1): 최종 검증을 통과한 프로그램만 마지막 유효 프로그램으로 기록.
    self:RecordLastValidProgram(commands)
    log(self:WorkerTag() .. " RunProgram accepted blocks=" .. tostring(self._T.validationBlockCount) .. " - state=Running")
end

@ExecSpace("ServerOnly")
method string GetLastValidationError()
    -- 라이브러리 저장 검증(F7-C)이 거절 사유·수정안을 만들 때 읽는다.
    return tostring(self._T.validationError)
end

@ExecSpace("ServerOnly")
method void RecordLastValidProgram(table commands)
    -- MVP 는 광산 맵당 1인 세션이다. 프로필 서비스에 내용을 넘겨 자동 저장
    -- 배치로 영속화한다 (즉시 저장하지 않는다 — F7-C §3).
    for _, user in ipairs(_UserService.UserEntities.Values) do
        if isvalid(user) then
            ---@type AccountProfileService
            local profile = user:GetComponent("script.AccountProfileService")
            if profile ~= nil then
                profile:RecordWorkerProgram(self.WorkerIndex, _HttpService:JSONEncode(commands))
            end
            return
        end
    end
end

@ExecSpace("Server")
method void StopProgram()
    -- Stops the current interpreter. 사용자가 정지시킨 것은 `Stopped` 다 (C217) —
    -- 자연 완료(`FinishProgram`)와 구분되지 않으면 "왜 멈췄지?" 에 답할 수 없다.
    self:ResetExecution()
    self.ProgramState = "Stopped"
    log(self:WorkerTag() .. " stopped by user - state=Stopped")
end

@ExecSpace("ServerOnly")
method void StopForMapTransition()
    -- Stops an active interpreter before its owner enters another mine map.
    -- 맵을 옮겨서 멈춘 것도 `Stopped` 다 (C217). F7-C 계약상 맵 전환 뒤에는
    -- 수동 실행 대기이므로, 플레이어에게 "멈춰 있다"가 보여야 맞다.
    self:ResetExecution()
    self.ProgramState = "Stopped"
    log(self:WorkerTag() .. " stopped for map transition - state=Stopped")
end

@ExecSpace("ServerOnly")
method void ConfigureFromProfile(integer workerIndex, integer cartCapacity, table cart, string pendingOre, integer pendingOreCount)
    -- Dynamic workers are spawned from one shared model. Rebind their stable index
    -- and authored start cell only after the spawn lifecycle has completed.
    self:ResetExecution()
    self.WorkerIndex = workerIndex
    -- The 20→50 upgrade cap applies to base capacity only. Rare-stone
    -- collection is a separate account bonus and can raise this runtime cap.
    local configuredCapacity = math.max(20, math.min(100, cartCapacity))
    self.CartCapacity = configuredCapacity
    self.Cart = { stone = 0, iron = 0, gold = 0, rare_stone = 0, rare_iron = 0, rare_gold = 0 }
    if type(cart) == "table" then
        for oreType, count in pairs(cart) do
            if (oreType == "stone" or oreType == "iron" or oreType == "gold" or oreType == "rare_stone" or oreType == "rare_iron" or oreType == "rare_gold") and type(count) == "number" and count > 0 then
                self.Cart[oreType] = math.floor(count)
            end
        end
    end
    self.CartCount = 0
    for _, count in pairs(self.Cart) do self.CartCount = self.CartCount + count end
    if self.CartCount > self.CartCapacity then
        self.Cart = { stone = 0, iron = 0, gold = 0, rare_stone = 0, rare_iron = 0, rare_gold = 0 }
        self.CartCount = 0
        pendingOre = ""
        log_warning(self:WorkerTag() .. " profile cart exceeded capacity and was cleared")
    end
    self.PendingOre = ""
    self.PendingOreCount = 0
    if pendingOre == "stone" or pendingOre == "iron" or pendingOre == "gold" or pendingOre == "rare_stone" or pendingOre == "rare_iron" or pendingOre == "rare_gold" then
        self.PendingOre = pendingOre
        -- v7 기록(개수 없음)은 1개로 복구한다 (F7-B §5.7 · B18은 2개 복구).
        self.PendingOreCount = math.max(1, math.min(2, math.floor(pendingOreCount or 1)))
    end
    if self._T.mineState ~= nil then
        local configuredStart = self._T.mineState:GetWorkerStart(workerIndex)
        if configuredStart ~= nil then
            self._T.cellX = configuredStart.cellX
            self._T.cellY = configuredStart.cellY
            self.CellX = self._T.cellX
            self.CellY = self._T.cellY
            self.Entity.KinematicbodyComponent:SetWorldPosition(self:CellToWorld(self._T.cellX, self._T.cellY))
        end
    end
    log(self:WorkerTag() .. " configured cart=" .. tostring(self.CartCount) .. "/" .. tostring(self.CartCapacity) .. " hand=" .. self.PendingOre .. " handCount=" .. tostring(self.PendingOreCount))
end

@ExecSpace("ServerOnly")
method boolean ApplyCartCapacity(integer cartCapacity)
    -- A purchased upgrade must preserve the currently running program, location,
    -- hand, and cart stacks; only the capacity limit changes.
    local nextCapacity = math.max(20, math.min(100, cartCapacity))
    if nextCapacity < self.CartCount then return false end
    self.CartCapacity = nextCapacity
    log(self:WorkerTag() .. " cart capacity upgraded=" .. tostring(self.CartCapacity))
    return true
end

@ExecSpace("ServerOnly")
method void AdvanceSimulationTick(integer tick)
    -- Advances control frames until one action executes or the evaluation budget is exhausted.
    if not self._T.running then return end
    self._T.lastSimulationTick = tick
    local evaluations = 0

    while self._T.running and evaluations < self.MaxEvaluationsPerTick do
        if self._T.frames == nil or #self._T.frames == 0 then
            self:FinishProgram()
            return
        end

        local frame = self._T.frames[#self._T.frames]
        if frame.index > #frame.list then
            evaluations = evaluations + 1
            if frame.kind == "repeat" and (frame.remaining == "inf" or frame.remaining > 1) then
                if frame.remaining ~= "inf" then
                    frame.remaining = frame.remaining - 1
                end
                frame.index = 1
            else
                table.remove(self._T.frames)
            end
        else
            local command = frame.list[frame.index]
            local commandType = command.type
            if self:IsActionType(commandType) then
                frame.index = frame.index + 1
                self._T.actionStep = self._T.actionStep + 1
                self:ExecuteAction(command)
                return
            elseif commandType == "repeat" then
                evaluations = evaluations + 1
                -- D2 invariant: advance the parent before entering its child.
                frame.index = frame.index + 1
                table.insert(self._T.frames, {
                    list = command.body,
                    index = 1,
                    remaining = command.count,
                    kind = "repeat",
                })
            elseif commandType == "if" then
                evaluations = evaluations + 1
                frame.index = frame.index + 1
                if self:EvaluateCondition(command.cond) then
                    table.insert(self._T.frames, {
                        list = command.body,
                        index = 1,
                        remaining = 1,
                        kind = "if",
                    })
                end
            end
        end
    end

    if self._T.running then
        log(self:WorkerTag() .. " eval limit hit simTick=" .. tostring(self._T.lastSimulationTick))
    end
end

@ExecSpace("ServerOnly")
method string GetProgramState()
    -- Returns the synchronized state — `Idle` / `Running` / `Stopped` (C217).
    -- `Idle` = 아직 안 돌렸거나 프로그램이 끝까지 갔다 · `Stopped` = 사용자 정지 ·
    -- 맵 전환 정지 · 서버 거절. `Blocked`(진행 불가)는 판정 로직이 없어 보류다.
    return self.ProgramState
end

@ExecSpace("ServerOnly")
method string WorkerTag()
    -- Stable per-instance prefix keeps two-worker runtime logs distinguishable.
    return "[Worker " .. tostring(self.WorkerIndex) .. "]"
end

@ExecSpace("ServerOnly")
method void ResetExecution()
    -- Clears every stack frame, queued command, and action counter.
    -- **항상 `Idle` 로 착지한다.** "멈춰 세운 것"을 뜻하는 호출자(StopProgram ·
    -- StopForMapTransition · RunProgram 의 거절 경로)는 이 뒤에 `Stopped` 로
    -- 덮어쓴다 (C217). 여기서 갈래를 만들면 성공 실행 경로까지 물든다.
    self.CommandQueue = {}
    self._T.frames = {}
    self._T.actionStep = 0
    self._T.running = false
    self.ProgramState = "Idle"
end

@ExecSpace("ServerOnly")
method void FinishProgram()
    -- Finalizes a naturally completed program and records positive log evidence.
    self:ResetExecution()
    log(self:WorkerTag() .. " program finished")
end

@ExecSpace("ServerOnly")
method void EmitVisualEvent(string kind, integer cellX, integer cellY)
    -- Publishes one F5 §2.2 action event. Sequence is written last so a client
    -- that observes the new Sequence always sees the matching kind and cell.
    self.VisualEventKind = kind
    self.VisualEventCellX = cellX
    self.VisualEventCellY = cellY
    self.VisualEventSequence = self.VisualEventSequence + 1
end

@ExecSpace("ServerOnly")
method boolean IsActionType(string commandType)
    -- Reports whether a command consumes one simulation tick as a D2 action.
    return commandType == "move" or commandType == "mine" or commandType == "load" or commandType == "unload"
end

@ExecSpace("ServerOnly")
method void ExecuteAction(table command)
    -- Dispatches one validated atomic action.
    local actionType = command.type
    if actionType == "move" then
        self:DoMove(command.dir)
    elseif actionType == "mine" then
        self:DoMine()
    elseif actionType == "load" then
        self:DoLoad()
    elseif actionType == "unload" then
        self:DoUnload()
    end
end

@ExecSpace("ServerOnly")
method boolean EvaluateCondition(string condition)
    -- Evaluates D2 ore conditions and the reserved D3 cart stubs.
    if condition == "ore_present" then
        return self._T.mineState:HasOre(self._T.cellX, self._T.cellY)
    elseif condition == "ore_absent" then
        return not self._T.mineState:HasOre(self._T.cellX, self._T.cellY)
    elseif condition == "cart_full" then
        return self.CartCount >= self.CartCapacity
    elseif condition == "cart_empty" then
        return self.CartCount == 0
    end
    return false
end

@ExecSpace("ServerOnly")
method boolean ValidateProgram(table program)
    -- Resets validator counters and validates the full untrusted client program.
    self._T.validationError = ""
    self._T.validationBlockCount = 0
    self._T.validationInfiniteCount = 0
    return self:ValidateList(program, 0)
end

@ExecSpace("ServerOnly")
method boolean ValidateList(table list, integer depth)
    -- Recursively enforces block, depth, type, direction, condition, and repeat limits.
    if type(list) ~= "table" then
        self._T.validationError = "body must be a table"
        return false
    end
    if depth > self.MaxProgramDepth then
        self._T.validationError = "depth limit exceeded"
        return false
    end

    for i = 1, #list do
        local command = list[i]
        if type(command) ~= "table" then
            self._T.validationError = "block " .. tostring(i) .. " must be a table"
            return false
        end

        self._T.validationBlockCount = self._T.validationBlockCount + 1
        if self._T.validationBlockCount > self.MaxProgramBlocks then
            self._T.validationError = "block limit exceeded"
            return false
        end

        local commandType = command.type
        if commandType == "move" then
            if command.dir ~= "E" and command.dir ~= "W" and command.dir ~= "N" and command.dir ~= "S" then
                self._T.validationError = "invalid dir=" .. tostring(command.dir)
                return false
            end
        elseif commandType == "mine" or commandType == "load" or commandType == "unload" then
            -- Action blocks have no additional D2 parameters.
        elseif commandType == "repeat" then
            local repeatCount = command.count
            if repeatCount == "inf" then
                if depth ~= 0 then
                    self._T.validationError = "infinite repeat must be top-level"
                    return false
                end
                self._T.validationInfiniteCount = self._T.validationInfiniteCount + 1
                if self._T.validationInfiniteCount > 1 then
                    self._T.validationError = "only one infinite repeat is allowed"
                    return false
                end
            elseif type(repeatCount) ~= "number" or repeatCount < 2 or repeatCount > 99 or math.floor(repeatCount) ~= repeatCount then
                self._T.validationError = "invalid repeat count=" .. tostring(repeatCount)
                return false
            end
            if not self:ValidateList(command.body, depth + 1) then return false end
        elseif commandType == "if" then
            local condition = command.cond
            if condition ~= "ore_present" and condition ~= "ore_absent" and condition ~= "cart_full" and condition ~= "cart_empty" then
                self._T.validationError = "invalid condition=" .. tostring(condition)
                return false
            end
            if not self:ValidateList(command.body, depth + 1) then return false end
        else
            self._T.validationError = "unknown type=" .. tostring(commandType)
            return false
        end
    end
    return true
end

@ExecSpace("ServerOnly")
method void DoMove(string dir)
    -- Moves one RectTile cell when the target tile is walkable.
    local dx, dy = 0, 0
    if dir == "E" then dx = 1
    elseif dir == "W" then dx = -1
    elseif dir == "N" then dy = 1
    elseif dir == "S" then dy = -1
    else
        log(self:WorkerTag() .. " invalid move dir=" .. tostring(dir))
        return
    end

    local targetX = self._T.cellX + dx
    local targetY = self._T.cellY + dy
    if not self:IsCellWalkable(targetX, targetY) then
        log(self:WorkerTag() .. " blocked " .. dir .. " at boundary target=(" .. targetX .. "," .. targetY .. ")")
        return
    end

    self._T.cellX = targetX
    self._T.cellY = targetY
    self.CellX = targetX
    self.CellY = targetY
    self.Entity.KinematicbodyComponent:SetWorldPosition(self:CellToWorld(self._T.cellX, self._T.cellY))
    self:EmitVisualEvent("move", self._T.cellX, self._T.cellY)
    log(self:WorkerTag() .. " simTick=" .. self._T.lastSimulationTick .. " step=" .. self._T.actionStep .. " - move " .. dir .. " -> cell (" .. self._T.cellX .. "," .. self._T.cellY .. ")")
end

@ExecSpace("ServerOnly")
method void DoMine()
    -- Atomically checks the hand before consuming a reserve stage.
    if self.PendingOre ~= "" then
        self:EmitVisualEvent("mine_fail", self._T.cellX, self._T.cellY)
        log(self:WorkerTag() .. " simTick=" .. self._T.lastSimulationTick .. " step=" .. self._T.actionStep .. " - hand full ore=" .. self.PendingOre)
        return
    end
    if not self._T.mineState:IsVein(self._T.cellX, self._T.cellY) then
        self:EmitVisualEvent("mine_fail", self._T.cellX, self._T.cellY)
        log(self:WorkerTag() .. " simTick=" .. self._T.lastSimulationTick .. " step=" .. self._T.actionStep .. " - no vein at (" .. self._T.cellX .. "," .. self._T.cellY .. ")")
        return
    end
    if not self._T.mineState:HasOre(self._T.cellX, self._T.cellY) then
        self:EmitVisualEvent("mine_fail", self._T.cellX, self._T.cellY)
        log(self:WorkerTag() .. " simTick=" .. self._T.lastSimulationTick .. " step=" .. self._T.actionStep .. " - vein empty at (" .. self._T.cellX .. "," .. self._T.cellY .. ")")
        return
    end

    local oreType = self._T.mineState:TryMine(self._T.cellX, self._T.cellY)
    if oreType == "" then
        self:EmitVisualEvent("mine_fail", self._T.cellX, self._T.cellY)
        log(self:WorkerTag() .. " simTick=" .. self._T.lastSimulationTick .. " step=" .. self._T.actionStep .. " - vein empty at (" .. self._T.cellX .. "," .. self._T.cellY .. ")")
        return
    end
    self.PendingOre = oreType
    -- F7-B §5.3 yield: 희귀 승격이 아닐 때만 확률로 같은 광물 1개 추가 (최대 2개).
    self.PendingOreCount = self._T.mineState:RollYieldCount(oreType)
    self:EmitVisualEvent("mine_success", self._T.cellX, self._T.cellY)
    local stage = self._T.mineState:GetReserveStage(self._T.cellX, self._T.cellY)
    log(self:WorkerTag() .. " simTick=" .. self._T.lastSimulationTick .. " step=" .. self._T.actionStep .. " - mine " .. oreType .. " x" .. tostring(self.PendingOreCount) .. " -> hand at (" .. self._T.cellX .. "," .. self._T.cellY .. ") stage=" .. stage)
    if self._T.mineState.AutoLoadOnMine then self:DoLoad() end
end

@ExecSpace("ServerOnly")
method void DoLoad()
    -- Moves the hand stack into this worker's cart without losing it on failure.
    -- F7-B §5.3: 손의 전량을 옮기되, 수레 여유가 1칸뿐이면 1개만 싣고 나머지는 손에 남긴다.
    if self.PendingOre == "" or self.PendingOreCount <= 0 then
        log(self:WorkerTag() .. " simTick=" .. self._T.lastSimulationTick .. " step=" .. self._T.actionStep .. " - hand empty")
        return
    end
    local space = self.CartCapacity - self.CartCount
    if space <= 0 then
        log(self:WorkerTag() .. " simTick=" .. self._T.lastSimulationTick .. " step=" .. self._T.actionStep .. " - cart full count=" .. self.CartCount)
        return
    end
    local moved = math.min(space, self.PendingOreCount)
    local oreType = self.PendingOre
    local oreCount = self.Cart[oreType]
    if oreCount == nil then oreCount = 0 end
    self.Cart[oreType] = oreCount + moved
    self.CartCount = self.CartCount + moved
    self.PendingOreCount = self.PendingOreCount - moved
    if self.PendingOreCount <= 0 then
        self.PendingOre = ""
        self.PendingOreCount = 0
    end
    self:EmitVisualEvent("load_success", self._T.cellX, self._T.cellY)
    log(self:WorkerTag() .. " simTick=" .. self._T.lastSimulationTick .. " step=" .. self._T.actionStep .. " - load " .. oreType .. " x" .. tostring(moved) .. " cart=" .. self.CartCount .. "/" .. self.CartCapacity .. " handLeft=" .. tostring(self.PendingOreCount))
end

@ExecSpace("ServerOnly")
method void DoUnload()
    -- Deposits every cart stack only at the configured depot cell.
    if not self._T.mineState:IsDepot(self._T.cellX, self._T.cellY) then
        log(self:WorkerTag() .. " simTick=" .. self._T.lastSimulationTick .. " step=" .. self._T.actionStep .. " - not at depot")
        return
    end
    if self.CartCount <= 0 then
        log(self:WorkerTag() .. " simTick=" .. self._T.lastSimulationTick .. " step=" .. self._T.actionStep .. " - cart empty")
        return
    end
    local unloaded = self.CartCount
    local rareUnloaded = 0
    for oreType, count in pairs(self.Cart) do
        if count > 0 then
            self._T.mineState:AddToDepot(oreType, count)
            if self:IsRareOre(oreType) then rareUnloaded = rareUnloaded + count end
        end
    end
    self.Cart = { stone = 0, rare_stone = 0 }
    self.CartCount = 0
    self:EmitVisualEvent("unload_success", self._T.cellX, self._T.cellY)
    -- F5 §2.2 중요 이벤트. **하역 1회당 정확히 1건**만 낸다 — 종류별로 AddToDepot
    -- 안에서 내면 희귀 돌+철을 함께 실은 수레가 한 틱에 2건을 만들고, 그러면
    -- 클라이언트의 "id 점프 = 놓친 이벤트" 가드에 걸려 **토스트가 통째로 사라진다**
    -- (MineNoticeController: noticeId > lastNoticeId + 1 이면 재생을 건너뛴다).
    if rareUnloaded > 0 then
        self._T.mineState:EmitMineNotice("rare_ore_unload", self._T.cellX, self._T.cellY, rareUnloaded)
    end
    log(self:WorkerTag() .. " simTick=" .. self._T.lastSimulationTick .. " step=" .. self._T.actionStep .. " - unload count=" .. unloaded .. " rare=" .. rareUnloaded .. " depotStone=" .. self._T.mineState.DepotStone)
end

@ExecSpace("ServerOnly")
method boolean IsRareOre(string oreType)
    -- 희귀 3종 판별. C196 이 고정한 종류이며 다른 곳에도 같은 목록이 있다.
    return oreType == "rare_stone" or oreType == "rare_iron" or oreType == "rare_gold"
end

@ExecSpace("ServerOnly")
method void ResetToTutorialState(integer cellX, integer cellY, string hand, integer handCount, integer cartStone)
    -- T-07 (F7-E §5.2): 서버 권위로 일꾼을 지정한 튜토리얼 단계 시작 상태로 되돌린다.
    -- 호출 창구는 TutorialService 하나뿐이며 값은 그쪽에서 이미 클램프됐다.
    self:ResetExecution()
    self.PendingOre = ""
    self.PendingOreCount = 0
    if hand == "stone" and handCount > 0 then
        self.PendingOre = "stone"
        self.PendingOreCount = math.min(2, handCount)
    end
    self.Cart = { stone = 0 }
    self.CartCount = 0
    if cartStone > 0 then
        self.Cart.stone = math.min(2, cartStone)
        self.CartCount = self.Cart.stone
    end
    if self:IsCellWalkable(cellX, cellY) then
        self._T.cellX = cellX
        self._T.cellY = cellY
        self.CellX = cellX
        self.CellY = cellY
        self.Entity.KinematicbodyComponent:SetWorldPosition(self:CellToWorld(cellX, cellY))
    else
        log_warning(self:WorkerTag() .. " tutorial reset cell not walkable (" .. tostring(cellX) .. "," .. tostring(cellY) .. ") - position kept")
    end
    log(self:WorkerTag() .. " tutorial reset cell=(" .. tostring(self.CellX) .. "," .. tostring(self.CellY) .. ") hand=" .. self.PendingOre .. " cart=" .. tostring(self.CartCount))
end

@ExecSpace("ServerOnly")
method void ResetInventory()
    -- Session-local reset used by restart flows and deterministic verification.
    self.PendingOre = ""
    self.PendingOreCount = 0
    self.Cart = { stone = 0, rare_stone = 0 }
    self.CartCount = 0
end

@ExecSpace("ServerOnly")
method boolean IsCellWalkable(integer cellX, integer cellY)
    -- Reports whether the requested RectTile cell exists and has a tile name.
    local tile = self._T.tilemap:GetTile(Vector2Int(cellX, cellY))
    return tile ~= nil and tile.Name ~= ""
end

@ExecSpace("ServerOnly")
method Vector2 CellToWorld(integer cellX, integer cellY)
    -- Converts a RectTile cell coordinate into a world-unit position.
    local world3 = self._T.tilemap:ToWorldPosition(Vector2Int(cellX, cellY))
    return Vector2(world3.x, world3.y)
end

end
