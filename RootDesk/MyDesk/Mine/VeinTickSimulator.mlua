-- ACTIVE MINE RUNTIME CONTRACT
-- This map-scoped component is the single server owner of simulation ticks,
-- vein state, and the shared depot ledger. Workers must register here and act
-- only through AdvanceSimulationTick; do not add an independent worker timer.
@Component
script VeinTickSimulator extends Component

property number TickInterval = 0.4
property integer CurrentTick = 0
property integer MaxReserveStage = 3
property integer StoneRecoverTicks = 5
property integer MineYield = 1
property integer CartCapacity = 20
property integer HandCapacity = 1
property boolean AutoLoadOnMine = false
property integer RequiredWorkerStartCount = 5
property integer DepotCellX = 0
property integer DepotCellY = 0
property string MineId = "beginner_mine"
property integer LayoutVersion = 2
property integer SpecialVeinSpawnTicks = 750
property integer SpecialVeinMaxActive = 3
property integer SpecialVeinSpawnBatch = 2
-- F7-B §5.3: 기준 단위는 만분율(basis point)이다. 정수 백분율로는 1% 에 +10% 를
-- 적용한 1.1%(110bp)를 표현할 수 없어 승격했다. 판정도 1..10000 을 쓴다.
property integer RareDropChanceBasisPoint = 100
property integer SpecialRareDropChanceBasisPoint = 500
property integer RareDropTestBasisPoint = -1
-- These tables are map-authored configuration injection points. They remain
-- empty in the existing prototype map, where the explicit fallback layout
-- below preserves the validated beginner-mine route.
property table DepotDefinitions = {}
property table VeinDefinitions = {}
property table WorkerStarts = {}
property table SpecialVeinCandidates = {}
-- Map component table overrides arrive empty in Maker Play.  Keep the legacy
-- fields for backward compatibility, but load authored layout JSON strings.
property string DepotDefinitionsJson = ""
property string VeinDefinitionsJson = ""
property string WorkerStartsJson = ""
property string SpecialVeinCandidatesJson = ""
property table VeinState = {}
property table Depot = {}

@Sync
property integer DepotStone = 0

@Sync
property integer DepotIron = 0

@Sync
property integer DepotGold = 0

-- F5 §2.2 중요 이벤트 채널. 일꾼의 행동 scalar(`WorkerController.VisualEvent*`)와
-- 분리된 별도 채널이다. 서버만 쓰고 클라이언트는 읽기만 한다. NoticeId 는 단조
-- 증가하며, 클라이언트는 아직 처리하지 않은 id 만 한 번 처리한다.
@Sync
property integer NoticeId = 0

-- special_vein_spawn / rare_ore_unload / sale_completed / appearance_obtained
@Sync
property string NoticeKind = ""

@Sync
property integer NoticeCellX = 0

@Sync
property integer NoticeCellY = 0

-- 이벤트별 요약 수량. special_vein_spawn 은 이번 묶음에서 스폰된 광맥 수다.
@Sync
property integer NoticeCount = 0

-- 이벤트를 놓쳤을 때 HUD 가 현재 상태로 복구할 수 있어야 한다 (F5 §2.2 / F5-5).
-- 그래서 "몇 개가 활성인가"는 이벤트가 아니라 상태로도 내려보낸다.
@Sync
property integer ActiveSpecialCount = 0

@ExecSpace("ServerOnly")
method void OnBeginPlay()
    -- Initializes the map-scoped vein ledger, shared depot, and worker registry.
    self._T.tickAccumulator = 0
    -- F7-B §5.5: 맵 강화 4효과 캐시. 매 틱 프로필을 조회하지 않는다 — 맵 진입 시와
    -- 강화 성공 시 AccountProfileService:PushMineBonusesToSimulator 가 갱신한다.
    self._T.bonusYield = 0.0
    self._T.bonusRecovery = 0.0
    self._T.bonusRareChance = 0.0
    self._T.bonusSpecialSpawn = 0.0
    self._T.workers = {}
    self._T.markers = {}
    self._T.markerList = {}
    self._T.activeSpecialVeins = {}
    self._T.nextSpecialCandidateIndex = 1
    self._T.tilemap = self.Entity:GetFirstChildComponentByTypeName("RectTileMapComponent")
    self.CurrentTick = 0
    self.DepotStone = 0
    self.DepotIron = 0
    self.DepotGold = 0
    -- NoticeId 만 여기서 0 으로 초기화한다. LoadLayout 은 맵 전환마다 다시 도는데
    -- 거기서 id 를 되돌리면 이미 본 id 가 재사용돼 클라이언트 중복 제거가 깨진다.
    self.NoticeId = 0
    self.NoticeKind = ""
    self.NoticeCellX = 0
    self.NoticeCellY = 0
    self.NoticeCount = 0
    if self._T.tilemap == nil then
        log_error("[VeinTick] RectTileMapComponent not found")
        return
    end
    if not self:LoadLayout() then
        log_error("[VeinTick] layout rejected mineId=" .. self.MineId .. " reason=" .. tostring(self._T.layoutError))
        return
    end

    log("[VeinTick] layout loaded mineId=" .. self.MineId .. " veins=" .. tostring(self._T.veinCount) .. " starts=" .. tostring(self._T.startCount) .. " specialCandidates=" .. tostring(self._T.specialCandidateCount) .. " depot=(" .. self.DepotCellX .. "," .. self.DepotCellY .. ")")
end

@ExecSpace("ServerOnly")
method void OnUpdate(number delta)
    -- Advances the deterministic server simulation at the configured fixed interval.
    self._T.tickAccumulator = self._T.tickAccumulator + delta
    while self._T.tickAccumulator >= self.TickInterval do
        self._T.tickAccumulator = self._T.tickAccumulator - self.TickInterval
        self.CurrentTick = self.CurrentTick + 1
        -- Fixed order for every simulation tick: recover veins first, then let
        -- registered workers execute one action. This order must stay stable.
        self:AdvanceTick()
        self:AdvanceWorkers()
        -- 회복과 채굴이 모두 끝난 뒤 한 번만 밀어 넣는다. 틱 중간 상태가
        -- 클라이언트에 보이지 않도록 순서를 유지할 것.
        self:SyncMarkerVisuals()
    end
end

@ExecSpace("ServerOnly")
method void AdvanceTick()
    -- Applies one recovery step to every authored vein before workers act.
    local recoveredCount = 0
    local recoveryMultiplier = self:GetRecoveryMultiplier()
    for key, vein in pairs(self.VeinState) do
        vein.recoverElapsed = vein.recoverElapsed + recoveryMultiplier
        if vein.recoverElapsed >= vein.recoverTicks then
            vein.recoverElapsed = 0
            if vein.stage < self.MaxReserveStage then
                vein.stage = vein.stage + 1
                recoveredCount = recoveredCount + 1
                log("[VeinTick] recovered cell " .. key .. " ore=" .. vein.ore .. " stage=" .. vein.stage)
            end
        end
    end

    if recoveredCount > 0 then
        log("[VeinTick] tick " .. self.CurrentTick .. " - recovered cells=" .. recoveredCount)
    end

    local effectiveSpawnTicks = self:GetEffectiveSpecialSpawnTicks()
    if effectiveSpawnTicks > 0 and self.CurrentTick % effectiveSpawnTicks == 0 then
        self:TrySpawnSpecialVeins()
    end
end

@ExecSpace("ServerOnly")
method void ApplyMineBonuses(number yieldBonus, number recoveryBonus, number rareChanceBonus, number specialSpawnBonus)
    -- F7-B §5.5: 프로필 서비스가 맵 진입·강화 성공 시에만 부르는 캐시 갱신 지점.
    self._T.bonusYield = math.max(0.0, yieldBonus)
    self._T.bonusRecovery = math.max(0.0, recoveryBonus)
    self._T.bonusRareChance = math.max(0.0, rareChanceBonus)
    self._T.bonusSpecialSpawn = math.max(0.0, specialSpawnBonus)
    log("[VeinTick] mine bonuses cached mineId=" .. self.MineId
        .. " yield=" .. tostring(self._T.bonusYield)
        .. " recovery=" .. tostring(self._T.bonusRecovery)
        .. " rareChance=" .. tostring(self._T.bonusRareChance)
        .. " specialSpawn=" .. tostring(self._T.bonusSpecialSpawn)
        .. " effectiveSpawnTicks=" .. tostring(self:GetEffectiveSpecialSpawnTicks()))
end

@ExecSpace("ServerOnly")
method integer GetEffectiveSpecialSpawnTicks()
    -- F7-B §5.3 (C200): max(60, floor(기본 / (1 + specialSpawn 보너스))). 하한 60틱.
    if self.SpecialVeinSpawnTicks <= 0 then return 0 end
    local bonus = self._T.bonusSpecialSpawn or 0.0
    if bonus <= 0 then return self.SpecialVeinSpawnTicks end
    return math.max(60, math.floor(self.SpecialVeinSpawnTicks / (1 + bonus)))
end

@ExecSpace("ServerOnly")
method void RegisterWorker(WorkerController worker)
    -- Adds a worker once while preserving deterministic registration order.
    if self._T.workers == nil then self._T.workers = {} end
    for i = 1, #self._T.workers do
        if self._T.workers[i] == worker then return end
    end
    table.insert(self._T.workers, worker)
    log("[VeinTick] worker registered count=" .. #self._T.workers)
end

@ExecSpace("ServerOnly")
method void UnregisterWorker(WorkerController worker)
    -- Removes a worker that is leaving the map or ending play.
    if self._T.workers == nil then return end
    for i = #self._T.workers, 1, -1 do
        if self._T.workers[i] == worker then
            table.remove(self._T.workers, i)
            log("[VeinTick] worker unregistered count=" .. #self._T.workers)
            return
        end
    end
end

@ExecSpace("ServerOnly")
method void RegisterMarker(string markerId, string markerKind, VeinMarker marker)
    -- Registers a map-authored marker so its stable ID can be checked in Play logs
    -- and so SyncMarkerVisuals can push F5 §2.1 visual state into it each tick.
    if markerId == nil or markerId == "" then
        log_error("[VeinTick] marker missing id kind=" .. tostring(markerKind))
        return
    end
    if self._T.markers == nil then self._T.markers = {} end
    if self._T.markers[markerId] ~= nil then
        log_error("[VeinTick] duplicate marker id=" .. markerId)
        return
    end
    self._T.markers[markerId] = { kind = markerKind, marker = marker }
    if self._T.markerList == nil then self._T.markerList = {} end
    table.insert(self._T.markerList, marker)

    -- 저작된 marker 셀이 실제 광맥/창고와 어긋나면 연출이 조용히 빈 채로 남는다.
    -- 등록 시점에 대조해 로그로 드러낸다.
    if markerKind == "normal" and not self:IsVein(marker.CellX, marker.CellY) then
        log_error("[VeinTick] marker cell has no vein id=" .. markerId
            .. " cell=(" .. marker.CellX .. "," .. marker.CellY .. ")")
    end
    log("[VeinTick] marker registered id=" .. markerId .. " kind=" .. markerKind
        .. " cell=(" .. marker.CellX .. "," .. marker.CellY .. ")")
end

@ExecSpace("ServerOnly")
method void SyncMarkerVisuals()
    -- Pushes the authoritative vein snapshot into every registered marker.
    -- ApplyVeinState skips unchanged markers, so this is cheap enough to run
    -- every tick and removes the need for change plumbing at each mutation site.
    if self._T.markerList == nil then return end
    for i = 1, #self._T.markerList do
        local marker = self._T.markerList[i]
        if marker ~= nil and isvalid(marker) then
            local vein = self:GetVein(marker.CellX, marker.CellY)
            if vein == nil then
                marker:ApplyVeinState("", 0, false)
            else
                marker:ApplyVeinState(vein.ore, vein.stage, vein.isSpecial == true)
            end
        end
    end
end

@ExecSpace("ServerOnly")
method void AdvanceWorkers()
    -- Gives each registered worker at most one action opportunity this tick.
    if self._T.workers == nil then return end
    for i = 1, #self._T.workers do
        local worker = self._T.workers[i]
        if worker ~= nil then
            worker:AdvanceSimulationTick(self.CurrentTick)
        end
    end
end

@ExecSpace("ServerOnly")
method boolean LoadLayout()
    -- Creates a session-only runtime ledger from map-provided layout tables.
    -- The fallback exists only so the already-authored farm01 prototype remains
    -- playable until MapBuilder writes the v2 properties into each map.
    self._T.layoutError = ""
    self._T.workerStarts = {}
    self._T.veinCount = 0
    self._T.startCount = 0
    self._T.specialCandidateCount = 0
    self._T.specialVeinCandidates = {}
    self._T.activeSpecialVeins = {}
    self._T.nextSpecialCandidateIndex = 1
    self.ActiveSpecialCount = 0
    self.VeinState = {}
    self.Depot = {}

    if self.LayoutVersion ~= 2 then
        self._T.layoutError = "unsupported layoutVersion=" .. tostring(self.LayoutVersion)
        return false
    end
    if self.MineId == nil or self.MineId == "" then
        self._T.layoutError = "missing mineId"
        return false
    end

    local depots = self:DecodeLayoutTable(self.DepotDefinitionsJson, "depot definitions")
    if depots == nil then
        if self._T.layoutError ~= "" then return false end
        depots = self:GetFallbackDepotDefinitions()
    end
    if #depots ~= 1 then
        self._T.layoutError = "expected exactly one depot"
        return false
    end
    local depot = depots[1]
    if depot == nil or depot.id == nil or depot.id == "" or depot.cellX == nil or depot.cellY == nil then
        self._T.layoutError = "invalid depot definition"
        return false
    end
    if not self:IsWalkableCell(depot.cellX, depot.cellY) then
        self._T.layoutError = "depot is not on a walkable tile"
        return false
    end
    self.DepotCellX = depot.cellX
    self.DepotCellY = depot.cellY

    local veinDefinitions = self:DecodeLayoutTable(self.VeinDefinitionsJson, "vein definitions")
    if veinDefinitions == nil then
        if self._T.layoutError ~= "" then return false end
        veinDefinitions = self:GetFallbackVeinDefinitions()
    end
    if #veinDefinitions == 0 then
        self._T.layoutError = "missing vein definitions"
        return false
    end
    local occupied = {}
    local ids = {}
    for i = 1, #veinDefinitions do
        local definition = veinDefinitions[i]
        if definition == nil or definition.id == nil or definition.id == "" then
            self._T.layoutError = "vein " .. tostring(i) .. " missing id"
            return false
        end
        if ids[definition.id] then
            self._T.layoutError = "duplicate vein id=" .. definition.id
            return false
        end
        if definition.cellX == nil or definition.cellY == nil or definition.oreType == nil or definition.oreType == "" or definition.markerId == nil or definition.markerId == "" then
            self._T.layoutError = "invalid vein id=" .. definition.id
            return false
        end
        if definition.oreType ~= "stone" and definition.oreType ~= "iron" and definition.oreType ~= "gold" then
            self._T.layoutError = "unsupported oreType=" .. definition.oreType
            return false
        end
        if not self:IsWalkableCell(definition.cellX, definition.cellY) then
            self._T.layoutError = "vein is not on a walkable tile id=" .. definition.id
            return false
        end
        if definition.initialStage ~= nil and (definition.initialStage < 0 or definition.initialStage > self.MaxReserveStage) then
            self._T.layoutError = "invalid initialStage id=" .. definition.id
            return false
        end
        if definition.recoverTicks ~= nil and definition.recoverTicks < 1 then
            self._T.layoutError = "invalid recoverTicks id=" .. definition.id
            return false
        end
        local key = self:CellKey(definition.cellX, definition.cellY)
        if occupied[key] then
            self._T.layoutError = "overlapping veins at " .. key
            return false
        end
        if definition.cellX == self.DepotCellX and definition.cellY == self.DepotCellY then
            self._T.layoutError = "vein overlaps depot id=" .. definition.id
            return false
        end
        ids[definition.id] = true
        occupied[key] = true
        local initialStage = definition.initialStage
        if initialStage == nil then initialStage = self.MaxReserveStage end
        local recoverTicks = definition.recoverTicks
        if recoverTicks == nil then recoverTicks = self.StoneRecoverTicks end
        self:AddVein(definition.cellX, definition.cellY, definition.oreType, initialStage, recoverTicks)
        self._T.veinCount = self._T.veinCount + 1
    end

    local starts = self:DecodeLayoutTable(self.WorkerStartsJson, "worker starts")
    if starts == nil then
        if self._T.layoutError ~= "" then return false end
        starts = self:GetFallbackWorkerStarts()
    end
    for i = 1, #starts do
        local start = starts[i]
        if start == nil or start.workerIndex == nil or start.cellX == nil or start.cellY == nil then
            self._T.layoutError = "invalid worker start=" .. tostring(i)
            return false
        end
        if start.workerIndex < 1 or start.workerIndex > 5 then
            self._T.layoutError = "workerIndex out of range=" .. tostring(start.workerIndex)
            return false
        end
        if self._T.workerStarts[start.workerIndex] ~= nil then
            self._T.layoutError = "duplicate workerIndex=" .. tostring(start.workerIndex)
            return false
        end
        if not self:IsWalkableCell(start.cellX, start.cellY) then
            self._T.layoutError = "worker start is not on a walkable tile index=" .. tostring(start.workerIndex)
            return false
        end
        self._T.workerStarts[start.workerIndex] = { cellX = start.cellX, cellY = start.cellY }
        self._T.startCount = self._T.startCount + 1
    end
    for workerIndex = 1, self.RequiredWorkerStartCount do
        if self._T.workerStarts[workerIndex] == nil then
            self._T.layoutError = "missing worker start index=" .. tostring(workerIndex)
            return false
        end
    end

    local specialCandidates = self:DecodeLayoutTable(self.SpecialVeinCandidatesJson, "special candidates")
    if specialCandidates == nil then
        if self._T.layoutError ~= "" then return false end
        specialCandidates = {}
    end
    local specialIds = {}
    local specialCells = {}
    for i = 1, #specialCandidates do
        local candidate = specialCandidates[i]
        if candidate == nil or candidate.id == nil or candidate.id == "" or candidate.markerId == nil or candidate.markerId == "" or candidate.cellX == nil or candidate.cellY == nil then
            self._T.layoutError = "invalid special candidate=" .. tostring(i)
            return false
        end
        if specialIds[candidate.id] then
            self._T.layoutError = "duplicate special candidate id=" .. candidate.id
            return false
        end
        local key = self:CellKey(candidate.cellX, candidate.cellY)
        if occupied[key] or (candidate.cellX == self.DepotCellX and candidate.cellY == self.DepotCellY) then
            self._T.layoutError = "special candidate overlaps occupied cell id=" .. candidate.id
            return false
        end
        if specialCells[key] then
            self._T.layoutError = "duplicate special candidate cell id=" .. candidate.id
            return false
        end
        if not self:IsWalkableCell(candidate.cellX, candidate.cellY) then
            self._T.layoutError = "special candidate is not on a walkable tile id=" .. candidate.id
            return false
        end
        specialIds[candidate.id] = true
        specialCells[key] = true
        self._T.specialCandidateCount = self._T.specialCandidateCount + 1
        table.insert(self._T.specialVeinCandidates, candidate)
    end
    return true
end

@ExecSpace("ServerOnly")
method integer TrySpawnSpecialVeins()
    -- Creates session-only special veins from unused authored candidates at a fixed tick cadence.
    if self._T.specialVeinCandidates == nil or #self._T.specialVeinCandidates == 0 then
        log("[VeinTick] special spawn skipped reason=no-candidates")
        return 0
    end
    if self._T.activeSpecialVeins == nil then self._T.activeSpecialVeins = {} end

    local activeCount = 0
    for _, active in pairs(self._T.activeSpecialVeins) do
        if active then activeCount = activeCount + 1 end
    end
    local slots = self.SpecialVeinMaxActive - activeCount
    if slots <= 0 then
        log("[VeinTick] special spawn skipped reason=max-active count=" .. activeCount)
        return 0
    end

    local targetCount = self.SpecialVeinSpawnBatch
    if targetCount < 1 then targetCount = 1 end
    if targetCount > slots then targetCount = slots end

    local spawned = 0
    -- 토스트·HUD 는 묶음당 한 번만 알린다(F5 §4 "스폰 묶음당 1회"). 대표 위치로
    -- 이번 묶음의 첫 광맥 셀을 쓴다.
    local firstCellX = 0
    local firstCellY = 0
    local candidateCount = #self._T.specialVeinCandidates
    for offset = 0, candidateCount - 1 do
        if spawned >= targetCount then break end
        local index = ((self._T.nextSpecialCandidateIndex - 1 + offset) % candidateCount) + 1
        local candidate = self._T.specialVeinCandidates[index]
        if candidate ~= nil and not self._T.activeSpecialVeins[candidate.id] then
            local oreType = candidate.oreType
            if oreType == nil or oreType == "" then oreType = "stone" end
            local recoverTicks = candidate.recoverTicks
            if recoverTicks == nil or recoverTicks < 1 then recoverTicks = self.StoneRecoverTicks end
            local key = self:CellKey(candidate.cellX, candidate.cellY)
            self.VeinState[key] = {
                ore = oreType,
                stage = self.MaxReserveStage,
                recoverTicks = recoverTicks,
                recoverElapsed = 0,
                isSpecial = true,
                specialId = candidate.id,
            }
            self._T.activeSpecialVeins[candidate.id] = true
            if spawned == 0 then
                firstCellX = candidate.cellX
                firstCellY = candidate.cellY
            end
            spawned = spawned + 1
            log("[VeinTick] special spawned id=" .. candidate.id .. " marker=" .. candidate.markerId .. " ore=" .. oreType .. " cell=" .. key)
        end
    end
    self._T.nextSpecialCandidateIndex = ((self._T.nextSpecialCandidateIndex - 1 + spawned) % candidateCount) + 1
    if spawned == 0 then
        log("[VeinTick] special spawn skipped reason=no-unused-candidate")
        return 0
    end
    self.ActiveSpecialCount = activeCount + spawned
    self:EmitMineNotice("special_vein_spawn", firstCellX, firstCellY, spawned)
    return spawned
end

@ExecSpace("ServerOnly")
method void EmitMineNotice(string kind, integer cellX, integer cellY, integer count)
    -- Publishes one F5 §2.2 important event. NoticeId is written last so a client
    -- that observes the new id always sees the matching payload, and it is never
    -- reset mid-session so a reconnecting client can tell old ids from new ones.
    self.NoticeKind = kind
    self.NoticeCellX = cellX
    self.NoticeCellY = cellY
    self.NoticeCount = count
    self.NoticeId = self.NoticeId + 1
    log("[VeinTick] notice id=" .. self.NoticeId .. " kind=" .. kind
        .. " cell=(" .. cellX .. "," .. cellY .. ") count=" .. count
        .. " activeSpecial=" .. self.ActiveSpecialCount)
end

@ExecSpace("ServerOnly")
method table GetSpecialVeinState()
    -- Returns active special vein IDs for later marker and HUD presentation layers.
    return self._T.activeSpecialVeins
end

@ExecSpace("ServerOnly")
method void ResetSessionForMapTransition()
    -- Rebuilds this map's session-only veins and specials after every exit.
    if self:LoadLayout() then
        log("[VeinTick] session reset mineId=" .. self.MineId)
    else
        log_error("[VeinTick] session reset rejected mineId=" .. self.MineId .. " reason=" .. tostring(self._T.layoutError))
    end
end

@ExecSpace("ServerOnly")
method table DecodeLayoutTable(string json, string label)
    -- Returns nil only when the map intentionally has no JSON configuration.
    if json == nil or json == "" then return nil end
    local decoded = _HttpService:JSONDecode(json)
    if type(decoded) ~= "table" then
        self._T.layoutError = "invalid " .. label .. " json"
        return nil
    end
    return decoded
end

@ExecSpace("ServerOnly")
method boolean IsWalkableCell(integer cellX, integer cellY)
    -- Static layout coordinates must point at a painted RectTile cell.
    if self._T.tilemap == nil then return false end
    local tile = self._T.tilemap:GetTile(Vector2Int(cellX, cellY))
    return tile ~= nil and tile.Name ~= ""
end

@ExecSpace("ServerOnly")
method table GetWorkerStart(integer workerIndex)
    -- Workers always respawn at the target map's configured start cell. Current
    -- runtime position and interpreter frames are intentionally not persisted.
    if self._T.workerStarts == nil then return nil end
    return self._T.workerStarts[workerIndex]
end

@ExecSpace("ServerOnly")
method table GetFallbackDepotDefinitions()
    return { { id = "depot-main", cellX = 0, cellY = 0 } }
end

@ExecSpace("ServerOnly")
method table GetFallbackVeinDefinitions()
    return {
        { id = "vein-stone-01", cellX = 1, cellY = 0, oreType = "stone", initialStage = 3, recoverTicks = 5 },
        { id = "vein-stone-02", cellX = 2, cellY = 0, oreType = "stone", initialStage = 3, recoverTicks = 5 },
        { id = "vein-stone-03", cellX = 2, cellY = -1, oreType = "stone", initialStage = 3, recoverTicks = 5 },
        { id = "vein-stone-04", cellX = 3, cellY = -1, oreType = "stone", initialStage = 3, recoverTicks = 5 },
    }
end

@ExecSpace("ServerOnly")
method table GetFallbackWorkerStarts()
    return {
        { workerIndex = 1, cellX = 0, cellY = 0 },
        { workerIndex = 2, cellX = 0, cellY = 1 },
        { workerIndex = 3, cellX = -1, cellY = 0 },
        { workerIndex = 4, cellX = -1, cellY = 1 },
        { workerIndex = 5, cellX = -2, cellY = 0 },
    }
end

@ExecSpace("ServerOnly")
method void AddVein(integer cellX, integer cellY, string oreType, integer stage, integer recoverTicks)
    -- Adds or replaces one vein entry after clamping its tuning values.
    local safeStage = stage
    if safeStage < 0 then safeStage = 0 end
    if safeStage > self.MaxReserveStage then safeStage = self.MaxReserveStage end

    local safeRecoverTicks = recoverTicks
    if safeRecoverTicks < 1 then safeRecoverTicks = 1 end

    self.VeinState[self:CellKey(cellX, cellY)] = {
        ore = oreType,
        stage = safeStage,
        recoverTicks = safeRecoverTicks,
        recoverElapsed = 0,
    }
end

@ExecSpace("ServerOnly")
method string CellKey(integer cellX, integer cellY)
    -- Produces the stable dictionary key used by all vein operations.
    return tostring(cellX) .. "," .. tostring(cellY)
end

@ExecSpace("ServerOnly")
method table GetVein(integer cellX, integer cellY)
    -- Returns the vein state at a cell or nil when the cell is not a vein.
    return self.VeinState[self:CellKey(cellX, cellY)]
end

@ExecSpace("ServerOnly")
method boolean IsVein(integer cellX, integer cellY)
    -- Reports whether a vein entry exists at the requested cell.
    return self:GetVein(cellX, cellY) ~= nil
end

@ExecSpace("ServerOnly")
method integer GetReserveStage(integer cellX, integer cellY)
    -- Returns the current reserve stage, treating non-vein cells as empty.
    local vein = self:GetVein(cellX, cellY)
    if vein == nil then return 0 end
    return vein.stage
end

@ExecSpace("ServerOnly")
method boolean HasOre(integer cellX, integer cellY)
    -- Reports whether the requested vein currently has a mineable stage.
    return self:GetReserveStage(cellX, cellY) >= 1
end

@ExecSpace("ServerOnly")
method number GetRecoveryMultiplier()
    -- This MVP has one active player per mine map. The rare-iron passive changes
    -- recovery speed continuously; the map `recovery` bonus is ADDED, not
    -- multiplied — C198 가산 합성: 1.0 + 희귀 철 + 맵 recovery 보너스 (최대 1.60).
    local mapBonus = self._T.bonusRecovery or 0.0
    if self.Entity.MapComponent == nil then return 1.0 + mapBonus end
    local users = _UserService:GetUsersByMapComponent(self.Entity.MapComponent)
    if users == nil or #users ~= 1 then return 1.0 + mapBonus end
    local profile = users[1]:GetComponent("script.AccountProfileService")
    if profile == nil or not profile.IsLoaded then return 1.0 + mapBonus end
    return 1.0 + profile.RareIronCollectionLevel * 0.03 + mapBonus
end

@ExecSpace("ServerOnly")
method boolean RollRareDrop(boolean isSpecial)
    -- F7-B §5.3: 만분율 판정. 테스트 훅이 켜져 있으면 그 값을 최종값으로 쓴다
    -- (보너스 미적용 — 결정적 테스트를 위해).
    local bp = self.RareDropChanceBasisPoint
    if isSpecial then bp = self.SpecialRareDropChanceBasisPoint end
    if self.RareDropTestBasisPoint >= 0 then
        bp = self.RareDropTestBasisPoint
    else
        bp = math.floor(bp * (1 + (self._T.bonusRareChance or 0.0)))
    end
    bp = math.max(0, math.min(10000, bp))
    if bp <= 0 then return false end
    if bp >= 10000 then return true end
    return _UtilLogic:RandomIntegerRange(1, 10000) <= bp
end

@ExecSpace("ServerOnly")
method integer RollYieldCount(string deliveredOre)
    -- F7-B §5.3 (C199): 확률(yield 보너스)로 같은 광물 1개 추가 지급, 최대 2개.
    -- 희귀로 승격된 채굴에는 적용하지 않는다 — 적용하면 희귀 획득량이 실질 2배가 된다.
    if deliveredOre == "rare_stone" or deliveredOre == "rare_iron" or deliveredOre == "rare_gold" then return 1 end
    local bonus = self._T.bonusYield or 0.0
    if bonus <= 0 then return 1 end
    local bp = math.max(0, math.min(10000, math.floor(bonus * 10000 + 0.5)))
    if _UtilLogic:RandomIntegerRange(1, 10000) <= bp then return 2 end
    return 1
end

@ExecSpace("ServerOnly")
method string TryMine(integer cellX, integer cellY)
    -- Atomically consumes one reserve stage and returns its ore type on success.
    local key = self:CellKey(cellX, cellY)
    local vein = self.VeinState[key]
    if vein == nil or vein.stage <= 0 then return "" end

    vein.stage = vein.stage - 1
    vein.recoverElapsed = 0
    local deliveredOre = vein.ore
    if self:RollRareDrop(vein.isSpecial == true) then
        deliveredOre = "rare_" .. vein.ore
    end
    log("[VeinTick] mined cell " .. key .. " ore=" .. deliveredOre .. " stage=" .. vein.stage)
    return deliveredOre
end

@ExecSpace("ServerOnly")
method boolean IsDepot(integer cellX, integer cellY)
    -- Reports whether a cell is the single shared session depot.
    return cellX == self.DepotCellX and cellY == self.DepotCellY
end

@ExecSpace("ServerOnly")
method integer AddToDepot(string oreType, integer count)
    -- Adds a positive amount to the shared depot and synchronizes stone totals.
    if count <= 0 then return self:GetDepotCount(oreType) end
    local current = self:GetDepotCount(oreType)
    self.Depot[oreType] = current + count
    if oreType == "stone" then self.DepotStone = self.Depot[oreType] end
    if oreType == "iron" then self.DepotIron = self.Depot[oreType] end
    if oreType == "gold" then self.DepotGold = self.Depot[oreType] end
    _EconomyService:CreditOreFromMine(self.Entity, oreType, count)
    log("[VeinTick] depot add ore=" .. oreType .. " count=" .. count .. " total=" .. self.Depot[oreType])
    return self.Depot[oreType]
end

@ExecSpace("ServerOnly")
method integer GetDepotCount(string oreType)
    -- Returns a depot stack count without exposing nil to callers.
    local count = self.Depot[oreType]
    if count == nil then return 0 end
    return count
end

end
