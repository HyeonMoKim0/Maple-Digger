-- TRANSACTION NOTICE (T-15, 2026-08-22 오너 요청)
-- 서버 결과 채널(LastTransactionMessage + LastTransactionSeq)을 전역으로 감시해,
-- "부족·거절·실패" 류 응답을 확인 단독 팝업(_UIPopup:OpenNotice)으로 안내한다.
-- 해금·일꾼 고용·수레 강화·광물 판매·외형(가챠/제작/교환)·라이브러리 슬롯 구매까지
-- 채널이 하나라 이 로직 하나로 전부 덮인다. 성공 문구는 기존 인라인 표기 유지
-- (예외: "맵 강화 완료" — §52-5에서 오너가 팝업으로 확정).
-- 인라인 소비처(MineSelect 헤더/판매 패널, 라이브러리, 외형)는 IsSuppressed 로
-- 같은 문구의 중복 표기를 건너뛴다.
@Logic
script TransactionNoticeLogic extends Logic

@ExecSpace("ClientOnly")
method void OnBeginPlay()
    -- 접속 시점의 잔존 메시지를 팝업하지 않도록 첫 관측에서 기준만 잡는다.
    self._T.seqBase = nil
    self._T.pendingMessage = nil
    self._T.lastPopupMessage = ""
    log("[TxnNotice] ready")
end

@ExecSpace("ClientOnly")
method AccountProfileService GetProfile()
    -- 로컬 플레이어의 프로필 @Sync 미러.
    local player = _UserService.LocalPlayer
    if player == nil then return nil end
    ---@type AccountProfileService
    local profile = player:GetComponent("script.AccountProfileService")
    return profile
end

@ExecSpace("ClientOnly")
method boolean IsSuppressed(string message)
    -- 이 문구가 팝업으로 이미 안내됐는가 — 인라인 피드백 표기가 이걸로 중복을 피한다.
    return message ~= nil and message ~= "" and message == self._T.lastPopupMessage
end

@ExecSpace("ClientOnly")
method boolean IsFailureMessage(string message)
    -- 실패/거절 판별. 서버 문구 전수 카탈로그(docs/16 §52-7) 기준이며, 성공 문구
    -- ("… 완료", "… 저장:", "…했습니다" 계열)와 겹치지 않는 조각만 쓴다.
    -- ⚠ string.find 의 plain 검색을 쓴다 — 한글은 바이트 단위 sub 로 자르면 깨진다 (§52-5).
    if message == nil or message == "" then return false end
    -- 시스템 발신(사용자 조작 없이 나오는) 문구는 제외한다.
    if string.find(message, "저장된 프로그램", 1, true) ~= nil then return false end
    local fragments = {
        "부족",             -- 재화·조건·재료 부족 전반
        "실패",             -- 저장 실패·되돌림 전반
        "할 수 없습니다",   -- 판매·강화·장착·변경 불가
        "할 수 있습니다",   -- "…뒤/…에서만/…만 …할 수 있습니다" 꼴 거절
        "해야 합니다",      -- "먼저 해금해야 합니다"
        "못했습니다",       -- "요청을 처리하지 못했습니다"
        "가득 찼습니다",    -- 슬롯 상한
        "이미 최대",        -- 최대 레벨·최대 인원
        "최대 용량",        -- 수레 상한
        "없습니다",         -- "저장할 블록이 없습니다" 등
        "보유하지 않은",    -- 미보유 외형
        "선택해 주세요",    -- 보장 부위·보호분 포함 선택 안내
    }
    for i = 1, #fragments do
        if string.find(message, fragments[i], 1, true) ~= nil then return true end
    end
    return false
end

@ExecSpace("ClientOnly")
method boolean ShouldPopup(string message)
    -- 팝업 대상: 실패/거절 전부 + 성공 예외("맵 강화 완료" — §52-5 오너 확정).
    if self:IsFailureMessage(message) then return true end
    return string.find(message, "맵 강화 완료", 1, true) == 1
end

@ExecSpace("ClientOnly")
method string FormatForPopup(string message)
    -- 가독성 개행 (§52-6): 첫 문장("…니다.") 뒤를 빈 줄로 띄워 제목/상세 2단.
    return (string.gsub(message, "니다%. ", "니다.\n\n", 1))
end

@ExecSpace("ClientOnly")
method void OnUpdate(number delta)
    local profile = self:GetProfile()
    if profile == nil then return end
    -- ① 대기 중인 팝업: 다른 팝업(확인 질문 등)이 닫히는 동안 도착한 결과는
    --    UIPopup 의 isOpen 가드에 삼켜지므로, 빌 때까지 들고 있다가 연다 (§52-5).
    local pending = self._T.pendingMessage
    if pending ~= nil then
        if _UIPopup.isOpen ~= true and _UIPopup.isTweenPlaying ~= true then
            self._T.pendingMessage = nil
            log("[TxnNotice] popup: " .. pending)
            _UIPopup:OpenNotice(self:FormatForPopup(pending), nil)
        end
        return
    end
    -- ② 시퀀스 감시. 첫 관측은 기준만 잡는다 (접속 잔존 메시지 팝업 방지).
    local seq = profile.LastTransactionSeq
    if self._T.seqBase == nil then
        self._T.seqBase = seq
        return
    end
    if seq == self._T.seqBase then return end
    self._T.seqBase = seq
    -- 튜토리얼 중에는 잠금·화살표가 화면을 소유한다 — 팝업으로 덮지 않는다.
    if _TutorialController ~= nil and _TutorialController:IsUiDragLocked() then return end
    local message = profile.LastTransactionMessage
    if not self:ShouldPopup(message) then return end
    self._T.lastPopupMessage = message
    self._T.pendingMessage = message
end

end
