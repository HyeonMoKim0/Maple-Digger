-- F5 §1 CLIENT-SIDE WORKER PRESENTATION
-- 서버가 확정한 WorkerController 의 @Sync 상태와 행동 이벤트만 읽어
-- 선택 링 · 채굴 파편 · Depot 강조를 그린다.
-- 게임 상태를 절대 바꾸지 않는다 (F5 §1 금지 사항).
-- RUID 는 docs/21 §5 확정값이다.
@Component
script WorkerVisualController extends Component

-- 표시 전용 자식 엔티티의 공용 모델. 맵 파일을 건드리지 않으려고 런타임에 붙인다.
property string FxModelId = "fxsprite"

-- 선택 일꾼 발밑 링 (docs/21 §5 승인). 116x40 = 1.16x0.40 world unit.
property string RingRuid = "76e2d942cc264558aad35f78be17b109"
-- 2026-08-18 오너 실측: 링이 일꾼보다 너무 아래에 떠서 -0.32 → -0.1 로 보정
-- (Play 중 직접 수치 편집으로 확정 — 시작 셀 기준 WorldPosition Y = 0.4).
property number RingOffsetY = -0.1
property integer RingOrderInLayer = 0

-- 채굴 파편 (docs/21 §5). **일꾼이 아니라 채굴한 광맥 셀 중심에 띄운다**
-- (2026-08-04 오너 검수). 일꾼 자식으로 두면 일꾼 스프라이트 크기에 맞춰
-- 오프셋을 잡아야 하는데, 아바타 교체 뒤 그 값이 전부 무효가 된다.
-- 셀 좌표는 Phase 1 이 만든 VisualEventCellX/Y 가 그대로 준다.
--
-- 자산은 **뭉게뭉게 피는 흰 먼지구름**이다 (2026-08-04 오너 확정).
-- 앞선 `78ea5621`(넓고 납작한 베이지 얼룩)은 오너 검수에서 "어울리지 않는다"로
-- 교체됐다 — 초록 바닥에 스며들어 얼룩처럼 읽혔다.
--
-- 후보는 **텍스트 검색으로 못 찾는다.** searchResources 가 돌려준 39건이 전부
-- 이름·점수가 비어 있었고, "먼지"로 잡힌 것 중에는 나무 상자와 검은 연기도 있었다.
-- 결국 `78ea5621` 을 씨앗으로 findSimilarResources 를 돌려 skill 카테고리
-- 애니메이션클립 12개를 얻고, 그걸 월드에 띄워 눈으로 골랐다.
-- (같은 종류의 오독: C206 부유석 condition · `d4f82b52` 어두운 얼룩 ·
--  `6ade17ad` 보라색 광석 — 전부 메타데이터 설명과 실제 그림이 달랐다.)
property string ShardRuid = "de538ed75f964038b61d6d735cd9ae0b"
property number ShardScale = 1.3
property integer ShardOrderInLayer = 6

-- 먼지 엔티티의 최종 오프셋 — **광맥 셀 기준, 광맥 종류별** (2026-08-18 오너 실측).
-- 오너가 Play 중 Worker01_Shard 의 Position 을 직접 움직여 확정한 **맵 절대좌표**
-- (일반: 광맥(1,0)에서 (0.75, 0.25) · 특별: 광맥(1,1)에서 (0.75, 1))를 셀 기준
-- 오프셋으로 환산한 값이다: 일반 (-0.75, -0.25) · 특별 (-0.75, -0.5).
-- 먼지는 광맥의 왼쪽(일꾼 쪽) 아래에 뜬다. 자산의 pivot 쏠림까지
-- **오너가 눈으로 보정해 포함한 값**이다.
--
-- ⚠ 자산(`de538ed7`)의 pivot 은 중심이 아니다 — 시각 중심이 엔티티 위치에서
-- ShardScale 에 비례해 밀린다 (1.3 배 실측: 가로 -1.11 / 세로 -0.28 unit).
-- **자산이나 ShardScale 을 바꾸면 이 오프셋을 오너와 다시 잰다.**
-- 다시 잴 때는 수명만 늘려 찍지 말 것 — 애니메이션클립이라 재생 중 시각 중심이
-- 프레임마다 이동한다. PlayRate 0.02 + StartFrameIndex/EndFrameIndex 0~1 로
-- 앞부분 프레임에 고정해 판정한다 (2026-08-06 오독 사례).
property number ShardOffsetNormalX = -0.75
property number ShardOffsetNormalY = -0.25
property number ShardOffsetSpecialX = -0.75
property number ShardOffsetSpecialY = -0.5

-- F5 §3 "0.3초 내 파편 효과".
property number ShardSeconds = 0.3

@ExecSpace("ClientOnly")
method void OnBeginPlay()
    -- Caches the sibling worker and builds the two client-local visuals.
    self._T.worker = self.Entity:GetComponent("script.WorkerController")
    self._T.lastSequence = -1
    self._T.shardElapsed = -1
    self._T.ring = nil
    self._T.shard = nil
    self._T.lastSelected = -1
    self._T.lastAppearanceKey = ""
    if self._T.worker == nil then
        log_error("[WorkerFx] WorkerController missing on " .. self.Entity.Name)
        return
    end
    self:EnsureVisuals()
    self:RefreshAppearance()
    log("[WorkerFx] ready " .. self.Entity.Name .. " index=" .. tostring(self._T.worker.WorkerIndex))
end

@ExecSpace("ClientOnly")
method void OnEndPlay()
    -- 클라이언트 로컬 엔티티라 서버가 치워 주지 않는다 (F5 §3).
    if self._T.ring ~= nil and isvalid(self._T.ring) then self._T.ring:Destroy() end
    if self._T.shard ~= nil and isvalid(self._T.shard) then self._T.shard:Destroy() end
    self._T.ring = nil
    self._T.shard = nil
end

@ExecSpace("ClientOnly")
method void OnUpdate(number delta)
    -- Polls the selection and consumes at most one unseen action event per frame.
    local worker = self._T.worker
    if worker == nil then return end

    self:RefreshRing()
    self:AdvanceShard(delta)
    self:RefreshAppearance()

    local sequence = worker.VisualEventSequence
    if sequence == self._T.lastSequence then return end
    if self._T.lastSequence < 0 then
        -- 최초 관측. 접속 전에 쌓인 행동을 소급 재생하지 않는다.
        self._T.lastSequence = sequence
        return
    end
    self._T.lastSequence = sequence
    self:PlayActionEvent(worker.VisualEventKind, worker.VisualEventCellX, worker.VisualEventCellY)
end

@ExecSpace("ClientOnly")
method void RefreshAppearance()
    -- 서버가 확정해 @Sync한 슬롯만 CostumeManager에 반영한다. 안전모·곡괭이는 건드리지 않는다.
    local worker = self._T.worker
    if worker == nil then return end
    local key = worker.AppearanceHairRuid .. "|" .. worker.AppearanceFaceRuid .. "|" .. worker.AppearanceCoatRuid .. "|" .. worker.AppearancePantsRuid
    if key == self._T.lastAppearanceKey then return end
    local costume = self.Entity.CostumeManagerComponent
    if costume == nil then
        log_error("[WorkerFx] CostumeManagerComponent missing on " .. self.Entity.Name)
        return
    end
    costume.CustomHairEquip = worker.AppearanceHairRuid
    costume.CustomFaceEquip = worker.AppearanceFaceRuid
    costume.CustomCoatEquip = worker.AppearanceCoatRuid
    costume.CustomPantsEquip = worker.AppearancePantsRuid
    self._T.lastAppearanceKey = key
    log("[WorkerFx] appearance applied " .. self.Entity.Name)
end

@ExecSpace("ClientOnly")
method void EnsureVisuals()
    -- Creates the ring and the shard once, as children of this worker.
    local map = self.Entity.CurrentMap
    if map == nil then return end

    if self._T.ring == nil then
        local ring = _SpawnService:SpawnByModelId(self.FxModelId, self.Entity.Name .. "_Ring", Vector3(0, self.RingOffsetY, 0), self.Entity)
        if ring == nil then
            log_error("[WorkerFx] ring spawn failed model=" .. self.FxModelId)
        else
            ring.TransformComponent.Position = Vector3(0, self.RingOffsetY, 0)
            local renderer = ring.SpriteRendererComponent
            if renderer ~= nil then
                renderer.SpriteRUID = self.RingRuid
                renderer.OrderInLayer = self.RingOrderInLayer
                renderer.Enable = false
            end
            self._T.ring = ring
        end
    end

    if self._T.shard == nil then
        -- 파편은 **맵의 자식**이다. 일꾼 자식으로 두면 좌표가 일꾼 로컬이 되어
        -- 채굴한 광맥 셀에 놓을 수 없고, 일꾼 스프라이트 크기에 오프셋이 묶인다.
        local shard = _SpawnService:SpawnByModelId(self.FxModelId, self.Entity.Name .. "_Shard", Vector3(0, 0, 0), map)
        if shard == nil then
            log_error("[WorkerFx] shard spawn failed model=" .. self.FxModelId)
        else
            shard.TransformComponent.Scale = Vector3(self.ShardScale, self.ShardScale, 1)
            local renderer = shard.SpriteRendererComponent
            if renderer ~= nil then
                renderer.SpriteRUID = self.ShardRuid
                renderer.OrderInLayer = self.ShardOrderInLayer
                -- 채굴 순간에만 뜬다. 평소에는 꺼 둔다.
                renderer.Enable = false
            end
            self._T.shard = shard
        end
    end
end

@ExecSpace("ClientOnly")
method void SetHitFxEnabled(boolean enabled)
    -- Toggles the mining debris.
    local shard = self._T.shard
    if shard == nil or not isvalid(shard) then return end
    local renderer = shard.SpriteRendererComponent
    if renderer ~= nil then renderer.Enable = enabled end
end

@ExecSpace("ClientOnly")
method boolean MoveShardToCell(integer cellX, integer cellY)
    -- Places the debris at the mined vein's cell (2026-08-04 오너 검수 —
    -- "파편은 광석 위치 중심에 발생할 것"). 셀 좌표는 서버가 행동 이벤트에
    -- 실어 보낸 값 그대로다.
    local shard = self._T.shard
    if shard == nil or not isvalid(shard) then return false end

    local map = self.Entity.CurrentMap
    if map == nil then return false end
    ---@type RectTileMapComponent
    local tilemap = map:GetFirstChildComponentByTypeName("RectTileMapComponent")
    if tilemap == nil then
        log_error("[WorkerFx] RectTileMapComponent not found")
        return false
    end

    local world = tilemap:ToWorldPosition(Vector2Int(cellX, cellY))
    -- 광맥 종류별 최종 오프셋 (속성 선언부의 ⚠ 참조 — 2026-08-18 오너 지정값).
    local offsetX = self.ShardOffsetNormalX
    local offsetY = self.ShardOffsetNormalY
    local special = self:IsSpecialCell(cellX, cellY)
    if special then
        offsetX = self.ShardOffsetSpecialX
        offsetY = self.ShardOffsetSpecialY
    end
    shard.TransformComponent.Position = Vector3(world.x + offsetX, world.y + offsetY, 0)
    if _MineLogPolicy:IsVerbose() then log("[WorkerFx] shard placed cell=(" .. tostring(cellX) .. "," .. tostring(cellY) .. ") special=" .. tostring(special) .. " offset=(" .. tostring(offsetX) .. "," .. tostring(offsetY) .. ")") end
    return true
end

@ExecSpace("ClientOnly")
method boolean IsSpecialCell(integer cellX, integer cellY)
    -- 특별 광맥 판정 — 맵 저작 marker 의 kind 를 본다. 특별 광맥은 반드시
    -- special-slot marker 셀에만 스폰되므로(F6), marker kind 가 곧 광맥 종류다.
    -- 서버 시뮬레이터를 부르지 않는 것은 F5 §1(클라이언트는 @Sync/이벤트만 읽는다) 때문.
    if self._T.markerCells == nil then
        self._T.markerCells = {}
        local map = self.Entity.CurrentMap
        if map ~= nil then
            local markers = map:GetChildComponentsByTypeName("script.VeinMarker", false)
            if markers ~= nil then
                for _, component in ipairs(markers) do
                    ---@type VeinMarker
                    local marker = component
                    if marker.MarkerKind == "special" then
                        self._T.markerCells[tostring(marker.CellX) .. "," .. tostring(marker.CellY)] = true
                    end
                end
            end
        end
    end
    return self._T.markerCells[tostring(cellX) .. "," .. tostring(cellY)] == true
end

@ExecSpace("ClientOnly")
method void RefreshRing()
    -- 선택 링은 프로그램 편집기의 선택값을 단일 기준으로 따른다 (F5 §3 / §5.3).
    -- HUD 가 인덱스를 따로 들고 있으면 둘이 어긋난다.
    local ring = self._T.ring
    if ring == nil or not isvalid(ring) then return end

    local selected = _BlockProgramController:GetSelectedWorkerIndex()
    if selected == self._T.lastSelected then return end
    self._T.lastSelected = selected

    local renderer = ring.SpriteRendererComponent
    if renderer == nil then return end
    renderer.Enable = selected == self._T.worker.WorkerIndex
end

@ExecSpace("ClientOnly")
method void PlayActionEvent(string kind, integer cellX, integer cellY)
    -- Renders one F5 §2.2 action event + F5 §4 사운드 cue (Phase 5).
    -- 쿨다운 판정은 MineSoundController 몫이다 — 여기서는 무조건 넘긴다.
    local workerKey = tostring(self._T.worker.WorkerIndex)
    if kind == "mine_success" then
        self:ShowShard(cellX, cellY)
        self:PlaySoundCue("mine_hit", workerKey)
        return
    end
    if kind == "mine_fail" then
        -- 시각 연출은 없다(의도). 선택 일꾼 여부는 사운드 쪽이 거른다.
        self:PlaySoundCue("mine_empty", workerKey)
        return
    end
    if kind == "load_success" then
        self:PlaySoundCue("cart_load", workerKey)
        return
    end
    if kind == "unload_success" then
        self:EmphasizeDepot()
        -- depot_unload 는 전역 쿨다운이라 key 가 무시되지만, 어느 일꾼이
        -- 트리거했는지 로그에 남게 일꾼 인덱스를 그대로 넘긴다.
        self:PlaySoundCue("depot_unload", workerKey)
        return
    end
    -- move 는 전용 연출·사운드가 없다. 조용히 넘어간다.
end

@ExecSpace("ClientOnly")
method void PlaySoundCue(string cue, string key)
    -- Forwards one cue to the map's sound controller (F5 §1 책임 분리).
    -- 컨트롤러가 없으면 무음으로 건너뛴다 — 사운드 부재가 시각 연출을 멈추면
    -- 안 된다 (F5 §4).
    local sound = self:FindSoundController()
    if sound == nil then return end
    sound:PlayCue(cue, key)
end

@ExecSpace("ClientOnly")
method MineSoundController FindSoundController()
    -- Resolves the map's sound controller once and caches it.
    if self._T.soundFx ~= nil and isvalid(self._T.soundFx) then return self._T.soundFx end
    local map = self.Entity.CurrentMap
    if map == nil then return nil end
    ---@type MineSoundController
    local sound = map:GetComponent("script.MineSoundController")
    self._T.soundFx = sound
    return sound
end

@ExecSpace("ClientOnly")
method void ShowShard(integer cellX, integer cellY)
    -- Places the debris on the mined vein, then shows it for ShardSeconds.
    -- 셀로 옮기지 못하면 아무 데나 띄우지 않고 건너뛴다 — 엉뚱한 자리의 파편은
    -- 없는 것보다 나쁘다.
    if not self:MoveShardToCell(cellX, cellY) then return end
    self:SetHitFxEnabled(true)
    self._T.shardElapsed = 0
    -- 0.3초짜리라 스크린샷으로 잡히지 않는다. 생성·소멸을 짝으로 남겨
    -- 로그만으로 1회 재생을 판정할 수 있게 한다 (verify-checklist Step 2b).
    if _MineLogPolicy:IsVerbose() then log("[WorkerFx] shard on " .. self.Entity.Name) end
end

@ExecSpace("ClientOnly")
method void AdvanceShard(number delta)
    -- Hides the shard once its short lifetime is over.
    if self._T.shardElapsed == nil or self._T.shardElapsed < 0 then return end
    self._T.shardElapsed = self._T.shardElapsed + delta
    if self._T.shardElapsed < self.ShardSeconds then return end

    self._T.shardElapsed = -1
    self:SetHitFxEnabled(false)
    if _MineLogPolicy:IsVerbose() then log("[WorkerFx] shard off " .. self.Entity.Name) end
end

@ExecSpace("ClientOnly")
method void EmphasizeDepot()
    -- Depot 강조는 marker 자신이 그린다. 여기서 Transform 을 직접 만지면
    -- VeinMarkerController 의 Scale 과 매 프레임 다툰다.
    local depot = self:FindDepotController()
    if depot == nil then
        log_error("[WorkerFx] depot marker not found for " .. self.Entity.Name)
        return
    end
    depot:PlayEmphasis()
    if _MineLogPolicy:IsVerbose() then log("[WorkerFx] depot emphasis by " .. self.Entity.Name) end
end

@ExecSpace("ClientOnly")
method VeinMarkerController FindDepotController()
    -- Resolves the depot marker once and caches it; the map has exactly one.
    if self._T.depotFx ~= nil and isvalid(self._T.depotFx) then return self._T.depotFx end

    local map = self.Entity.CurrentMap
    if map == nil then return nil end
    local markers = map:GetChildComponentsByTypeName("script.VeinMarker", false)
    if markers == nil then return nil end
    for _, component in ipairs(markers) do
        ---@type VeinMarker
        local marker = component
        if marker.MarkerKind == "depot" then
            ---@type VeinMarkerController
            local fx = marker.Entity:GetComponent("script.VeinMarkerController")
            self._T.depotFx = fx
            return fx
        end
    end
    return nil
end

end
