-- ACTIVE CLIENT HUD
-- Shows only synchronized server state. Inventory/depot mutations remain in
-- WorkerController and VeinTickSimulator so the client cannot grant resources.
-- Display contract: docs/08-비주얼-사운드-기능명세.md §5 (fields H1~H10 / I1).
@Logic
script MineInventoryController extends Logic

-- UIBuilder replaces these placeholders with generated entity UUIDs.
property TextGUIRendererComponent mineText = "365c199b-862d-462d-a8c9-64a9ad20bf05"
property TextGUIRendererComponent storageText = "10e4c593-6ae5-4625-8828-20a2597f5175"
property TextGUIRendererComponent currencyText = "a29041bf-f355-4b95-ab3c-eb0d5c38b8d5"
property TextGUIRendererComponent workerStateText = "8241b596-fed7-42ec-a823-696ded08ed1f"
-- 실행 상태 램프 (T-13 A2). **선택 일꾼** 기준이다 — H9(손·수레)와 같은 대상을
-- 가리켜야 하고, 선택 기준은 `_BlockProgramController` 하나뿐이다(F5 §5.3).
-- 램프는 위 workerStateText 를 대체하지 않고 함께 뜬다 (docs/20 §6).
property SpriteGUIRendererComponent workerStateLamp = "e0cd2e0e-0067-43ff-9f1b-2ef1374d0e8b"
-- docs/26 §5.4 확정 RUID. `Blocked` 는 판정 로직이 없어 보류다 (C217).
property string LampRunning = "b3837d651fe7474b9632fec45153cfe2"
property string LampIdle = "27e502e69b064e3bba82801c739740e5"
property string LampStopped = "5e178be4569841139fa6252de9220130"
property TextGUIRendererComponent depotText = "9395e38a-0b37-4c6e-ba68-ebd554c90fd3"
-- F5 §2.2 특별 광맥 "HUD 아이콘". 토스트를 놓쳐도 여기서 현재 상태를 읽을 수
-- 있어야 한다 (F5-5). 아이콘 자산 적용 자체는 T-08 범위라 지금은 텍스트다.
property TextGUIRendererComponent specialText = "93a12307-155f-4923-bf63-ce8398e6024c"
property TextGUIRendererComponent cartText = "ada2db0e-12dc-4412-82d0-e94425ced00c"
-- T-13 B1: 선택 일꾼 수레 적재율. Filled 스프라이트이므로 0~1 FillAmount만 갱신한다.
property SpriteGUIRendererComponent cartCapacityFill = "35672750-3baa-45ff-b67a-7c68daf20266"
property TextGUIRendererComponent handText = "936aa37c-c3da-4dcd-83a6-390a45b2ad4e"
property TextGUIRendererComponent inventoryStoneText = "1ca7983f-7693-4805-bbfe-a5e5529cbcbb"
property TextGUIRendererComponent inventoryIronText = "bf26fd3e-6fd1-45de-a17a-80ae4fc73f12"
property TextGUIRendererComponent inventoryGoldText = "f4777656-c94c-4e30-b459-b98aac679dbd"
property TextGUIRendererComponent inventoryStoneQuantityText = "a4f9ecc6-8eef-4c96-9cac-31bf3e342417"
property TextGUIRendererComponent inventoryIronQuantityText = "282401a5-57df-4981-a94a-b8ea8007f29a"
property TextGUIRendererComponent inventoryGoldQuantityText = "7ce6f7aa-58c1-4302-b701-b0aa7d2196c4"
-- 인벤토리 팝업의 희귀 컬렉션 필드 (docs/08 §5.2 I2~I6).
property TextGUIRendererComponent rareStoneText = "25ea3ae3-31f5-425c-abdb-695e0bf5c6aa"
property TextGUIRendererComponent rareIronText = "e81b1e08-66b8-4fc4-a7f6-51f0a0b39d8f"
property TextGUIRendererComponent rareGoldText = "841b16be-6b84-4598-9f35-e81548735df7"
property TextGUIRendererComponent saleSettingText = "2a0d93d2-63be-42cc-a8d2-0e62e659a59b"
property ButtonComponent btnInventory = "7e830fdf-624e-4d91-83d9-d6e2d321c96f"
property ButtonComponent btnClose = "6bf38474-c9e7-44b4-847d-36fb7fac3bb9"
property Entity inventoryPanel = "3434f74e-d21b-4493-a1f7-9406a7796a4c"

-- H2/H7 are constants until the v8 profile adds mineLevels and Crystal
-- (docs/08 §5.1 "미구현 필드의 처리", docs/16 §10.2 D-6).
property integer MineLevelMax = 10

-- H10 폭 잠금 (2026-08-27). `WorkerStateText` rect 는 330 이지만 슬레이트 프레임
-- 장식이 오른쪽 끝 30px 를 덮어 **실가용폭은 300** 이다 — 328px 문구가 화면에서
-- 프레임 밑으로 파고드는 것을 실측해 정했다. `BestFit` 은 이 컴포넌트가
-- `Overflow(0)` 이라 아예 동작하지 않아(실기 확인) 같은 일을 코드로 한다.
property number WorkerStateMaxWidth = 300
property number WorkerStateFontSize = 22
property number WorkerStateMinFontSize = 15

@ExecSpace("ClientOnly")
method void OnBeginPlay()
    -- Initializes cached HUD state, popup visibility, and UI event handlers.
    self._T.handlers = {}
    self._T.lastState = "__unset__"

    if self.inventoryPanel ~= nil then self.inventoryPanel.Enable = false end
    if self.btnInventory ~= nil then
        self._T.handlers.inventory = self.btnInventory.Entity:ConnectEvent(ButtonClickEvent, self.OnInventoryClicked)
    end
    if self.btnClose ~= nil then
        self._T.handlers.close = self.btnClose.Entity:ConnectEvent(ButtonClickEvent, self.OnCloseClicked)
    end

    self:RefreshUI(true)
    log("[MineInventoryUI] PC HUD ready")
end

@ExecSpace("ClientOnly")
method void OnUpdate(number delta)
    -- Polls synchronized values while RefreshUI suppresses unchanged redraws.
    self:RefreshUI(false)
end

@ExecSpace("ClientOnly")
method AccountProfileService GetProfile()
    -- Resolves the local player's server-owned account ledger (read-only here).
    local player = _UserService.LocalPlayer
    if player == nil then return nil end
    ---@type AccountProfileService
    local profile = player:GetComponent("script.AccountProfileService")
    return profile
end

@ExecSpace("ClientOnly")
method void RefreshUI(boolean force)
    -- Renders every field required by docs/08 §5.1 when any of them changed.
    local worker = self:GetSelectedWorker()
    local mineState = self:GetCurrentMineState()
    local profile = self:GetProfile()
    if worker == nil or mineState == nil or profile == nil then return end

    local workerIndex = self:GetSelectedWorkerIndex()
    local ownedCount = profile.OwnedWorkerCount
    -- Resolved once per refresh: the summary walks up to 5 child lookups, so
    -- building it twice (change key + display) would double that cost.
    local workerStates = self:GetWorkerStateSummary(ownedCount)
    local state = tostring(workerIndex) .. ":" .. tostring(ownedCount)
    state = state .. ":" .. tostring(mineState.MineId) .. ":" .. tostring(profile.LastMineId)
    state = state .. ":" .. tostring(profile.Stone) .. ":" .. tostring(profile.Iron) .. ":" .. tostring(profile.GoldOre)
    state = state .. ":" .. tostring(profile.Gold) .. ":" .. tostring(profile.MineTokens)
    state = state .. ":" .. tostring(worker.PendingOre) .. ":" .. tostring(worker.PendingOreCount) .. ":" .. tostring(worker.CartCount) .. ":" .. tostring(worker.CartCapacity)
    -- D-6 해소 (T-02): 맵 강화 레벨·크리스탈이 상수에서 @Sync 로 바뀌었다. 키에서
    -- 빠지면 강화해도 화면이 갱신되지 않는다 (무증상 실패).
    state = state .. ":" .. tostring(self:GetMineLevel(mineState, profile)) .. ":" .. tostring(profile.Crystal)
    state = state .. ":" .. tostring(mineState.DepotStone) .. ":" .. tostring(mineState.DepotIron) .. ":" .. tostring(mineState.DepotGold)
    state = state .. ":" .. workerStates
    -- 특별 광맥 현재 상태 + 최근 출현 위치. 키에서 빠지면 값이 바뀌어도 화면이
    -- 갱신되지 않는다 (F5 §5.3 무증상 실패).
    state = state .. ":" .. tostring(mineState.ActiveSpecialCount) .. ":" .. tostring(mineState.NoticeId)
    -- I2~I6: 희귀 컬렉션·보관·판매 잠금·패시브·판매 설정. 변경 감지 키에서 빠지면
    -- 값이 바뀌어도 팝업이 갱신되지 않는다 (무증상 실패).
    state = state .. ":" .. tostring(profile.RareStoneCollectionLevel) .. ":" .. tostring(profile.RareIronCollectionLevel) .. ":" .. tostring(profile.RareGoldCollectionLevel)
    state = state .. ":" .. tostring(profile.RareStoneStored) .. ":" .. tostring(profile.RareIronStored) .. ":" .. tostring(profile.RareGoldStored)
    state = state .. ":" .. tostring(profile.StoneAutoSell) .. ":" .. tostring(profile.IronAutoSell) .. ":" .. tostring(profile.GoldOreAutoSell)
    state = state .. ":" .. tostring(profile.StoneEffectiveProtection) .. ":" .. tostring(profile.IronEffectiveProtection) .. ":" .. tostring(profile.GoldOreEffectiveProtection)

    if not force and state == self._T.lastState then return end
    self._T.lastState = state
    if force then
        log("[MineInventoryUI] fields mine=" .. self:GetMineDisplayName(mineState, profile) .. " lv=" .. tostring(self:GetMineLevel(mineState, profile)) .. " storage=" .. tostring(profile.Stone) .. "/" .. tostring(profile.Iron) .. "/" .. tostring(profile.GoldOre) .. " gold=" .. tostring(profile.Gold) .. " crystal=" .. tostring(profile.Crystal) .. " token=" .. tostring(profile.MineTokens) .. " worker=" .. tostring(workerIndex) .. " cart=" .. tostring(worker.CartCount) .. "/" .. tostring(worker.CartCapacity) .. " states=" .. workerStates)
    end

    -- H1 + H2: current mine and its permanent upgrade level.
    if self.mineText ~= nil then
        self.mineText.Text = self:GetMineDisplayName(mineState, profile) .. "   Lv." .. tostring(self:GetMineLevel(mineState, profile)) .. " / " .. tostring(self.MineLevelMax)
    end
    -- H3~H5: account storage ledger, NOT the session depot total.
    if self.storageText ~= nil then
        self.storageText.Text = "창고  돌 " .. tostring(profile.Stone) .. "  철 " .. tostring(profile.Iron) .. "  금 " .. tostring(profile.GoldOre)
    end
    -- H6~H8: currencies.
    if self.currencyText ~= nil then
        self.currencyText.Text = "골드 " .. tostring(profile.Gold) .. "  크리스탈 " .. tostring(profile.Crystal) .. "  토큰 " .. tostring(profile.MineTokens)
    end
    -- H9: selected worker's hand and cart.
    if self.handText ~= nil then
        if worker.PendingOre == "" then
            self.handText.Text = "일꾼 " .. tostring(workerIndex) .. " 손: 비어 있음"
        elseif worker.PendingOreCount > 1 then
            -- F7-B §5.3 yield: 손에 같은 광물 2개가 들어올 수 있다.
            self.handText.Text = "일꾼 " .. tostring(workerIndex) .. " 손: " .. self:OreLabel(worker.PendingOre) .. " x" .. tostring(worker.PendingOreCount)
        else
            self.handText.Text = "일꾼 " .. tostring(workerIndex) .. " 손: " .. self:OreLabel(worker.PendingOre)
        end
    end
    if self.cartText ~= nil then
        self.cartText.Text = "일꾼 " .. tostring(workerIndex) .. " 수레: " .. tostring(worker.CartCount) .. " / " .. tostring(worker.CartCapacity)
    end
    if self.cartCapacityFill ~= nil then
        local ratio = 0
        if worker.CartCapacity > 0 then ratio = worker.CartCount / worker.CartCapacity end
        self.cartCapacityFill.FillAmount = math.max(0, math.min(1, ratio))
    end
    -- H10: per-worker program state for every owned worker.
    if self.workerStateText ~= nil then
        self:ApplyWorkerStateText("실행 상태  " .. workerStates)
    end
    self:ApplyStateLamp(worker.ProgramState)
    -- Session depot total is kept under its own label so it is never mistaken
    -- for the account ledger above (docs/16 §10.2 D-4).
    if self.depotText ~= nil then
        self.depotText.Text = "이번 세션 하역  돌 " .. tostring(mineState.DepotStone) .. " 철 " .. tostring(mineState.DepotIron) .. " 금 " .. tostring(mineState.DepotGold)
    end
    -- F5 §2.2: 특별 광맥 활성 수는 "상태"라 이벤트를 놓쳐도 복구된다. 최근 출현
    -- 위치는 특별 광맥이 하나라도 살아 있을 때만 뜻이 있으므로 그때만 덧붙인다.
    if self.specialText ~= nil then
        local specialLine = "특별 광맥  활성 " .. tostring(mineState.ActiveSpecialCount) .. "곳"
        if mineState.ActiveSpecialCount > 0 and mineState.NoticeKind == "special_vein_spawn" then
            specialLine = specialLine .. "   최근 (" .. tostring(mineState.NoticeCellX) .. ", " .. tostring(mineState.NoticeCellY) .. ")"
        end
        self.specialText.Text = specialLine
    end
    -- I1: inventory popup shows the account ledger too.
    if self.inventoryStoneText ~= nil then
        self.inventoryStoneText.Text = "돌"
    end
    if self.inventoryIronText ~= nil then
        self.inventoryIronText.Text = "철"
    end
    if self.inventoryGoldText ~= nil then
        self.inventoryGoldText.Text = "금"
    end
    if self.inventoryStoneQuantityText ~= nil then self.inventoryStoneQuantityText.Text = tostring(profile.Stone) end
    if self.inventoryIronQuantityText ~= nil then self.inventoryIronQuantityText.Text = tostring(profile.Iron) end
    if self.inventoryGoldQuantityText ~= nil then self.inventoryGoldQuantityText.Text = tostring(profile.GoldOre) end
    -- I2~I5: 희귀 3종의 컬렉션 단계 / 보관 수량 / 판매 잠금 / 적용 패시브.
    if self.rareStoneText ~= nil then
        self.rareStoneText.Text = self:RareRowText("돌", profile.RareStoneCollectionLevel, profile.RareStoneStored, "수레")
    end
    if self.rareIronText ~= nil then
        self.rareIronText.Text = self:RareRowText("철", profile.RareIronCollectionLevel, profile.RareIronStored, "회복")
    end
    if self.rareGoldText ~= nil then
        self.rareGoldText.Text = self:RareRowText("금", profile.RareGoldCollectionLevel, profile.RareGoldStored, "판매가")
    end
    -- I6: 일반 광물 자동 판매 여부와 실제로 판매를 막는 보호 수량.
    if self.saleSettingText ~= nil then
        self.saleSettingText.Text = "자동판매  돌 " .. self:OnOffLabel(profile.StoneAutoSell) .. " · 철 " .. self:OnOffLabel(profile.IronAutoSell) .. " · 금 " .. self:OnOffLabel(profile.GoldOreAutoSell) .. "\n보호 수량  돌 " .. tostring(profile.StoneEffectiveProtection) .. " · 철 " .. tostring(profile.IronEffectiveProtection) .. " · 금 " .. tostring(profile.GoldOreEffectiveProtection)
    end
end

@ExecSpace("ClientOnly")
method string RareRowText(string oreLabel, integer level, integer stored, string passiveLabel)
    -- "돌  3/10   보관 0   판매 잠김   수레 +9%" 한 줄. 패시브는 단계당 +3%이고
    -- 10단계 전에는 수동·자동 판매가 모두 잠긴다 (C196).
    local lockLabel = "판매 잠김"
    if level >= 10 then lockLabel = "판매 가능" end
    return oreLabel .. "  " .. tostring(level) .. "/10   보관 " .. tostring(stored) .. "   " .. lockLabel .. "   " .. passiveLabel .. " +" .. tostring(level * 3) .. "%"
end

@ExecSpace("ClientOnly")
method string OnOffLabel(boolean flag)
    -- 자동 판매 토글 표시.
    if flag then return "켬" end
    return "끔"
end

@ExecSpace("ClientOnly")
method string GetMineDisplayName(VeinTickSimulator mineState, AccountProfileService profile)
    -- Maps the layout MineId to its Korean label, falling back to the profile.
    local mineId = ""
    if mineState ~= nil then mineId = mineState.MineId end
    if mineId == "" or mineId == nil then mineId = profile.LastMineId end
    if mineId == "beginner_mine" or mineId == "farm01" then return "초보 광산" end
    if mineId == "deep_mine" then return "깊은 광산" end
    if mineId == "gem_mine" then return "보석 광산" end
    return tostring(mineId)
end

@ExecSpace("ClientOnly")
method integer GetMineLevel(VeinTickSimulator mineState, AccountProfileService profile)
    -- D-6 해소 (T-02): 현재 광산의 맵 강화 레벨. 서버 @Sync 3종에서 고른다 (재계산 금지).
    local mineId = ""
    if mineState ~= nil then mineId = mineState.MineId end
    if mineId == "" or mineId == nil then mineId = profile.LastMineId end
    if mineId == "deep_mine" then return profile.MineLevelDeep end
    if mineId == "gem_mine" then return profile.MineLevelGem end
    return profile.MineLevelBeginner
end

@ExecSpace("ClientOnly")
method void ApplyStateLamp(string programState)
    -- 선택 일꾼의 실행 상태를 램프 색으로 보조한다. 문구(`실행 상태  진행 1,2`)는
    -- 그대로 남는다 — 색 단독 표기는 docs/20 §6 위반이다.
    -- 모르는 상태는 Idle 로 떨어뜨린다. `Blocked` 가 나중에 생겨도 배선이 깨지지
    -- 않고 파랑으로 보일 뿐이며, 그때 이 분기에 한 줄을 더한다 (C217).
    if self.workerStateLamp == nil then return end
    if programState == "Running" then
        self.workerStateLamp.ImageRUID = DataRef(self.LampRunning)
    elseif programState == "Stopped" then
        self.workerStateLamp.ImageRUID = DataRef(self.LampStopped)
    else
        self.workerStateLamp.ImageRUID = DataRef(self.LampIdle)
    end
end

@ExecSpace("ClientOnly")
method void ApplyWorkerStateText(string line)
    -- H10 문구를 넣되 **가용폭(300)을 넘으면 들어갈 때까지 글자를 줄인다.**
    -- 상태별 묶음 표기라 폭은 유계지만, 5명이 서로 다른 5칸으로 흩어지는 최악 조합은
    -- 404px 라 포맷만으로는 막을 수 없다 (2026-08-27 `GetPreferredWidth` 실측:
    -- 1칸 181 · 3칸 283 · 4칸 333 · 5칸 404). 평상시(1~3칸)에는 축소가 걸리지 않아
    -- 옆 행들과 같은 22 로 뜬다.
    --
    -- `BestFit` 으로 하려 했으나 이 컴포넌트는 `Overflow(0)` 이라 "넘쳤다"고 판정하지
    -- 않아 전혀 축소되지 않았다(실기 확인) — 그래서 직접 잰다. `RefreshUI` 가 상태 키가
    -- 바뀔 때만 여기까지 오므로 매 프레임 레이아웃을 재는 비용은 없다.
    local text = self.workerStateText
    if text == nil then return end
    text.FontSize = self.WorkerStateFontSize
    text.Text = line
    local width = text:GetPreferredWidth(line)
    if width <= self.WorkerStateMaxWidth then return end
    local scaled = math.floor(self.WorkerStateFontSize * self.WorkerStateMaxWidth / width)
    if scaled < self.WorkerStateMinFontSize then scaled = self.WorkerStateMinFontSize end
    text.FontSize = scaled
    log("[MineInventoryUI] H10 shrink " .. tostring(self.WorkerStateFontSize) .. "->" .. tostring(scaled) .. " width=" .. tostring(math.floor(width)) .. " max=" .. tostring(self.WorkerStateMaxWidth))
end

@ExecSpace("ClientOnly")
method string GetWorkerStateSummary(integer ownedCount)
    -- 상태별로 묶어 "진행 1,2  대기 3" 한 줄을 만든다 (최대 5명).
    --
    -- 옛 형식은 일꾼마다 토큰 하나(`1 Running  ·  2 Running`)였는데, 토큰 하나가
    -- 구분자까지 약 132px 라 **폭이 일꾼 수에 비례**했다. 2명에서 이미 rect(330)을
    -- 넘겨 옆 칸을 침범했고 5명이면 740px 로 두 배를 넘겼다 (2026-08-27 오너 보고).
    -- 여기서는 폭이 **서로 다른 상태 수**(최대 4)에만 비례하므로 5명이어도 한 줄이다.
    --
    -- 상태 순서는 고정이다 — 일꾼이 상태를 오갈 때 칸 순서가 흔들리면 "어디를 봐야
    -- 하는지"가 매번 달라진다. `Blocked` 는 아직 판정 로직이 없지만(C217) 생겼을 때
    -- 배선이 깨지지 않도록 자리만 미리 잡아 둔다.
    local order = { "Running", "Idle", "Blocked", "Stopped", "-" }
    local label = { Running = "진행", Idle = "대기", Blocked = "막힘", Stopped = "정지" }
    local buckets = {}
    for index = 1, ownedCount do
        local worker = self:GetWorkerByIndex(index)
        -- 일꾼 엔티티를 못 찾은 경우도 "미확인"으로 남긴다. 숨기면 검수에서 누락과
        -- 구분되지 않는다 (docs/08 §5.1 "값이 0이거나 미구현이어도 숨기지 않는다").
        -- 모르는 상태 문자열도 같은 칸으로 떨어뜨려 조용히 사라지지 않게 한다.
        local key = "-"
        if worker ~= nil then key = tostring(worker.ProgramState) end
        if label[key] == nil then key = "-" end
        if buckets[key] == nil then buckets[key] = "" end
        if buckets[key] ~= "" then buckets[key] = buckets[key] .. "," end
        buckets[key] = buckets[key] .. tostring(index)
    end
    local summary = ""
    for orderIndex = 1, #order do
        local key = order[orderIndex]
        local indices = buckets[key]
        if indices ~= nil and indices ~= "" then
            local name = label[key]
            if name == nil then name = "미확인" end
            if summary ~= "" then summary = summary .. "  " end
            summary = summary .. name .. " " .. indices
        end
    end
    if summary == "" then return "-" end
    return summary
end

@ExecSpace("ClientOnly")
method WorkerController GetWorkerByIndex(integer workerIndex)
    -- Resolves a worker in the current mine by its Worker0N entity name.
    local player = _UserService.LocalPlayer
    if player == nil or player.CurrentMap == nil then return nil end
    local suffix = tostring(workerIndex)
    if workerIndex < 10 then suffix = "0" .. suffix end
    local workerEntity = player.CurrentMap:GetChildByName("Worker" .. suffix, false)
    if workerEntity == nil then return nil end
    ---@type WorkerController
    local worker = workerEntity:GetComponent("script.WorkerController")
    return worker
end

@ExecSpace("ClientOnly")
method WorkerController GetSelectedWorker()
    -- The program editor owns target selection; the HUD mirrors that target.
    local selected = _BlockProgramController:GetSelectedWorker()
    if selected ~= nil then return selected end
    return nil
end

@ExecSpace("ClientOnly")
method VeinTickSimulator GetCurrentMineState()
    -- Resolves the active map's synchronized depot after a player map change.
    local player = _UserService.LocalPlayer
    if player == nil or player.CurrentMap == nil then return nil end
    ---@type VeinTickSimulator
    local mineState = player.CurrentMap:GetComponent("script.VeinTickSimulator")
    return mineState
end

@ExecSpace("ClientOnly")
method integer GetSelectedWorkerIndex()
    -- Follows the program editor's selection instead of a hard-coded slot
    -- (docs/08 §5.3, docs/16 §10.2 D-5).
    return _BlockProgramController:GetSelectedWorkerIndex()
end

@ExecSpace("ClientOnly")
method string OreLabel(string oreType)
    -- Converts the serialized ore key into its localized display label.
    if oreType == "stone" then return "돌" end
    if oreType == "iron" then return "철" end
    if oreType == "gold" then return "금" end
    return oreType
end

@ExecSpace("ClientOnly")
method void OnInventoryClicked()
    -- Toggles the inventory popup and forces a fresh value render when opened.
    if self.inventoryPanel == nil then return end
    self.inventoryPanel.Enable = not self.inventoryPanel.Enable
    -- T-12-B: 열 때는 설정 모달을 닫는다 — 중앙 모달은 한 번에 하나 (F5 §6.1).
    if self.inventoryPanel.Enable and _SettingsPanelController ~= nil then
        _SettingsPanelController:ClosePanel()
    end
    if self.inventoryPanel.Enable and _AppearanceController ~= nil then
        _AppearanceController:ClosePanel()
    end
    self:RefreshUI(true)
end

@ExecSpace("ClientOnly")
method void OnCloseClicked()
    -- Closes the inventory popup without mutating any server-owned state.
    if self.inventoryPanel ~= nil then self.inventoryPanel.Enable = false end
end

@ExecSpace("ClientOnly")
method table GetTutorialButtons()
    -- T-07 (F7-E §5.1): 튜토리얼 잠금 대상 — 인벤토리 열기 버튼.
    return { inventoryOpen = self.btnInventory }
end

@ExecSpace("ClientOnly")
method void OnEndPlay()
    -- Disconnects every UI event handler created during begin play.
    if self.btnInventory ~= nil and self._T.handlers.inventory ~= nil then
        self.btnInventory.Entity:DisconnectEvent(ButtonClickEvent, self._T.handlers.inventory)
    end
    if self.btnClose ~= nil and self._T.handlers.close ~= nil then
        self.btnClose.Entity:DisconnectEvent(ButtonClickEvent, self._T.handlers.close)
    end
end

end
