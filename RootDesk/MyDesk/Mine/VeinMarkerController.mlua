-- F5 §1 CLIENT-SIDE MARKER RENDERING
-- 서버가 확정한 VeinMarker 의 @Sync 상태만 읽어 스프라이트를 고른다.
-- 게임 상태를 절대 바꾸지 않는다 (F5 §1 금지 사항).
-- RUID 는 docs/21 §7.1 확정값이며 C205·C206 이 근거다.
@Component
script VeinMarkerController extends Component

-- 일반 광맥 = 부유석(npc/2400021.img). stage 3→0 순서로 광물이 줄어든다.
-- 관측 잔량 순서는 stand ≈ condition1 > condition3 ≈ condition4 > condition5 이며
-- condition2 는 색만 달라(빨강) D5 §8 V1 위반이라 제외했다 (C206).
property string Stage3Ruid = "0f44530d655f4e33bfbe43423450ee9f"
property string Stage2Ruid = "a0bd28cbdcd54445827f0375f24266b5"
property string Stage1Ruid = "2daf76debab042e09b2d3bf2d5ba575f"
property string Stage0Ruid = "40c805ead61d440889632ef2244dab30"

-- 특별 광맥 = 신비한 광석(mob/9300497.img). 바위 받침이라는 형태 차이로
-- 일반 광맥과 즉시 구분된다 (F5 §2.2 / D5 §7).
property string SpecialRuid = "2e0c28aa5d2c4118b53668f6649b7322"

-- Depot = 눈 없는 금속 광차. 108x80 이 아니라 128x64 라 한 셀에 잘 들어간다.
property string DepotRuid = "3d661344f01f4c1c8fc0facbb80df834"

-- 부유석은 80x144 = 0.8 x 1.44 world unit 이라 한 셀(1 unit)을 세로로 44% 넘는다.
-- 축소하지 않으면 위아래 칸의 광맥·일꾼과 겹쳐 보인다 (C206).
property number VeinScale = 0.7
property number SpecialScale = 1.0
property number DepotScale = 1.0

-- 특별 광맥 스폰 강조 (F5 §2.2 "월드 전용 marker"). 별도 파티클 자산이 없어
-- (docs/21 §5.1) 크기 펄스로 시선을 끈다. 사운드 cue 는 Phase 5 범위다.
property number SpawnPulseSeconds = 0.6
property number SpawnPulseScale = 1.6

-- D-14: 광물 종류 아이콘 뱃지 (C205 방안 C / docs/21 §1.3).
-- stage 는 부모 스프라이트가, 광물 종류는 이 뱃지가 담당한다. 색조로만 구분하는
-- 방안은 D5 §8 V1("색 외의 형태로 구분")을 어겨 기각됐다.
-- 아이콘 RUID 3종은 docs/20 §0 승인값이며 전부 sprite 타입이라 thumbnail:// 을 붙이지 않는다.
property string BadgeModelId = "orebadge"
property string StoneBadgeRuid = "184829e852ab4810898f5bb72b9db8a3"
property string IronBadgeRuid = "79f438d0427142f09f979b58e982b1bd"
property string GoldBadgeRuid = "658807fea5a24a0299a2b909c36b3025"

-- 뱃지는 광맥 스프라이트 상단에 얹는다. 부모 로컬 좌표이며 부모 Scale 이 곱해진다.
-- 부유석(0.8x1.44)과 신비한 광석(1.08x0.80)은 높이가 달라 kind 별로 값이 다르다.
property number BadgeHeightNormal = 0.62
property number BadgeHeightSpecial = 0.45
-- 부모가 0.7 로 축소돼 있어 뱃지도 함께 줄어든다. 원본 28~32px(0.28~0.32 unit)이
-- 0.3 unit 내외로 보이도록 되돌린다 (docs/21 §1.3).
property number BadgeScale = 1.4

@ExecSpace("ClientOnly")
method void OnBeginPlay()
    -- Caches the sibling marker and paints the first frame.
    self._T.marker = self.Entity:GetComponent("script.VeinMarker")
    self._T.lastRevision = -1
    -- 음수는 "펄스 없음"이다. 접속 시점에 이미 활성인 특별 광맥까지 강조하면
    -- 재접속마다 스폰 연출이 반복되므로(F5-5) 첫 페인트는 제외한다.
    self._T.pulseElapsed = -1
    self._T.wasActive = false
    self._T.firstPaint = true
    self._T.badge = nil
    if self._T.marker == nil then
        log_error("[VeinMarkerFx] VeinMarker missing on " .. self.Entity.Name)
        return
    end
    self:EnsureBadge()
    self:Repaint()
end

@ExecSpace("ClientOnly")
method void OnEndPlay()
    -- 뱃지는 클라이언트 로컬 엔티티라 서버가 치워 주지 않는다. 맵을 떠날 때
    -- 직접 지운다 (F5 §3 "임시 파티클·타이머·핸들은 map unload 에서 정리").
    if self._T.badge ~= nil and isvalid(self._T.badge) then
        self._T.badge:Destroy()
    end
    self._T.badge = nil
end

@ExecSpace("ClientOnly")
method void EnsureBadge()
    -- Creates the client-local ore-type badge once, as a child of this marker.
    -- 맵 파일을 건드리지 않으려고 런타임 생성을 택했다 — 이미 배치된 marker 35개에
    -- 자식 엔티티를 심으려면 .map 3개를 모두 수술해야 한다.
    local marker = self._T.marker
    if marker == nil or self._T.badge ~= nil then return end
    -- Depot 은 광물 종류가 없다.
    if marker.MarkerKind == "depot" then return end

    local height = self.BadgeHeightNormal
    if marker.MarkerKind == "special" then height = self.BadgeHeightSpecial end

    local badge = _SpawnService:SpawnByModelId(self.BadgeModelId, self.Entity.Name .. "_Badge", Vector3(0, height, 0), self.Entity)
    if badge == nil then
        -- 모델이 없으면 조용히 nil 이 온다(platform.md §8). 뱃지는 표시 전용이라
        -- 여기서 멈추지 않고 stage 표시만 계속한다.
        log_error("[VeinMarkerFx] badge spawn failed model=" .. self.BadgeModelId .. " on " .. self.Entity.Name)
        return
    end

    -- 부모 자식 좌표는 부모 로컬이다. 스폰 인자만 믿지 않고 명시적으로 다시 쓴다.
    badge.TransformComponent.Position = Vector3(0, height, 0)
    badge.TransformComponent.Scale = Vector3(self.BadgeScale, self.BadgeScale, 1)
    self._T.badge = badge
    log("[VeinMarkerFx] badge attached " .. self.Entity.Name .. " kind=" .. marker.MarkerKind)
end

@ExecSpace("ClientOnly")
method void UpdateBadge(VeinMarker marker, boolean parentVisible)
    -- Shows the ore icon whenever the marker itself is visible.
    -- 고갈(stage 0)에서도 뱃지는 유지한다 — 무슨 광맥이었는지 알아야 회복을
    -- 기다릴 수 있다 (docs/21 §1.3).
    local badge = self._T.badge
    if badge == nil then return end
    if not isvalid(badge) then
        self._T.badge = nil
        return
    end

    local renderer = badge.SpriteRendererComponent
    if renderer == nil then return end

    local ruid = self:BadgeRuid(marker.OreType)
    if ruid == "" or not parentVisible then
        renderer.Enable = false
        return
    end
    renderer.Enable = true
    renderer.SpriteRUID = ruid
end

@ExecSpace("ClientOnly")
method string BadgeRuid(string oreType)
    -- Maps the serialized ore key to its approved icon (docs/20 §0).
    -- 희귀 광물은 광맥 종류가 아니라 채굴 결과이므로 여기 오지 않는다.
    if oreType == "stone" then return self.StoneBadgeRuid end
    if oreType == "iron" then return self.IronBadgeRuid end
    if oreType == "gold" then return self.GoldBadgeRuid end
    return ""
end

@ExecSpace("ClientOnly")
method void OnUpdate(number delta)
    -- VisualRevision 이 바뀔 때만 다시 그린다. 서버가 무변경 틱에는 올리지
    -- 않으므로 정지 상태에서는 비교 1회로 끝난다.
    if self._T.marker == nil then return end
    if self._T.marker.VisualRevision ~= self._T.lastRevision then
        self:Repaint()
    end
    -- 펄스는 revision 과 무관하게 진행돼야 한다. Repaint 뒤에 두어 이번 프레임의
    -- 기본 Scale 위에 덮어쓴다.
    self:AdvanceSpawnPulse(delta)
end

@ExecSpace("ClientOnly")
method void PlayEmphasis()
    -- Public one-shot emphasis. Depot 강조(F5 §3 unload_success)처럼 다른
    -- 컨트롤러가 이 marker 를 강조시키고 싶을 때 부른다. Transform.Scale 은
    -- 이 컴포넌트만 쓰도록 해서 두 곳이 같은 값을 다투지 않게 한다.
    self._T.pulseElapsed = 0
end

@ExecSpace("ClientOnly")
method void AdvanceSpawnPulse(number delta)
    -- Shrinks the marker from SpawnPulseScale back to its resting scale once.
    if self._T.pulseElapsed == nil or self._T.pulseElapsed < 0 then return end
    self._T.pulseElapsed = self._T.pulseElapsed + delta

    -- 쉬는 크기는 kind 마다 다르다(일반 0.7 / 특별·Depot 1.0). Repaint 가 정한
    -- 값으로 돌아가지 않으면 Depot 이 펄스 뒤에 특별 광맥 크기로 굳어 버린다.
    local rest = self._T.restScale
    if rest == nil then rest = self.VeinScale end

    local progress = self._T.pulseElapsed / self.SpawnPulseSeconds
    if progress >= 1 then
        self._T.pulseElapsed = -1
        self.Entity.TransformComponent.Scale = Vector3(rest, rest, 1)
        return
    end

    local scale = rest * (1 + (self.SpawnPulseScale - 1) * (1 - progress))
    self.Entity.TransformComponent.Scale = Vector3(scale, scale, 1)
end

@ExecSpace("ClientOnly")
method void Repaint()
    -- Picks one RUID from (MarkerKind, OreType, ReserveStage) and applies it.
    local marker = self._T.marker
    if marker == nil then return end
    self._T.lastRevision = marker.VisualRevision
    -- 플래그는 여기서 즉시 내린다. 아래 분기에는 조기 return 경로가 있어 메서드
    -- 끝에서 내리면 "첫 페인트"가 계속 참으로 남는다.
    local isFirstPaint = self._T.firstPaint == true
    self._T.firstPaint = false

    local renderer = self.Entity.SpriteRendererComponent
    if renderer == nil then
        log_error("[VeinMarkerFx] SpriteRendererComponent missing on " .. self.Entity.Name)
        return
    end

    local ruid = ""
    local scale = self.VeinScale

    if marker.MarkerKind == "depot" then
        ruid = self.DepotRuid
        scale = self.DepotScale
    elseif marker.MarkerKind == "special" then
        -- 활성 슬롯일 때만 보인다. 비활성 후보 자리는 숨긴다 (F5 §3).
        if marker.IsActive then
            ruid = self.SpecialRuid
            scale = self.SpecialScale
            if self._T.wasActive ~= true and not isFirstPaint then
                -- 비활성 → 활성. 이 marker 에서 실제로 스폰이 일어난 순간이다.
                self:PlayEmphasis()
                log("[VeinMarkerFx] special spawn emphasis " .. self.Entity.Name
                    .. " cell=(" .. marker.CellX .. "," .. marker.CellY .. ")")
            end
            self._T.wasActive = true
        else
            -- 활성 목록에서 제거되면 즉시 연출을 취소한다 (F5 §3).
            self._T.wasActive = false
            self._T.pulseElapsed = -1
        end
    else
        ruid = self:StageRuid(marker.ReserveStage)
    end

    -- 뱃지는 부모가 숨을 때 함께 숨어야 하므로 아래 조기 return 보다 먼저 부른다.
    self:UpdateBadge(marker, ruid ~= "")

    if ruid == "" then
        -- 빈 RUID 를 넣으면 아무 오류 없이 사라진다(platform.md §7). 그래서
        -- RUID 를 지우는 대신 렌더러 자체를 끈다.
        renderer.Enable = false
        return
    end

    renderer.Enable = true
    renderer.SpriteRUID = ruid
    -- 펄스가 끝나면 이 값으로 돌아간다. kind 별로 다르므로 여기서 기억해 둔다.
    self._T.restScale = scale
    self.Entity.TransformComponent.Scale = Vector3(scale, scale, 1)
end

@ExecSpace("ClientOnly")
method string StageRuid(integer stage)
    -- Maps ReserveStage 0~3 to the approved 부유석 condition sprites (C206).
    if stage >= 3 then return self.Stage3Ruid end
    if stage == 2 then return self.Stage2Ruid end
    if stage == 1 then return self.Stage1Ruid end
    return self.Stage0Ruid
end

end
