-- CAMERA CONTROL (마우스 휠 줌 + 휠 버튼 드래그 팬)
-- 오너 요청 (2026-08-21): 월드 카메라만 확대/축소한다 — UI 는 영향 없음.
-- 줌 범위: 현재(ZoomRatio 100)가 최대 확대, 최소는 3배 축소(100/3 ≈ 33.4).
-- 팬은 CameraComponent.CameraOffset 만 움직인다 — 플레이어(비표시)는 건드리지
-- 않으므로 기존 "플레이어 이동 = 카메라 팬" 수단과 공존한다.
--
-- 좌표 방식 (2026-08-21 개정): 픽셀→world 상수 환산은 실창 크기에 따라 어긋나
-- 마우스를 1:1 로 못 따라갔다. 대신 _UILogic:ScreenToWorldPosition 으로
-- "커서 아래 월드 지점"을 앵커로 잡아 고정한다 — 팬은 드래그 시작점의 월드
-- 좌표를 커서에 계속 붙이고, 줌은 포토샵처럼 커서 아래 지점이 제자리에 남는다.
-- ⚠ ScreenToWorldPosition 은 카메라 변경을 다음 프레임에 반영한다(실측) —
-- 그래서 줌 보정은 지연 측정값에 서보를 돌리지 않고(진동 원인), 노치가 들어온
-- 프레임에 "화면 반경 ∝ 1/ZoomRatio" 관계로 오프셋을 한 번에 해석 계산한다.
-- 연속 휠 동안은 첫 노치의 실측(zoomAnchor)을 기준으로 누적 배율만 다시 푼다.
-- 전부 ClientOnly: 카메라는 로컬 표시 전용이고 서버 상태를 바꾸지 않는다.
@Logic
script CameraControlLogic extends Logic

-- 줌 경계. 엔진 제약(ZoomRatioMin > 30)을 지키는 값이다.
property number MaxZoom = 100.0
property number MinZoom = 33.4
-- 휠 1노치당 줌 배율 (곱셈 스텝 — 어느 배율에서도 체감이 같다).
property number ZoomStep = 1.1
-- 팬 한계 (world unit, 카메라 오프셋 절대값 상한 — 맵 밖으로 무한히 나가는 것 방지).
property number PanLimit = 30.0

property any scrollHandler = nil
property any keyDownHandler = nil
property any keyUpHandler = nil

@ExecSpace("ClientOnly")
method void OnBeginPlay()
    -- 입력 이벤트 연결. 카메라 설정은 플레이어 스폰 뒤 GetCamera 가 지연 적용한다.
    self._T.zoom = self.MaxZoom
    self._T.dragging = false
    self._T.dragAnchor = nil        -- 드래그 시작 시 커서 아래 월드 지점 (Vector2)
    self._T.offsetX = 0.0
    self._T.offsetY = 0.0
    self._T.zoomAnchor = nil        -- 연속 휠 세션의 기준 실측 { worldX, worldY, relX, relY, zoom0, offsetX0, offsetY0, timeout }
    self._T.configured = false
    self._T.lastMapName = ""
    self.scrollHandler = _InputService:ConnectEvent(MouseScrollEvent, self.OnMouseScroll)
    self.keyDownHandler = _InputService:ConnectEvent(KeyDownEvent, self.OnKeyDown)
    self.keyUpHandler = _InputService:ConnectEvent(KeyUpEvent, self.OnKeyUp)
    log("[CameraControl] ready zoom=" .. tostring(self._T.zoom))
end

@ExecSpace("ClientOnly")
method void OnEndPlay()
    -- 이벤트 해제 (OnBeginPlay 연결분 전부).
    if self.scrollHandler ~= nil then _InputService:DisconnectEvent(MouseScrollEvent, self.scrollHandler) end
    if self.keyDownHandler ~= nil then _InputService:DisconnectEvent(KeyDownEvent, self.keyDownHandler) end
    if self.keyUpHandler ~= nil then _InputService:DisconnectEvent(KeyUpEvent, self.keyUpHandler) end
end

@ExecSpace("ClientOnly")
method CameraComponent GetCamera()
    -- 로컬 플레이어의 카메라. 최초 접근 시 줌 경계를 엔진 제약에 맞춰 넓혀 둔다.
    local player = _UserService.LocalPlayer
    if player == nil then return nil end
    local camera = player.CameraComponent
    if camera == nil then return nil end
    if not self._T.configured then
        camera.ZoomRatioMax = self.MaxZoom
        camera.ZoomRatioMin = 31.0
        camera.IsAllowZoomInOut = true
        -- 추적 감쇠 제거: 기본 Damping(2.5, 5.0)은 y 축이 특히 느려서, 줌·팬이
        -- CameraOffset 을 한 프레임에 써도 렌더 카메라가 세로로 미끄러지며
        -- 따라온다(줌 시 상하 슬라이드의 원인). DeadZone 도 미세 보정을 삼킨다.
        -- 이 카메라는 커서 1:1 조작이 목적이므로 둘 다 0 이 맞다.
        camera.Damping = Vector2(0.0, 0.0)
        camera.DeadZone = Vector2(0.0, 0.0)
        self._T.configured = true
        log("[CameraControl] camera configured min=" .. tostring(camera.ZoomRatioMin) .. " max=" .. tostring(camera.ZoomRatioMax))
    end
    return camera
end

@ExecSpace("ClientOnly")
method void ApplyOffset(CameraComponent camera, number ox, number oy)
    -- 팬 한계로 클램프해 카메라 오프셋을 쓴다.
    ox = math.max(-self.PanLimit, math.min(self.PanLimit, ox))
    oy = math.max(-self.PanLimit, math.min(self.PanLimit, oy))
    self._T.offsetX = ox
    self._T.offsetY = oy
    camera.CameraOffset = Vector2(ox, oy)
end

@ExecSpace("ClientOnly")
method void OnMouseScroll(MouseScrollEvent event)
    -- 휠 위 = 확대, 아래 = 축소. UI 위에서는 무시한다 (리스트 스크롤과 충돌 방지).
    -- 포토샵식 커서 고정: 화면 반경이 1/ZoomRatio 에 비례하므로, 커서 아래 지점이
    -- 제자리에 남으려면 카메라 중심이 (커서월드-중심월드)×(1 - z0/z1) 만큼 이동해야
    -- 한다. 이 값을 노치 프레임에 한 번에 적용한다 — 지연 측정 서보(진동 원인) 없음.
    if _InputService:IsPointerOverUI() then return end
    local camera = self:GetCamera()
    if camera == nil then return end
    local zoom = self._T.zoom
    if event.ScrollDelta > 0 then
        zoom = zoom * self.ZoomStep
    elseif event.ScrollDelta < 0 then
        zoom = zoom / self.ZoomStep
    end
    zoom = math.max(self.MinZoom, math.min(self.MaxZoom, zoom))
    if zoom == self._T.zoom then return end
    -- 팬 드래그 중에는 배율만 바꾼다 — 오프셋은 OnUpdate ② 의 팬 피드포워드가
    -- 새 줌(zoomScale)까지 반영해 전담 계산하므로, 여기서 또 만지면 이중 보정이다.
    if self._T.dragging then
        self._T.zoom = zoom
        camera.ZoomRatio = zoom
        return
    end
    -- 연속 휠 세션: 첫 노치에서만 실측하고(그 프레임의 렌더 기준으로 커서·중심이
    -- 서로 일관), 이후 노치는 캡처값에서 새 배율로 다시 푼다. 실측을 매 노치
    -- 반복하면 1프레임 지연 값이 섞여 어긋난다.
    local anchor = self._T.zoomAnchor
    if anchor == nil then
        local cursor = _InputService:GetCursorPosition()
        local center = Vector2(_UILogic.ScreenWidth * 0.5, _UILogic.ScreenHeight * 0.5)
        local world = _UILogic:ScreenToWorldPosition(cursor)
        local centerWorld = _UILogic:ScreenToWorldPosition(center)
        anchor = {
            worldX = world.x, worldY = world.y,
            relX = world.x - centerWorld.x, relY = world.y - centerWorld.y,
            zoom0 = self._T.zoom, offsetX0 = self._T.offsetX, offsetY0 = self._T.offsetY,
            timeout = 0.3
        }
        self._T.zoomAnchor = anchor
    else
        anchor.timeout = 0.3
    end
    local scale = 1.0 - anchor.zoom0 / zoom
    self:ApplyOffset(camera, anchor.offsetX0 + anchor.relX * scale, anchor.offsetY0 + anchor.relY * scale)
    self._T.zoom = zoom
    camera.ZoomRatio = zoom
end

@ExecSpace("ClientOnly")
method void OnKeyDown(KeyDownEvent event)
    -- 휠 버튼(가운데 버튼)을 누르는 동안 팬 모드. 시작 프레임에 커서 아래 월드
    -- 지점(앵커) + 픽셀→월드 배율 + 카메라 기준점(중심-오프셋)을 실측해 두면,
    -- 이후 프레임은 측정 없이 "앵커가 커서 밑에 오는 오프셋"을 직접 계산할 수
    -- 있다 (피드포워드 — 지연 측정 서보의 출렁임 없음).
    if event.key ~= KeyboardKey.Mouse2 then return end
    if _InputService:IsPointerOverUI() then return end
    local cursor = _InputService:GetCursorPosition()
    local center = Vector2(_UILogic.ScreenWidth * 0.5, _UILogic.ScreenHeight * 0.5)
    local world = _UILogic:ScreenToWorldPosition(cursor)
    local centerWorld = _UILogic:ScreenToWorldPosition(center)
    local probeX = _UILogic:ScreenToWorldPosition(Vector2(center.x + 100.0, center.y))
    local probeY = _UILogic:ScreenToWorldPosition(Vector2(center.x, center.y + 100.0))
    self._T.dragAnchor = {
        x = world.x, y = world.y,
        baseX = centerWorld.x - self._T.offsetX, baseY = centerWorld.y - self._T.offsetY,
        kx = (probeX.x - centerWorld.x) * 0.01, ky = (probeY.y - centerWorld.y) * 0.01,
        zoom0 = self._T.zoom
    }
    self._T.dragging = true
end

@ExecSpace("ClientOnly")
method void OnKeyUp(KeyUpEvent event)
    -- 휠 버튼을 놓으면 팬 종료.
    if event.key == KeyboardKey.Mouse2 then
        self._T.dragging = false
        self._T.dragAnchor = nil
    end
end

@ExecSpace("ClientOnly")
method void OnUpdate(number delta)
    -- 줌 앵커 세션 만료 → 팬 추적 → 맵 전환 리셋을 한 곳에서 돈다.
    local camera = nil

    -- ① 줌 앵커 세션 만료: 보정 자체는 OnMouseScroll 이 노치 프레임에 끝냈다.
    --    여기서는 마지막 노치 후 0.3s 가 지나면 세션을 닫아, 다음 휠이 새 실측으로
    --    시작하게만 한다 (커서가 옮겨졌을 수 있으므로).
    local anchor = self._T.zoomAnchor
    if anchor ~= nil then
        anchor.timeout = anchor.timeout - delta
        if anchor.timeout <= 0 then self._T.zoomAnchor = nil end
    end

    -- ② 팬: 드래그 시작점의 월드 지점을 커서에 계속 붙인다 (잡고 끌기 1:1).
    --    시작 프레임에 실측해 둔 배율·기준점으로 목표 오프셋을 직접 계산한다.
    --    ScreenToWorldPosition 을 매 프레임 다시 읽지 않으므로(1프레임 지연 값)
    --    서보식 출렁임이 없다. 배율은 줌에 반비례하므로 zoom0/zoom 으로 환산한다.
    if self._T.dragging and self._T.dragAnchor ~= nil then
        if camera == nil then camera = self:GetCamera() end
        if camera ~= nil then
            local pan = self._T.dragAnchor
            local cursor = _InputService:GetCursorPosition()
            local zoomScale = pan.zoom0 / self._T.zoom
            local relX = (cursor.x - _UILogic.ScreenWidth * 0.5) * pan.kx * zoomScale
            local relY = (cursor.y - _UILogic.ScreenHeight * 0.5) * pan.ky * zoomScale
            local ox = pan.x - relX - pan.baseX
            local oy = pan.y - relY - pan.baseY
            if ox ~= self._T.offsetX or oy ~= self._T.offsetY then
                self:ApplyOffset(camera, ox, oy)
            end
        end
    end

    -- ③ 맵이 바뀌면 팬 오프셋만 원점으로 되돌린다 (줌 배율은 유지 — 사용자 취향값).
    local player = _UserService.LocalPlayer
    if player == nil or player.CurrentMap == nil then return end
    local mapName = player.CurrentMap.Name
    if mapName ~= self._T.lastMapName then
        self._T.lastMapName = mapName
        if self._T.offsetX ~= 0.0 or self._T.offsetY ~= 0.0 then
            if camera == nil then camera = self:GetCamera() end
            if camera ~= nil then self:ApplyOffset(camera, 0.0, 0.0) end
            self._T.dragging = false
            self._T.dragAnchor = nil
            log("[CameraControl] map changed - pan offset reset map=" .. mapName)
        end
    end
end

end
